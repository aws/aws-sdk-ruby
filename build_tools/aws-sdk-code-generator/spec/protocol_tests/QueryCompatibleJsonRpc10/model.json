                        "vendorParamsShape": "aws.protocoltests.config#ErrorCodeParams",
                        "vendorParams": {
                            "code": "NoCustomCodeError"
                        }
                    }
                ]
            }
        },
        "aws.protocoltests.json10#QueryCompatibleJsonRpc10": {
