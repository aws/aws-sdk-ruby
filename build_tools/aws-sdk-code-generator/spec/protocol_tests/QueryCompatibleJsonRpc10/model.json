                        "id": "QueryCompatibleAwsJson10NoCustomCodeError",
                        "documentation": "Parses simple errors with no query error code",
                        "protocol": "aws.protocols#awsJson1_0",
                        "params": {
                            "message": "Hi"
                        },
                        "code": 400,
                        "headers": {
                            "Content-Type": "application/x-amz-json-1.0"
                        },
                        "body": "{\n    \"__type\": \"aws.protocoltests.json10#NoCustomCodeError\",\n    \"message\": \"Hi\"\n}",
