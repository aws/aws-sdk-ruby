{
  "version": "1.0",
  "sources": ["model.smithy"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-aws-protocol-tests:1.60.3"
    ]
  },
  "projections": {
    "AwsEc2": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.ec2#AwsEc2"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "AwsQuery": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.query#AwsQuery"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "JsonProtocol": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.json#JsonProtocol"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "JsonRpc10": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.json10#JsonRpc10"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "QueryCompatibleJsonRpc10": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.json10#QueryCompatibleJsonRpc10"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "RestJson": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.restjson#RestJson"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    },
    "RestXml": {
      "transforms": [
        {
          "name": "includeServices",
          "args": { "services": ["aws.protocoltests.restxml#RestXml"] }
        },
        { "name": "removeUnusedShapes" },
        { "name": "removeTraitDefinitions" }
      ]
    }
  }
}
