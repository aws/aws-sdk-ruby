    class Condition
      include Smithy::Schema::Union

      def initialize: (
        ?allow_after: Time,
        ?allow_before: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor allow_after: Time?
      attr_accessor allow_before: Time?

      class AllowAfter < Condition
      end
      class AllowBefore < Condition
      end
      class Unknown < Condition
      end
    end

