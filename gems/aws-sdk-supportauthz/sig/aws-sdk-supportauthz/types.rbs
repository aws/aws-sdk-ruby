    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ActionSet
      include Smithy::Schema::Union

      def initialize: (
        ?all_actions: Smithy::Schema::EmptyStructure,
        ?actions: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor all_actions: Smithy::Schema::EmptyStructure?
      attr_accessor actions: Array[String]?

      class AllActions < ActionSet
      end
      class Actions < ActionSet
      end
      class Unknown < ActionSet
      end
    end

    class ActionSummary
      include Smithy::Schema::Structure

