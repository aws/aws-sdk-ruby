    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateEndpointResponse
      include Smithy::Client::_Response[Types::UpdateEndpointResponse]
      def desired_model_arn: () -> String?
    end
    def update_endpoint: (
      ?endpoint_arn: String,
      ?desired_model_arn: String,
      ?desired_inference_units: Integer,
      ?desired_data_access_role_arn: String,
      ?flywheel_arn: String
    ) -> _UpdateEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateEndpointResponse

    interface _UpdateFlywheelResponse
      include Smithy::Client::_Response[Types::UpdateFlywheelResponse]
      def flywheel_properties: () -> Types::FlywheelProperties?
    end
    def update_flywheel: (
      ?flywheel_arn: String,
      ?active_model_arn: String,
      ?data_access_role_arn: String,
      ?data_security_config: {
        model_kms_key_id: String,
        volume_kms_key_id: untyped,
        vpc_config: {
          security_group_ids: Array[String],
          subnets: Array[String]
        }
      }
    ) -> _UpdateFlywheelResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateFlywheelResponse
  end
end
