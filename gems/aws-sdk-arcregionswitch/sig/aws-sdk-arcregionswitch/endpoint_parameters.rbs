module Aws::ARCRegionswitch
  class EndpointParameters
    def initialize: (
      ?use_fips: bool,
      ?endpoint: String,
      ?region: String,
      ?use_control_plane_endpoint: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    attr_accessor use_fips: bool?
    attr_accessor endpoint: String?
    attr_accessor region: String?
    attr_accessor use_control_plane_endpoint: bool?
  end
end
