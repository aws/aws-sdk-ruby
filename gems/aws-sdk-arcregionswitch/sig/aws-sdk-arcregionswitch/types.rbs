    class ExecutionBlockConfiguration
      include Smithy::Schema::Union

      def initialize: (
        ?custom_action_lambda_config: Types::CustomActionLambdaConfiguration,
        ?ec2_asg_capacity_increase_config: Types::Ec2AsgCapacityIncreaseConfiguration,
        ?execution_approval_config: Types::ExecutionApprovalConfiguration,
        ?arc_routing_control_config: Types::ArcRoutingControlConfiguration,
        ?global_aurora_config: Types::GlobalAuroraConfiguration,
        ?parallel_config: Types::ParallelExecutionBlockConfiguration,
        ?region_switch_plan_config: Types::RegionSwitchPlanConfiguration,
        ?ecs_capacity_increase_config: Types::EcsCapacityIncreaseConfiguration,
        ?eks_resource_scaling_config: Types::EksResourceScalingConfiguration,
        ?route53_health_check_config: Types::Route53HealthCheckConfiguration,
        ?document_db_config: Types::DocumentDbConfiguration,
        ?rds_promote_read_replica_config: Types::RdsPromoteReadReplicaConfiguration,
        ?rds_create_cross_region_read_replica_config: Types::RdsCreateCrossRegionReplicaConfiguration,
        ?lambda_event_source_mapping_config: Types::LambdaEventSourceMappingConfiguration,
        ?aurora_serverless_scaling_config: Types::AuroraServerlessScalingConfiguration,
        ?aurora_provisioned_scaling_config: Types::AuroraProvisionedScalingConfiguration,
        ?neptune_global_database_config: Types::NeptuneGlobalDatabaseConfiguration,
        ?rds_switchover_read_replica_config: Types::RdsSwitchoverReadReplicaConfiguration,
        ?ssm_send_command_config: Types::SsmSendCommandConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor custom_action_lambda_config: Types::CustomActionLambdaConfiguration?
      attr_accessor ec2_asg_capacity_increase_config: Types::Ec2AsgCapacityIncreaseConfiguration?
      attr_accessor execution_approval_config: Types::ExecutionApprovalConfiguration?
      attr_accessor arc_routing_control_config: Types::ArcRoutingControlConfiguration?
      attr_accessor global_aurora_config: Types::GlobalAuroraConfiguration?
      attr_accessor parallel_config: Types::ParallelExecutionBlockConfiguration?
      attr_accessor region_switch_plan_config: Types::RegionSwitchPlanConfiguration?
      attr_accessor ecs_capacity_increase_config: Types::EcsCapacityIncreaseConfiguration?
      attr_accessor eks_resource_scaling_config: Types::EksResourceScalingConfiguration?
      attr_accessor route53_health_check_config: Types::Route53HealthCheckConfiguration?
      attr_accessor document_db_config: Types::DocumentDbConfiguration?
      attr_accessor rds_promote_read_replica_config: Types::RdsPromoteReadReplicaConfiguration?
      attr_accessor rds_create_cross_region_read_replica_config: Types::RdsCreateCrossRegionReplicaConfiguration?
      attr_accessor lambda_event_source_mapping_config: Types::LambdaEventSourceMappingConfiguration?
      attr_accessor aurora_serverless_scaling_config: Types::AuroraServerlessScalingConfiguration?
      attr_accessor aurora_provisioned_scaling_config: Types::AuroraProvisionedScalingConfiguration?
      attr_accessor neptune_global_database_config: Types::NeptuneGlobalDatabaseConfiguration?
      attr_accessor rds_switchover_read_replica_config: Types::RdsSwitchoverReadReplicaConfiguration?
      attr_accessor ssm_send_command_config: Types::SsmSendCommandConfiguration?

      class CustomActionLambdaConfig < ExecutionBlockConfiguration
      end
      class Ec2AsgCapacityIncreaseConfig < ExecutionBlockConfiguration
      end
      class ExecutionApprovalConfig < ExecutionBlockConfiguration
      end
      class ArcRoutingControlConfig < ExecutionBlockConfiguration
      end
      class GlobalAuroraConfig < ExecutionBlockConfiguration
      end
      class ParallelConfig < ExecutionBlockConfiguration
      end
      class RegionSwitchPlanConfig < ExecutionBlockConfiguration
      end
      class EcsCapacityIncreaseConfig < ExecutionBlockConfiguration
      end
      class EksResourceScalingConfig < ExecutionBlockConfiguration
      end
      class Route53HealthCheckConfig < ExecutionBlockConfiguration
      end
      class DocumentDbConfig < ExecutionBlockConfiguration
      end
      class RdsPromoteReadReplicaConfig < ExecutionBlockConfiguration
      end
      class RdsCreateCrossRegionReadReplicaConfig < ExecutionBlockConfiguration
      end
      class LambdaEventSourceMappingConfig < ExecutionBlockConfiguration
      end
      class AuroraServerlessScalingConfig < ExecutionBlockConfiguration
      end
      class AuroraProvisionedScalingConfig < ExecutionBlockConfiguration
      end
      class NeptuneGlobalDatabaseConfig < ExecutionBlockConfiguration
      end
      class RdsSwitchoverReadReplicaConfig < ExecutionBlockConfiguration
      end
      class SsmSendCommandConfig < ExecutionBlockConfiguration
      end
      class Unknown < ExecutionBlockConfiguration
      end
    end

