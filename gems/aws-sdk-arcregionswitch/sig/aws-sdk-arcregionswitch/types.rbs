module Aws::ARCRegionswitch
  module Types

    class AbbreviatedExecution
      include Smithy::Schema::Structure

      def initialize: (
        ?plan_arn: String,
        ?execution_id: String,
        ?version: String,
        ?updated_at: Time,
        ?comment: String,
        ?start_time: Time,
        ?end_time: Time,
        ?mode: String,
        ?execution_state: String,
        ?execution_action: String,
        ?execution_region: String,
        ?recovery_execution_id: String,
        ?actual_recovery_time: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor plan_arn: String?
      attr_accessor execution_id: String?
      attr_accessor version: String?
      attr_accessor updated_at: Time?
      attr_accessor comment: String?
      attr_accessor start_time: Time?
      attr_accessor end_time: Time?
      attr_accessor mode: String?
      attr_accessor execution_state: String?
      attr_accessor execution_action: String?
      attr_accessor execution_region: String?
      attr_accessor recovery_execution_id: String?
      attr_accessor actual_recovery_time: String?
    end

    class AbbreviatedPlan
