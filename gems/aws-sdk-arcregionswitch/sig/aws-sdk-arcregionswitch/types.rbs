      STEP_SUCCEEDED: String
      STEP_FAILED: String
      STEP_SKIPPED: String
      STEP_PAUSED_BY_ERROR: String
      STEP_PAUSED_BY_OPERATOR: String
      STEP_CANCELED: String
      STEP_PENDING_APPROVAL: String
      STEP_EXECUTION_BEHAVIOR_CHANGED_TO_UNGRACEFUL: String
