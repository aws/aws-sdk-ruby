      include Smithy::Client::_Response[Types::RotateSecretResponse]
      def arn: () -> String?
      def name: () -> String?
      def version_id: () -> String?
    end
    def rotate_secret: (
      ?secret_id: String,
      ?client_request_token: String,
      ?rotation_lambda_arn: String,
      ?rotation_rules: {
        automatically_after_days: Integer,
        duration: String,
        schedule_expression: String
      },
      ?rotate_immediately: bool
    ) -> _RotateSecretResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RotateSecretResponse

    interface _StopReplicationToReplicaResponse
