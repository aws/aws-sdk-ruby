module Aws::SecretsManager
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SecretsManager::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchGetSecretValueResponse
      include Smithy::Client::_Response[Types::BatchGetSecretValueResponse]
      def secret_values: () -> Array[Types::SecretValueEntry]?
      def next_token: () -> String?
      def errors: () -> Array[Types::APIErrorType]?
    end
    def batch_get_secret_value: (
      ?secret_id_list: Array[String],
      ?filters: Array[
        {
          key: String,
          values: Array[String]
        }
      ],
      ?max_results: Integer,
      ?next_token: String
    ) -> _BatchGetSecretValueResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchGetSecretValueResponse

    interface _CancelRotateSecretResponse
      include Smithy::Client::_Response[Types::CancelRotateSecretResponse]
      def arn: () -> String?
      def name: () -> String?
      def version_id: () -> String?
    end
    def cancel_rotate_secret: (
      ?secret_id: String
    ) -> _CancelRotateSecretResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CancelRotateSecretResponse

    interface _CreateSecretResponse
      include Smithy::Client::_Response[Types::CreateSecretResponse]
      def arn: () -> String?
      def name: () -> String?
      def version_id: () -> String?
      def replication_status: () -> Array[Types::ReplicationStatusType]?
    end
    def create_secret: (
      ?name: String,
      ?client_request_token: String,
      ?description: String,
      ?kms_key_id: String,
      ?secret_binary: String,
      ?secret_string: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?add_replica_regions: Array[
        {
          region: String,
          kms_key_id: String
        }
      ],
      ?force_overwrite_replica_secret: bool
    ) -> _CreateSecretResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateSecretResponse

    interface _DeleteResourcePolicyResponse
      include Smithy::Client::_Response[Types::DeleteResourcePolicyResponse]
      def arn: () -> String?
      def name: () -> String?
    end
    def delete_resource_policy: (
      ?secret_id: String
    ) -> _DeleteResourcePolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteResourcePolicyResponse

    interface _DeleteSecretResponse
      include Smithy::Client::_Response[Types::DeleteSecretResponse]
      def arn: () -> String?
      def name: () -> String?
      def deletion_date: () -> Time?
    end
    def delete_secret: (
      ?secret_id: String,
      ?recovery_window_in_days: Integer,
      ?force_delete_without_recovery: bool
    ) -> _DeleteSecretResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSecretResponse

    interface _DescribeSecretResponse
      include Smithy::Client::_Response[Types::DescribeSecretResponse]
      def arn: () -> String?
      def name: () -> String?
      def description: () -> String?
      def kms_key_id: () -> String?
      def rotation_enabled: () -> bool?
      def rotation_lambda_arn: () -> String?
      def rotation_rules: () -> Types::RotationRulesType?
      def last_rotated_date: () -> Time?
      def last_changed_date: () -> Time?
      def last_accessed_date: () -> Time?
      def deleted_date: () -> Time?
      def next_rotation_date: () -> Time?
      def tags: () -> Array[Types::Tag]?
      def version_ids_to_stages: () -> Hash[String, Array[String]]?
      def owning_service: () -> String?
      def created_date: () -> Time?
      def primary_region: () -> String?
      def replication_status: () -> Array[Types::ReplicationStatusType]?
    end
    def describe_secret: (
      ?secret_id: String
    ) -> _DescribeSecretResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeSecretResponse

    interface _GetRandomPasswordResponse
      include Smithy::Client::_Response[Types::GetRandomPasswordResponse]
      def random_password: () -> String?
    end
    def get_random_password: (
      ?password_length: Integer,
      ?exclude_characters: String,
      ?exclude_numbers: bool,
      ?exclude_punctuation: bool,
      ?exclude_uppercase: bool,
      ?exclude_lowercase: bool,
      ?include_space: bool,
      ?require_each_included_type: bool
    ) -> _GetRandomPasswordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetRandomPasswordResponse

    interface _GetResourcePolicyResponse
      include Smithy::Client::_Response[Types::GetResourcePolicyResponse]
