    end
    def list_secrets: (
      ?include_planned_deletion: bool,
      ?max_results: Integer,
      ?next_token: String,
      ?filters: Array[
        {
          key: String,
          values: Array[String]
        }
      ],
      ?sort_order: String
    ) -> _ListSecretsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSecretsResponse

