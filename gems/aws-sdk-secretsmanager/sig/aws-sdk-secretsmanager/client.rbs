    interface _ReplicateSecretToRegionsResponse
      include Smithy::Client::_Response[Types::ReplicateSecretToRegionsResponse]
      def arn: () -> String?
      def replication_status: () -> Array[Types::ReplicationStatusType]?
    end
    def replicate_secret_to_regions: (
      ?secret_id: String,
      ?add_replica_regions: Array[
        {
          region: String,
          kms_key_id: String
        }
      ],
      ?force_overwrite_replica_secret: bool
    ) -> _ReplicateSecretToRegionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ReplicateSecretToRegionsResponse

