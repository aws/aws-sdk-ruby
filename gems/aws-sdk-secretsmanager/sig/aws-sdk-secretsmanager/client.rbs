      include Smithy::Client::_Response[Types::RemoveRegionsFromReplicationResponse]
      def arn: () -> String?
      def replication_status: () -> Array[Types::ReplicationStatusType]?
    end
    def remove_regions_from_replication: (
      ?secret_id: String,
