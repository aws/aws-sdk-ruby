        ?usage: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor limit: Integer?
      attr_accessor usage: Float?
    end

    class UserMessageBlock
      include Smithy::Schema::Union

      def initialize: (
        ?text: String,
        ?tool_result: Smithy::Schema::document,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor text: String?
      attr_accessor tool_result: Smithy::Schema::document?

      class Text < UserMessageBlock
      end
      class ToolResult < UserMessageBlock
      end
      class Unknown < UserMessageBlock
      end
    end

