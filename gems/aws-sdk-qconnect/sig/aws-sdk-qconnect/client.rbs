            },
            inclusion_filters: Array[String],
            exclusion_filters: untyped,
            scope: String
          }
        }
      },
      ?rendering_configuration: {
        template_uri: String
      },
      ?vector_ingestion_configuration: {
        chunking_configuration: {
          chunking_strategy: String,
          fixed_size_chunking_configuration: {
            max_tokens: Integer,
            overlap_percentage: untyped
          },
          hierarchical_chunking_configuration: {
            level_configurations: Array[
              {
                max_tokens: untyped
              }
            ],
            overlap_tokens: untyped
          },
          semantic_chunking_configuration: {
            max_tokens: untyped,
            buffer_size: untyped,
            breakpoint_percentile_threshold: untyped
          }
        },
        parsing_configuration: {
          parsing_strategy: String,
          bedrock_foundation_model_configuration: {
            model_arn: String,
            parsing_prompt: {
              parsing_prompt_text: String
            }
          }
        }
      },
      ?server_side_encryption_configuration: {
        kms_key_id: String
      },
      ?description: String,
      ?tags: Hash[String, String]
    ) -> _CreateKnowledgeBaseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateKnowledgeBaseResponse

