    end
    def create_ai_agent: (
      ?client_token: String,
      ?assistant_id: String,
      ?name: String,
      ?type: String,
      ?configuration: {
        manual_search_ai_agent_configuration: {
          answer_generation_ai_prompt_id: String,
          answer_generation_ai_guardrail_id: untyped,
          association_configurations: Array[
            {
              association_id: String,
              association_type: String,
              association_configuration_data: {
                knowledge_base_association_configuration_data: {
                  content_tag_filter: {
                    tag_condition: {
                      key: String,
                      value: String
                    },
                    and_conditions: Array[
                      {
                        key: untyped,
                        value: untyped
                      }
                    ],
                    or_conditions: Array[
                      {
                        and_conditions: untyped,
                        tag_condition: untyped
                      }
                    ]
                  },
                  max_results: Integer,
                  override_knowledge_base_search_type: String
                }
              }
            }
          ],
          locale: String
        },
        answer_recommendation_ai_agent_configuration: {
          intent_labeling_generation_ai_prompt_id: untyped,
          query_reformulation_ai_prompt_id: untyped,
          answer_generation_ai_prompt_id: untyped,
          answer_generation_ai_guardrail_id: untyped,
          association_configurations: untyped,
          locale: untyped
        },
        self_service_ai_agent_configuration: {
          self_service_pre_processing_ai_prompt_id: untyped,
          self_service_answer_generation_ai_prompt_id: untyped,
          self_service_ai_guardrail_id: untyped,
          association_configurations: untyped
        },
        email_response_ai_agent_configuration: {
          email_response_ai_prompt_id: untyped,
          email_query_reformulation_ai_prompt_id: untyped,
          locale: untyped,
          association_configurations: untyped
        },
        email_overview_ai_agent_configuration: {
          email_overview_ai_prompt_id: untyped,
          locale: untyped
        },
        email_generative_answer_ai_agent_configuration: {
          email_generative_answer_ai_prompt_id: untyped,
          email_query_reformulation_ai_prompt_id: untyped,
          locale: untyped,
          association_configurations: untyped
        }
      },
      ?visibility_status: String,
      ?tags: Hash[String, String],
      ?description: String
    ) -> _CreateAIAgentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateAIAgentResponse

