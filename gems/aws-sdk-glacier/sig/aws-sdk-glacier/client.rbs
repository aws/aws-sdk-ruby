    interface _InitiateJobResponse
      include Smithy::Client::_Response[Types::InitiateJobOutput]
      def location: () -> String?
      def job_id: () -> String?
      def job_output_path: () -> String?
    end
    def initiate_job: (
      ?account_id: String,
      ?vault_name: String,
      ?job_parameters: {
        format: String,
        type: untyped,
        archive_id: untyped,
        description: untyped,
        sns_topic: untyped,
        retrieval_byte_range: untyped,
        tier: untyped,
        inventory_retrieval_parameters: {
          start_date: untyped,
          end_date: untyped,
          limit: untyped,
          marker: untyped
        },
        select_parameters: {
          input_serialization: {
            csv: {
              file_header_info: String,
              comments: untyped,
              quote_escape_character: untyped,
              record_delimiter: untyped,
              field_delimiter: untyped,
              quote_character: untyped
            }
          },
          expression_type: String,
          expression: untyped,
          output_serialization: {
            csv: {
              quote_fields: String,
              quote_escape_character: untyped,
              record_delimiter: untyped,
              field_delimiter: untyped,
              quote_character: untyped
            }
          }
        },
        output_location: {
          s3: {
            bucket_name: untyped,
            prefix: untyped,
            encryption: {
              encryption_type: String,
              kms_key_id: untyped,
              kms_context: untyped
            },
            canned_acl: String,
            access_control_list: Array[
              {
                grantee: {
                  type: String,
                  display_name: untyped,
                  uri: untyped,
                  id: untyped,
                  email_address: untyped
                },
                permission: String
              }
            ],
            tagging: Hash[String, String],
            user_metadata: untyped,
            storage_class: String
          }
        }
      }
    ) -> _InitiateJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InitiateJobResponse

