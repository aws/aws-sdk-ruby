module Aws::S3Outposts
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::S3Outposts::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: Smithy::Client::Retry::ExponentialBackoff,
      ?retry_base_delay: untyped,
      ?retry_max_attempts: Integer,
      ?retry_max_delay: untyped,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateEndpointResponse
      include Smithy::Client::_Response[Types::CreateEndpointResult]
      def endpoint_arn: () -> String?
    end
    def create_endpoint: (
      ?outpost_id: String,
      ?subnet_id: String,
      ?security_group_id: String,
      ?access_type: String,
      ?customer_owned_ipv4_pool: String
    ) -> _CreateEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateEndpointResponse

    interface _DeleteEndpointResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_endpoint: (
      ?endpoint_id: String,
      ?outpost_id: String
    ) -> _DeleteEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteEndpointResponse

    interface _ListEndpointsResponse
      include Smithy::Client::_Response[Types::ListEndpointsResult]
      def endpoints: () -> Array[Types::Endpoint]?
      def next_token: () -> String?
    end
    def list_endpoints: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListEndpointsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListEndpointsResponse

    interface _ListOutpostsWithS3Response
      include Smithy::Client::_Response[Types::ListOutpostsWithS3Result]
      def outposts: () -> Array[Types::Outpost]?
      def next_token: () -> String?
    end
    def list_outposts_with_s3: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListOutpostsWithS3Response | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListOutpostsWithS3Response

    interface _ListSharedEndpointsResponse
      include Smithy::Client::_Response[Types::ListSharedEndpointsResult]
      def endpoints: () -> Array[Types::Endpoint]?
      def next_token: () -> String?
    end
    def list_shared_endpoints: (
      ?next_token: String,
      ?max_results: Integer,
      ?outpost_id: String
    ) -> _ListSharedEndpointsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSharedEndpointsResponse
  end
end
