      ?version_revisions: Hash[String, String],
      ?expected_status: String,
      ?target_status: String
    ) -> _UpdatePackageVersionsStatusResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdatePackageVersionsStatusResponse

    interface _UpdateRepositoryResponse
      include Smithy::Client::_Response[Types::UpdateRepositoryResult]
      def repository: () -> Types::RepositoryDescription?
    end
    def update_repository: (
