module Aws::Braket
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Braket::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CancelJobResponse
      include Smithy::Client::_Response[Types::CancelJobOutput]
      def job_arn: () -> String?
      def cancellation_status: () -> String?
    end
    def cancel_job: (
      ?job_arn: String
    ) -> _CancelJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CancelJobResponse

    interface _CancelQuantumTaskResponse
      include Smithy::Client::_Response[Types::CancelQuantumTaskOutput]
      def quantum_task_arn: () -> String?
      def cancellation_status: () -> String?
    end
    def cancel_quantum_task: (
      ?quantum_task_arn: String,
      ?client_token: String
    ) -> _CancelQuantumTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CancelQuantumTaskResponse

    interface _CreateJobResponse
      include Smithy::Client::_Response[Types::CreateJobOutput]
      def job_arn: () -> String?
    end
    def create_job: (
      ?client_token: String,
      ?algorithm_specification: {
        script_mode_config: {
          entry_point: String,
          s3_uri: String,
          compression_type: String
        },
        container_image: {
          uri: String
        }
      },
      ?input_data_config: Array[
        {
          channel_name: String,
          content_type: String,
          data_source: {
            s3_data_source: {
              s3_uri: String
            }
          }
        }
      ],
      ?output_data_config: {
        kms_key_id: String,
        s3_path: String
      },
      ?checkpoint_config: {
        local_path: String,
        s3_uri: String
      },
      ?job_name: String,
      ?role_arn: String,
      ?stopping_condition: {
        max_runtime_in_seconds: Integer
      },
      ?instance_config: {
        instance_type: String,
        volume_size_in_gb: Integer,
        instance_count: untyped
      },
      ?hyper_parameters: Hash[String, String],
      ?device_config: {
        device: String
      },
      ?tags: Hash[String, String],
      ?associations: Array[
        {
          arn: String,
          type: String
        }
      ]
    ) -> _CreateJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateJobResponse

    interface _CreateQuantumTaskResponse
      include Smithy::Client::_Response[Types::CreateQuantumTaskOutput]
      def quantum_task_arn: () -> String?
    end
    def create_quantum_task: (
      ?client_token: String,
      ?device_arn: String,
      ?device_parameters: String,
      ?shots: Integer,
      ?output_s3_bucket: String,
      ?output_s3_key_prefix: String,
      ?action: String,
      ?tags: Hash[String, String],
      ?job_token: String,
      ?associations: Array[
        {
          arn: String,
          type: String
        }
      ]
    ) -> _CreateQuantumTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateQuantumTaskResponse

    interface _GetDeviceResponse
      include Smithy::Client::_Response[Types::GetDeviceOutput]
      def device_arn: () -> String?
      def device_name: () -> String?
      def provider_name: () -> String?
      def device_type: () -> String?
      def device_status: () -> String?
      def device_capabilities: () -> String?
      def device_queue_info: () -> Array[Types::DeviceQueueInfo]?
    end
    def get_device: (
      ?device_arn: String
    ) -> _GetDeviceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetDeviceResponse

    interface _GetJobResponse
      include Smithy::Client::_Response[Types::GetJobOutput]
      def status: () -> String?
      def job_arn: () -> String?
      def role_arn: () -> String?
      def failure_reason: () -> String?
      def job_name: () -> String?
      def hyper_parameters: () -> Hash[String, String]?
      def input_data_config: () -> Array[Types::InputFileConfig]?
      def output_data_config: () -> Types::JobOutputDataConfig?
      def stopping_condition: () -> Types::JobStoppingCondition?
      def checkpoint_config: () -> Types::JobCheckpointConfig?
      def algorithm_specification: () -> Types::AlgorithmSpecification?
      def instance_config: () -> Types::InstanceConfig?
      def created_at: () -> Time?
      def started_at: () -> Time?
      def ended_at: () -> Time?
      def billable_duration: () -> Integer?
      def device_config: () -> Types::DeviceConfig?
      def events: () -> Array[Types::JobEventDetails]?
      def tags: () -> Hash[String, String]?
      def queue_info: () -> Types::HybridJobQueueInfo?
      def associations: () -> Array[Types::Association]?
    end
    def get_job: (
      ?job_arn: String,
      ?additional_attribute_names: Array[String]
    ) -> _GetJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetJobResponse

    interface _GetQuantumTaskResponse
      include Smithy::Client::_Response[Types::GetQuantumTaskOutput]
      def quantum_task_arn: () -> String?
      def status: () -> String?
      def failure_reason: () -> String?
      def device_arn: () -> String?
      def device_parameters: () -> String?
      def shots: () -> Integer?
      def output_s3_bucket: () -> String?
      def output_s3_directory: () -> String?
      def created_at: () -> Time?
      def ended_at: () -> Time?
      def tags: () -> Hash[String, String]?
      def job_arn: () -> String?
      def queue_info: () -> Types::QuantumTaskQueueInfo?
      def associations: () -> Array[Types::Association]?
      def num_successful_shots: () -> Integer?
      def action_metadata: () -> Types::ActionMetadata?
    end
    def get_quantum_task: (
      ?quantum_task_arn: String,
      ?additional_attribute_names: Array[String]
    ) -> _GetQuantumTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetQuantumTaskResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _SearchDevicesResponse
      include Smithy::Client::_Response[Types::SearchDevicesOutput]
      def devices: () -> Array[Types::DeviceSummary]?
      def next_token: () -> String?
    end
    def search_devices: (
      ?next_token: String,
      ?max_results: Integer,
      ?filters: Array[
        {
          name: String,
          values: Array[String]
        }
      ]
    ) -> _SearchDevicesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchDevicesResponse

    interface _SearchJobsResponse
      include Smithy::Client::_Response[Types::SearchJobsOutput]
      def jobs: () -> Array[Types::JobSummary]?
      def next_token: () -> String?
    end
    def search_jobs: (
      ?next_token: String,
      ?max_results: Integer,
      ?filters: Array[
        {
          name: String,
          values: Array[String],
          operator: String
        }
      ]
    ) -> _SearchJobsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchJobsResponse

    interface _SearchQuantumTasksResponse
      include Smithy::Client::_Response[Types::SearchQuantumTasksOutput]
      def quantum_tasks: () -> Array[Types::QuantumTaskSummary]?
      def next_token: () -> String?
    end
    def search_quantum_tasks: (
      ?next_token: String,
      ?max_results: Integer,
      ?filters: Array[
        {
          name: String,
          values: Array[String],
          operator: String
        }
      ]
    ) -> _SearchQuantumTasksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchQuantumTasksResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceOutput]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceOutput]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
  end
end
