module Aws::Braket
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class DeviceOfflineException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class DeviceRetiredException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalServiceException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
      def reason: () -> String?
      def program_set_validation_failures: () -> Array[Types::ProgramSetValidationFailure]?
    end
  end
end
