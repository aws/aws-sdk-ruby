module Aws::B2bi
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AdvancedOptions
      include Smithy::Schema::Structure

      def initialize: (
        ?x12: Types::X12AdvancedOptions,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor x12: Types::X12AdvancedOptions?
    end

    class CapabilityConfiguration
      include Smithy::Schema::Union

      def initialize: (
        ?edi: Types::EdiConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor edi: Types::EdiConfiguration?

      class Edi < CapabilityConfiguration
      end
      class Unknown < CapabilityConfiguration
      end
    end

    module CapabilityDirection
      INBOUND: String
      OUTBOUND: String
    end

    class CapabilityOptions
      include Smithy::Schema::Structure

      def initialize: (
