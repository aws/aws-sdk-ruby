    class X12ValidationOptions
      include Smithy::Schema::Structure

      def initialize: (
        ?validation_rules: Array[Types::X12ValidationRule],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor validation_rules: Array[Types::X12ValidationRule]?
    end

    class X12ValidationRule
      include Smithy::Schema::Union

      def initialize: (
        ?code_list_validation_rule: Types::X12CodeListValidationRule,
        ?element_length_validation_rule: Types::X12ElementLengthValidationRule,
        ?element_requirement_validation_rule: Types::X12ElementRequirementValidationRule,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor code_list_validation_rule: Types::X12CodeListValidationRule?
      attr_accessor element_length_validation_rule: Types::X12ElementLengthValidationRule?
      attr_accessor element_requirement_validation_rule: Types::X12ElementRequirementValidationRule?

      class CodeListValidationRule < X12ValidationRule
      end
      class ElementLengthValidationRule < X12ValidationRule
      end
      class ElementRequirementValidationRule < X12ValidationRule
      end
      class Unknown < X12ValidationRule
      end
    end

