    def create_capability: (
      ?name: String,
      ?type: String,
      ?configuration: {
        edi: {
          capability_direction: String,
          type: {
            x12_details: {
              transaction_set: String,
              version: String
            }
          },
          input_location: {
            bucket_name: String,
            key: String
          },
          output_location: untyped,
          transformer_id: String
        }
      },
      ?instructions_documents: Array[
        {
          bucket_name: String,
          key: String
        }
      ],
      ?client_token: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateCapabilityResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCapabilityResponse

