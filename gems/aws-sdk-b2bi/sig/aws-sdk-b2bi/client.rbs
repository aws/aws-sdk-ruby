    def create_partnership: (
      ?profile_id: String,
      ?name: String,
      ?email: String,
      ?phone: String,
      ?capabilities: Array[String],
      ?capability_options: {
        outbound_edi: {
          x12: {
            common: {
              interchange_control_headers: {
                sender_id_qualifier: String,
                sender_id: String,
                receiver_id_qualifier: untyped,
                receiver_id: String,
                repetition_separator: String,
                acknowledgment_requested_code: String,
                usage_indicator_code: String
              },
              functional_group_headers: {
                application_sender_code: String,
                application_receiver_code: String,
                responsible_agency_code: String
              },
              delimiters: {
                component_separator: String,
                data_element_separator: String,
                segment_terminator: String
              },
              validate_edi: bool,
              control_numbers: {
                starting_interchange_control_number: Integer,
                starting_functional_group_control_number: Integer,
                starting_transaction_set_control_number: Integer
              },
              gs05_time_format: String
            },
            wrap_options: {
              wrap_by: String,
              line_terminator: String,
              line_length: Integer
            }
          }
        },
        inbound_edi: {
          x12: {
            acknowledgment_options: {
              functional_acknowledgment: String,
              technical_acknowledgment: String
            }
          }
        }
      },
      ?client_token: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreatePartnershipResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreatePartnershipResponse

