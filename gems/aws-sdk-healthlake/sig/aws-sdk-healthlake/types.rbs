    class CreateFHIRDatastoreRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?datastore_name: String,
        ?datastore_type_version: String,
        ?sse_configuration: Types::SseConfiguration,
        ?preload_data_config: Types::PreloadDataConfig,
        ?client_token: String,
        ?tags: Array[Types::Tag],
        ?identity_provider_configuration: Types::IdentityProviderConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor datastore_name: String?
      attr_accessor datastore_type_version: String?
      attr_accessor sse_configuration: Types::SseConfiguration?
      attr_accessor preload_data_config: Types::PreloadDataConfig?
      attr_accessor client_token: String?
      attr_accessor tags: Array[Types::Tag]?
      attr_accessor identity_provider_configuration: Types::IdentityProviderConfiguration?
    end

