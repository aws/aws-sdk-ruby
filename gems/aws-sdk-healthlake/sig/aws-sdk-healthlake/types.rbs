      attr_accessor source: Types::CreateDataTransformationProfileSource?
      attr_accessor kms_key_id: String?
      attr_accessor profile_description: String?
      attr_accessor profile_name: String?
      attr_accessor tags: Hash[String, String]?
      attr_accessor client_token: String?
    end

    class CreateDataTransformationProfileResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?profile_id: String,
        ?version: Integer,
        ?source_format: String,
        ?target_format: String,
        ?profile_name: String,
        ?last_updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor profile_id: String?
      attr_accessor version: Integer?
      attr_accessor source_format: String?
      attr_accessor target_format: String?
      attr_accessor profile_name: String?
      attr_accessor last_updated_at: Time?
    end

    class CreateDataTransformationProfileSource
      include Smithy::Schema::Union

      def initialize: (
        ?starter_profile: Types::StarterProfileSource,
        ?existing_versioned_profile_id: Types::ExistingVersionedProfileSource,
        ?profile_mapping: Types::ProfileMappingSource,
        ?sample_data: Types::SampleDataSource,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor starter_profile: Types::StarterProfileSource?
      attr_accessor existing_versioned_profile_id: Types::ExistingVersionedProfileSource?
      attr_accessor profile_mapping: Types::ProfileMappingSource?
      attr_accessor sample_data: Types::SampleDataSource?

      class StarterProfile < CreateDataTransformationProfileSource
      end
      class ExistingVersionedProfileId < CreateDataTransformationProfileSource
      end
      class ProfileMapping < CreateDataTransformationProfileSource
      end
      class SampleData < CreateDataTransformationProfileSource
      end
      class Unknown < CreateDataTransformationProfileSource
      end
    end

