module Aws::HealthLake
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AgentInputMessage
      include Smithy::Schema::Structure

      def initialize: (
        ?body: String,
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor body: String?
      attr_accessor type: String?
    end

    module AgentInputMessageType
      NORMAL: String
      USER_CONFIRMATION_RESPONSE: String
    end

    class AgentMessageOutOfContextException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AgentOutputMessage
      include Smithy::Schema::Structure

      def initialize: (
        ?body: String,
        ?type: String,
        ?options_list: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor body: String?
      attr_accessor type: String?
      attr_accessor options_list: Array[String]?
    end

    module AgentOutputMessageType
      INITIAL_GREETING: String
      NORMAL: String
      USER_CONFIRMATION_REQUEST: String
      COMPLETE: String
      ERROR: String
      OPTIONS: String
      CHOICES: String
    end

