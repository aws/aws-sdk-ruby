module Aws::HealthLake
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AuthorizationStrategy
      SMARTV1: String
      SMART_ON_FHIR: String
      AWS_AUTH: String
    end

    module CmkType
      CM_CMK: String
      AO_CMK: String
    end

