module Aws::HealthLake
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::HealthLake::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateFHIRDatastoreResponse
      include Smithy::Client::_Response[Types::CreateFHIRDatastoreResponse]
      def datastore_id: () -> String?
      def datastore_arn: () -> String?
      def datastore_status: () -> String?
      def datastore_endpoint: () -> String?
    end
    def create_fhir_datastore: (
      ?datastore_name: String,
      ?datastore_type_version: String,
      ?sse_configuration: {
        kms_encryption_config: {
          cmk_type: String,
          kms_key_id: String
        }
      },
      ?preload_data_config: {
        preload_data_type: String
      },
      ?client_token: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?identity_provider_configuration: {
        authorization_strategy: String,
        fine_grained_authorization_enabled: bool,
        metadata: String,
        idp_lambda_arn: String
      }
    ) -> _CreateFHIRDatastoreResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateFHIRDatastoreResponse

    interface _DeleteFHIRDatastoreResponse
      include Smithy::Client::_Response[Types::DeleteFHIRDatastoreResponse]
      def datastore_id: () -> String?
      def datastore_arn: () -> String?
      def datastore_status: () -> String?
      def datastore_endpoint: () -> String?
    end
    def delete_fhir_datastore: (
      ?datastore_id: String
    ) -> _DeleteFHIRDatastoreResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteFHIRDatastoreResponse

    interface _DescribeFHIRDatastoreResponse
      include Smithy::Client::_Response[Types::DescribeFHIRDatastoreResponse]
      def datastore_properties: () -> Types::DatastoreProperties?
    end
    def describe_fhir_datastore: (
      ?datastore_id: String
    ) -> _DescribeFHIRDatastoreResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeFHIRDatastoreResponse

    interface _DescribeFHIRExportJobResponse
      include Smithy::Client::_Response[Types::DescribeFHIRExportJobResponse]
      def export_job_properties: () -> Types::ExportJobProperties?
    end
    def describe_fhir_export_job: (
      ?datastore_id: String,
      ?job_id: String
    ) -> _DescribeFHIRExportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeFHIRExportJobResponse

    interface _DescribeFHIRImportJobResponse
      include Smithy::Client::_Response[Types::DescribeFHIRImportJobResponse]
      def import_job_properties: () -> Types::ImportJobProperties?
    end
    def describe_fhir_import_job: (
      ?datastore_id: String,
      ?job_id: String
    ) -> _DescribeFHIRImportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeFHIRImportJobResponse

    interface _ListFHIRDatastoresResponse
      include Smithy::Client::_Response[Types::ListFHIRDatastoresResponse]
      def datastore_properties_list: () -> Array[Types::DatastoreProperties]?
      def next_token: () -> String?
    end
    def list_fhir_datastores: (
      ?filter: {
        datastore_name: String,
        datastore_status: String,
        created_before: Time,
        created_after: untyped
      },
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListFHIRDatastoresResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListFHIRDatastoresResponse

    interface _ListFHIRExportJobsResponse
      include Smithy::Client::_Response[Types::ListFHIRExportJobsResponse]
      def export_job_properties_list: () -> Array[Types::ExportJobProperties]?
      def next_token: () -> String?
    end
    def list_fhir_export_jobs: (
      ?datastore_id: String,
      ?next_token: String,
      ?max_results: Integer,
      ?job_name: String,
      ?job_status: String,
      ?submitted_before: Time,
      ?submitted_after: Time
    ) -> _ListFHIRExportJobsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListFHIRExportJobsResponse

    interface _ListFHIRImportJobsResponse
      include Smithy::Client::_Response[Types::ListFHIRImportJobsResponse]
      def import_job_properties_list: () -> Array[Types::ImportJobProperties]?
      def next_token: () -> String?
    end
    def list_fhir_import_jobs: (
      ?datastore_id: String,
      ?next_token: String,
      ?max_results: Integer,
      ?job_name: String,
      ?job_status: String,
      ?submitted_before: Time,
      ?submitted_after: Time
    ) -> _ListFHIRImportJobsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListFHIRImportJobsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def tags: () -> Array[Types::Tag]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _StartFHIRExportJobResponse
      include Smithy::Client::_Response[Types::StartFHIRExportJobResponse]
      def job_id: () -> String?
      def job_status: () -> String?
      def datastore_id: () -> String?
    end
    def start_fhir_export_job: (
      ?job_name: String,
      ?output_data_config: {
        s3_configuration: {
          s3_uri: String,
          kms_key_id: String
        }
      },
      ?datastore_id: String,
      ?data_access_role_arn: String,
      ?client_token: String
    ) -> _StartFHIRExportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartFHIRExportJobResponse

    interface _StartFHIRImportJobResponse
      include Smithy::Client::_Response[Types::StartFHIRImportJobResponse]
      def job_id: () -> String?
      def job_status: () -> String?
      def datastore_id: () -> String?
    end
    def start_fhir_import_job: (
      ?job_name: String,
      ?input_data_config: {
        s3_uri: String
      },
      ?job_output_data_config: {
        s3_configuration: {
          s3_uri: String,
          kms_key_id: String
        }
      },
      ?datastore_id: String,
      ?data_access_role_arn: String,
      ?client_token: String,
      ?validation_level: String
    ) -> _StartFHIRImportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartFHIRImportJobResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
