        existing_versioned_profile_id: {
          profile_id: untyped,
          version: Integer
        },
        profile_mapping: {
          profile_mapping: Hash[String, String]
        },
        sample_data: {
          s3_uri: String
        }
      },
      ?kms_key_id: String,
      ?profile_description: String,
      ?profile_name: String,
      ?tags: Hash[String, String],
