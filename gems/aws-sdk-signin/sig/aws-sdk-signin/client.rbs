module Aws::Signin
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Signin::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateOAuth2TokenResponse
      include Smithy::Client::_Response[Types::CreateOAuth2TokenResponse]
      def token_output: () -> Types::CreateOAuth2TokenResponseBody?
    end
    def create_o_auth2_token: (
      ?token_input: {
        client_id: String,
        grant_type: String,
        code: String,
        redirect_uri: String,
        code_verifier: String,
        refresh_token: String
      }
    ) -> _CreateOAuth2TokenResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateOAuth2TokenResponse

    interface _CreateOAuth2TokenWithIAMResponse
      include Smithy::Client::_Response[Types::CreateOAuth2TokenWithIAMResponse]
      def access_token: () -> String?
      def token_type: () -> String?
      def expires_in: () -> Integer?
    end
    def create_o_auth2_token_with_iam: (
      ?grant_type: String,
      ?resource: String
    ) -> _CreateOAuth2TokenWithIAMResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateOAuth2TokenWithIAMResponse

    interface _DeleteConsoleAuthorizationConfigurationResponse
      include Smithy::Client::_Response[Types::DeleteConsoleAuthorizationConfigurationOutput]
      def target_id: () -> String?
      def scope: () -> String?
      def console_authorization_enabled: () -> bool?
    end
    def delete_console_authorization_configuration: (
      ?target_id: String
    ) -> _DeleteConsoleAuthorizationConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteConsoleAuthorizationConfigurationResponse

    interface _DeleteResourcePermissionStatementResponse
      include Smithy::Client::_Response[Types::DeleteResourcePermissionStatementOutput]
    end
    def delete_resource_permission_statement: (
      ?statement_id: String,
      ?client_token: String
    ) -> _DeleteResourcePermissionStatementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteResourcePermissionStatementResponse

    interface _GetConsoleAuthorizationConfigurationResponse
      include Smithy::Client::_Response[Types::GetConsoleAuthorizationConfigurationOutput]
      def target_id: () -> String?
      def scope: () -> String?
      def console_authorization_enabled: () -> bool?
    end
    def get_console_authorization_configuration: (
      ?target_id: String
    ) -> _GetConsoleAuthorizationConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetConsoleAuthorizationConfigurationResponse

    interface _GetResourcePolicyResponse
      include Smithy::Client::_Response[Types::GetResourcePolicyOutput]
      def signin_resource_based_policy: () -> Types::SigninResourceBasedPolicy?
    end
    def get_resource_policy: (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetResourcePolicyResponse

    interface _IntrospectOAuth2TokenWithIAMResponse
      include Smithy::Client::_Response[Types::IntrospectOAuth2TokenWithIAMResponse]
      def active: () -> bool?
      def client_id: () -> String?
      def user_id: () -> String?
      def token_type: () -> String?
      def exp: () -> Integer?
      def iat: () -> Integer?
      def nbf: () -> Integer?
      def sub: () -> String?
      def aud: () -> String?
      def iss: () -> String?
      def jti: () -> String?
      def account_id: () -> String?
      def signin_session: () -> String?
      def resource: () -> String?
    end
    def introspect_o_auth2_token_with_iam: (
      ?token: String,
      ?token_type_hint: String
    ) -> _IntrospectOAuth2TokenWithIAMResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _IntrospectOAuth2TokenWithIAMResponse

    interface _ListResourcePermissionStatementsResponse
      include Smithy::Client::_Response[Types::ListResourcePermissionStatementsOutput]
      def permission_statements: () -> Array[Types::PermissionStatementSummary]?
      def next_token: () -> String?
    end
    def list_resource_permission_statements: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListResourcePermissionStatementsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListResourcePermissionStatementsResponse

    interface _PutConsoleAuthorizationConfigurationResponse
      include Smithy::Client::_Response[Types::PutConsoleAuthorizationConfigurationOutput]
      def target_id: () -> String?
      def scope: () -> String?
      def console_authorization_enabled: () -> bool?
    end
    def put_console_authorization_configuration: (
      ?target_id: String
    ) -> _PutConsoleAuthorizationConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutConsoleAuthorizationConfigurationResponse

    interface _PutResourcePermissionStatementResponse
      include Smithy::Client::_Response[Types::PutResourcePermissionStatementOutput]
      def statement_id: () -> String?
    end
    def put_resource_permission_statement: (
      ?source_vpc: String,
      ?signin_source_vpce: String,
      ?console_source_vpce: String,
      ?vpc_source_ip: String,
      ?source_ip: String,
      ?requested_region: String,
      ?excluded_principal: String,
      ?client_token: String
    ) -> _PutResourcePermissionStatementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutResourcePermissionStatementResponse

    interface _RevokeOAuth2TokenWithIAMResponse
      include Smithy::Client::_Response[Types::RevokeOAuth2TokenWithIAMResponse]
    end
    def revoke_o_auth2_token_with_iam: (
      ?token: String
    ) -> _RevokeOAuth2TokenWithIAMResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RevokeOAuth2TokenWithIAMResponse
  end
end
