    module OAuth2ErrorCode
      TOKEN_EXPIRED: String
      USER_CREDENTIALS_CHANGED: String
      INSUFFICIENT_PERMISSIONS: String
      AUTHCODE_EXPIRED: String
      SERVER_ERROR: String
      INVALID_REQUEST: String
      RESOURCE_NOT_FOUND: String
      CONFLICT: String
      SERVICE_QUOTA_EXCEEDED: String
    end

    class PermissionStatementSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?sid: String,
        ?condition: Hash[String, Hash[String, Array[String]]],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor sid: String?
      attr_accessor condition: Hash[String, Hash[String, Array[String]]]?
    end

    class PolicyStatement
      include Smithy::Schema::Structure

      def initialize: (
        ?effect: String,
        ?principal: Hash[String, String],
        ?action: Array[String],
        ?resource: String,
        ?condition: Hash[String, Hash[String, Array[String]]],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor effect: String?
      attr_accessor principal: Hash[String, String]?
      attr_accessor action: Array[String]?
      attr_accessor resource: String?
      attr_accessor condition: Hash[String, Hash[String, Array[String]]]?
    end

