    interface _ListContainersResponse
      include Smithy::Client::_Response[Types::ListContainersOutput]
      def containers: () -> Array[Types::Container]?
      def next_token: () -> String?
    end
    def list_containers: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListContainersResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListContainersResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
