    ) -> _PutContainerPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutContainerPolicyResponse

    interface _PutCorsPolicyResponse
      include Smithy::Client::_Response[Types::PutCorsPolicyOutput]
    end
    def put_cors_policy: (
      ?container_name: String,
      ?cors_policy: Array[
        {
          allowed_origins: Array[String],
          allowed_methods: Array[String],
          allowed_headers: Array[String],
