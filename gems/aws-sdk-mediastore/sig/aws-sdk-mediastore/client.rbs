      include Smithy::Client::_Response[Types::DeleteLifecyclePolicyOutput]
    end
    def delete_lifecycle_policy: (
      ?container_name: String
    ) -> _DeleteLifecyclePolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteLifecyclePolicyResponse

    interface _DeleteMetricPolicyResponse
      include Smithy::Client::_Response[Types::DeleteMetricPolicyOutput]
    end
    def delete_metric_policy: (
      ?container_name: String
    ) -> _DeleteMetricPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteMetricPolicyResponse

    interface _DescribeContainerResponse
      include Smithy::Client::_Response[Types::DescribeContainerOutput]
      def container: () -> Types::Container?
    end
    def describe_container: (
      ?container_name: String
    ) -> _DescribeContainerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeContainerResponse

    interface _GetContainerPolicyResponse
      include Smithy::Client::_Response[Types::GetContainerPolicyOutput]
      def policy: () -> String?
    end
    def get_container_policy: (
      ?container_name: String
    ) -> _GetContainerPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetContainerPolicyResponse

    interface _GetCorsPolicyResponse
      include Smithy::Client::_Response[Types::GetCorsPolicyOutput]
      def cors_policy: () -> Array[Types::CorsRule]?
    end
    def get_cors_policy: (
      ?container_name: String
    ) -> _GetCorsPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetCorsPolicyResponse

    interface _GetLifecyclePolicyResponse
      include Smithy::Client::_Response[Types::GetLifecyclePolicyOutput]
