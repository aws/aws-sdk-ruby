module Aws::MediaStore
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::MediaStore::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateContainerResponse
      include Smithy::Client::_Response[Types::CreateContainerOutput]
      def container: () -> Types::Container?
    end
    def create_container: (
      ?container_name: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateContainerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateContainerResponse

    interface _DeleteContainerResponse
      include Smithy::Client::_Response[Types::DeleteContainerOutput]
    end
    def delete_container: (
      ?container_name: String
    ) -> _DeleteContainerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteContainerResponse

    interface _DeleteContainerPolicyResponse
      include Smithy::Client::_Response[Types::DeleteContainerPolicyOutput]
    end
    def delete_container_policy: (
      ?container_name: String
    ) -> _DeleteContainerPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteContainerPolicyResponse

    interface _DeleteCorsPolicyResponse
      include Smithy::Client::_Response[Types::DeleteCorsPolicyOutput]
    end
    def delete_cors_policy: (
      ?container_name: String
