    class UsageRecordResult
      include Smithy::Schema::Structure

      def initialize: (
        ?usage_record: Types::UsageRecord,
        ?metering_record_id: String,
        ?status: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor usage_record: Types::UsageRecord?
      attr_accessor metering_record_id: String?
      attr_accessor status: String?
    end

    module UsageRecordResultStatus
      SUCCESS: String
      CUSTOMER_NOT_SUBSCRIBED: String
      DUPLICATE_RECORD: String
