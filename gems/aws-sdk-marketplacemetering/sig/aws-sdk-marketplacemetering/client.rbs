module Aws::MarketplaceMetering
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::MarketplaceMetering::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchMeterUsageResponse
      include Smithy::Client::_Response[Types::BatchMeterUsageResult]
      def results: () -> Array[Types::UsageRecordResult]?
      def unprocessed_records: () -> Array[Types::UsageRecord]?
    end
    def batch_meter_usage: (
      ?usage_records: Array[
        {
          timestamp: Time,
          customer_identifier: String,
          dimension: String,
          quantity: Integer,
          usage_allocations: Array[
            {
              allocated_usage_quantity: Integer,
              tags: Array[
                {
                  key: String,
                  value: String
                }
              ]
            }
          ],
          customer_aws_account_id: String,
          license_arn: String
        }
      ],
      ?product_code: String
    ) -> _BatchMeterUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchMeterUsageResponse

    interface _MeterUsageResponse
      include Smithy::Client::_Response[Types::MeterUsageResult]
      def metering_record_id: () -> String?
    end
    def meter_usage: (
      ?product_code: String,
      ?timestamp: Time,
      ?usage_dimension: String,
      ?usage_quantity: Integer,
      ?dry_run: bool,
      ?usage_allocations: Array[
        {
          allocated_usage_quantity: Integer,
          tags: Array[
            {
              key: String,
              value: String
            }
          ]
        }
      ],
      ?client_token: String
    ) -> _MeterUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _MeterUsageResponse

    interface _RegisterUsageResponse
      include Smithy::Client::_Response[Types::RegisterUsageResult]
      def public_key_rotation_timestamp: () -> Time?
      def signature: () -> String?
    end
    def register_usage: (
      ?product_code: String,
      ?public_key_version: Integer,
      ?nonce: String
    ) -> _RegisterUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RegisterUsageResponse

    interface _ResolveCustomerResponse
      include Smithy::Client::_Response[Types::ResolveCustomerResult]
      def customer_identifier: () -> String?
      def product_code: () -> String?
      def customer_aws_account_id: () -> String?
      def license_arn: () -> String?
      def metadata: () -> Types::Metadata?
    end
    def resolve_customer: (
      ?registration_token: String
    ) -> _ResolveCustomerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ResolveCustomerResponse
  end
end
