      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccessGrant
      include Smithy::Schema::Structure

      def initialize: (
        ?grant_id: String,
        ?grant_arn: String,
        ?name: String,
        ?account_id: String,
        ?domain_id: String,
        ?principal: Types::AccessGrantPrincipal,
        ?permission: String,
        ?grant_type: String,
        ?created_by: String,
        ?created_at: Time,
        ?updated_at: Time,
        ?space_id: String,
        ?scoped_actions: Array[Types::ScopedActions],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor grant_id: String?
      attr_accessor grant_arn: String?
      attr_accessor name: String?
      attr_accessor account_id: String?
      attr_accessor domain_id: String?
      attr_accessor principal: Types::AccessGrantPrincipal?
      attr_accessor permission: String?
      attr_accessor grant_type: String?
      attr_accessor created_by: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
      attr_accessor space_id: String?
      attr_accessor scoped_actions: Array[Types::ScopedActions]?
    end

