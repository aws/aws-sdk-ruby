module Aws::LambdaMicrovms
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
    end
    class InsufficientCapacityException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
      def retry_after_seconds: () -> Integer?
      def retryable?: () -> true
    end
    class InvalidParameterValueException < Smithy::Client::ServiceError
      def type: () -> String?
      def message: () -> String?
    end
    class ResourceConflictException < Smithy::Client::ServiceError
      def type: () -> String?
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_type: () -> String?
      def resource_id: () -> String?
    end
    class ServiceException < Smithy::Client::ServiceError
      def type: () -> String?
      def message: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
      def service_code: () -> String?
      def quota_code: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
      def service_code: () -> String?
      def quota_code: () -> String?
      def retry_after_seconds: () -> Integer?
      def retryable?: () -> true
      def throttling?: () -> true
    end
    class TooManyRequestsException < Smithy::Client::ServiceError
      def type: () -> String?
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
