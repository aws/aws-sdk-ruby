    class SourceConfiguration
      include Smithy::Schema::Union

      def initialize: (
        ?database_clone: Types::DatabaseCloneConfiguration,
        ?restore_from_backup: Types::RestoreFromBackupConfiguration,
        ?point_in_time_restore: Types::PointInTimeRestoreConfiguration,
        ?cross_region_data_guard: Types::CrossRegionDataGuardConfiguration,
        ?cross_region_disaster_recovery: Types::CrossRegionDisasterRecoveryConfiguration,
        ?clone_to_refreshable: Types::CloneToRefreshableConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor database_clone: Types::DatabaseCloneConfiguration?
      attr_accessor restore_from_backup: Types::RestoreFromBackupConfiguration?
      attr_accessor point_in_time_restore: Types::PointInTimeRestoreConfiguration?
      attr_accessor cross_region_data_guard: Types::CrossRegionDataGuardConfiguration?
      attr_accessor cross_region_disaster_recovery: Types::CrossRegionDisasterRecoveryConfiguration?
      attr_accessor clone_to_refreshable: Types::CloneToRefreshableConfiguration?

      class DatabaseClone < SourceConfiguration
      end
      class RestoreFromBackup < SourceConfiguration
      end
      class PointInTimeRestore < SourceConfiguration
      end
      class CrossRegionDataGuard < SourceConfiguration
      end
      class CrossRegionDisasterRecovery < SourceConfiguration
      end
      class CloneToRefreshable < SourceConfiguration
      end
      class Unknown < SourceConfiguration
      end
    end

