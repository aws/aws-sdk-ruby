module Aws::SageMakerFeatureStoreRuntime
  module Types

    class AccessForbidden
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class BatchGetRecordError
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record_identifier_value_as_string: String,
        ?error_code: String,
        ?error_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record_identifier_value_as_string: String?
      attr_accessor error_code: String?
      attr_accessor error_message: String?
    end

    class BatchGetRecordIdentifier
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record_identifiers_value_as_string: Array[String],
        ?feature_names: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record_identifiers_value_as_string: Array[String]?
      attr_accessor feature_names: Array[String]?
    end

    class BatchGetRecordRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?identifiers: Array[Types::BatchGetRecordIdentifier],
        ?expiration_time_response: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor identifiers: Array[Types::BatchGetRecordIdentifier]?
      attr_accessor expiration_time_response: String?
    end

    class BatchGetRecordResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?records: Array[Types::BatchGetRecordResultDetail],
        ?errors: Array[Types::BatchGetRecordError],
        ?unprocessed_identifiers: Array[Types::BatchGetRecordIdentifier],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor records: Array[Types::BatchGetRecordResultDetail]?
      attr_accessor errors: Array[Types::BatchGetRecordError]?
      attr_accessor unprocessed_identifiers: Array[Types::BatchGetRecordIdentifier]?
    end

    class BatchGetRecordResultDetail
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record_identifier_value_as_string: String,
        ?record: Array[Types::FeatureValue],
        ?expires_at: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record_identifier_value_as_string: String?
      attr_accessor record: Array[Types::FeatureValue]?
      attr_accessor expires_at: String?
    end

    class DeleteRecordRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record_identifier_value_as_string: String,
        ?event_time: String,
        ?target_stores: Array[String],
        ?deletion_mode: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record_identifier_value_as_string: String?
      attr_accessor event_time: String?
      attr_accessor target_stores: Array[String]?
      attr_accessor deletion_mode: String?
    end

    module DeletionMode
      SOFT_DELETE: String
      HARD_DELETE: String
    end

    module ExpirationTimeResponse
      ENABLED: String
      DISABLED: String
    end

    class FeatureValue
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_name: String,
        ?value_as_string: String,
        ?value_as_string_list: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_name: String?
      attr_accessor value_as_string: String?
      attr_accessor value_as_string_list: Array[String]?
    end

    class GetRecordRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record_identifier_value_as_string: String,
        ?feature_names: Array[String],
        ?expiration_time_response: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record_identifier_value_as_string: String?
      attr_accessor feature_names: Array[String]?
      attr_accessor expiration_time_response: String?
    end

    class GetRecordResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?record: Array[Types::FeatureValue],
        ?expires_at: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor record: Array[Types::FeatureValue]?
      attr_accessor expires_at: String?
    end

    class InternalFailure
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class PutRecordRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?feature_group_name: String,
        ?record: Array[Types::FeatureValue],
        ?target_stores: Array[String],
        ?ttl_duration: Types::TtlDuration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor feature_group_name: String?
      attr_accessor record: Array[Types::FeatureValue]?
      attr_accessor target_stores: Array[String]?
      attr_accessor ttl_duration: Types::TtlDuration?
    end

    class ResourceNotFound
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ServiceUnavailable
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module TargetStore
      ONLINE_STORE: String
      OFFLINE_STORE: String
    end

    class TtlDuration
      include Smithy::Schema::Structure

      def initialize: (
        ?unit: String,
        ?value: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor unit: String?
      attr_accessor value: Integer?
    end

    module TtlDurationUnit
      SECONDS: String
      MINUTES: String
      HOURS: String
      DAYS: String
      WEEKS: String
    end

    class ValidationError
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end
  end
end
