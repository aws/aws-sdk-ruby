module Aws::SageMakerFeatureStoreRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SageMakerFeatureStoreRuntime::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchGetRecordResponse
      include Smithy::Client::_Response[Types::BatchGetRecordResponse]
      def records: () -> Array[Types::BatchGetRecordResultDetail]?
      def errors: () -> Array[Types::BatchGetRecordError]?
      def unprocessed_identifiers: () -> Array[Types::BatchGetRecordIdentifier]?
    end
    def batch_get_record: (
      ?identifiers: Array[
        {
          feature_group_name: String,
          record_identifiers_value_as_string: Array[String],
          feature_names: Array[String]
        }
      ],
      ?expiration_time_response: String
    ) -> _BatchGetRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchGetRecordResponse

    interface _BatchWriteRecordResponse
      include Smithy::Client::_Response[Types::BatchWriteRecordResponse]
      def errors: () -> Array[Types::BatchWriteRecordError]?
      def unprocessed_entries: () -> Array[Types::BatchWriteRecordEntry]?
    end
    def batch_write_record: (
      ?entries: Array[
        {
          feature_group_name: String,
          record: Array[
            {
              feature_name: String,
              value_as_string: String,
              value_as_string_list: Array[String]
            }
          ],
          target_stores: Array[String],
          ttl_duration: {
            unit: String,
            value: Integer
          }
        }
      ],
      ?ttl_duration: {
        unit: String,
        value: Integer
      }
    ) -> _BatchWriteRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchWriteRecordResponse

    interface _DeleteRecordResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_record: (
      ?feature_group_name: String,
      ?record_identifier_value_as_string: String,
      ?event_time: String,
      ?target_stores: Array[String],
      ?deletion_mode: String
    ) -> _DeleteRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteRecordResponse

    interface _GetRecordResponse
      include Smithy::Client::_Response[Types::GetRecordResponse]
      def record: () -> Array[Types::FeatureValue]?
      def expires_at: () -> String?
    end
    def get_record: (
      ?feature_group_name: String,
      ?record_identifier_value_as_string: String,
      ?feature_names: Array[String],
      ?expiration_time_response: String
    ) -> _GetRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetRecordResponse

    interface _ListRecordsResponse
      include Smithy::Client::_Response[Types::ListRecordsResponse]
      def record_identifiers: () -> Array[String]?
      def next_token: () -> String?
    end
    def list_records: (
      ?feature_group_name: String,
      ?max_results: Integer,
      ?next_token: String,
      ?include_soft_deleted_records: bool
    ) -> _ListRecordsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListRecordsResponse

    interface _PutRecordResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def put_record: (
      ?feature_group_name: String,
      ?record: Array[
        {
          feature_name: String,
          value_as_string: String,
          value_as_string_list: Array[String]
        }
      ],
      ?target_stores: Array[String],
      ?ttl_duration: {
        unit: String,
        value: Integer
      }
    ) -> _PutRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutRecordResponse

    interface _UpdateRecordResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def update_record: (
      ?feature_group_name: String,
      ?record_identifier_value_as_string: String,
      ?features: Array[
        {
          feature_name: String,
          value_as_string: String,
          value_as_string_list: Array[String]
        }
      ],
      ?target_stores: Array[String],
      ?ttl_duration: {
        unit: String,
        value: Integer
      }
    ) -> _UpdateRecordResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateRecordResponse
  end
end
