      include Smithy::Schema::Structure

      def initialize: (
        ?client_id: String,
        ?clean_session: bool,
        ?prevent_will_message: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor client_id: String?
      attr_accessor clean_session: bool?
      attr_accessor prevent_will_message: bool?
    end

