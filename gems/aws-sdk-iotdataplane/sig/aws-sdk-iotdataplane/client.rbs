module Aws::IoTDataPlane
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::IoTDataPlane::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DeleteConnectionResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_connection: (
      ?client_id: String,
      ?clean_session: bool,
      ?prevent_will_message: bool
    ) -> _DeleteConnectionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteConnectionResponse

    interface _DeleteThingShadowResponse
      include Smithy::Client::_Response[Types::DeleteThingShadowResponse]
      def payload: () -> String?
    end
    def delete_thing_shadow: (
      ?thing_name: String,
      ?shadow_name: String
    ) -> _DeleteThingShadowResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteThingShadowResponse

    interface _GetConnectionResponse
      include Smithy::Client::_Response[Types::GetConnectionResponse]
      def connected: () -> bool?
      def thing_name: () -> String?
      def clean_session: () -> bool?
      def source_ip: () -> String?
      def source_port: () -> Integer?
      def target_ip: () -> String?
      def target_port: () -> Integer?
      def keep_alive_duration: () -> Integer?
      def connected_since: () -> Integer?
      def disconnected_since: () -> Integer?
      def disconnect_reason: () -> String?
      def session_expiry: () -> Integer?
      def client_id: () -> String?
      def vpc_endpoint_id: () -> String?
    end
    def get_connection: (
      ?client_id: String,
      ?include_socket_information: bool
    ) -> _GetConnectionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetConnectionResponse

    interface _GetRetainedMessageResponse
      include Smithy::Client::_Response[Types::GetRetainedMessageResponse]
      def topic: () -> String?
      def payload: () -> String?
      def qos: () -> Integer?
      def last_modified_time: () -> Integer?
      def user_properties: () -> String?
    end
    def get_retained_message: (
      ?topic: String
    ) -> _GetRetainedMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetRetainedMessageResponse

    interface _GetThingShadowResponse
      include Smithy::Client::_Response[Types::GetThingShadowResponse]
      def payload: () -> String?
    end
    def get_thing_shadow: (
      ?thing_name: String,
      ?shadow_name: String
    ) -> _GetThingShadowResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetThingShadowResponse

    interface _ListNamedShadowsForThingResponse
      include Smithy::Client::_Response[Types::ListNamedShadowsForThingResponse]
      def results: () -> Array[String]?
      def next_token: () -> String?
      def timestamp: () -> Integer?
    end
    def list_named_shadows_for_thing: (
      ?thing_name: String,
      ?next_token: String,
      ?page_size: Integer
    ) -> _ListNamedShadowsForThingResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListNamedShadowsForThingResponse

    interface _ListRetainedMessagesResponse
      include Smithy::Client::_Response[Types::ListRetainedMessagesResponse]
      def retained_topics: () -> Array[Types::RetainedMessageSummary]?
      def next_token: () -> String?
    end
    def list_retained_messages: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListRetainedMessagesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListRetainedMessagesResponse

    interface _ListSubscriptionsResponse
      include Smithy::Client::_Response[Types::ListSubscriptionsResponse]
      def subscriptions: () -> Array[Types::SubscriptionSummary]?
      def next_token: () -> String?
    end
    def list_subscriptions: (
      ?client_id: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListSubscriptionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSubscriptionsResponse

    interface _PublishResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def publish: (
      ?topic: String,
      ?qos: Integer,
      ?retain: bool,
      ?payload: String,
      ?user_properties: String,
      ?payload_format_indicator: String,
      ?content_type: String,
      ?response_topic: String,
      ?correlation_data: String,
      ?message_expiry: Integer
    ) -> _PublishResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PublishResponse

    interface _SendDirectMessageResponse
      include Smithy::Client::_Response[Types::SendDirectMessageResponse]
      def message: () -> String?
      def trace_id: () -> String?
    end
    def send_direct_message: (
      ?client_id: String,
      ?topic: String,
      ?content_type: String,
      ?response_topic: String,
      ?confirmation: bool,
      ?timeout: Integer,
      ?payload: String,
      ?user_properties: String,
      ?payload_format_indicator: String,
      ?correlation_data: String
    ) -> _SendDirectMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendDirectMessageResponse

    interface _UpdateThingShadowResponse
      include Smithy::Client::_Response[Types::UpdateThingShadowResponse]
      def payload: () -> String?
    end
    def update_thing_shadow: (
      ?thing_name: String,
      ?shadow_name: String,
      ?payload: String
    ) -> _UpdateThingShadowResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateThingShadowResponse
  end
end
