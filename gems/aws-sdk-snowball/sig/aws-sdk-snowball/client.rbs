    interface _CreateClusterResponse
      include Smithy::Client::_Response[Types::CreateClusterResult]
      def cluster_id: () -> String?
      def job_list_entries: () -> Array[Types::JobListEntry]?
    end
    def create_cluster: (
      ?job_type: String,
      ?resources: {
        s3_resources: Array[
          {
            bucket_arn: String,
            key_range: {
              begin_marker: String,
              end_marker: untyped
            },
            target_on_device_services: Array[
              {
                service_name: String,
                transfer_option: String
              }
            ]
          }
        ],
        lambda_resources: Array[
          {
            lambda_arn: untyped,
            event_triggers: Array[
              {
                event_resource_arn: untyped
              }
            ]
          }
        ],
        ec2_ami_resources: Array[
          {
            ami_id: String,
            snowball_ami_id: untyped
          }
        ]
      },
      ?on_device_service_configuration: {
        nfs_on_device_service: {
          storage_limit: Integer,
          storage_unit: String
        },
        tgw_on_device_service: {
          storage_limit: untyped,
          storage_unit: untyped
        },
        eks_on_device_service: {
          kubernetes_version: String,
          eks_anywhere_version: untyped
        },
        s3_on_device_service: {
          storage_limit: Float,
          storage_unit: untyped,
          service_size: Integer,
          fault_tolerance: Integer
        }
      },
      ?description: String,
      ?address_id: String,
      ?kms_key_arn: String,
      ?role_arn: String,
      ?snowball_type: String,
      ?shipping_option: String,
      ?notification: {
        sns_topic_arn: String,
        job_states_to_notify: Array[String],
        notify_all: bool,
        device_pickup_sns_topic_arn: untyped
      },
      ?forwarding_address_id: String,
      ?tax_documents: {
        ind: {
          gstin: String
        }
      },
      ?remote_management: String,
      ?initial_cluster_size: Integer,
      ?force_create_jobs: bool,
      ?long_term_pricing_ids: Array[String],
      ?snowball_capacity_preference: String
    ) -> _CreateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateClusterResponse

