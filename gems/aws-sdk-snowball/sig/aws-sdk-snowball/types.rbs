module Aws::Snowball
  module Types

    class Address
      include Smithy::Schema::Structure

      def initialize: (
        ?address_id: String,
        ?name: String,
        ?company: String,
        ?street1: String,
        ?street2: String,
        ?street3: String,
        ?city: String,
        ?state_or_province: String,
        ?prefecture_or_district: String,
        ?landmark: String,
        ?country: String,
        ?postal_code: String,
        ?phone_number: String,
        ?is_restricted: bool,
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor address_id: String?
      attr_accessor name: String?
      attr_accessor company: String?
      attr_accessor street1: String?
      attr_accessor street2: String?
      attr_accessor street3: String?
      attr_accessor city: String?
      attr_accessor state_or_province: String?
      attr_accessor prefecture_or_district: String?
      attr_accessor landmark: String?
      attr_accessor country: String?
      attr_accessor postal_code: String?
      attr_accessor phone_number: String?
      attr_accessor is_restricted: bool?
      attr_accessor type: String?
    end

    module AddressType
      CUST_PICKUP: String
      AWS_SHIP: String
    end

