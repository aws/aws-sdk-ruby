    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Amplify::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateAppResponse
      include Smithy::Client::_Response[Types::CreateAppResult]
      def app: () -> Types::App?
    end
    def create_app: (
      ?name: String,
      ?description: String,
      ?repository: String,
      ?platform: String,
      ?compute_role_arn: String,
      ?iam_service_role_arn: String,
      ?oauth_token: String,
      ?access_token: String,
      ?environment_variables: Hash[String, String],
      ?enable_branch_auto_build: bool,
      ?enable_branch_auto_deletion: bool,
      ?enable_basic_auth: bool,
      ?basic_auth_credentials: String,
      ?custom_rules: Array[
        {
          source: String,
          target: String,
          status: String,
          condition: String
        }
      ],
      ?tags: Hash[String, String],
      ?build_spec: String,
      ?custom_headers: String,
      ?enable_auto_branch_creation: bool,
      ?auto_branch_creation_patterns: Array[String],
      ?auto_branch_creation_config: {
        stage: String,
        framework: String,
        enable_auto_build: bool,
        environment_variables: Hash[String, String],
        basic_auth_credentials: String,
        enable_basic_auth: bool,
        enable_performance_mode: bool,
        build_spec: String,
        enable_pull_request_preview: bool,
        pull_request_environment_name: String
      },
      ?job_config: {
        build_compute_type: String
      },
      ?cache_config: {
        type: String
      }
    ) -> _CreateAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateAppResponse

