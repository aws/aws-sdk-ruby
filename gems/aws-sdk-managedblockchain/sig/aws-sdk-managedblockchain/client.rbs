    interface _UpdateMemberResponse
      include Smithy::Client::_Response[Types::UpdateMemberOutput]
    end
    def update_member: (
      ?network_id: String,
      ?member_id: String,
      ?log_publishing_configuration: {
        fabric: {
          ca_logs: {
            cloudwatch: {
              enabled: bool
            }
