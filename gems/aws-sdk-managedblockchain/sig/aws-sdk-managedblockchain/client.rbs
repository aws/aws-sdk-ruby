module Aws::ManagedBlockchain
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::ManagedBlockchain::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateAccessorResponse
      include Smithy::Client::_Response[Types::CreateAccessorOutput]
      def accessor_id: () -> String?
      def billing_token: () -> String?
      def network_type: () -> String?
    end
    def create_accessor: (
      ?client_request_token: String,
      ?accessor_type: String,
      ?tags: Hash[String, String],
      ?network_type: String
    ) -> _CreateAccessorResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateAccessorResponse

    interface _CreateMemberResponse
      include Smithy::Client::_Response[Types::CreateMemberOutput]
      def member_id: () -> String?
    end
    def create_member: (
      ?client_request_token: String,
      ?invitation_id: String,
      ?network_id: String,
      ?member_configuration: {
        name: String,
        description: String,
        framework_configuration: {
          fabric: {
            admin_username: String,
            admin_password: String
          }
        },
        log_publishing_configuration: {
          fabric: {
            ca_logs: {
              cloudwatch: {
                enabled: bool
              }
            }
          }
        },
        tags: Hash[String, String],
        kms_key_arn: String
      }
    ) -> _CreateMemberResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateMemberResponse

    interface _CreateNetworkResponse
      include Smithy::Client::_Response[Types::CreateNetworkOutput]
      def network_id: () -> String?
      def member_id: () -> String?
    end
    def create_network: (
      ?client_request_token: String,
      ?name: String,
      ?description: String,
      ?framework: String,
      ?framework_version: String,
      ?framework_configuration: {
        fabric: {
          edition: String
        }
      },
      ?voting_policy: {
        approval_threshold_policy: {
          threshold_percentage: Integer,
          proposal_duration_in_hours: Integer,
          threshold_comparator: String
        }
      },
      ?member_configuration: {
        name: String,
        description: String,
        framework_configuration: {
          fabric: {
            admin_username: String,
            admin_password: String
          }
        },
        log_publishing_configuration: {
          fabric: {
            ca_logs: {
              cloudwatch: {
                enabled: bool
              }
            }
          }
        },
        tags: Hash[String, String],
        kms_key_arn: String
      },
      ?tags: Hash[String, String]
    ) -> _CreateNetworkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateNetworkResponse

    interface _CreateNodeResponse
      include Smithy::Client::_Response[Types::CreateNodeOutput]
      def node_id: () -> String?
    end
    def create_node: (
      ?client_request_token: String,
      ?network_id: String,
      ?member_id: String,
      ?node_configuration: {
        instance_type: String,
        availability_zone: String,
        log_publishing_configuration: {
          fabric: {
            chaincode_logs: {
              cloudwatch: {
                enabled: bool
              }
            },
            peer_logs: untyped
          }
        },
        state_db: String
      },
      ?tags: Hash[String, String]
    ) -> _CreateNodeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateNodeResponse

    interface _CreateProposalResponse
      include Smithy::Client::_Response[Types::CreateProposalOutput]
      def proposal_id: () -> String?
    end
    def create_proposal: (
      ?client_request_token: String,
      ?network_id: String,
      ?member_id: String,
      ?actions: {
        invitations: Array[
          {
            principal: String
          }
        ],
        removals: Array[
          {
            member_id: String
          }
        ]
      },
      ?description: String,
      ?tags: Hash[String, String]
    ) -> _CreateProposalResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateProposalResponse

    interface _DeleteAccessorResponse
      include Smithy::Client::_Response[Types::DeleteAccessorOutput]
    end
