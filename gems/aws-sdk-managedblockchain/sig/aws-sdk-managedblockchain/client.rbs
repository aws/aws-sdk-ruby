    ) -> _GetProposalResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetProposalResponse

    interface _ListAccessorsResponse
      include Smithy::Client::_Response[Types::ListAccessorsOutput]
      def accessors: () -> Array[Types::AccessorSummary]?
