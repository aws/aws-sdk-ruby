    class ChatInputStream
      include Smithy::Schema::Union

      def initialize: (
        ?configuration_event: Types::ConfigurationEvent,
        ?text_event: Types::TextInputEvent,
        ?attachment_event: Types::AttachmentInputEvent,
        ?action_execution_event: Types::ActionExecutionEvent,
        ?end_of_input_event: Types::EndOfInputEvent,
        ?auth_challenge_response_event: Types::AuthChallengeResponseEvent,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor configuration_event: Types::ConfigurationEvent?
      attr_accessor text_event: Types::TextInputEvent?
      attr_accessor attachment_event: Types::AttachmentInputEvent?
      attr_accessor action_execution_event: Types::ActionExecutionEvent?
      attr_accessor end_of_input_event: Types::EndOfInputEvent?
      attr_accessor auth_challenge_response_event: Types::AuthChallengeResponseEvent?

      class ConfigurationEvent < ChatInputStream
      end
      class TextEvent < ChatInputStream
      end
      class AttachmentEvent < ChatInputStream
      end
      class ActionExecutionEvent < ChatInputStream
      end
      class EndOfInputEvent < ChatInputStream
      end
      class AuthChallengeResponseEvent < ChatInputStream
      end
      class Unknown < ChatInputStream
      end
    end

