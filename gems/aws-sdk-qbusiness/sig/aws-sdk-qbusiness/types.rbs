module Aws::QBusiness
  module Types

    class APISchema
      include Smithy::Schema::Union

      def initialize: (
        ?payload: String,
        ?s3: Types::S3,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor payload: String?
      attr_accessor s3: Types::S3?

      class Payload < APISchema
      end
      class S3 < APISchema
      end
      class Unknown < APISchema
      end
    end

    module APISchemaType
      OPEN_API_V3: String
    end

