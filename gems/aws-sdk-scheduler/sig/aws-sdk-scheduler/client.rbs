        },
        sqs_parameters: {
          message_group_id: String
        }
      },
      ?flexible_time_window: {
        mode: String,
        maximum_window_in_minutes: Integer
      },
      ?client_token: String,
      ?action_after_completion: String
    ) -> _CreateScheduleResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateScheduleResponse

