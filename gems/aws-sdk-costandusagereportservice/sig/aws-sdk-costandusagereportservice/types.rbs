module Aws::CostandUsageReportService
  module Types

    module AWSRegion
      CAPE_TOWN: String
      HONG_KONG: String
      MUMBAI: String
      HYDERABAD: String
      SINGAPORE: String
      SYDNEY: String
      JAKARTA: String
      TOKYO: String
      SEOUL: String
      OSAKA: String
      CANADA_CENTRAL: String
      FRANKFURT: String
      ZURICH: String
      IRELAND: String
      LONDON: String
      PARIS: String
      STOCKHOLM: String
      MILANO: String
      SPAIN: String
      UAE: String
      BAHRAIN: String
      SAO_PAULO: String
      US_STANDARD: String
      OHIO: String
      NORTHERN_CALIFORNIA: String
      OREGON: String
      BEIJING: String
      NINGXIA: String
    end

    module AdditionalArtifact
      REDSHIFT: String
      QUICKSIGHT: String
      ATHENA: String
    end

    module CompressionFormat
      ZIP: String
      GZIP: String
      Parquet: String
    end

    class DeleteReportDefinitionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?report_name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_name: String?
    end

    class DeleteReportDefinitionResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?response_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor response_message: String?
    end

    class DescribeReportDefinitionsRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?max_results: Integer,
        ?next_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor max_results: Integer?
      attr_accessor next_token: String?
    end

    class DescribeReportDefinitionsResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?report_definitions: Array[Types::ReportDefinition],
        ?next_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_definitions: Array[Types::ReportDefinition]?
      attr_accessor next_token: String?
    end

    class DuplicateReportNameException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InternalErrorException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module LastStatus
      SUCCESS: String
      ERROR_PERMISSIONS: String
      ERROR_NO_BUCKET: String
    end

    class ListTagsForResourceRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?report_name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_name: String?
    end

