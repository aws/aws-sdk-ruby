      include Smithy::Schema::Structure

      def initialize: (
        ?tags: Array[Types::Tag],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor tags: Array[Types::Tag]?
    end

    class ModifyReportDefinitionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?report_name: String,
        ?report_definition: Types::ReportDefinition,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_name: String?
      attr_accessor report_definition: Types::ReportDefinition?
    end

    class ModifyReportDefinitionResponse
      include Smithy::Schema::Structure

      def initialize: (
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

    end

    class PutReportDefinitionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?report_definition: Types::ReportDefinition,
        ?tags: Array[Types::Tag],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_definition: Types::ReportDefinition?
      attr_accessor tags: Array[Types::Tag]?
    end

    class PutReportDefinitionResponse
      include Smithy::Schema::Structure

      def initialize: (
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

    end

    class ReportDefinition
      include Smithy::Schema::Structure

      def initialize: (
        ?report_name: String,
        ?time_unit: String,
        ?format: String,
        ?compression: String,
        ?additional_schema_elements: Array[String],
        ?s3_bucket: String,
        ?s3_prefix: String,
        ?s3_region: String,
        ?additional_artifacts: Array[String],
        ?refresh_closed_reports: bool,
        ?report_versioning: String,
        ?billing_view_arn: String,
        ?report_status: Types::ReportStatus,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor report_name: String?
      attr_accessor time_unit: String?
      attr_accessor format: String?
      attr_accessor compression: String?
      attr_accessor additional_schema_elements: Array[String]?
      attr_accessor s3_bucket: String?
      attr_accessor s3_prefix: String?
      attr_accessor s3_region: String?
      attr_accessor additional_artifacts: Array[String]?
      attr_accessor refresh_closed_reports: bool?
      attr_accessor report_versioning: String?
      attr_accessor billing_view_arn: String?
      attr_accessor report_status: Types::ReportStatus?
    end

    module ReportFormat
      CSV: String
      Parquet: String
    end

