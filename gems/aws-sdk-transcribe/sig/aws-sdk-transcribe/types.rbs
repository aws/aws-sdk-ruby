module Aws::Transcribe
  module Types

    class AbsoluteTimeRange
      include Smithy::Schema::Structure

      def initialize: (
        ?start_time: Integer,
        ?end_time: Integer,
        ?first: Integer,
        ?last: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor start_time: Integer?
      attr_accessor end_time: Integer?
      attr_accessor first: Integer?
      attr_accessor last: Integer?
    end

    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module BaseModelName
      NARROW_BAND: String
      WIDE_BAND: String
    end

    module CLMLanguageCode
      EN_US: String
      HI_IN: String
      ES_US: String
      EN_GB: String
      EN_AU: String
      DE_DE: String
      JA_JP: String
    end

    module CallAnalyticsFeature
      GENERATIVE_SUMMARIZATION: String
    end

    class CallAnalyticsJob
      include Smithy::Schema::Structure

      def initialize: (
        ?call_analytics_job_name: String,
        ?call_analytics_job_status: String,
        ?call_analytics_job_details: Types::CallAnalyticsJobDetails,
        ?language_code: String,
        ?media_sample_rate_hertz: Integer,
        ?media_format: String,
        ?media: Types::Media,
        ?transcript: Types::Transcript,
        ?start_time: Time,
        ?creation_time: Time,
        ?completion_time: Time,
        ?failure_reason: String,
        ?data_access_role_arn: String,
        ?identified_language_score: Float,
        ?settings: Types::CallAnalyticsJobSettings,
        ?channel_definitions: Array[Types::ChannelDefinition],
        ?tags: Array[Types::Tag],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor call_analytics_job_name: String?
      attr_accessor call_analytics_job_status: String?
      attr_accessor call_analytics_job_details: Types::CallAnalyticsJobDetails?
      attr_accessor language_code: String?
      attr_accessor media_sample_rate_hertz: Integer?
      attr_accessor media_format: String?
      attr_accessor media: Types::Media?
      attr_accessor transcript: Types::Transcript?
      attr_accessor start_time: Time?
      attr_accessor creation_time: Time?
      attr_accessor completion_time: Time?
      attr_accessor failure_reason: String?
      attr_accessor data_access_role_arn: String?
      attr_accessor identified_language_score: Float?
      attr_accessor settings: Types::CallAnalyticsJobSettings?
      attr_accessor channel_definitions: Array[Types::ChannelDefinition]?
      attr_accessor tags: Array[Types::Tag]?
    end

    class CallAnalyticsJobDetails
      include Smithy::Schema::Structure

      def initialize: (
