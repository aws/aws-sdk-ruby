module Aws::AmplifyUIBuilder
  module Types

    class ActionParameters
      include Smithy::Schema::Structure

      def initialize: (
        ?type: Types::ComponentProperty,
        ?url: Types::ComponentProperty,
        ?anchor: Types::ComponentProperty,
        ?target: Types::ComponentProperty,
        ?global: Types::ComponentProperty,
        ?model: String,
        ?id: Types::ComponentProperty,
        ?fields: Hash[String, Types::ComponentProperty],
        ?state: Types::MutationActionSetStateParameter,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: Types::ComponentProperty?
      attr_accessor url: Types::ComponentProperty?
      attr_accessor anchor: Types::ComponentProperty?
      attr_accessor target: Types::ComponentProperty?
      attr_accessor global: Types::ComponentProperty?
      attr_accessor model: String?
      attr_accessor id: Types::ComponentProperty?
      attr_accessor fields: Hash[String, Types::ComponentProperty]?
      attr_accessor state: Types::MutationActionSetStateParameter?
    end

    class ApiConfiguration
      include Smithy::Schema::Union

      def initialize: (
        ?graph_ql_config: Types::GraphQLRenderConfig,
        ?data_store_config: Types::DataStoreRenderConfig,
        ?no_api_config: Types::NoApiRenderConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor graph_ql_config: Types::GraphQLRenderConfig?
      attr_accessor data_store_config: Types::DataStoreRenderConfig?
      attr_accessor no_api_config: Types::NoApiRenderConfig?

      class GraphQLConfig < ApiConfiguration
      end
      class DataStoreConfig < ApiConfiguration
      end
      class NoApiConfig < ApiConfiguration
      end
      class Unknown < ApiConfiguration
      end
    end

    class CodegenDependency
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?supported_version: String,
        ?is_sem_ver: bool,
        ?reason: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor supported_version: String?
      attr_accessor is_sem_ver: bool?
      attr_accessor reason: String?
    end

    class CodegenFeatureFlags
      include Smithy::Schema::Structure

      def initialize: (
        ?is_relationship_supported: bool,
        ?is_non_model_supported: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor is_relationship_supported: bool?
      attr_accessor is_non_model_supported: bool?
    end

    class CodegenGenericDataEnum
      include Smithy::Schema::Structure

      def initialize: (
        ?values: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor values: Array[String]?
    end

    class CodegenGenericDataField
      include Smithy::Schema::Structure

      def initialize: (
        ?data_type: String,
        ?data_type_value: String,
        ?required: bool,
        ?read_only: bool,
        ?is_array: bool,
        ?relationship: Types::CodegenGenericDataRelationshipType,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor data_type: String?
      attr_accessor data_type_value: String?
      attr_accessor required: bool?
      attr_accessor read_only: bool?
      attr_accessor is_array: bool?
      attr_accessor relationship: Types::CodegenGenericDataRelationshipType?
    end

    module CodegenGenericDataFieldDataType
      ID: String
      STRING: String
      INT: String
      FLOAT: String
      AWS_DATE: String
      AWS_TIME: String
      AWS_DATE_TIME: String
      AWS_TIMESTAMP: String
      AWS_EMAIL: String
      AWS_URL: String
      AWS_IP_ADDRESS: String
      BOOLEAN: String
      AWS_JSON: String
      AWS_PHONE: String
      ENUM: String
      MODEL: String
      NON_MODEL: String
    end

    class CodegenGenericDataModel
      include Smithy::Schema::Structure

      def initialize: (
        ?fields: Hash[String, Types::CodegenGenericDataField],
