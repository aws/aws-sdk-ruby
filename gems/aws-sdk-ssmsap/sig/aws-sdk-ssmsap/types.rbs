module Aws::SsmSap
  module Types

    module AllocationType
      VPC_SUBNET: String
      ELASTIC_IP: String
      OVERLAY: String
      UNKNOWN: String
    end

    class Application
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?type: String,
        ?arn: String,
        ?app_registry_arn: String,
        ?status: String,
        ?discovery_status: String,
        ?components: Array[String],
        ?last_updated: Time,
        ?status_message: String,
        ?associated_application_arns: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor type: String?
      attr_accessor arn: String?
      attr_accessor app_registry_arn: String?
      attr_accessor status: String?
      attr_accessor discovery_status: String?
      attr_accessor components: Array[String]?
      attr_accessor last_updated: Time?
      attr_accessor status_message: String?
      attr_accessor associated_application_arns: Array[String]?
    end

    class ApplicationCredential
      include Smithy::Schema::Structure

      def initialize: (
        ?database_name: String,
        ?credential_type: String,
        ?secret_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor database_name: String?
      attr_accessor credential_type: String?
      attr_accessor secret_id: String?
    end

    module ApplicationDiscoveryStatus
      SUCCESS: String
      REGISTRATION_FAILED: String
      REFRESH_FAILED: String
      REGISTERING: String
      DELETING: String
    end

    module ApplicationStatus
      ACTIVATED: String
      STARTING: String
      STOPPED: String
