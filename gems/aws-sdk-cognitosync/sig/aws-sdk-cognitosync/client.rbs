    interface _UpdateRecordsResponse
      include Smithy::Client::_Response[Types::UpdateRecordsResponse]
      def records: () -> Array[Types::Record]?
    end
    def update_records: (
      ?identity_pool_id: String,
      ?identity_id: String,
      ?dataset_name: String,
      ?device_id: String,
      ?record_patches: Array[
        {
          op: String,
          key: String,
          value: String,
          sync_count: Integer,
          device_last_modified_date: Time
        }
      ],
      ?sync_session_token: String,
      ?client_context: String
    ) -> _UpdateRecordsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateRecordsResponse
