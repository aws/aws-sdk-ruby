    interface _ListIdentityPoolUsageResponse
      include Smithy::Client::_Response[Types::ListIdentityPoolUsageResponse]
      def identity_pool_usages: () -> Array[Types::IdentityPoolUsage]?
      def max_results: () -> Integer?
      def count: () -> Integer?
      def next_token: () -> String?
    end
    def list_identity_pool_usage: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListIdentityPoolUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListIdentityPoolUsageResponse

    interface _ListRecordsResponse
      include Smithy::Client::_Response[Types::ListRecordsResponse]
      def records: () -> Array[Types::Record]?
      def next_token: () -> String?
      def count: () -> Integer?
      def dataset_sync_count: () -> Integer?
      def last_modified_by: () -> String?
