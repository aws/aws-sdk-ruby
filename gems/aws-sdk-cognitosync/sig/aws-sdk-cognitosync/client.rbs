    interface _SetIdentityPoolConfigurationResponse
      include Smithy::Client::_Response[Types::SetIdentityPoolConfigurationResponse]
      def identity_pool_id: () -> String?
      def push_sync: () -> Types::PushSync?
      def cognito_streams: () -> Types::CognitoStreams?
    end
    def set_identity_pool_configuration: (
      ?identity_pool_id: String,
      ?push_sync: {
        application_arns: Array[String],
        role_arn: String
      },
      ?cognito_streams: {
        stream_name: String,
        role_arn: String,
        streaming_status: String
      }
    ) -> _SetIdentityPoolConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SetIdentityPoolConfigurationResponse

    interface _SubscribeToDatasetResponse
      include Smithy::Client::_Response[Types::SubscribeToDatasetResponse]
    end
