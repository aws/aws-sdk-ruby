      include Smithy::Client::_Response[Types::ListDatasetsResponse]
      def datasets: () -> Array[Types::Dataset]?
      def count: () -> Integer?
      def next_token: () -> String?
    end
    def list_datasets: (
      ?identity_pool_id: String,
      ?identity_id: String,
      ?next_token: String,
