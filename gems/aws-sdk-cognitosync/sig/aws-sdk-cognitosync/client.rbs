      def identity_usage: () -> Types::IdentityUsage?
    end
    def describe_identity_usage: (
      ?identity_pool_id: String,
      ?identity_id: String
    ) -> _DescribeIdentityUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeIdentityUsageResponse

    interface _GetBulkPublishDetailsResponse
      include Smithy::Client::_Response[Types::GetBulkPublishDetailsResponse]
      def identity_pool_id: () -> String?
      def bulk_publish_start_time: () -> Time?
      def bulk_publish_complete_time: () -> Time?
      def bulk_publish_status: () -> String?
      def failure_message: () -> String?
    end
    def get_bulk_publish_details: (
      ?identity_pool_id: String
    ) -> _GetBulkPublishDetailsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetBulkPublishDetailsResponse

    interface _GetCognitoEventsResponse
