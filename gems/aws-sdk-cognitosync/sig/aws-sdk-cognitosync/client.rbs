    end
    def delete_dataset: (
      ?identity_pool_id: String,
      ?identity_id: String,
      ?dataset_name: String
    ) -> _DeleteDatasetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteDatasetResponse

