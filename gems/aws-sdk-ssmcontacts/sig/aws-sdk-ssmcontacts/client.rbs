    end
    def create_contact_channel: (
      ?contact_id: String,
      ?name: String,
      ?type: String,
      ?delivery_address: {
        simple_address: String
      },
      ?defer_activation: bool,
      ?idempotency_token: String
    ) -> _CreateContactChannelResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateContactChannelResponse

    interface _CreateRotationResponse
      include Smithy::Client::_Response[Types::CreateRotationResult]
