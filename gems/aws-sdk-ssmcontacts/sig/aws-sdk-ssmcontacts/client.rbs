    interface _CreateContactResponse
      include Smithy::Client::_Response[Types::CreateContactResult]
      def contact_arn: () -> String?
    end
    def create_contact: (
      ?alias: String,
      ?display_name: String,
      ?type: String,
      ?plan: {
        stages: Array[
          {
            duration_in_minutes: Integer,
            targets: Array[
              {
                channel_target_info: {
                  contact_channel_id: String,
                  retry_interval_in_minutes: Integer
                },
                contact_target_info: {
                  contact_id: untyped,
                  is_essential: bool
                }
              }
            ]
          }
        ],
        rotation_ids: Array[String]
      },
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?idempotency_token: String
    ) -> _CreateContactResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateContactResponse

    interface _CreateContactChannelResponse
      include Smithy::Client::_Response[Types::CreateContactChannelResult]
