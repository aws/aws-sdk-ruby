      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateActivityResponse
      include Smithy::Client::_Response[Types::CreateActivityOutput]
      def activity_arn: () -> String?
      def creation_date: () -> Time?
    end
    def create_activity: (
      ?name: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?encryption_configuration: {
        kms_key_id: String,
        kms_data_key_reuse_period_seconds: Integer,
        type: String
      }
    ) -> _CreateActivityResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateActivityResponse

