EDED" | "RESULT_COMPLETED_MANIFEST_MISMATCH" | "RESULT_SOURCE_BINDING_MISMATCH" | "SERVICE_COPY_DIGEST_MISMATCH" | "SERVICE_OBJECT_READ_FAILED" | "SERVICE_OBJECT_TOO_LARGE" | "SERVICE_RECEIPT_OUTSIDE_ISSUE" | "SOURCE_OBJECT_DIGEST_MISMATCH" | "SOURCE_REFERENCE_OUTSIDE_BUILD" | "SOURCE_TARGET_BUILD_MISMATCH" | "UNKNOWN_REPOSITORY" | "UNKNOWN_SOURCE_PROVIDER" | "UNSUPPORTED_ENVIRONMENT_SCHEMA" | "github_destination_not_enabled" | "patch_creation_policy_disabled")]
