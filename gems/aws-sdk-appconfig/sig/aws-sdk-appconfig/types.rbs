      attr_accessor description: String?
      attr_accessor actions: Hash[String, Array[Types::Action]]?
      attr_accessor parameters: Hash[String, Types::Parameter]?
      attr_accessor version_number: Integer?
    end

    class ValidateConfigurationRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?application_id: String,
        ?configuration_profile_id: String,
        ?configuration_version: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor application_id: String?
      attr_accessor configuration_profile_id: String?
      attr_accessor configuration_version: String?
    end

    class Validator
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?content: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor content: String?
    end

    module ValidatorType
      JSON_SCHEMA: String
      LAMBDA: String
    end

    class VendedMetricsSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?enabled: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor enabled: bool?
    end
  end
end
