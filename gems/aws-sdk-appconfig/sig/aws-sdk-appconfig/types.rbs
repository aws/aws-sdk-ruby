module Aws::AppConfig
  module Types

    class Action
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?description: String,
        ?uri: String,
        ?role_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor uri: String?
      attr_accessor role_arn: String?
    end

    class ActionInvocation
      include Smithy::Schema::Structure

      def initialize: (
        ?extension_identifier: String,
        ?action_name: String,
        ?uri: String,
        ?role_arn: String,
        ?error_message: String,
        ?error_code: String,
        ?invocation_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor extension_identifier: String?
      attr_accessor action_name: String?
      attr_accessor uri: String?
      attr_accessor role_arn: String?
      attr_accessor error_message: String?
      attr_accessor error_code: String?
      attr_accessor invocation_id: String?
    end

    module ActionPoint
      PRE_CREATE_HOSTED_CONFIGURATION_VERSION: String
      PRE_START_DEPLOYMENT: String
      AT_DEPLOYMENT_TICK: String
      ON_DEPLOYMENT_START: String
      ON_DEPLOYMENT_STEP: String
      ON_DEPLOYMENT_BAKING: String
      ON_DEPLOYMENT_COMPLETE: String
      ON_DEPLOYMENT_ROLLED_BACK: String
    end

    class Application
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?name: String,
        ?description: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor name: String?
      attr_accessor description: String?
    end

    class AppliedExtension
      include Smithy::Schema::Structure

      def initialize: (
        ?extension_id: String,
        ?extension_association_id: String,
        ?version_number: Integer,
        ?parameters: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor extension_id: String?
      attr_accessor extension_association_id: String?
      attr_accessor version_number: Integer?
      attr_accessor parameters: Hash[String, String]?
    end

    class AttributeValue
      include Smithy::Schema::Union

      def initialize: (
        ?string_value: String,
        ?number_value: Float,
        ?boolean_value: bool,
        ?string_array: Array[String],
        ?number_array: Array[Float],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor string_value: String?
      attr_accessor number_value: Float?
      attr_accessor boolean_value: bool?
      attr_accessor string_array: Array[String]?
      attr_accessor number_array: Array[Float]?

      class StringValue < AttributeValue
      end
      class NumberValue < AttributeValue
      end
      class BooleanValue < AttributeValue
      end
      class StringArray < AttributeValue
      end
      class NumberArray < AttributeValue
      end
      class Unknown < AttributeValue
      end
    end

    class BadRequestDetails
      include Smithy::Schema::Union

      def initialize: (
        ?invalid_configuration: Array[Types::InvalidConfigurationDetail],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor invalid_configuration: Array[Types::InvalidConfigurationDetail]?

      class InvalidConfiguration < BadRequestDetails
      end
      class Unknown < BadRequestDetails
      end
    end

    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
        ?details: Types::BadRequestDetails,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor details: Types::BadRequestDetails?
    end

    module BadRequestReason
      INVALID_CONFIGURATION: String
    end

    module BytesMeasure
      KILOBYTES: String
    end

