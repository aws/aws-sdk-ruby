module Aws::Identitystore
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?request_id: String,
        ?reason: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor request_id: String?
      attr_accessor reason: String?
    end

    module AccessDeniedExceptionReason
      KMS_ACCESS_DENIED: String
    end

    class Address
      include Smithy::Schema::Structure

      def initialize: (
        ?street_address: String,
        ?locality: String,
        ?region: String,
        ?postal_code: String,
        ?country: String,
        ?formatted: String,
        ?type: String,
        ?primary: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor street_address: String?
      attr_accessor locality: String?
      attr_accessor region: String?
      attr_accessor postal_code: String?
      attr_accessor country: String?
      attr_accessor formatted: String?
      attr_accessor type: String?
      attr_accessor primary: bool?
    end

    class AlternateIdentifier
      include Smithy::Schema::Union

      def initialize: (
        ?external_id: Types::ExternalId,
        ?unique_attribute: Types::UniqueAttribute,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor external_id: Types::ExternalId?
      attr_accessor unique_attribute: Types::UniqueAttribute?

      class ExternalId < AlternateIdentifier
      end
      class UniqueAttribute < AlternateIdentifier
      end
      class Unknown < AlternateIdentifier
      end
    end

    class AttributeOperation
      include Smithy::Schema::Structure

      def initialize: (
