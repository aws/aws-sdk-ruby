    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?request_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor request_id: String?
    end

    class Address
      include Smithy::Schema::Structure

      def initialize: (
        ?street_address: String,
        ?locality: String,
