      ],
      ?phone_numbers: Array[
        {
          value: String,
          type: untyped,
          primary: bool
        }
      ],
      ?user_type: String,
      ?title: String,
      ?preferred_language: String,
      ?locale: String,
      ?timezone: String,
      ?photos: Array[
        {
          value: String,
          type: untyped,
          display: untyped,
          primary: bool
        }
      ],
      ?website: String,
      ?birthdate: String,
