    end
    def list_group_memberships: (
      ?identity_store_id: String,
      ?group_id: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListGroupMembershipsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListGroupMembershipsResponse

    interface _ListGroupMembershipsForMemberResponse
      include Smithy::Client::_Response[Types::ListGroupMembershipsForMemberOutput]
      def group_memberships: () -> Array[Types::GroupMembership]?
