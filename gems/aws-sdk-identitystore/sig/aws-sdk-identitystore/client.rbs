      ?filters: Array[
        {
          attribute_path: String,
          attribute_value: String
        }
      ]
    ) -> _ListUsersResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListUsersResponse

    interface _UpdateGroupResponse
      include Smithy::Client::_Response[Types::UpdateGroupOutput]
    end
    def update_group: (
      ?identity_store_id: String,
      ?group_id: String,
      ?operations: Array[
        {
          attribute_path: String,
          attribute_value: Smithy::Schema::document
        }
      ]
    ) -> _UpdateGroupResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateGroupResponse

    interface _UpdateUserResponse
