      }
    ) -> _GetGroupMembershipIdResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetGroupMembershipIdResponse

    interface _GetUserIdResponse
      include Smithy::Client::_Response[Types::GetUserIdOutput]
      def user_id: () -> String?
      def identity_store_id: () -> String?
    end
    def get_user_id: (
      ?identity_store_id: String,
      ?alternate_identifier: {
        external_id: {
          issuer: String,
          id: String
        },
        unique_attribute: {
          attribute_path: String,
          attribute_value: Smithy::Schema::document
        }
      }
    ) -> _GetUserIdResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetUserIdResponse

    interface _IsMemberInGroupsResponse
      include Smithy::Client::_Response[Types::IsMemberInGroupsOutput]
      def results: () -> Array[Types::GroupMembershipExistenceResult]?
    end
    def is_member_in_groups: (
      ?identity_store_id: String,
      ?member_id: {
        user_id: String
      },
      ?group_ids: Array[String]
    ) -> _IsMemberInGroupsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _IsMemberInGroupsResponse

    interface _ListGroupMembershipsResponse
      include Smithy::Client::_Response[Types::ListGroupMembershipsOutput]
      def group_memberships: () -> Array[Types::GroupMembership]?
