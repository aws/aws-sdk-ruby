    end
    def list_group_memberships_for_member: (
      ?identity_store_id: String,
      ?member_id: {
        user_id: String
      },
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListGroupMembershipsForMemberResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListGroupMembershipsForMemberResponse

    interface _ListGroupsResponse
      include Smithy::Client::_Response[Types::ListGroupsOutput]
      def groups: () -> Array[Types::Group]?
      def next_token: () -> String?
    end
    def list_groups: (
      ?identity_store_id: String,
      ?max_results: Integer,
      ?next_token: String,
      ?filters: Array[
        {
          attribute_path: String,
          attribute_value: String
        }
      ]
    ) -> _ListGroupsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListGroupsResponse

    interface _ListUsersResponse
      include Smithy::Client::_Response[Types::ListUsersOutput]
      def users: () -> Array[Types::User]?
      def next_token: () -> String?
    end
    def list_users: (
      ?identity_store_id: String,
      ?max_results: Integer,
