        ?title: String,
        ?description: String,
        ?width: Integer,
        ?height: Integer,
        ?horizontal_offset: Integer,
        ?configs: Array[Types::WidgetConfig],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor title: String?
      attr_accessor description: String?
      attr_accessor width: Integer?
      attr_accessor height: Integer?
      attr_accessor horizontal_offset: Integer?
      attr_accessor configs: Array[Types::WidgetConfig]?
    end

    class WidgetConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?query_parameters: Types::QueryParameters,
        ?display_config: Types::DisplayConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor query_parameters: Types::QueryParameters?
      attr_accessor display_config: Types::DisplayConfig?
    end
  end
end
