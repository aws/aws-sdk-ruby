      attr_accessor time_range: Types::DateTimeRange?
      attr_accessor group_by: Array[Types::GroupDefinition]?
      attr_accessor granularity: String?
      attr_accessor filter: Types::Expression?
      attr_accessor metrics: Array[String]?
