module Aws::IoT
  module Types

    module AbortAction
      CANCEL: String
    end

    class AbortConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?criteria_list: Array[Types::AbortCriteria],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor criteria_list: Array[Types::AbortCriteria]?
    end

    class AbortCriteria
      include Smithy::Schema::Structure

      def initialize: (
