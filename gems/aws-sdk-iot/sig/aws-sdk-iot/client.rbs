    def create_job: (
      ?job_id: String,
      ?targets: Array[String],
      ?document_source: String,
      ?document: String,
      ?description: String,
      ?presigned_url_config: {
        role_arn: String,
        expires_in_sec: Integer
      },
      ?target_selection: String,
      ?job_executions_rollout_config: {
        maximum_per_minute: Integer,
        exponential_rate: {
          base_rate_per_minute: Integer,
          increment_factor: Float,
          rate_increase_criteria: {
            number_of_notified_things: Integer,
            number_of_succeeded_things: untyped
          }
        }
      },
      ?abort_config: {
        criteria_list: Array[
          {
            failure_type: String,
            action: String,
            threshold_percentage: Float,
            min_number_of_executed_things: Integer
          }
        ]
      },
      ?timeout_config: {
        in_progress_timeout_in_minutes: Integer
      },
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?namespace_id: String,
      ?job_template_arn: String,
      ?job_executions_retry_config: {
        criteria_list: Array[
          {
            failure_type: String,
            number_of_retries: Integer
          }
        ]
      },
      ?document_parameters: Hash[String, String],
      ?scheduling_config: {
        start_time: String,
        end_time: untyped,
        end_behavior: String,
        maintenance_windows: Array[
          {
            start_time: String,
            duration_in_minutes: Integer
          }
        ]
      },
      ?destination_package_versions: Array[String]
    ) -> _CreateJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateJobResponse

