      def modified_at: () -> Time?
      def tags: () -> Hash[String, String]?
    end
    def get_probe: (
      ?monitor_name: String,
      ?probe_id: String
    ) -> _GetProbeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetProbeResponse

    interface _ListMonitorsResponse
      include Smithy::Client::_Response[Types::ListMonitorsOutput]
      def monitors: () -> Array[Types::MonitorSummary]?
      def next_token: () -> String?
    end
    def list_monitors: (
      ?next_token: String,
      ?max_results: Integer,
      ?state: String
    ) -> _ListMonitorsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListMonitorsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
