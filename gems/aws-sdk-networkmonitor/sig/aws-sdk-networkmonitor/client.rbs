    interface _GetProbeResponse
      include Smithy::Client::_Response[Types::GetProbeOutput]
      def probe_id: () -> String?
      def probe_arn: () -> String?
      def source_arn: () -> String?
      def destination: () -> String?
      def destination_port: () -> Integer?
      def protocol: () -> String?
      def packet_size: () -> Integer?
