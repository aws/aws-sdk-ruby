module Aws::NetworkMonitor
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::NetworkMonitor::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateMonitorResponse
      include Smithy::Client::_Response[Types::CreateMonitorOutput]
      def monitor_arn: () -> String?
      def monitor_name: () -> String?
      def state: () -> String?
      def aggregation_period: () -> Integer?
      def tags: () -> Hash[String, String]?
    end
    def create_monitor: (
      ?monitor_name: String,
      ?probes: Array[
        {
          source_arn: String,
          destination: String,
          destination_port: Integer,
          protocol: String,
          packet_size: Integer,
          probe_tags: Hash[String, String]
        }
      ],
      ?aggregation_period: Integer,
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateMonitorResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateMonitorResponse

    interface _CreateProbeResponse
      include Smithy::Client::_Response[Types::CreateProbeOutput]
      def probe_id: () -> String?
      def probe_arn: () -> String?
      def source_arn: () -> String?
      def destination: () -> String?
      def destination_port: () -> Integer?
      def protocol: () -> String?
      def packet_size: () -> Integer?
      def address_family: () -> String?
      def vpc_id: () -> String?
      def state: () -> String?
      def created_at: () -> Time?
      def modified_at: () -> Time?
      def tags: () -> Hash[String, String]?
    end
    def create_probe: (
      ?monitor_name: String,
      ?probe: {
        source_arn: String,
        destination: String,
        destination_port: Integer,
        protocol: String,
        packet_size: Integer,
        tags: Hash[String, String]
      },
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateProbeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateProbeResponse

    interface _DeleteMonitorResponse
      include Smithy::Client::_Response[Types::DeleteMonitorOutput]
    end
    def delete_monitor: (
      ?monitor_name: String
    ) -> _DeleteMonitorResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteMonitorResponse

    interface _DeleteProbeResponse
      include Smithy::Client::_Response[Types::DeleteProbeOutput]
    end
    def delete_probe: (
      ?monitor_name: String,
      ?probe_id: String
    ) -> _DeleteProbeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteProbeResponse

    interface _GetMonitorResponse
      include Smithy::Client::_Response[Types::GetMonitorOutput]
      def monitor_arn: () -> String?
      def monitor_name: () -> String?
      def state: () -> String?
      def aggregation_period: () -> Integer?
      def tags: () -> Hash[String, String]?
      def probes: () -> Array[Types::Probe]?
      def created_at: () -> Time?
      def modified_at: () -> Time?
    end
    def get_monitor: (
      ?monitor_name: String
