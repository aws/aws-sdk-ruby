        include_iframe_only_streams: untyped,
        ts_include_dvb_subtitles: untyped,
        scte: {
          scte_filter: Array[String]
        },
        encryption: {
          constant_initialization_vector: untyped,
          encryption_method: {
            ts_encryption_method: String,
            cmaf_encryption_method: String,
            ism_encryption_method: String
          },
          key_rotation_interval_seconds: untyped,
          cmaf_exclude_segment_drm_metadata: untyped,
          speke_key_provider: {
            encryption_contract_configuration: {
              preset_speke20_audio: String,
              preset_speke20_video: String
            },
            resource_id: untyped,
            drm_systems: Array[String],
            role_arn: untyped,
            url: untyped
          }
        }
      },
      ?description: String,
      ?startover_window_seconds: Integer,
      ?hls_manifests: Array[
        {
          manifest_name: String,
          child_manifest_name: untyped,
          scte_hls: {
            ad_marker_hls: String
          },
          start_tag: {
            time_offset: Float,
            precise: bool
          },
          manifest_window_seconds: Integer,
          program_date_time_interval_seconds: untyped,
          filter_configuration: {
            manifest_filter: String,
            start: Time,
            end: untyped,
            time_delay_seconds: untyped,
            clip_start_time: untyped
          },
          url_encode_child_manifest: untyped
        }
      ],
      ?low_latency_hls_manifests: Array[
        {
          manifest_name: String,
          child_manifest_name: untyped,
          scte_hls: {
            ad_marker_hls: String
          },
          start_tag: {
            time_offset: Float,
            precise: bool
          },
          manifest_window_seconds: Integer,
          program_date_time_interval_seconds: untyped,
          filter_configuration: {
            manifest_filter: String,
            start: Time,
            end: untyped,
            time_delay_seconds: untyped,
            clip_start_time: untyped
          },
          url_encode_child_manifest: untyped
        }
      ],
      ?dash_manifests: Array[
        {
          manifest_name: String,
          manifest_window_seconds: Integer,
          filter_configuration: {
            manifest_filter: String,
            start: Time,
            end: untyped,
            time_delay_seconds: untyped,
            clip_start_time: untyped
          },
          min_update_period_seconds: untyped,
          min_buffer_time_seconds: untyped,
          suggested_presentation_delay_seconds: untyped,
          segment_template_format: String,
          period_triggers: Array[String],
          scte_dash: {
            ad_marker_dash: String
          },
          drm_signaling: String,
          utc_timing: {
            timing_mode: String,
            timing_source: untyped
          },
          profiles: Array[String],
          base_urls: Array[
            {
              url: untyped,
              service_location: untyped,
              dvb_priority: untyped,
              dvb_weight: untyped
            }
          ],
          program_information: {
            title: untyped,
            source: untyped,
            copyright: untyped,
            language_code: untyped,
            more_information_url: untyped
          },
          dvb_settings: {
            font_download: {
              url: untyped,
              mime_type: untyped,
              font_family: untyped
            },
            error_metrics: Array[
              {
                reporting_url: untyped,
                probability: untyped
              }
            ]
          },
          compactness: String,
          subtitle_configuration: {
            ttml_configuration: {
              ttml_profile: String
            }
          }
        }
      ],
      ?mss_manifests: Array[
        {
          manifest_name: String,
          manifest_window_seconds: Integer,
          filter_configuration: {
            manifest_filter: String,
            start: Time,
            end: untyped,
            time_delay_seconds: untyped,
            clip_start_time: untyped
          },
          manifest_layout: String
        }
      ],
      ?force_endpoint_error_configuration: {
        endpoint_error_conditions: Array[String]
      },
      ?e_tag: String
    ) -> _UpdateOriginEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateOriginEndpointResponse
  end
end
