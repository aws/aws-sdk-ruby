      ?step_timeout_in_minutes: Integer
    ) -> _StartNextPendingJobExecutionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartNextPendingJobExecutionResponse

    interface _UpdateJobExecutionResponse
      include Smithy::Client::_Response[Types::UpdateJobExecutionResponse]
      def execution_state: () -> Types::JobExecutionState?
      def job_document: () -> String?
    end
    def update_job_execution: (
      ?job_id: String,
      ?thing_name: String,
      ?status: String,
      ?status_details: Hash[String, String],
      ?step_timeout_in_minutes: Integer,
      ?expected_version: Integer,
      ?include_job_execution_state: bool,
      ?include_job_document: bool,
      ?execution_number: Integer
    ) -> _UpdateJobExecutionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateJobExecutionResponse
