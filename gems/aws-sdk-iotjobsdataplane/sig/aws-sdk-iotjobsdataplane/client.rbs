      ?client_token: String
    ) -> _StartCommandExecutionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartCommandExecutionResponse

    interface _StartNextPendingJobExecutionResponse
      include Smithy::Client::_Response[Types::StartNextPendingJobExecutionResponse]
      def execution: () -> Types::JobExecution?
    end
    def start_next_pending_job_execution: (
      ?thing_name: String,
