      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::IoTJobsDataPlane::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DescribeJobExecutionResponse
      include Smithy::Client::_Response[Types::DescribeJobExecutionResponse]
      def execution: () -> Types::JobExecution?
    end
    def describe_job_execution: (
      ?job_id: String,
      ?thing_name: String,
      ?include_job_document: bool,
      ?execution_number: Integer
    ) -> _DescribeJobExecutionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeJobExecutionResponse

    interface _GetPendingJobExecutionsResponse
      include Smithy::Client::_Response[Types::GetPendingJobExecutionsResponse]
      def in_progress_jobs: () -> Array[Types::JobExecutionSummary]?
      def queued_jobs: () -> Array[Types::JobExecutionSummary]?
    end
    def get_pending_job_executions: (
      ?thing_name: String
    ) -> _GetPendingJobExecutionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPendingJobExecutionsResponse

    interface _StartCommandExecutionResponse
      include Smithy::Client::_Response[Types::StartCommandExecutionResponse]
      def execution_id: () -> String?
    end
    def start_command_execution: (
      ?target_arn: String,
      ?command_arn: String,
      ?parameters: Hash[String,
        {
          s: String,
          b: bool,
          i: Integer,
          l: Integer,
          d: Float,
          bin: String,
          ul: String
        }
      ],
