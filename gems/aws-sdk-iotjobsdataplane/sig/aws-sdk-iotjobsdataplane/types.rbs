    class JobExecution
      include Smithy::Schema::Structure

      def initialize: (
        ?job_id: String,
        ?thing_name: String,
        ?status: String,
        ?status_details: Hash[String, String],
        ?queued_at: Integer,
        ?started_at: Integer,
        ?last_updated_at: Integer,
        ?approximate_seconds_before_timed_out: Integer,
        ?version_number: Integer,
        ?execution_number: Integer,
        ?job_document: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor job_id: String?
      attr_accessor thing_name: String?
      attr_accessor status: String?
      attr_accessor status_details: Hash[String, String]?
      attr_accessor queued_at: Integer?
      attr_accessor started_at: Integer?
      attr_accessor last_updated_at: Integer?
      attr_accessor approximate_seconds_before_timed_out: Integer?
      attr_accessor version_number: Integer?
      attr_accessor execution_number: Integer?
      attr_accessor job_document: String?
    end

    class JobExecutionState
      include Smithy::Schema::Structure

      def initialize: (
        ?status: String,
        ?status_details: Hash[String, String],
        ?version_number: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: String?
      attr_accessor status_details: Hash[String, String]?
      attr_accessor version_number: Integer?
    end

    module JobExecutionStatus
      QUEUED: String
      IN_PROGRESS: String
      SUCCEEDED: String
      FAILED: String
      TIMED_OUT: String
      REJECTED: String
      REMOVED: String
      CANCELED: String
    end

    class JobExecutionSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?job_id: String,
