module Aws::AccountAccess
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::AccountAccess::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateApplicationResponse
      include Smithy::Client::_Response[Types::CreateApplicationResponse]
      def application_arn: () -> String?
    end
    def create_application: (
      ?identity_source: {
        identity_center: {
          instance_arn: String
        }
      },
      ?tags: Hash[String, String]
    ) -> _CreateApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateApplicationResponse

    interface _CreateEntitlementResponse
      include Smithy::Client::_Response[Types::CreateEntitlementResponse]
      def entitlement_id: () -> String?
    end
    def create_entitlement: (
      ?application_arn: String,
      ?entitlement: {
        principal_role: {
          principal: {
            identity_center: {
              user_id: String,
              group_id: String
            }
          },
          role_arn: String
        }
      }
    ) -> _CreateEntitlementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateEntitlementResponse

    interface _DeleteApplicationResponse
      include Smithy::Client::_Response[Types::DeleteApplicationResponse]
    end
    def delete_application: (
      ?application_arn: String
    ) -> _DeleteApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteApplicationResponse

    interface _DeleteEntitlementResponse
      include Smithy::Client::_Response[Types::DeleteEntitlementResponse]
    end
    def delete_entitlement: (
      ?application_arn: String,
      ?entitlement_id: String
    ) -> _DeleteEntitlementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteEntitlementResponse

    interface _GetApplicationResponse
      include Smithy::Client::_Response[Types::GetApplicationResponse]
      def identity_source: () -> Types::IdentitySourceDetails?
      def status: () -> String?
      def tenant_id: () -> String?
      def created_at: () -> Time?
      def updated_at: () -> Time?
      def tags: () -> Hash[String, String]?
      def error: () -> Types::ErrorDetails?
    end
    def get_application: (
      ?application_arn: String
    ) -> _GetApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetApplicationResponse

    interface _GetEntitlementResponse
      include Smithy::Client::_Response[Types::GetEntitlementResponse]
      def application_arn: () -> String?
      def entitlement_id: () -> String?
      def entitlement: () -> Types::EntitlementDetails?
      def created_at: () -> Time?
    end
    def get_entitlement: (
      ?application_arn: String,
      ?entitlement_id: String
    ) -> _GetEntitlementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetEntitlementResponse

    interface _ListApplicationsResponse
      include Smithy::Client::_Response[Types::ListApplicationsResponse]
      def applications: () -> Array[Types::ApplicationSummary]?
      def next_token: () -> String?
    end
    def list_applications: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListApplicationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListApplicationsResponse

    interface _ListEntitlementsResponse
      include Smithy::Client::_Response[Types::ListEntitlementsResponse]
      def entitlements: () -> Array[Types::EntitlementsListMember]?
      def next_token: () -> String?
    end
    def list_entitlements: (
      ?application_arn: String,
      ?filter: {
        principal_role: {
          principal: {
            identity_center: {
              user_id: String,
              group_id: String
            }
          },
          role_arn: String,
          account: String
        }
      },
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListEntitlementsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListEntitlementsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
  end
end
