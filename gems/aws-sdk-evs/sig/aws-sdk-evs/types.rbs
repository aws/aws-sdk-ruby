    class CreateEnvironmentRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?client_token: String,
        ?environment_name: String,
        ?kms_key_id: String,
        ?tags: Hash[String, String],
        ?service_access_security_groups: Types::ServiceAccessSecurityGroups,
