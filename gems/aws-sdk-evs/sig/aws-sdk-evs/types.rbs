    class Check
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?id: String,
        ?result: String,
        ?impaired_since: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor id: String?
      attr_accessor result: String?
      attr_accessor impaired_since: Time?
    end

    module CheckResult
      PASSED: String
      FAILED: String
      UNKNOWN: String
    end

    module CheckType
      KEY_REUSE: String
      KEY_COVERAGE: String
      REACHABILITY: String
      HOST_COUNT: String
