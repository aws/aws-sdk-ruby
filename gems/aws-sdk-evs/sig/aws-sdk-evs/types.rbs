module Aws::Evs
  module Types

    class Check
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?result: String,
        ?impaired_since: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor result: String?
      attr_accessor impaired_since: Time?
    end

    module CheckResult
      PASSED: String
      FAILED: String
      UNKNOWN: String
    end

    module CheckType
      KEY_REUSE: String
      KEY_COVERAGE: String
      REACHABILITY: String
      HOST_COUNT: String
    end

    class ConnectivityInfo
      include Smithy::Schema::Structure

      def initialize: (
        ?private_route_server_peerings: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor private_route_server_peerings: Array[String]?
    end

    class CreateEnvironmentHostRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?client_token: String,
