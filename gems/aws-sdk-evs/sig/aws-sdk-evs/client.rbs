    interface _CreateEnvironmentResponse
      include Smithy::Client::_Response[Types::CreateEnvironmentResponse]
      def environment: () -> Types::Environment?
    end
    def create_environment: (
      ?client_token: String,
      ?environment_name: String,
      ?kms_key_id: String,
      ?tags: Hash[String, String],
      ?service_access_security_groups: {
        security_groups: Array[String]
      },
      ?vpc_id: String,
      ?service_access_subnet_id: String,
      ?vcf_version: String,
      ?terms_accepted: bool,
      ?initial_vlans: {
        vmk_management: {
          cidr: String
        },
        vm_management: untyped,
        v_motion: untyped,
        v_san: untyped,
        v_tep: untyped,
        edge_v_tep: untyped,
        nsx_uplink: untyped,
        hcx: untyped,
        expansion_vlan1: untyped,
        expansion_vlan2: untyped,
        is_hcx_public: bool,
        hcx_network_acl_id: String
      },
      ?connectivity_info: {
        private_route_server_peerings: Array[String]
      },
      ?license_info: Array[
        {
          solution_key: String,
          vsan_key: String
        }
      ],
      ?hosts: Array[
        {
          host_name: String,
          key_name: String,
          instance_type: String,
          placement_group_id: String,
          dedicated_host_id: String
        }
      ],
      ?vcf_hostnames: {
        v_center: String,
        nsx: untyped,
        nsx_manager1: untyped,
        nsx_manager2: untyped,
        nsx_manager3: untyped,
        nsx_edge1: untyped,
        nsx_edge2: untyped,
        sddc_manager: untyped,
        cloud_builder: untyped
      },
      ?site_id: String
    ) -> _CreateEnvironmentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateEnvironmentResponse

