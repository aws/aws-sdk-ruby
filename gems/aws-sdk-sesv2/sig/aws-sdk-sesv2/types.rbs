    class AccountDetails
      include Smithy::Schema::Structure

      def initialize: (
        ?mail_type: String,
        ?website_url: String,
        ?contact_language: String,
        ?use_case_description: String,
        ?additional_contact_email_addresses: Array[String],
        ?review_details: Types::ReviewDetails,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor mail_type: String?
      attr_accessor website_url: String?
      attr_accessor contact_language: String?
      attr_accessor use_case_description: String?
      attr_accessor additional_contact_email_addresses: Array[String]?
      attr_accessor review_details: Types::ReviewDetails?
    end

