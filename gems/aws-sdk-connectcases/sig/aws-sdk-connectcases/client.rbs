      ?content: {
        basic: {
          top_panel: {
            sections: Array[
              {
                field_group: {
                  name: String,
                  fields: Array[
                    {
                      id: String
                    }
                  ]
                }
              }
            ]
          },
          more_info: untyped
        }
      }
    ) -> _UpdateLayoutResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateLayoutResponse

    interface _UpdateTemplateResponse
      include Smithy::Client::_Response[Types::UpdateTemplateOutput]
    end
    def update_template: (
      ?domain_id: String,
      ?template_id: String,
      ?name: String,
      ?description: String,
      ?layout_configuration: {
        default_layout: String
      },
      ?required_fields: Array[
        {
          field_id: String
        }
      ],
      ?status: String,
      ?rules: Array[
        {
          case_rule_id: String,
          field_id: String
        }
      ]
    ) -> _UpdateTemplateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateTemplateResponse
  end
end
