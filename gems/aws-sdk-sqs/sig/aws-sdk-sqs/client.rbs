module Aws::SQS
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SQS::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AddPermissionResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def add_permission: (
      ?queue_url: String,
      ?label: String,
      ?aws_account_ids: Array[String],
      ?actions: Array[String]
    ) -> _AddPermissionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AddPermissionResponse

    interface _CancelMessageMoveTaskResponse
      include Smithy::Client::_Response[Types::CancelMessageMoveTaskResult]
      def approximate_number_of_messages_moved: () -> Integer?
    end
    def cancel_message_move_task: (
      ?task_handle: String
    ) -> _CancelMessageMoveTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CancelMessageMoveTaskResponse

    interface _ChangeMessageVisibilityResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def change_message_visibility: (
      ?queue_url: String,
      ?receipt_handle: String,
      ?visibility_timeout: Integer
    ) -> _ChangeMessageVisibilityResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ChangeMessageVisibilityResponse

    interface _ChangeMessageVisibilityBatchResponse
      include Smithy::Client::_Response[Types::ChangeMessageVisibilityBatchResult]
      def successful: () -> Array[Types::ChangeMessageVisibilityBatchResultEntry]?
      def failed: () -> Array[Types::BatchResultErrorEntry]?
    end
    def change_message_visibility_batch: (
      ?queue_url: String,
      ?entries: Array[
        {
          id: String,
          receipt_handle: untyped,
          visibility_timeout: Integer
        }
      ]
    ) -> _ChangeMessageVisibilityBatchResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ChangeMessageVisibilityBatchResponse

    interface _CreateQueueResponse
      include Smithy::Client::_Response[Types::CreateQueueResult]
      def queue_url: () -> String?
    end
    def create_queue: (
      ?queue_name: String,
      ?attributes: Hash[String, String],
      ?tags: Hash[String, String]
    ) -> _CreateQueueResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateQueueResponse

    interface _DeleteMessageResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_message: (
      ?queue_url: String,
      ?receipt_handle: String
    ) -> _DeleteMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteMessageResponse

    interface _DeleteMessageBatchResponse
      include Smithy::Client::_Response[Types::DeleteMessageBatchResult]
      def successful: () -> Array[Types::DeleteMessageBatchResultEntry]?
      def failed: () -> Array[Types::BatchResultErrorEntry]?
    end
    def delete_message_batch: (
      ?queue_url: String,
      ?entries: Array[
        {
          id: String,
          receipt_handle: untyped
        }
      ]
    ) -> _DeleteMessageBatchResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteMessageBatchResponse

    interface _DeleteQueueResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_queue: (
      ?queue_url: String
    ) -> _DeleteQueueResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteQueueResponse

    interface _GetQueueAttributesResponse
      include Smithy::Client::_Response[Types::GetQueueAttributesResult]
      def attributes: () -> Hash[String, String]?
    end
    def get_queue_attributes: (
      ?queue_url: String,
