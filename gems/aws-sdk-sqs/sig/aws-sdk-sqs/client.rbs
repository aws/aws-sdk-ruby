    interface _ReceiveMessageResponse
      include Smithy::Client::_Response[Types::ReceiveMessageResult]
      def messages: () -> Array[Types::Message]?
    end
    def receive_message: (
      ?queue_url: String,
      ?attribute_names: Array[String],
      ?message_system_attribute_names: Array[String],
      ?message_attribute_names: Array[String],
      ?max_number_of_messages: Integer,
      ?visibility_timeout: Integer,
      ?wait_time_seconds: Integer,
      ?receive_request_attempt_id: String
    ) -> _ReceiveMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ReceiveMessageResponse

    interface _RemovePermissionResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
