    ) -> _TagQueueResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagQueueResponse

    interface _UntagQueueResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def untag_queue: (
      ?queue_url: String,
      ?tag_keys: Array[String]
    ) -> _UntagQueueResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagQueueResponse
  end
end
