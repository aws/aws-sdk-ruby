    interface _GetQueueUrlResponse
      include Smithy::Client::_Response[Types::GetQueueUrlResult]
      def queue_url: () -> String?
    end
    def get_queue_url: (
      ?queue_name: String,
      ?queue_owner_aws_account_id: String
    ) -> _GetQueueUrlResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetQueueUrlResponse

    interface _ListDeadLetterSourceQueuesResponse
      include Smithy::Client::_Response[Types::ListDeadLetterSourceQueuesResult]
      def queue_urls: () -> Array[String]?
      def next_token: () -> String?
    end
    def list_dead_letter_source_queues: (
      ?queue_url: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListDeadLetterSourceQueuesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListDeadLetterSourceQueuesResponse

    interface _ListMessageMoveTasksResponse
      include Smithy::Client::_Response[Types::ListMessageMoveTasksResult]
      def results: () -> Array[Types::ListMessageMoveTasksResultEntry]?
    end
    def list_message_move_tasks: (
      ?source_arn: String,
      ?max_results: Integer
    ) -> _ListMessageMoveTasksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListMessageMoveTasksResponse

    interface _ListQueueTagsResponse
      include Smithy::Client::_Response[Types::ListQueueTagsResult]
