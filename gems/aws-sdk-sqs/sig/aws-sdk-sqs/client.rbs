    ) -> _RemovePermissionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RemovePermissionResponse

    interface _SendMessageResponse
      include Smithy::Client::_Response[Types::SendMessageResult]
      def md5_of_message_body: () -> String?
      def md5_of_message_attributes: () -> String?
      def md5_of_message_system_attributes: () -> String?
      def message_id: () -> String?
      def sequence_number: () -> String?
    end
    def send_message: (
      ?queue_url: String,
      ?message_body: String,
      ?delay_seconds: Integer,
      ?message_attributes: Hash[String,
        {
          string_value: String,
          binary_value: String,
          string_list_values: Array[String],
          binary_list_values: Array[String],
          data_type: untyped
        }
      ],
      ?message_system_attributes: Hash[String,
        {
          string_value: String,
          binary_value: String,
          string_list_values: Array[String],
          binary_list_values: Array[String],
          data_type: untyped
        }
      ],
      ?message_deduplication_id: String,
      ?message_group_id: String
    ) -> _SendMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendMessageResponse

    interface _SendMessageBatchResponse
      include Smithy::Client::_Response[Types::SendMessageBatchResult]
      def successful: () -> Array[Types::SendMessageBatchResultEntry]?
      def failed: () -> Array[Types::BatchResultErrorEntry]?
    end
    def send_message_batch: (
      ?queue_url: String,
      ?entries: Array[
        {
          id: String,
          message_body: untyped,
          delay_seconds: Integer,
          message_attributes: Hash[String,
            {
              string_value: untyped,
              binary_value: String,
              string_list_values: Array[String],
              binary_list_values: Array[String],
              data_type: untyped
            }
          ],
          message_system_attributes: Hash[String,
            {
              string_value: untyped,
              binary_value: untyped,
              string_list_values: untyped,
              binary_list_values: untyped,
              data_type: untyped
            }
          ],
          message_deduplication_id: untyped,
          message_group_id: untyped
        }
      ]
    ) -> _SendMessageBatchResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendMessageBatchResponse

    interface _SetQueueAttributesResponse
