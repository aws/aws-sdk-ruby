        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class UntagQueueRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?queue_url: String,
        ?tag_keys: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor queue_url: String?
      attr_accessor tag_keys: Array[String]?
    end
  end
end
