        ?max_value: Integer,
        ?max_length: Integer,
        ?regex: Types::OptionRestrictionRegex,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor namespace: String?
      attr_accessor name: String?
