module Aws::KeyspacesStreams
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::KeyspacesStreams::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetRecordsResponse
      include Smithy::Client::_Response[Types::GetRecordsOutput]
      def change_records: () -> Array[Types::Record]?
      def next_shard_iterator: () -> String?
    end
    def get_records: (
      ?shard_iterator: String,
      ?max_results: Integer
    ) -> _GetRecordsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetRecordsResponse

    interface _GetShardIteratorResponse
      include Smithy::Client::_Response[Types::GetShardIteratorOutput]
      def shard_iterator: () -> String?
    end
    def get_shard_iterator: (
      ?stream_arn: String,
      ?shard_id: String,
      ?shard_iterator_type: String,
      ?sequence_number: String
    ) -> _GetShardIteratorResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetShardIteratorResponse

    interface _GetStreamResponse
      include Smithy::Client::_Response[Types::GetStreamOutput]
      def stream_arn: () -> String?
      def stream_label: () -> String?
      def stream_status: () -> String?
      def stream_view_type: () -> String?
      def creation_request_date_time: () -> Time?
      def keyspace_name: () -> String?
      def table_name: () -> String?
      def shards: () -> Array[Types::Shard]?
      def next_token: () -> String?
    end
    def get_stream: (
      ?stream_arn: String,
      ?max_results: Integer,
      ?shard_filter: {
        type: String,
        shard_id: String
      },
      ?next_token: String
    ) -> _GetStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetStreamResponse

    interface _ListStreamsResponse
      include Smithy::Client::_Response[Types::ListStreamsOutput]
      def streams: () -> Array[Types::Stream]?
      def next_token: () -> String?
    end
    def list_streams: (
      ?keyspace_name: String,
      ?table_name: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListStreamsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListStreamsResponse
  end
end
