module Aws::XRay
  module Types

    class Alias
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?names: Array[String],
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor names: Array[String]?
      attr_accessor type: String?
    end

    class AnnotationValue
      include Smithy::Schema::Union

      def initialize: (
        ?number_value: Float,
        ?boolean_value: bool,
        ?string_value: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor number_value: Float?
      attr_accessor boolean_value: bool?
      attr_accessor string_value: String?

      class NumberValue < AnnotationValue
      end
      class BooleanValue < AnnotationValue
      end
      class StringValue < AnnotationValue
      end
      class Unknown < AnnotationValue
      end
    end

