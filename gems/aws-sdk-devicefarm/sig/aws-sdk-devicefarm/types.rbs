      CALABASH_JAVA_XML_OUTPUT: String
      AUTOMATION_OUTPUT: String
      APPIUM_SERVER_OUTPUT: String
      APPIUM_JAVA_OUTPUT: String
      APPIUM_JAVA_XML_OUTPUT: String
      APPIUM_PYTHON_OUTPUT: String
      APPIUM_PYTHON_XML_OUTPUT: String
      EXPLORER_EVENT_LOG: String
      EXPLORER_SUMMARY_LOG: String
      APPLICATION_CRASH_REPORT: String
      XCTEST_LOG: String
      VIDEO: String
      CUSTOMER_ARTIFACT: String
      CUSTOMER_ARTIFACT_LOG: String
      TESTSPEC_OUTPUT: String
    end

    module BillingMethod
      METERED: String
      UNMETERED: String
    end

