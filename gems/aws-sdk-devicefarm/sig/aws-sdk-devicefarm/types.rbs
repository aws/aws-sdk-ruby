module Aws::DeviceFarm
  module Types

    class AccountSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?aws_account_number: String,
        ?unmetered_devices: Hash[String, Integer],
        ?unmetered_remote_access_devices: Hash[String, Integer],
        ?max_job_timeout_minutes: Integer,
        ?trial_minutes: Types::TrialMinutes,
        ?max_slots: Hash[String, Integer],
        ?default_job_timeout_minutes: Integer,
        ?skip_app_resign: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor aws_account_number: String?
      attr_accessor unmetered_devices: Hash[String, Integer]?
      attr_accessor unmetered_remote_access_devices: Hash[String, Integer]?
      attr_accessor max_job_timeout_minutes: Integer?
      attr_accessor trial_minutes: Types::TrialMinutes?
      attr_accessor max_slots: Hash[String, Integer]?
      attr_accessor default_job_timeout_minutes: Integer?
      attr_accessor skip_app_resign: bool?
    end

    class ArgumentException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Artifact
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?name: String,
        ?type: String,
        ?extension: String,
        ?url: String,
      ) -> void
