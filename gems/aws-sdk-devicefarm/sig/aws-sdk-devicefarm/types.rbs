      attr_accessor arn: String?
      attr_accessor name: String?
      attr_accessor type: String?
      attr_accessor extension: String?
      attr_accessor url: String?
    end

    module ArtifactCategory
      SCREENSHOT: String
      FILE: String
      LOG: String
    end

    module ArtifactType
      UNKNOWN: String
