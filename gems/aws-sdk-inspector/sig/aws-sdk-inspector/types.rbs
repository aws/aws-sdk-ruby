module Aws::Inspector
  module Types

    module AccessDeniedErrorCode
      ACCESS_DENIED_TO_ASSESSMENT_TARGET: String
      ACCESS_DENIED_TO_ASSESSMENT_TEMPLATE: String
      ACCESS_DENIED_TO_ASSESSMENT_RUN: String
      ACCESS_DENIED_TO_FINDING: String
      ACCESS_DENIED_TO_RESOURCE_GROUP: String
      ACCESS_DENIED_TO_RULES_PACKAGE: String
      ACCESS_DENIED_TO_SNS_TOPIC: String
      ACCESS_DENIED_TO_IAM_ROLE: String
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?error_code: String,
        ?can_retry: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor error_code: String?
      attr_accessor can_retry: bool?
    end

