    class AssessmentRunNotification
      include Smithy::Schema::Structure

      def initialize: (
        ?date: Time,
        ?event: String,
        ?message: String,
        ?error: bool,
        ?sns_topic_arn: String,
        ?sns_publish_status_code: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor date: Time?
      attr_accessor event: String?
      attr_accessor message: String?
      attr_accessor error: bool?
      attr_accessor sns_topic_arn: String?
      attr_accessor sns_publish_status_code: String?
    end

    module AssessmentRunNotificationSnsStatusCode
      SUCCESS: String
      TOPIC_DOES_NOT_EXIST: String
      ACCESS_DENIED: String
      INTERNAL_ERROR: String
    end

    module AssessmentRunState
      CREATED: String
      START_DATA_COLLECTION_PENDING: String
      START_DATA_COLLECTION_IN_PROGRESS: String
      COLLECTING_DATA: String
      STOP_DATA_COLLECTION_PENDING: String
      DATA_COLLECTED: String
      START_EVALUATING_RULES_PENDING: String
      EVALUATING_RULES: String
      FAILED: String
      ERROR: String
      COMPLETED: String
      COMPLETED_WITH_ERRORS: String
      CANCELED: String
    end

