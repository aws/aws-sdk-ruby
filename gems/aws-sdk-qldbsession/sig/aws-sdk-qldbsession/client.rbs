module Aws::QLDBSession
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::QLDBSession::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _SendCommandResponse
      include Smithy::Client::_Response[Types::SendCommandResult]
      def start_session: () -> Types::StartSessionResult?
      def start_transaction: () -> Types::StartTransactionResult?
      def end_session: () -> Types::EndSessionResult?
      def commit_transaction: () -> Types::CommitTransactionResult?
      def abort_transaction: () -> Types::AbortTransactionResult?
      def execute_statement: () -> Types::ExecuteStatementResult?
      def fetch_page: () -> Types::FetchPageResult?
    end
    def send_command: (
      ?session_token: String,
      ?start_session: {
        ledger_name: String
      },
      ?start_transaction: {
      },
      ?end_session: {
      },
      ?commit_transaction: {
        transaction_id: String,
        commit_digest: String
      },
      ?abort_transaction: {
      },
      ?execute_statement: {
        transaction_id: String,
        statement: String,
        parameters: Array[
          {
            ion_binary: String,
            ion_text: String
          }
        ]
      },
      ?fetch_page: {
        transaction_id: String,
        next_page_token: String
      }
    ) -> _SendCommandResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendCommandResponse
  end
end
