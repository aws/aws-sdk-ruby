      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor page: Types::Page?
      attr_accessor timing_information: Types::TimingInformation?
      attr_accessor consumed_i_os: Types::IOUsage?
    end

    class IOUsage
      include Smithy::Schema::Structure

      def initialize: (
        ?read_i_os: Integer,
