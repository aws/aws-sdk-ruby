module Aws::QLDBSession
  module Types

    class AbortTransactionRequest
      include Smithy::Schema::Structure

      def initialize: (
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

    end

    class AbortTransactionResult
      include Smithy::Schema::Structure

      def initialize: (
        ?timing_information: Types::TimingInformation,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor timing_information: Types::TimingInformation?
    end

    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?code: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor code: String?
    end

    class CapacityExceededException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class CommitTransactionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?transaction_id: String,
        ?commit_digest: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor transaction_id: String?
      attr_accessor commit_digest: String?
    end

    class CommitTransactionResult
      include Smithy::Schema::Structure

      def initialize: (
        ?transaction_id: String,
        ?commit_digest: String,
        ?timing_information: Types::TimingInformation,
        ?consumed_i_os: Types::IOUsage,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor transaction_id: String?
      attr_accessor commit_digest: String?
      attr_accessor timing_information: Types::TimingInformation?
      attr_accessor consumed_i_os: Types::IOUsage?
    end

    class EndSessionRequest
      include Smithy::Schema::Structure

      def initialize: (
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

