        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class SendAlexaOfferToMasterRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?channel_arn: String,
