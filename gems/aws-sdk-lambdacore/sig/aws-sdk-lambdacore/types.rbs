    class NetworkConnectorConfiguration
      include Smithy::Schema::Union

      def initialize: (
        ?vpc_egress_configuration: Types::NetworkConnectorVpcEgressConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor vpc_egress_configuration: Types::NetworkConnectorVpcEgressConfiguration?

      class VpcEgressConfiguration < NetworkConnectorConfiguration
      end
      class Unknown < NetworkConnectorConfiguration
      end
    end

    module NetworkConnectorLastUpdateStatus
      Successful: String
      Failed: String
      InProgress: String
    end

    module NetworkConnectorLastUpdateStatusReasonCode
      DisallowedByVpcEncryptionControl: String
      Ec2RequestLimitExceeded: String
      InsufficientRolePermissions: String
      InternalError: String
      InvalidSecurityGroup: String
      InvalidSubnet: String
      SecurityGroupsPerInterfaceLimitExceeded: String
      SubnetOutOfIPAddresses: String
    end

