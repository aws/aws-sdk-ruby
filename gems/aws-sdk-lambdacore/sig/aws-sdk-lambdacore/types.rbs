module Aws::LambdaCore
  module Types

    module ComputeResourceType
      MicroVm: String
      WebFunction: String
    end

    class CreateNetworkConnectorRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?configuration: Types::NetworkConnectorConfiguration,
        ?operator_role: String,
        ?client_token: String,
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor configuration: Types::NetworkConnectorConfiguration?
      attr_accessor operator_role: String?
      attr_accessor client_token: String?
      attr_accessor tags: Hash[String, String]?
    end

