    end
    def list_network_connectors: (
      ?state: String,
      ?marker: String,
      ?max_items: Integer
    ) -> _ListNetworkConnectorsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListNetworkConnectorsResponse

    interface _UpdateNetworkConnectorResponse
      include Smithy::Client::_Response[Types::UpdateNetworkConnectorResponse]
      def arn: () -> String?
      def name: () -> String?
      def id: () -> String?
      def version_arn: () -> String?
      def version: () -> Integer?
      def operator_role: () -> String?
      def configuration: () -> Types::NetworkConnectorConfiguration?
      def state: () -> String?
      def last_update_status: () -> String?
      def last_update_status_reason: () -> String?
      def last_modified: () -> Time?
    end
    def update_network_connector: (
      ?identifier: String,
      ?configuration: {
        vpc_egress_configuration: {
          subnet_ids: Array[String],
          security_group_ids: Array[String],
          network_protocol: String,
