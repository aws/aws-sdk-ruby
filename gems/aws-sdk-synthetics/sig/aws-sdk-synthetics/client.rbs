            }
          ],
          base_canary_run_id: untyped,
          browser_type: String
        }
      ]
    ) -> _StartCanaryDryRunResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartCanaryDryRunResponse

