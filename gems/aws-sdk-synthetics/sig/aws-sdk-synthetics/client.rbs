module Aws::Synthetics
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Synthetics::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AssociateResourceResponse
      include Smithy::Client::_Response[Types::AssociateResourceResponse]
    end
    def associate_resource: (
      ?group_identifier: String,
      ?resource_arn: String
    ) -> _AssociateResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AssociateResourceResponse

    interface _CreateCanaryResponse
      include Smithy::Client::_Response[Types::CreateCanaryResponse]
      def canary: () -> Types::Canary?
    end
    def create_canary: (
      ?name: String,
      ?code: {
        s3_bucket: String,
        s3_key: untyped,
        s3_version: untyped,
        zip_file: String,
        handler: String,
        blueprint_types: Array[String],
        dependencies: Array[
          {
            type: String,
            reference: untyped
          }
        ]
      },
      ?artifact_s3_location: String,
      ?execution_role_arn: String,
      ?schedule: {
        expression: String,
        duration_in_seconds: Integer,
        retry_config: {
          max_retries: Integer
        }
      },
      ?run_config: {
        timeout_in_seconds: Integer,
        memory_in_mb: Integer,
        active_tracing: bool,
        environment_variables: Hash[String, String],
        ephemeral_storage: Integer
      },
      ?success_retention_period_in_days: Integer,
      ?failure_retention_period_in_days: Integer,
      ?runtime_version: String,
      ?vpc_config: {
        subnet_ids: Array[String],
        security_group_ids: Array[String],
        ipv6_allowed_for_dual_stack: bool
      },
      ?resources_to_replicate_tags: Array[String],
      ?provisioned_resource_cleanup: String,
      ?browser_configs: Array[
        {
          browser_type: String
        }
      ],
      ?tags: Hash[String, String],
      ?artifact_config: {
        s3_encryption: {
          encryption_mode: String,
          kms_key_arn: String
        }
      }
    ) -> _CreateCanaryResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCanaryResponse

    interface _CreateGroupResponse
      include Smithy::Client::_Response[Types::CreateGroupResponse]
      def group: () -> Types::Group?
    end
    def create_group: (
      ?name: String,
      ?tags: Hash[String, String]
