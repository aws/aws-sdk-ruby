module Aws::MWAAServerless
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::MWAAServerless::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateWorkflowResponse
      include Smithy::Client::_Response[Types::CreateWorkflowResponse]
      def workflow_arn: () -> String?
      def created_at: () -> Time?
      def revision_id: () -> String?
      def workflow_status: () -> String?
      def workflow_version: () -> String?
      def is_latest_version: () -> bool?
      def warnings: () -> Array[String]?
    end
    def create_workflow: (
      ?name: String,
      ?client_token: String,
      ?definition_s3_location: {
        bucket: String,
        object_key: untyped,
        version_id: untyped
      },
      ?code: {
        s3_location: {
          bucket: String,
          object_key: untyped,
          version_id: untyped
        }
      },
      ?role_arn: String,
      ?description: String,
      ?encryption_configuration: {
        type: String,
        kms_key_id: String
      },
      ?logging_configuration: {
        log_group_name: String
      },
      ?engine_version: Integer,
      ?network_configuration: {
        security_group_ids: Array[String],
        subnet_ids: Array[String]
      },
      ?tags: Hash[String, String],
      ?trigger_mode: String
    ) -> _CreateWorkflowResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateWorkflowResponse

    interface _DeleteWorkflowResponse
      include Smithy::Client::_Response[Types::DeleteWorkflowResponse]
      def workflow_arn: () -> String?
      def workflow_version: () -> String?
    end
    def delete_workflow: (
      ?workflow_arn: String,
      ?workflow_version: String
    ) -> _DeleteWorkflowResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteWorkflowResponse

