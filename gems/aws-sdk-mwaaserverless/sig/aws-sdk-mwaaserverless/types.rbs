module Aws::MWAAServerless
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Code
      include Smithy::Schema::Union

      def initialize: (
        ?s3_location: Types::S3Location,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor s3_location: Types::S3Location?

      class S3Location < Code
      end
      class Unknown < Code
      end
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
    end

    class CreateWorkflowRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?client_token: String,
        ?definition_s3_location: Types::DefinitionS3Location,
        ?code: Types::Code,
        ?role_arn: String,
        ?description: String,
        ?encryption_configuration: Types::EncryptionConfiguration,
        ?logging_configuration: Types::LoggingConfiguration,
        ?engine_version: Integer,
        ?network_configuration: Types::NetworkConfiguration,
        ?tags: Hash[String, String],
        ?trigger_mode: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor client_token: String?
      attr_accessor definition_s3_location: Types::DefinitionS3Location?
      attr_accessor code: Types::Code?
      attr_accessor role_arn: String?
      attr_accessor description: String?
      attr_accessor encryption_configuration: Types::EncryptionConfiguration?
      attr_accessor logging_configuration: Types::LoggingConfiguration?
      attr_accessor engine_version: Integer?
      attr_accessor network_configuration: Types::NetworkConfiguration?
      attr_accessor tags: Hash[String, String]?
      attr_accessor trigger_mode: String?
    end

    class CreateWorkflowResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?workflow_arn: String,
