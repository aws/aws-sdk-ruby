    class VoiceCreationData
      attr_accessor recordings: ::Array[Types::Recording]
      SENSITIVE: []
    end

    class StartSpeechSynthesisStreamActionStream < Enumerator[untyped, untyped]
      def event_types: () -> [:text_event, :close_stream_event]
    end

    class StartSpeechSynthesisStreamEventStream < Enumerator[untyped, untyped]
      def event_types: () -> [:audio_event, :stream_closed_event, :validation_exception, :service_quota_exceeded_exception, :service_failure_exception, :throttling_exception]
    end
  end
