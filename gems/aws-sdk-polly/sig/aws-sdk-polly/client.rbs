module Aws::Polly
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Polly::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DeleteLexiconResponse
      include Smithy::Client::_Response[Types::DeleteLexiconOutput]
    end
    def delete_lexicon: (
      ?name: String
    ) -> _DeleteLexiconResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteLexiconResponse

    interface _DescribeVoicesResponse
      include Smithy::Client::_Response[Types::DescribeVoicesOutput]
      def voices: () -> Array[Types::Voice]?
      def next_token: () -> String?
    end
    def describe_voices: (
      ?engine: String,
      ?language_code: String,
      ?include_additional_language_codes: bool,
      ?next_token: String
    ) -> _DescribeVoicesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeVoicesResponse

    interface _GetLexiconResponse
      include Smithy::Client::_Response[Types::GetLexiconOutput]
      def lexicon: () -> Types::Lexicon?
      def lexicon_attributes: () -> Types::LexiconAttributes?
    end
    def get_lexicon: (
      ?name: String
    ) -> _GetLexiconResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetLexiconResponse

    interface _GetSpeechSynthesisTaskResponse
      include Smithy::Client::_Response[Types::GetSpeechSynthesisTaskOutput]
      def synthesis_task: () -> Types::SynthesisTask?
    end
    def get_speech_synthesis_task: (
      ?task_id: String
    ) -> _GetSpeechSynthesisTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSpeechSynthesisTaskResponse

    interface _ListLexiconsResponse
      include Smithy::Client::_Response[Types::ListLexiconsOutput]
      def lexicons: () -> Array[Types::LexiconDescription]?
      def next_token: () -> String?
    end
    def list_lexicons: (
      ?next_token: String
    ) -> _ListLexiconsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListLexiconsResponse

    interface _ListSpeechSynthesisTasksResponse
      include Smithy::Client::_Response[Types::ListSpeechSynthesisTasksOutput]
      def next_token: () -> String?
      def synthesis_tasks: () -> Array[Types::SynthesisTask]?
    end
    def list_speech_synthesis_tasks: (
      ?max_results: Integer,
      ?next_token: String,
      ?status: String
    ) -> _ListSpeechSynthesisTasksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSpeechSynthesisTasksResponse

    interface _PutLexiconResponse
      include Smithy::Client::_Response[Types::PutLexiconOutput]
    end
    def put_lexicon: (
      ?name: String,
      ?content: String
    ) -> _PutLexiconResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutLexiconResponse

    interface _StartSpeechSynthesisTaskResponse
      include Smithy::Client::_Response[Types::StartSpeechSynthesisTaskOutput]
      def synthesis_task: () -> Types::SynthesisTask?
    end
    def start_speech_synthesis_task: (
      ?engine: String,
      ?language_code: String,
      ?lexicon_names: Array[String],
      ?output_format: String,
      ?output_s3_bucket_name: String,
      ?output_s3_key_prefix: String,
      ?sample_rate: String,
      ?sns_topic_arn: String,
      ?speech_mark_types: Array[String],
      ?text: String,
      ?text_type: String,
      ?voice_id: String
    ) -> _StartSpeechSynthesisTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSpeechSynthesisTaskResponse

    interface _SynthesizeSpeechResponse
      include Smithy::Client::_Response[Types::SynthesizeSpeechOutput]
      def audio_stream: () -> String?
      def content_type: () -> String?
      def request_characters: () -> Integer?
    end
    def synthesize_speech: (
      ?engine: String,
      ?language_code: String,
      ?lexicon_names: Array[String],
      ?output_format: String,
      ?sample_rate: String,
      ?speech_mark_types: Array[String],
      ?text: String,
      ?text_type: String,
      ?voice_id: String
    ) -> _SynthesizeSpeechResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SynthesizeSpeechResponse
  end
end
