    class CallAnalyticsTranscriptResultStream
      include Smithy::Schema::Union

      def initialize: (
        ?utterance_event: Types::UtteranceEvent,
        ?category_event: Types::CategoryEvent,
        ?bad_request_exception: Types::BadRequestException,
        ?limit_exceeded_exception: Types::LimitExceededException,
        ?internal_failure_exception: Types::InternalFailureException,
        ?conflict_exception: Types::ConflictException,
        ?service_unavailable_exception: Types::ServiceUnavailableException,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor utterance_event: Types::UtteranceEvent?
      attr_accessor category_event: Types::CategoryEvent?
      attr_accessor bad_request_exception: Types::BadRequestException?
      attr_accessor limit_exceeded_exception: Types::LimitExceededException?
      attr_accessor internal_failure_exception: Types::InternalFailureException?
      attr_accessor conflict_exception: Types::ConflictException?
      attr_accessor service_unavailable_exception: Types::ServiceUnavailableException?

      class UtteranceEvent < CallAnalyticsTranscriptResultStream
      end
      class CategoryEvent < CallAnalyticsTranscriptResultStream
      end
      class BadRequestException < CallAnalyticsTranscriptResultStream
      end
      class LimitExceededException < CallAnalyticsTranscriptResultStream
      end
      class InternalFailureException < CallAnalyticsTranscriptResultStream
      end
      class ConflictException < CallAnalyticsTranscriptResultStream
      end
      class ServiceUnavailableException < CallAnalyticsTranscriptResultStream
      end
      class Unknown < CallAnalyticsTranscriptResultStream
      end
    end

