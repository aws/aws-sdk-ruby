module Aws::TranscribeStreaming
  module Types

    class Alternative
      include Smithy::Schema::Structure

      def initialize: (
        ?transcript: String,
        ?items: Array[Types::Item],
        ?entities: Array[Types::Entity],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor transcript: String?
      attr_accessor items: Array[Types::Item]?
      attr_accessor entities: Array[Types::Entity]?
    end

    class AudioEvent
      include Smithy::Schema::Structure

      def initialize: (
        ?audio_chunk: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor audio_chunk: String?
    end

    class AudioStream
      include Smithy::Schema::Union

      def initialize: (
        ?audio_event: Types::AudioEvent,
        ?configuration_event: Types::ConfigurationEvent,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor audio_event: Types::AudioEvent?
      attr_accessor configuration_event: Types::ConfigurationEvent?

      class AudioEvent < AudioStream
      end
      class ConfigurationEvent < AudioStream
      end
      class Unknown < AudioStream
      end
    end

    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class CallAnalyticsEntity
      include Smithy::Schema::Structure

      def initialize: (
        ?begin_offset_millis: Integer,
        ?end_offset_millis: Integer,
        ?category: String,
        ?type: String,
        ?content: String,
        ?confidence: Float,
      ) -> void
