{
  "version": "1.0",
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-aws-protocol-tests:1.56.0"
    ]
  },
  "projections": {
    "restJson": {
      "transforms": [
        {
          "name": "includeServices",
          "args": {
            "services": ["aws.protocoltests.restjson#RestJson"]
          }
        },
        {
          "name": "removeUnusedShapes"
        },
        {
          "name": "removeTraitDefinitions"
        }
      ]
    }
  }
}
