    "PathMatcherNumber": {
      "delay": 0,
      "operation": "WaiterOperation",
      "maxAttempts": 25,
      "acceptors": [
        {
          "matcher": "path",
          "expected": 3,
          "state": "success",
          "argument": "length(TableList)"
