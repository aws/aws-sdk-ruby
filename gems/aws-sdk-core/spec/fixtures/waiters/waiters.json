      "acceptors": [
        {
          "matcher": "pathAny",
          "expected": "ACTIVE",
          "state": "success",
          "argument": "TableList[].TableStatus"
        },
        {
          "matcher": "pathAny",
          "expected": "FAILED",
          "state": "failure",
          "argument": "TableList[].TableStatus"
        },
        {
          "matcher": "pathAny",
          "expected": "UPDATING",
          "state": "retry",
          "argument": "TableList[].TableStatus"
        }
      ]
    },
    "PathAnyMatcherObject": {
      "delay": 0,
      "operation": "WaiterOperation",
