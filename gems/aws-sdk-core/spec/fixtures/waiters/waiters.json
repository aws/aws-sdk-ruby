          "expected": "FAILED",
          "state": "failure",
          "argument": "Table.TableStatus"
        },
        {
          "matcher": "path",
          "expected": "UPDATING",
          "state": "retry",
          "argument": "Table.TableStatus"
        }
      ]
    },
    "PathMatcherObject": {
      "delay": 0,
