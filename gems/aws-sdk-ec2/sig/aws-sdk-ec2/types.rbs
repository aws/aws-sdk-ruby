      include Smithy::Schema::Structure

      def initialize: (
        ?cidr: String,
        ?dry_run: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor cidr: String?
      attr_accessor dry_run: bool?
    end

    class WithdrawByoipCidrResult
      include Smithy::Schema::Structure

      def initialize: (
