      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor byoip_cidr: Types::ByoipCidr?
    end

    module Scope
      AVAILABILITY_ZONE: String
      REGIONAL: String
    end
  end
end
