      def message: () -> String?
    end
    class ServiceUnavailableException < Smithy::Client::ServiceError
      def message: () -> String?
      def retryable?: () -> true
    end
    class TooManyRequestException < Smithy::Client::ServiceError
      def message: () -> String?
