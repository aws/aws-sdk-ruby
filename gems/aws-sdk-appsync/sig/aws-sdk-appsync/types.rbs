module Aws::AppSync
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AdditionalAuthenticationProvider
      include Smithy::Schema::Structure

      def initialize: (
        ?authentication_type: String,
        ?open_id_connect_config: Types::OpenIDConnectConfig,
        ?user_pool_config: Types::CognitoUserPoolConfig,
        ?lambda_authorizer_config: Types::LambdaAuthorizerConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor authentication_type: String?
      attr_accessor open_id_connect_config: Types::OpenIDConnectConfig?
      attr_accessor user_pool_config: Types::CognitoUserPoolConfig?
      attr_accessor lambda_authorizer_config: Types::LambdaAuthorizerConfig?
    end

    class Api
      include Smithy::Schema::Structure

      def initialize: (
        ?api_id: String,
