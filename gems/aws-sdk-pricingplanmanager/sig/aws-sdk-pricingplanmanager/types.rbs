    class Subscription
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?plan_family: String,
        ?plan_tier: String,
        ?usage_level: String,
        ?scheduled_change: Types::ScheduledChange,
        ?status: String,
