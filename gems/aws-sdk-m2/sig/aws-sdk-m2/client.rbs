        s3_location: String,
        data_sets: Array[
          {
            data_set: {
              storage_type: String,
              dataset_name: untyped,
              dataset_org: {
                vsam: {
                  format: untyped,
                  encoding: untyped,
                  compressed: bool,
                  primary_key: {
                    name: untyped,
                    offset: Integer,
                    length: untyped
                  },
                  alternate_keys: Array[
                    {
                      name: untyped,
                      offset: untyped,
                      length: untyped,
                      allow_duplicates: untyped
                    }
                  ]
                },
                gdg: {
                  limit: untyped,
                  roll_disposition: untyped
                },
                po: {
                  format: untyped,
                  encoding: untyped,
                  member_file_extensions: Array[String]
                },
                ps: {
                  format: untyped,
                  encoding: untyped
                }
              },
              relative_path: untyped,
              record_length: {
                min: untyped,
                max: untyped
              }
            },
            external_location: {
              s3_location: untyped
            }
          }
        ]
      },
      ?client_token: String
    ) -> _CreateDataSetImportTaskResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateDataSetImportTaskResponse

