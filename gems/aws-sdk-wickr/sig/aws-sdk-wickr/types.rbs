    class BadRequestError
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class BasicDeviceObject
      include Smithy::Schema::Structure

      def initialize: (
        ?app_id: String,
        ?created: String,
        ?last_login: String,
        ?status_text: String,
