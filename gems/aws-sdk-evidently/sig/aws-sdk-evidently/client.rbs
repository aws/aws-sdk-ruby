    end
    def create_launch: (
      ?project: String,
      ?name: String,
      ?description: String,
      ?scheduled_splits_config: {
        steps: Array[
          {
            start_time: Time,
            group_weights: Hash[String, Integer],
            segment_overrides: Array[
              {
                segment: String,
                evaluation_order: Integer,
                weights: untyped
              }
            ]
          }
        ]
      },
      ?metric_monitors: Array[
        {
          metric_definition: {
            name: String,
            entity_id_key: String,
            value_key: untyped,
            event_pattern: String,
            unit_label: String
          }
        }
      ],
      ?groups: Array[
        {
          name: String,
          description: String,
          feature: String,
          variation: String
        }
      ],
      ?randomization_salt: String,
      ?tags: Hash[String, String]
    ) -> _CreateLaunchResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateLaunchResponse

