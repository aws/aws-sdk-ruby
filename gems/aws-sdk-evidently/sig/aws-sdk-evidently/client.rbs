module Aws::Evidently
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Evidently::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchEvaluateFeatureResponse
      include Smithy::Client::_Response[Types::BatchEvaluateFeatureOutput]
      def results: () -> Array[Types::EvaluationResult]?
    end
    def batch_evaluate_feature: (
      ?project: String,
      ?requests: Array[
        {
          feature: String,
          entity_id: String,
          evaluation_context: String
        }
      ]
    ) -> _BatchEvaluateFeatureResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchEvaluateFeatureResponse

    interface _CreateExperimentResponse
      include Smithy::Client::_Response[Types::CreateExperimentOutput]
      def experiment: () -> Types::Experiment?
    end
    def create_experiment: (
      ?project: String,
      ?name: String,
      ?description: String,
      ?treatments: Array[
        {
          name: String,
          description: String,
          feature: String,
          variation: String
        }
      ],
      ?metric_goals: Array[
        {
          metric_definition: {
            name: String,
            entity_id_key: String,
            value_key: untyped,
            event_pattern: String,
            unit_label: String
          },
          desired_change: String
        }
      ],
      ?randomization_salt: String,
      ?sampling_rate: Integer,
      ?online_ab_config: {
        control_treatment_name: String,
        treatment_weights: Hash[String, Integer]
      },
      ?segment: String,
      ?tags: Hash[String, String]
    ) -> _CreateExperimentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateExperimentResponse

    interface _CreateFeatureResponse
      include Smithy::Client::_Response[Types::CreateFeatureOutput]
      def feature: () -> Types::Feature?
    end
    def create_feature: (
      ?project: String,
      ?name: String,
      ?evaluation_strategy: String,
      ?description: String,
      ?variations: Array[
        {
          name: String,
          value: {
            bool_value: bool,
            string_value: String,
            long_value: Integer,
            double_value: Float
          }
        }
      ],
      ?default_variation: String,
      ?tags: Hash[String, String],
      ?entity_overrides: Hash[String, String]
    ) -> _CreateFeatureResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateFeatureResponse

    interface _CreateLaunchResponse
      include Smithy::Client::_Response[Types::CreateLaunchOutput]
