    interface _ListDeploymentsResponse
      include Smithy::Client::_Response[Types::ListDeploymentsOutput]
      def deployments: () -> Array[Types::DeploymentDataSummary]?
      def next_token: () -> String?
    end
    def list_deployments: (
      ?filters: Array[
        {
          name: String,
          values: Array[String]
        }
      ],
