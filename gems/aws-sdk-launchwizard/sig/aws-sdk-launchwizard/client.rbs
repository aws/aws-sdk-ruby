      def status_reason: () -> String?
    end
    def delete_deployment: (
      ?deployment_id: String
    ) -> _DeleteDeploymentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteDeploymentResponse

    interface _GetDeploymentResponse
      include Smithy::Client::_Response[Types::GetDeploymentOutput]
