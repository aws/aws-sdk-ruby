      attr_accessor allowed_values: Array[String]?
      attr_accessor required: String?
      attr_accessor conditionals: Array[Types::DeploymentConditionalField]?
    end

    module DeploymentStatus
      COMPLETED: String
      CREATING: String
      DELETE_IN_PROGRESS: String
      DELETE_INITIATING: String
      DELETE_FAILED: String
      DELETED: String
      FAILED: String
      IN_PROGRESS: String
      VALIDATING: String
      UPDATE_IN_PROGRESS: String
      UPDATE_COMPLETED: String
      UPDATE_FAILED: String
      UPDATE_ROLLBACK_COMPLETED: String
      UPDATE_ROLLBACK_FAILED: String
    end

    module EventStatus
      CANCELED: String
      CANCELING: String
      COMPLETED: String
      CREATED: String
      FAILED: String
      IN_PROGRESS: String
      PENDING: String
      TIMED_OUT: String
    end

