      ?perform_auto_training: bool,
      ?recipe_arn: String,
      ?dataset_group_arn: String,
      ?event_type: String,
      ?solution_config: {
        event_value_threshold: String,
        hpo_config: {
          hpo_objective: {
            type: String,
            metric_name: String,
            metric_regex: String
          },
          hpo_resource_config: {
            max_number_of_training_jobs: String,
            max_parallel_training_jobs: untyped
          },
          algorithm_hyper_parameter_ranges: {
            integer_hyper_parameter_ranges: Array[
              {
                name: String,
                min_value: Integer,
                max_value: Integer
              }
            ],
            continuous_hyper_parameter_ranges: Array[
              {
                name: untyped,
                min_value: Float,
                max_value: Float
              }
            ],
            categorical_hyper_parameter_ranges: Array[
              {
                name: untyped,
                values: Array[String]
              }
            ]
          }
        },
        algorithm_hyper_parameters: Hash[String, String],
        feature_transformation_parameters: Hash[String, String],
        auto_ml_config: {
          metric_name: untyped,
          recipe_list: Array[String]
        },
        events_config: {
          event_parameters_list: Array[
            {
              event_type: String,
              event_value_threshold: Float,
              weight: Float
            }
          ]
        },
        optimization_objective: {
          item_attribute: String,
          objective_sensitivity: String
        },
        training_data_config: {
          excluded_dataset_columns: Hash[String,
            Array[String]
          ]
        },
        auto_training_config: {
          scheduling_expression: String
        }
      },
      ?tags: Array[
        {
          tag_key: String,
          tag_value: String
        }
      ]
    ) -> _CreateSolutionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateSolutionResponse

