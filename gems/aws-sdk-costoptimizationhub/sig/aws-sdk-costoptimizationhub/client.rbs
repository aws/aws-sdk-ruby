    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetPreferencesResponse
      include Smithy::Client::_Response[Types::GetPreferencesResponse]
      def savings_estimation_mode: () -> String?
      def member_account_discount_visibility: () -> String?
      def preferred_commitment: () -> Types::PreferredCommitment?
    end
    def get_preferences: (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPreferencesResponse

    interface _GetRecommendationResponse
      include Smithy::Client::_Response[Types::GetRecommendationResponse]
      def recommendation_id: () -> String?
      def resource_id: () -> String?
      def resource_arn: () -> String?
      def account_id: () -> String?
      def currency_code: () -> String?
      def recommendation_lookback_period_in_days: () -> Integer?
      def cost_calculation_lookback_period_in_days: () -> Integer?
