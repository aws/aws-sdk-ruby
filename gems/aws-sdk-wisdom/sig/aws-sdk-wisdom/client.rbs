    end
    def create_knowledge_base: (
      ?client_token: String,
      ?name: String,
      ?knowledge_base_type: String,
      ?source_configuration: {
        app_integrations: {
          app_integration_arn: String,
          object_fields: Array[String]
        }
      },
      ?rendering_configuration: {
        template_uri: String
      },
      ?server_side_encryption_configuration: {
        kms_key_id: String
      },
      ?description: String,
      ?tags: Hash[String, String]
    ) -> _CreateKnowledgeBaseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateKnowledgeBaseResponse

    interface _CreateQuickResponseResponse
      include Smithy::Client::_Response[Types::CreateQuickResponseResponse]
