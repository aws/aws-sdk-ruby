module Aws::Wisdom
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Wisdom::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateAssistantResponse
      include Smithy::Client::_Response[Types::CreateAssistantOutput]
      def assistant: () -> Types::AssistantData?
    end
    def create_assistant: (
      ?client_token: String,
      ?name: String,
      ?type: String,
      ?description: String,
      ?tags: Hash[String, String],
      ?server_side_encryption_configuration: {
        kms_key_id: String
      }
    ) -> _CreateAssistantResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateAssistantResponse

    interface _CreateAssistantAssociationResponse
      include Smithy::Client::_Response[Types::CreateAssistantAssociationOutput]
      def assistant_association: () -> Types::AssistantAssociationData?
    end
    def create_assistant_association: (
      ?assistant_id: String,
      ?association_type: String,
      ?association: {
        knowledge_base_id: String
      },
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateAssistantAssociationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateAssistantAssociationResponse

    interface _CreateContentResponse
      include Smithy::Client::_Response[Types::CreateContentOutput]
      def content: () -> Types::ContentData?
    end
    def create_content: (
      ?knowledge_base_id: String,
      ?name: String,
