    ) -> _CreateContentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateContentResponse

    interface _CreateKnowledgeBaseResponse
      include Smithy::Client::_Response[Types::CreateKnowledgeBaseOutput]
