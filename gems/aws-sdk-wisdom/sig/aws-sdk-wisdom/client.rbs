      ?knowledge_base_id: String,
      ?name: String,
      ?content: {
        content: String
      },
      ?content_type: String,
      ?grouping_configuration: {
        criteria: String,
        values: Array[String]
      },
      ?description: String,
      ?shortcut_key: String,
      ?is_active: bool,
      ?channels: Array[String],
      ?language: String,
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateQuickResponseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateQuickResponseResponse

