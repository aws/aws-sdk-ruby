    interface _SearchContentResponse
      include Smithy::Client::_Response[Types::SearchContentOutput]
      def content_summaries: () -> Array[Types::ContentSummary]?
      def next_token: () -> String?
    end
    def search_content: (
      ?next_token: String,
      ?max_results: Integer,
      ?knowledge_base_id: String,
      ?search_expression: {
        filters: Array[
          {
            field: String,
            operator: String,
            value: String
          }
        ]
      }
    ) -> _SearchContentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchContentResponse

    interface _SearchQuickResponsesResponse
      include Smithy::Client::_Response[Types::SearchQuickResponsesResponse]
      def results: () -> Array[Types::QuickResponseSearchResultData]?
      def next_token: () -> String?
    end
    def search_quick_responses: (
      ?knowledge_base_id: String,
      ?search_expression: {
        queries: Array[
          {
            name: String,
            values: Array[String],
            operator: String,
            allow_fuzziness: bool,
            priority: String
          }
        ],
        filters: Array[
          {
            name: untyped,
            values: Array[String],
            operator: String,
            include_no_existence: untyped
          }
        ],
        order_on_field: {
          name: untyped,
          order: String
        }
      },
      ?next_token: String,
      ?max_results: Integer,
      ?attributes: Hash[String, String]
    ) -> _SearchQuickResponsesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchQuickResponsesResponse

