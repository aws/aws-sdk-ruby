module Aws::SimSpaceWeaver
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SimSpaceWeaver::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateSnapshotResponse
      include Smithy::Client::_Response[Types::CreateSnapshotOutput]
    end
    def create_snapshot: (
      ?simulation: String,
      ?destination: {
        bucket_name: String,
        object_key_prefix: String
      }
    ) -> _CreateSnapshotResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateSnapshotResponse

    interface _DeleteAppResponse
      include Smithy::Client::_Response[Types::DeleteAppOperationOutput]
    end
    def delete_app: (
      ?simulation: String,
      ?domain: String,
      ?app: String
    ) -> _DeleteAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteAppResponse

    interface _DeleteSimulationResponse
      include Smithy::Client::_Response[Types::DeleteSimulationOperationOutput]
    end
    def delete_simulation: (
      ?simulation: String
    ) -> _DeleteSimulationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSimulationResponse

    interface _DescribeAppResponse
      include Smithy::Client::_Response[Types::DescribeAppOperationOutput]
      def name: () -> String?
      def simulation: () -> String?
      def domain: () -> String?
      def status: () -> String?
      def target_status: () -> String?
      def launch_overrides: () -> Types::LaunchOverrides?
      def description: () -> String?
      def endpoint_info: () -> Types::SimulationAppEndpointInfo?
    end
    def describe_app: (
      ?simulation: String,
      ?domain: String,
      ?app: String
    ) -> _DescribeAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeAppResponse

    interface _DescribeSimulationResponse
      include Smithy::Client::_Response[Types::DescribeSimulationOperationOutput]
      def name: () -> String?
      def execution_id: () -> String?
      def arn: () -> String?
      def description: () -> String?
      def role_arn: () -> String?
      def creation_time: () -> Time?
      def status: () -> String?
      def target_status: () -> String?
      def schema_s3_location: () -> Types::S3Location?
      def schema_error: () -> String?
      def logging_configuration: () -> Types::LoggingConfiguration?
      def live_simulation_state: () -> Types::LiveSimulationState?
      def maximum_duration: () -> String?
      def snapshot_s3_location: () -> Types::S3Location?
      def start_error: () -> String?
    end
    def describe_simulation: (
      ?simulation: String
    ) -> _DescribeSimulationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeSimulationResponse

    interface _ListAppsResponse
      include Smithy::Client::_Response[Types::ListAppsOperationOutput]
      def apps: () -> Array[Types::SimulationAppMetadata]?
      def next_token: () -> String?
    end
    def list_apps: (
      ?simulation: String,
      ?domain: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListAppsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListAppsResponse

    interface _ListSimulationsResponse
      include Smithy::Client::_Response[Types::ListSimulationsOperationOutput]
      def simulations: () -> Array[Types::SimulationMetadata]?
      def next_token: () -> String?
    end
    def list_simulations: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListSimulationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSimulationsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOperationOutput]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _StartAppResponse
      include Smithy::Client::_Response[Types::StartAppOperationOutput]
      def name: () -> String?
      def domain: () -> String?
      def simulation: () -> String?
    end
    def start_app: (
      ?client_token: String,
      ?simulation: String,
      ?domain: String,
      ?name: String,
      ?description: String,
      ?launch_overrides: {
        launch_commands: Array[String]
      }
    ) -> _StartAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartAppResponse

    interface _StartClockResponse
      include Smithy::Client::_Response[Types::StartClockOperationOutput]
    end
    def start_clock: (
      ?simulation: String
    ) -> _StartClockResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartClockResponse

    interface _StartSimulationResponse
      include Smithy::Client::_Response[Types::StartSimulationOperationOutput]
      def arn: () -> String?
      def execution_id: () -> String?
      def creation_time: () -> Time?
    end
    def start_simulation: (
      ?client_token: String,
      ?name: String,
      ?description: String,
      ?role_arn: String,
      ?schema_s3_location: {
        bucket_name: String,
        object_key: String
      },
      ?maximum_duration: String,
      ?tags: Hash[String, String],
      ?snapshot_s3_location: {
        bucket_name: String,
        object_key: String
      }
    ) -> _StartSimulationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSimulationResponse

    interface _StopAppResponse
      include Smithy::Client::_Response[Types::StopAppOperationOutput]
    end
    def stop_app: (
      ?simulation: String,
      ?domain: String,
      ?app: String
    ) -> _StopAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StopAppResponse

    interface _StopClockResponse
      include Smithy::Client::_Response[Types::StopClockOperationOutput]
    end
    def stop_clock: (
      ?simulation: String
    ) -> _StopClockResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StopClockResponse

    interface _StopSimulationResponse
      include Smithy::Client::_Response[Types::StopSimulationOperationOutput]
    end
    def stop_simulation: (
      ?simulation: String
    ) -> _StopSimulationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StopSimulationResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceOperationOutput]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceOperationOutput]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
  end
end
