      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _InvokeEndpointWithBidirectionalStreamResponse
      include Smithy::Client::_Response[Types::InvokeEndpointWithBidirectionalStreamOutput]
      def body: () -> Types::ResponseStreamEvent?
      def invoked_production_variant: () -> String?
    end
    def invoke_endpoint_with_bidirectional_stream: (
      ?endpoint_name: String,
      ?body: {
        payload_part: {
          bytes: String,
          data_type: String,
          completion_state: untyped,
          p: untyped
        }
      },
      ?target_variant: String,
      ?model_invocation_path: String,
      ?model_query_string: String
    ) -> _InvokeEndpointWithBidirectionalStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InvokeEndpointWithBidirectionalStreamResponse
