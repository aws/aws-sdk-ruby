    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?class_name: String,
        ?code: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor class_name: String?
      attr_accessor code: Integer?
    end

