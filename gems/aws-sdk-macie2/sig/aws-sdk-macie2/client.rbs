    def create_classification_job: (
      ?allow_list_ids: Array[String],
      ?client_token: String,
      ?custom_data_identifier_ids: Array[String],
      ?description: String,
      ?initial_run: bool,
      ?job_type: String,
      ?managed_data_identifier_ids: Array[String],
      ?managed_data_identifier_selector: String,
      ?name: String,
      ?s3_job_definition: {
        bucket_criteria: {
          excludes: {
            and: Array[
              {
                simple_criterion: {
                  comparator: String,
                  key: String,
                  values: Array[String]
                },
                tag_criterion: {
                  comparator: untyped,
                  tag_values: Array[
                    {
                      key: String,
                      value: untyped
                    }
                  ]
                }
              }
            ]
          },
          includes: untyped
        },
        bucket_definitions: Array[
          {
            account_id: untyped,
            buckets: untyped
          }
        ],
        scoping: {
          excludes: {
            and: Array[
              {
                simple_scope_term: {
                  comparator: untyped,
                  key: String,
                  values: untyped
                },
                tag_scope_term: {
                  comparator: untyped,
                  key: untyped,
                  tag_values: Array[
                    {
                      key: untyped,
                      value: untyped
                    }
                  ],
                  target: String
                }
              }
            ]
          },
          includes: untyped
        }
      },
      ?sampling_percentage: Integer,
      ?schedule_frequency: {
        daily_schedule: {
        },
        monthly_schedule: {
          day_of_month: Integer
        },
        weekly_schedule: {
          day_of_week: String
        }
      },
      ?tags: Hash[String, String]
    ) -> _CreateClassificationJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateClassificationJobResponse

