module Aws::Glue
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Action
      include Smithy::Schema::Structure

      def initialize: (
        ?job_name: String,
        ?arguments: Hash[String, String],
        ?timeout: Integer,
        ?security_configuration: String,
        ?notification_property: Types::NotificationProperty,
        ?crawler_name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor job_name: String?
      attr_accessor arguments: Hash[String, String]?
      attr_accessor timeout: Integer?
      attr_accessor security_configuration: String?
      attr_accessor notification_property: Types::NotificationProperty?
      attr_accessor crawler_name: String?
    end

    module AdditionalOptionKeys
      CacheOption: String
      ObservationsOption: String
      CompositeOption: String
    end

    module AggFunction
      avg: String
      countDistinct: String
      count: String
      first: String
      last: String
      kurtosis: String
      max: String
      min: String
      skewness: String
      stddev_samp: String
      stddev_pop: String
      sum: String
      sumDistinct: String
      var_samp: String
      var_pop: String
    end

    class Aggregate
      include Smithy::Schema::Structure

