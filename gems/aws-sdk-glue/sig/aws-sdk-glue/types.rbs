        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ViewDefinition
      include Smithy::Schema::Structure

      def initialize: (
        ?is_protected: bool,
        ?definer: String,
