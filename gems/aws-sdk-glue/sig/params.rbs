        name: ::String,
        inputs: Array[::String],
        database: ::String,
        table: ::String
      }?,
      oracle_sql_catalog_target: {
        name: ::String,
        inputs: Array[::String],
        database: ::String,
        table: ::String
      }?,
      postgre_sql_catalog_target: {
        name: ::String,
        inputs: Array[::String],
        database: ::String,
        table: ::String
      }?,
      route: Params::route?,
      dynamic_transform: Params::dynamic_transform?,
      evaluate_data_quality: Params::evaluate_data_quality?,
      s3_catalog_hudi_source: Params::s3_catalog_hudi_source?,
      catalog_hudi_source: Params::catalog_hudi_source?,
      s3_hudi_source: Params::s3_hudi_source?,
      s3_hudi_catalog_target: Params::s3_hudi_catalog_target?,
      s3_hudi_direct_target: Params::s3_hudi_direct_target?,
      direct_jdbc_source: Params::direct_jdbc_source?,
      s3_catalog_delta_source: Params::s3_catalog_delta_source?,
      catalog_delta_source: Params::catalog_delta_source?,
      s3_delta_source: Params::s3_delta_source?,
      s3_delta_catalog_target: Params::s3_delta_catalog_target?,
      s3_delta_direct_target: Params::s3_delta_direct_target?,
      amazon_redshift_source: Params::amazon_redshift_source?,
      amazon_redshift_target: Params::amazon_redshift_target?,
      evaluate_data_quality_multi_frame: Params::evaluate_data_quality_multi_frame?,
      recipe: Params::recipe?,
      snowflake_source: Params::snowflake_source?,
      snowflake_target: Params::snowflake_target?,
      connector_data_source: Params::connector_data_source?,
      connector_data_target: {
        name: ::String,
        connection_type: ::String,
        data: Hash[::String, ::String],
        inputs: Array[::String]?
      }?,
      s3_catalog_iceberg_source: Params::s3_catalog_iceberg_source?,
      catalog_iceberg_source: Params::catalog_iceberg_source?,
      s3_iceberg_catalog_target: Params::s3_iceberg_catalog_target?,
      s3_iceberg_direct_target: Params::s3_iceberg_direct_target?,
      s3_excel_source: Params::s3_excel_source?,
      s3_hyper_direct_target: Params::s3_hyper_direct_target?,
      dynamo_dbelt_connector_source: Params::dynamo_dbelt_connector_source?
    }

      type mapping = {
      to_key: ::String?,
      from_path: Array[::String]?,
      from_type: ::String?,
      to_type: ::String?,
      dropped: bool?,
      children: Array[
        {
          to_key: ::String?,
          from_path: Array[::String]?,
          from_type: ::String?,
          to_type: ::String?,
          dropped: bool?,
          children: untyped?
        }
      ]?
    }

      type filter_expression = {
      operation: ("EQ" | "LT" | "GT" | "LTE" | "GTE" | "REGEX" | "ISNULL"),
      negated: bool?,
      values: Array[
        {
          type: ("COLUMNEXTRACTED" | "CONSTANT"),
          value: Array[::String]
        }
      ]
    }

      type group_filters = {
      group_name: ::String,
      filters: Array[
        Params::filter_expression
      ],
      logical_operator: ("AND" | "OR")
    }

      type transform_config_parameter = {
      name: ::String,
      type: ("str" | "int" | "float" | "complex" | "bool" | "list" | "null"),
      validation_rule: ::String?,
      validation_message: ::String?,
      value: Array[::String]?,
      list_type: ("str" | "int" | "float" | "complex" | "bool" | "list" | "null")?,
      is_optional: bool?
    }

      type recipe_step = {
      action: {
        operation: ::String,
        parameters: Hash[::String, ::String]?
      },
      condition_expressions: Array[
        {
          condition: ::String,
          value: ::String?,
          target_column: ::String
        }
      ]?
    }

      type source_control_details = {
      provider: ("GITHUB" | "GITLAB" | "BITBUCKET" | "AWS_CODE_COMMIT")?,
      repository: ::String?,
      owner: ::String?,
      branch: ::String?,
      folder: ::String?,
      last_commit_id: ::String?,
      auth_strategy: ("PERSONAL_ACCESS_TOKEN" | "AWS_SECRETS_MANAGER")?,
      auth_token: ::String?
    }

      type transform_parameters = {
      transform_type: ("FIND_MATCHES"),
      find_matches_parameters: {
        primary_key_column_name: ::String?,
        precision_recall_tradeoff: ::Float?,
        accuracy_cost_tradeoff: ::Float?,
        enforce_provided_labels: bool?
      }?
    }

      type view_definition_input = {
      is_protected: bool?,
      definer: ::String?,
      representations: Array[
        {
          dialect: ("REDSHIFT" | "ATHENA" | "SPARK")?,
          dialect_version: ::String?,
          view_original_text: ::String?,
          validation_connection: ::String?,
          view_expanded_text: ::String?
        }
      ]?,
      view_version_id: ::Integer?,
      view_version_token: ::String?,
      refresh_seconds: ::Integer?,
      last_refresh_type: ("FULL" | "INCREMENTAL")?,
      sub_objects: Array[::String]?,
      sub_object_version_ids: Array[::Integer]?
    }

      type table_input = {
      name: ::String,
      description: ::String?,
      owner: ::String?,
      last_access_time: ::Time?,
      last_analyzed_time: ::Time?,
      retention: ::Integer?,
      storage_descriptor: Params::storage_descriptor?,
      partition_keys: Array[
        {
          name: ::String,
          type: ::String?,
          comment: ::String?,
          parameters: Hash[::String, ::String]?
        }
      ]?,
      view_original_text: ::String?,
      view_expanded_text: ::String?,
      table_type: ::String?,
      parameters: Hash[::String, ::String]?,
      target_table: {
        catalog_id: ::String?,
        database_name: ::String?,
        name: ::String?,
        region: ::String?
      }?,
      view_definition: Params::view_definition_input?
    }

      type iceberg_schema = {
      schema_id: ::Integer?,
      identifier_field_ids: Array[::Integer]?,
      type: ("struct")?,
      fields: Array[
        Params::iceberg_struct_field
      ]
    }

      type iceberg_struct_field = {
      id: ::Integer,
      name: ::String,
      type: {
      },
      required: bool,
      doc: ::String?,
      initial_default: {
      }?,
      write_default: {
      }?
    }

      type iceberg_partition_spec = {
      fields: Array[
        {
          source_id: ::Integer,
          transform: ::String,
          name: ::String,
          field_id: ::Integer?
        }
      ],
      spec_id: ::Integer?
    }

      type iceberg_sort_order = {
      order_id: ::Integer,
      fields: Array[
        {
          source_id: ::Integer,
          transform: ::String,
          direction: ("asc" | "desc"),
          null_order: ("nulls-first" | "nulls-last")
        }
      ]
    }

      type retention_configuration = {
      iceberg_configuration: {
        snapshot_retention_period_in_days: ::Integer?,
        number_of_snapshots_to_retain: ::Integer?,
        clean_expired_files: bool?,
        run_rate_in_hours: ::Integer?
      }?
    }

      type table_optimizer_configuration = {
      role_arn: ::String?,
      enabled: bool?,
      vpc_configuration: {
        glue_connection_name: ::String?
      }?,
      compaction_configuration: {
        iceberg_configuration: {
          strategy: ("binpack" | "sort" | "z-order")?,
          min_input_files: ::Integer?,
          delete_file_threshold: ::Integer?
        }?
      }?,
      retention_configuration: Params::retention_configuration?,
      orphan_file_deletion_configuration: {
        iceberg_configuration: {
          orphan_file_retention_period_in_days: ::Integer?,
          location: ::String?,
          run_rate_in_hours: ::Integer?
        }?
      }?
    }

      type predicate = {
      logical: ("AND" | "ANY")?,
      conditions: Array[
        {
          logical_operator: ("EQUALS")?,
          job_name: ::String?,
          state: ("STARTING" | "RUNNING" | "STOPPING" | "STOPPED" | "SUCCEEDED" | "FAILED" | "TIMEOUT" | "ERROR" | "WAITING" | "EXPIRED")?,
          crawler_name: ::String?,
          crawl_state: ("RUNNING" | "CANCELLING" | "CANCELLED" | "SUCCEEDED" | "FAILED" | "ERROR")?
        }
      ]?
    }

      type action = {
      job_name: ::String?,
      arguments: Hash[::String, ::String]?,
      timeout: ::Integer?,
      security_configuration: ::String?,
      notification_property: {
        notify_delay_after: ::Integer?
      }?,
      crawler_name: ::String?
    }

      type profile_configuration = {
      session_configuration: Hash[::String, {
          default_value: ::String?,
          allowed_values: Array[::String]?,
          min_value: ::String?,
          max_value: ::String?
        }]?,
      job_configuration: Hash[::String, {
          default_value: ::String?,
          allowed_values: Array[::String]?,
          min_value: ::String?,
          max_value: ::String?
        }]?
    }

      type user_defined_function_input = {
      function_name: ::String?,
      class_name: ::String?,
      owner_name: ::String?,
      function_type: ("REGULAR_FUNCTION" | "AGGREGATE_FUNCTION" | "STORED_PROCEDURE")?,
      owner_type: ("USER" | "ROLE" | "GROUP")?,
      resource_uris: Array[
        {
          resource_type: ("JAR" | "FILE" | "ARCHIVE")?,
          uri: ::String?
        }
      ]?
    }

      type transform_filter_criteria = {
      name: ::String?,
      transform_type: ("FIND_MATCHES")?,
      status: ("NOT_READY" | "READY" | "DELETING")?,
      glue_version: ::String?,
      created_before: ::Time?,
      created_after: ::Time?,
      last_modified_before: ::Time?,
      last_modified_after: ::Time?,
      schema: Array[
        {
          name: ::String?,
          data_type: ::String?
        }
      ]?
    }

      type location = {
      jdbc: Array[
        {
          name: ::String,
          value: ::String,
          param: bool?
        }
      ]?,
      s3: Array[
        {
          name: ::String,
          value: ::String,
          param: bool?
        }
      ]?,
      dynamo_db: Array[
        {
          name: ::String,
          value: ::String,
          param: bool?
        }
      ]?
    }

      type data_quality_glue_table = {
      database_name: ::String,
      table_name: ::String,
      catalog_id: ::String?,
      connection_name: ::String?,
      additional_options: Hash[::String, ::String]?,
      pre_processing_query: ::String?
    }

      type data_source = {
      glue_table: {
        database_name: ::String,
        table_name: ::String,
        catalog_id: ::String?,
        connection_name: ::String?,
        additional_options: Hash[::String, ::String]?
      }?,
      data_quality_glue_table: Params::data_quality_glue_table?
    }

      type connector_property = {
      name: ::String,
      key_override: ::String?,
      required: bool,
      default_value: ::String?,
      allowed_values: Array[::String]?,
      property_location: ("HEADER" | "BODY" | "QUERY_PARAM" | "PATH")?,
      property_type: ("USER_INPUT" | "SECRET" | "READ_ONLY" | "UNUSED" | "SECRET_OR_USER_INPUT"),
      format: ::String?
    }

      type extracted_parameter = {
      key: ::String?,
      default_value: ::String?,
      property_location: ("HEADER" | "BODY" | "QUERY_PARAM" | "PATH")?,
      value: {
        content_path: ::String?,
        header_key: ::String?
      }?
    }

      type cursor_configuration = {
      next_page: Params::extracted_parameter,
      limit_parameter: Params::extracted_parameter?
    }

      type offset_configuration = {
      offset_parameter: Params::extracted_parameter,
      limit_parameter: Params::extracted_parameter
    }

      type pagination_configuration = {
      cursor_configuration: Params::cursor_configuration?,
      offset_configuration: Params::offset_configuration?
    }

      type filter_configuration = {
      filter_mode: ("QUERY_PARAMS" | "FILTER_STRING"),
      operator_mappings: Hash[::String, ::String]?,
      date_time_format: ::String?,
      strip_quotes: bool?,
      between_configuration: {
        low_bound_key: ::String?,
        high_bound_key: ::String?,
        template: ::String?
      }?,
      filter_string_configuration: {
        query_parameter_name: ::String,
        quote_string_values: bool?,
        quote_character: ::String?
      }?
    }

      type source_configuration = {
      request_method: ("GET" | "POST")?,
      request_path: ::String?,
      request_parameters: Array[
        Params::connector_property
      ]?,
      response_configuration: {
        result_path: ::String,
        error_path: ::String?
      }?,
      pagination_configuration: Params::pagination_configuration?,
      filter_configuration: Params::filter_configuration?
    }

      type search_filter_clause = {
      and_all_filters: Array[
        {
          and_all_filters: untyped?,
          or_any_filters: untyped?,
          attribute_filter: {
            attribute: ::String,
            operator: ("equals" | "greaterThan" | "greaterThanOrEquals" | "lessThan" | "lessThanOrEquals" | "notExists"),
            value: {
              string_value: ::String?,
              long_value: ::Integer?
            }?
          }?,
          map_filter: {
            attribute: ::String,
            key: ::String,
            value: {
              string_value: ::String?
            }
          }?
        }
      ]?,
      or_any_filters: Array[
        {
          and_all_filters: untyped?,
          or_any_filters: untyped?,
          attribute_filter: {
            attribute: ::String,
            operator: ("equals" | "greaterThan" | "greaterThanOrEquals" | "lessThan" | "lessThanOrEquals" | "notExists"),
            value: {
              string_value: ::String?,
              long_value: ::Integer?
            }?
          }?,
          map_filter: {
            attribute: ::String,
            key: ::String,
            value: {
              string_value: ::String?
            }
          }?
        }
      ]?,
      attribute_filter: {
        attribute: ::String,
        operator: ("equals" | "greaterThan" | "greaterThanOrEquals" | "lessThan" | "lessThanOrEquals" | "notExists"),
        value: {
          string_value: ::String?,
          long_value: ::Integer?
        }?
      }?,
      map_filter: {
        attribute: ::String,
        key: ::String,
        value: {
          string_value: ::String?
        }
      }?
    }

      type decimal_column_statistics_data = {
      minimum_value: {
        unscaled_value: ::String,
        scale: ::Integer
      }?,
      maximum_value: {
        unscaled_value: ::String,
        scale: ::Integer
      }?,
      number_of_nulls: ::Integer,
      number_of_distinct_values: ::Integer
    }

      type column_statistics_data = {
      type: ("BOOLEAN" | "DATE" | "DECIMAL" | "DOUBLE" | "LONG" | "STRING" | "BINARY"),
      boolean_column_statistics_data: {
        number_of_trues: ::Integer,
        number_of_falses: ::Integer,
        number_of_nulls: ::Integer
      }?,
      date_column_statistics_data: {
        minimum_value: ::Time?,
        maximum_value: ::Time?,
        number_of_nulls: ::Integer,
        number_of_distinct_values: ::Integer
      }?,
      decimal_column_statistics_data: Params::decimal_column_statistics_data?,
      double_column_statistics_data: {
        minimum_value: ::Float?,
        maximum_value: ::Float?,
        number_of_nulls: ::Integer,
        number_of_distinct_values: ::Integer
      }?,
      long_column_statistics_data: {
        minimum_value: ::Integer?,
        maximum_value: ::Integer?,
        number_of_nulls: ::Integer,
        number_of_distinct_values: ::Integer
      }?,
      string_column_statistics_data: {
        maximum_length: ::Integer,
        average_length: ::Float,
        number_of_nulls: ::Integer,
        number_of_distinct_values: ::Integer
      }?,
      binary_column_statistics_data: {
        maximum_length: ::Integer,
        average_length: ::Float,
        number_of_nulls: ::Integer
      }?
    }

      type column_statistics = {
      column_name: ::String,
      column_type: ::String,
      analyzed_time: ::Time,
      statistics_data: Params::column_statistics_data
    }

    end
  end
end
