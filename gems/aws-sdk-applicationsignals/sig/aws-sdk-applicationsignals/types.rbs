    class ServiceLevelObjective
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?name: String,
        ?description: String,
        ?created_time: Time,
        ?last_updated_time: Time,
        ?sli: Types::ServiceLevelIndicator,
        ?request_based_sli: Types::RequestBasedServiceLevelIndicator,
        ?evaluation_type: String,
        ?goal: Types::Goal,
        ?burn_rate_configurations: Array[Types::BurnRateConfiguration],
        ?metric_source_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor created_time: Time?
      attr_accessor last_updated_time: Time?
      attr_accessor sli: Types::ServiceLevelIndicator?
      attr_accessor request_based_sli: Types::RequestBasedServiceLevelIndicator?
      attr_accessor evaluation_type: String?
      attr_accessor goal: Types::Goal?
      attr_accessor burn_rate_configurations: Array[Types::BurnRateConfiguration]?
      attr_accessor metric_source_type: String?
    end

