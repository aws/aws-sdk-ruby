              metric_stat: {
                metric: {
                  namespace: String,
                  metric_name: String,
                  dimensions: Array[
                    {
                      name: String,
                      value: String
                    }
                  ]
                },
                period: Integer,
                stat: String,
                unit: String
              },
              expression: String,
              label: String,
              return_data: bool,
              period: untyped,
              account_id: String
            }
          ],
          monitored_request_count_metric: {
            good_count_metric: untyped,
            bad_count_metric: untyped
          },
          dependency_config: {
            dependency_key_attributes: untyped,
            dependency_operation_name: untyped
          }
        },
        metric_threshold: Float,
        comparison_operator: String
      },
