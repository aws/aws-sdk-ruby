                      name: String,
                      value: String
                    }
                  ]
                },
                period: Integer,
                stat: String,
                unit: String
              },
              expression: String,
              label: String,
              return_data: bool,
              period: untyped,
              account_id: String
            }
          ],
          monitored_request_count_metric: {
            good_count_metric: untyped,
            bad_count_metric: untyped
          },
          dependency_config: {
            dependency_key_attributes: untyped,
            dependency_operation_name: untyped
          },
          metric_source: {
            metric_source_key_attributes: untyped,
            metric_source_attributes: untyped
          },
          metric_name: untyped,
          composite_sli_config: {
            selection_config: {
              type: String,
              pattern: String
            },
            components: Array[
              {
                operation_name: untyped
              }
            ]
          }
        },
        metric_threshold: Float,
        comparison_operator: String
      },
      ?goal: {
        interval: {
          rolling_interval: {
            duration_unit: String,
            duration: Integer
          },
          calendar_interval: {
            start_time: Time,
            duration_unit: untyped,
            duration: Integer
          }
        },
        attainment_goal: Float,
        warning_threshold: Float
      },
      ?burn_rate_configurations: Array[
        {
          look_back_window_minutes: Integer
        }
      ],
      ?auto_investigation_enabled: bool
    ) -> _UpdateServiceLevelObjectiveResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateServiceLevelObjectiveResponse
  end
end
