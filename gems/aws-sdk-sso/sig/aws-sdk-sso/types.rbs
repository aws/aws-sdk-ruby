module Aws::SSO
  module Types

    class AccountInfo
      include Smithy::Schema::Structure

      def initialize: (
        ?account_id: String,
        ?account_name: String,
        ?email_address: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor account_id: String?
      attr_accessor account_name: String?
      attr_accessor email_address: String?
    end

    class GetRoleCredentialsRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?role_name: String,
        ?account_id: String,
        ?access_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor role_name: String?
      attr_accessor account_id: String?
      attr_accessor access_token: String?
    end

    class GetRoleCredentialsResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?role_credentials: Types::RoleCredentials,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor role_credentials: Types::RoleCredentials?
    end

    class InvalidRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ListAccountRolesRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?next_token: String,
        ?max_results: Integer,
        ?access_token: String,
        ?account_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor next_token: String?
      attr_accessor max_results: Integer?
      attr_accessor access_token: String?
      attr_accessor account_id: String?
    end

    class ListAccountRolesResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?next_token: String,
        ?role_list: Array[Types::RoleInfo],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor next_token: String?
      attr_accessor role_list: Array[Types::RoleInfo]?
    end

    class ListAccountsRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?next_token: String,
        ?max_results: Integer,
        ?access_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor next_token: String?
      attr_accessor max_results: Integer?
      attr_accessor access_token: String?
    end

    class ListAccountsResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?next_token: String,
        ?account_list: Array[Types::AccountInfo],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor next_token: String?
      attr_accessor account_list: Array[Types::AccountInfo]?
    end

    class LogoutRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?access_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor access_token: String?
    end

    class ResourceNotFoundException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class RoleCredentials
      include Smithy::Schema::Structure

      def initialize: (
        ?access_key_id: String,
        ?secret_access_key: String,
        ?session_token: String,
        ?expiration: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor access_key_id: String?
      attr_accessor secret_access_key: String?
      attr_accessor session_token: String?
      attr_accessor expiration: Integer?
    end

    class RoleInfo
      include Smithy::Schema::Structure

      def initialize: (
        ?role_name: String,
        ?account_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor role_name: String?
      attr_accessor account_id: String?
    end

    class TooManyRequestsException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class UnauthorizedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end
  end
end
