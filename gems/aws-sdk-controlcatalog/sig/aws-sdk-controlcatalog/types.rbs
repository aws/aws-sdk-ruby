    class ControlSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?aliases: Array[String],
        ?name: String,
        ?description: String,
        ?behavior: String,
        ?severity: String,
        ?parameter_requirement_summary: String,
        ?implementation: Types::ImplementationSummary,
        ?create_time: Time,
        ?governed_resources: Array[String],
        ?governed_providers: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor aliases: Array[String]?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor behavior: String?
      attr_accessor severity: String?
      attr_accessor parameter_requirement_summary: String?
      attr_accessor implementation: Types::ImplementationSummary?
      attr_accessor create_time: Time?
      attr_accessor governed_resources: Array[String]?
      attr_accessor governed_providers: Array[String]?
    end

