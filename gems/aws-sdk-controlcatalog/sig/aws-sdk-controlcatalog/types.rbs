    class Mapping
      include Smithy::Schema::Union

      def initialize: (
        ?framework: Types::FrameworkMappingDetails,
        ?common_control: Types::CommonControlMappingDetails,
        ?related_control: Types::RelatedControlMappingDetails,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor framework: Types::FrameworkMappingDetails?
      attr_accessor common_control: Types::CommonControlMappingDetails?
      attr_accessor related_control: Types::RelatedControlMappingDetails?

      class Framework < Mapping
      end
      class CommonControl < Mapping
      end
      class RelatedControl < Mapping
      end
      class Unknown < Mapping
      end
    end

    module MappingType
      FRAMEWORK: String
      COMMON_CONTROL: String
      RELATED_CONTROL: String
    end

