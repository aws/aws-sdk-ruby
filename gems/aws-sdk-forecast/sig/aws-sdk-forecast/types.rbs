module Aws::Forecast
  module Types

    class Action
      include Smithy::Schema::Structure

      def initialize: (
        ?attribute_name: String,
        ?operation: String,
        ?value: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor attribute_name: String?
      attr_accessor operation: String?
      attr_accessor value: Float?
    end

    class AdditionalDataset
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?configuration: Hash[String, Array[String]],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor configuration: Hash[String, Array[String]]?
    end

    class AttributeConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?attribute_name: String,
        ?transformations: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor attribute_name: String?
      attr_accessor transformations: Hash[String, String]?
    end

    module AttributeType
      STRING: String
      INTEGER: String
      FLOAT: String
      TIMESTAMP: String
      GEOLOCATION: String
    end

    module AutoMLOverrideStrategy
      LatencyOptimized: String
      AccuracyOptimized: String
    end

