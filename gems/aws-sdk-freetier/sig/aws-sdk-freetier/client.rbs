module Aws::FreeTier
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::FreeTier::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetAccountActivityResponse
      include Smithy::Client::_Response[Types::GetAccountActivityResponse]
      def activity_id: () -> String?
      def title: () -> String?
      def description: () -> String?
      def status: () -> String?
      def instructions_url: () -> String?
      def reward: () -> Types::ActivityReward?
      def estimated_time_to_complete_in_minutes: () -> Integer?
      def expires_at: () -> Time?
      def started_at: () -> Time?
      def completed_at: () -> Time?
    end
    def get_account_activity: (
      ?activity_id: String,
      ?language_code: String
    ) -> _GetAccountActivityResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAccountActivityResponse

    interface _GetAccountPlanStateResponse
      include Smithy::Client::_Response[Types::GetAccountPlanStateResponse]
      def account_id: () -> String?
      def account_plan_type: () -> String?
      def account_plan_status: () -> String?
      def account_plan_remaining_credits: () -> Types::MonetaryAmount?
      def account_plan_expiration_date: () -> Time?
    end
    def get_account_plan_state: (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAccountPlanStateResponse

    interface _GetFreeTierUsageResponse
      include Smithy::Client::_Response[Types::GetFreeTierUsageResponse]
      def free_tier_usages: () -> Array[Types::FreeTierUsage]?
      def next_token: () -> String?
    end
    def get_free_tier_usage: (
      ?filter: {
        or: Array[
          {
            or: untyped,
            and: untyped,
            not: untyped,
            dimensions: {
              key: String,
              values: Array[String],
              match_options: Array[String]
            }
          }
        ],
        and: untyped,
        not: untyped,
        dimensions: untyped
      },
      ?max_results: Integer,
      ?next_token: String
    ) -> _GetFreeTierUsageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetFreeTierUsageResponse

    interface _ListAccountActivitiesResponse
      include Smithy::Client::_Response[Types::ListAccountActivitiesResponse]
      def activities: () -> Array[Types::ActivitySummary]?
      def next_token: () -> String?
    end
    def list_account_activities: (
      ?filter_activity_statuses: Array[String],
      ?next_token: String,
      ?max_results: Integer,
      ?language_code: String
    ) -> _ListAccountActivitiesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListAccountActivitiesResponse

    interface _UpgradeAccountPlanResponse
      include Smithy::Client::_Response[Types::UpgradeAccountPlanResponse]
      def account_id: () -> String?
      def account_plan_type: () -> String?
      def account_plan_status: () -> String?
    end
    def upgrade_account_plan: (
      ?account_plan_type: String
    ) -> _UpgradeAccountPlanResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpgradeAccountPlanResponse
  end
end
