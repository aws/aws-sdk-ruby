        ?creation_time: Time,
        ?update_time: Time,
        ?status_message: String,
        ?store_size_bytes: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor reference: Types::ReferenceItem?
      attr_accessor status: String?
      attr_accessor store_arn: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor sse_config: Types::SseConfig?
      attr_accessor creation_time: Time?
      attr_accessor update_time: Time?
      attr_accessor status_message: String?
      attr_accessor store_size_bytes: Integer?
    end

    class VcfOptions
      include Smithy::Schema::Structure

      def initialize: (
        ?ignore_qual_field: bool,
        ?ignore_filter_field: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor ignore_qual_field: bool?
      attr_accessor ignore_filter_field: bool?
