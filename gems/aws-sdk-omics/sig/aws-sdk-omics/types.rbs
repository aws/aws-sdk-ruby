    end

    class VersionOptions
      include Smithy::Schema::Union

      def initialize: (
        ?tsv_version_options: Types::TsvVersionOptions,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor tsv_version_options: Types::TsvVersionOptions?

      class TsvVersionOptions < VersionOptions
      end
      class Unknown < VersionOptions
      end
    end

