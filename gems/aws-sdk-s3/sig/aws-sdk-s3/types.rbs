    class AnalyticsFilter
      include Smithy::Schema::Union

      def initialize: (
        ?prefix: String,
        ?tag: Types::Tag,
        ?and: Types::AnalyticsAndOperator,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor prefix: String?
      attr_accessor tag: Types::Tag?
      attr_accessor and: Types::AnalyticsAndOperator?

      class Prefix < AnalyticsFilter
      end
      class Tag < AnalyticsFilter
      end
      class And < AnalyticsFilter
      end
      class Unknown < AnalyticsFilter
      end
