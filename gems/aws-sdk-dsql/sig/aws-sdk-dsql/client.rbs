module Aws::DSQL
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::DSQL::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateClusterResponse
      include Smithy::Client::_Response[Types::CreateClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def multi_region_properties: () -> Types::MultiRegionProperties?
      def encryption_details: () -> Types::EncryptionDetails?
      def deletion_protection_enabled: () -> bool?
      def endpoint: () -> String?
    end
    def create_cluster: (
      ?deletion_protection_enabled: bool,
      ?kms_encryption_key: String,
      ?tags: Hash[String, String],
      ?client_token: String,
      ?multi_region_properties: {
        witness_region: String,
        clusters: Array[String]
      },
      ?policy: String,
      ?bypass_policy_lockout_safety_check: bool
    ) -> _CreateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateClusterResponse

    interface _CreateStreamResponse
      include Smithy::Client::_Response[Types::CreateStreamOutput]
      def cluster_identifier: () -> String?
      def stream_identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def ordering: () -> String?
      def format: () -> String?
    end
    def create_stream: (
      ?cluster_identifier: String,
      ?target_definition: {
        kinesis: {
          stream_arn: String,
          role_arn: String
        }
      },
      ?ordering: String,
      ?format: String,
      ?tags: Hash[String, String],
      ?client_token: String
    ) -> _CreateStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateStreamResponse

    interface _DeleteClusterResponse
      include Smithy::Client::_Response[Types::DeleteClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
    end
    def delete_cluster: (
      ?identifier: String,
      ?client_token: String
    ) -> _DeleteClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteClusterResponse

    interface _DeleteClusterPolicyResponse
      include Smithy::Client::_Response[Types::DeleteClusterPolicyOutput]
      def policy_version: () -> String?
    end
    def delete_cluster_policy: (
      ?identifier: String,
      ?expected_policy_version: String,
      ?client_token: String
    ) -> _DeleteClusterPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteClusterPolicyResponse

    interface _DeleteStreamResponse
      include Smithy::Client::_Response[Types::DeleteStreamOutput]
      def cluster_identifier: () -> String?
      def stream_identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
    end
    def delete_stream: (
      ?cluster_identifier: String,
      ?stream_identifier: String,
      ?client_token: String
    ) -> _DeleteStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteStreamResponse

    interface _GetClusterResponse
      include Smithy::Client::_Response[Types::GetClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def deletion_protection_enabled: () -> bool?
      def multi_region_properties: () -> Types::MultiRegionProperties?
      def tags: () -> Hash[String, String]?
      def encryption_details: () -> Types::EncryptionDetails?
      def endpoint: () -> String?
    end
    def get_cluster: (
      ?identifier: String
    ) -> _GetClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetClusterResponse

    interface _GetClusterPolicyResponse
      include Smithy::Client::_Response[Types::GetClusterPolicyOutput]
      def policy: () -> String?
      def policy_version: () -> String?
    end
    def get_cluster_policy: (
      ?identifier: String
    ) -> _GetClusterPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetClusterPolicyResponse

    interface _GetStreamResponse
      include Smithy::Client::_Response[Types::GetStreamOutput]
      def cluster_identifier: () -> String?
      def stream_identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def ordering: () -> String?
      def format: () -> String?
      def target_definition: () -> Types::TargetDefinition?
      def status_reason: () -> Types::StatusReason?
      def tags: () -> Hash[String, String]?
    end
    def get_stream: (
      ?cluster_identifier: String,
      ?stream_identifier: String
    ) -> _GetStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetStreamResponse

    interface _GetVpcEndpointServiceNameResponse
      include Smithy::Client::_Response[Types::GetVpcEndpointServiceNameOutput]
      def service_name: () -> String?
      def cluster_vpc_endpoint: () -> String?
    end
    def get_vpc_endpoint_service_name: (
      ?identifier: String
    ) -> _GetVpcEndpointServiceNameResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetVpcEndpointServiceNameResponse

    interface _ListClustersResponse
      include Smithy::Client::_Response[Types::ListClustersOutput]
      def next_token: () -> String?
      def clusters: () -> Array[Types::ClusterSummary]?
    end
    def list_clusters: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListClustersResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListClustersResponse

    interface _ListStreamsResponse
      include Smithy::Client::_Response[Types::ListStreamsOutput]
      def next_token: () -> String?
      def streams: () -> Array[Types::StreamSummary]?
    end
    def list_streams: (
      ?cluster_identifier: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListStreamsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListStreamsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _PutClusterPolicyResponse
      include Smithy::Client::_Response[Types::PutClusterPolicyOutput]
      def policy_version: () -> String?
    end
    def put_cluster_policy: (
      ?identifier: String,
      ?policy: String,
      ?bypass_policy_lockout_safety_check: bool,
      ?expected_policy_version: String,
      ?client_token: String
    ) -> _PutClusterPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutClusterPolicyResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateClusterResponse
      include Smithy::Client::_Response[Types::UpdateClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
    end
    def update_cluster: (
      ?identifier: String,
      ?deletion_protection_enabled: bool,
      ?kms_encryption_key: String,
      ?client_token: String,
      ?multi_region_properties: {
        witness_region: String,
        clusters: Array[String]
      }
    ) -> _UpdateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateClusterResponse
  end
end
