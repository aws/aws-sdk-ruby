module Aws::DSQL
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::DSQL::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateClusterResponse
      include Smithy::Client::_Response[Types::CreateClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def multi_region_properties: () -> Types::MultiRegionProperties?
      def encryption_details: () -> Types::EncryptionDetails?
      def deletion_protection_enabled: () -> bool?
    end
    def create_cluster: (
      ?deletion_protection_enabled: bool,
      ?kms_encryption_key: String,
      ?tags: Hash[String, String],
      ?client_token: String,
      ?multi_region_properties: {
        witness_region: String,
        clusters: Array[String]
      }
    ) -> _CreateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateClusterResponse

    interface _DeleteClusterResponse
      include Smithy::Client::_Response[Types::DeleteClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
    end
    def delete_cluster: (
      ?identifier: String,
      ?client_token: String
    ) -> _DeleteClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteClusterResponse

    interface _GetClusterResponse
      include Smithy::Client::_Response[Types::GetClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def deletion_protection_enabled: () -> bool?
      def multi_region_properties: () -> Types::MultiRegionProperties?
      def tags: () -> Hash[String, String]?
      def encryption_details: () -> Types::EncryptionDetails?
    end
    def get_cluster: (
      ?identifier: String
    ) -> _GetClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetClusterResponse

    interface _GetVpcEndpointServiceNameResponse
      include Smithy::Client::_Response[Types::GetVpcEndpointServiceNameOutput]
      def service_name: () -> String?
    end
    def get_vpc_endpoint_service_name: (
      ?identifier: String
    ) -> _GetVpcEndpointServiceNameResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetVpcEndpointServiceNameResponse

    interface _ListClustersResponse
      include Smithy::Client::_Response[Types::ListClustersOutput]
      def next_token: () -> String?
      def clusters: () -> Array[Types::ClusterSummary]?
    end
    def list_clusters: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListClustersResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListClustersResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateClusterResponse
      include Smithy::Client::_Response[Types::UpdateClusterOutput]
      def identifier: () -> String?
      def arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
    end
    def update_cluster: (
      ?identifier: String,
      ?deletion_protection_enabled: bool,
      ?kms_encryption_key: String,
      ?client_token: String,
      ?multi_region_properties: {
        witness_region: String,
        clusters: Array[String]
      }
    ) -> _UpdateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateClusterResponse
  end
end
