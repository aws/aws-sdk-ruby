    module StreamFailureErrorCode
      KINESIS_THROUGHPUT_EXCEEDED: String
      KINESIS_STREAM_NOT_FOUND: String
      ROLE_ACCESS_DENIED: String
      KINESIS_ACCESS_DENIED: String
      KINESIS_KMS_ACCESS_DENIED: String
      KINESIS_OVERSIZE_RECORD: String
      CLUSTER_CMK_INACCESSIBLE: String
      INTERNAL_ERROR: String
    end

    module StreamFormat
      JSON: String
    end

    module StreamOrdering
      UNORDERED: String
    end

    module StreamStatus
      CREATING: String
      ACTIVE: String
      DELETING: String
      DELETED: String
      FAILED: String
      IMPAIRED: String
    end

    class StreamSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?cluster_identifier: String,
        ?stream_identifier: String,
