module Aws::DSQL
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module ClusterStatus
      CREATING: String
      ACTIVE: String
      IDLE: String
      INACTIVE: String
      UPDATING: String
      DELETING: String
      DELETED: String
      FAILED: String
      PENDING_SETUP: String
      PENDING_DELETE: String
    end

    class ClusterSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?identifier: String,
        ?arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor identifier: String?
      attr_accessor arn: String?
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
    end

    class CreateClusterInput
      include Smithy::Schema::Structure

      def initialize: (
        ?deletion_protection_enabled: bool,
        ?kms_encryption_key: String,
        ?tags: Hash[String, String],
        ?client_token: String,
        ?multi_region_properties: Types::MultiRegionProperties,
        ?policy: String,
        ?bypass_policy_lockout_safety_check: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor deletion_protection_enabled: bool?
      attr_accessor kms_encryption_key: String?
      attr_accessor tags: Hash[String, String]?
      attr_accessor client_token: String?
      attr_accessor multi_region_properties: Types::MultiRegionProperties?
      attr_accessor policy: String?
      attr_accessor bypass_policy_lockout_safety_check: bool?
    end

    class CreateClusterOutput
      include Smithy::Schema::Structure

      def initialize: (
        ?identifier: String,
        ?arn: String,
        ?status: String,
        ?creation_time: Time,
        ?multi_region_properties: Types::MultiRegionProperties,
        ?encryption_details: Types::EncryptionDetails,
        ?deletion_protection_enabled: bool,
        ?endpoint: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor identifier: String?
      attr_accessor arn: String?
      attr_accessor status: String?
      attr_accessor creation_time: Time?
      attr_accessor multi_region_properties: Types::MultiRegionProperties?
      attr_accessor encryption_details: Types::EncryptionDetails?
      attr_accessor deletion_protection_enabled: bool?
      attr_accessor endpoint: String?
    end

    class CreateStreamInput
      include Smithy::Schema::Structure

      def initialize: (
        ?cluster_identifier: String,
        ?target_definition: Types::TargetDefinition,
        ?ordering: String,
        ?format: String,
        ?tags: Hash[String, String],
        ?client_token: String,
      ) -> void
