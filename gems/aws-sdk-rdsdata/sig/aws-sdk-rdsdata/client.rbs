module Aws::RDSData
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::RDSData::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchExecuteStatementResponse
      include Smithy::Client::_Response[Types::BatchExecuteStatementOutput]
      def update_results: () -> Array[Types::UpdateResult]?
    end
    def batch_execute_statement: (
      ?resource_arn: String,
      ?secret_arn: String,
      ?sql: String,
      ?database: String,
      ?schema: String,
      ?parameter_sets: Array[
        Array[
          {
            name: String,
            value: {
              is_null: bool,
              boolean_value: untyped,
              long_value: Integer,
              double_value: Float,
              string_value: String,
              blob_value: String,
              array_value: {
                boolean_values: Array[bool],
                long_values: Array[Integer],
                double_values: Array[Float],
                string_values: Array[String],
                array_values: Array[
                  {
                    boolean_values: untyped,
                    long_values: untyped,
                    double_values: untyped,
                    string_values: untyped,
                    array_values: untyped
                  }
                ]
              }
            },
            type_hint: String
          }
        ]
      ],
      ?transaction_id: String
    ) -> _BatchExecuteStatementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchExecuteStatementResponse

    interface _BeginTransactionResponse
      include Smithy::Client::_Response[Types::BeginTransactionOutput]
      def transaction_id: () -> String?
    end
    def begin_transaction: (
      ?resource_arn: String,
      ?secret_arn: String,
      ?database: String,
      ?schema: String
    ) -> _BeginTransactionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BeginTransactionResponse

    interface _CommitTransactionResponse
      include Smithy::Client::_Response[Types::CommitTransactionOutput]
      def transaction_status: () -> String?
    end
    def commit_transaction: (
      ?resource_arn: String,
      ?secret_arn: String,
      ?transaction_id: String
    ) -> _CommitTransactionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CommitTransactionResponse

    interface _ExecuteSqlResponse
      include Smithy::Client::_Response[Types::ExecuteSqlOutput]
      def sql_statement_results: () -> Array[Types::SqlStatementResult]?
    end
    def execute_sql: (
      ?db_cluster_or_instance_arn: String,
      ?aws_secret_store_arn: String,
      ?sql_statements: String,
      ?database: String,
      ?schema: String
    ) -> _ExecuteSqlResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ExecuteSqlResponse

    interface _ExecuteStatementResponse
      include Smithy::Client::_Response[Types::ExecuteStatementOutput]
      def records: () -> Array[Array[Types::Field]]?
      def column_metadata: () -> Array[Types::ColumnMetadata]?
      def number_of_records_updated: () -> Integer?
      def generated_fields: () -> Array[Types::Field]?
      def formatted_records: () -> String?
    end
    def execute_statement: (
      ?resource_arn: String,
      ?secret_arn: String,
      ?sql: String,
      ?database: String,
      ?schema: String,
      ?parameters: Array[
        {
          name: String,
          value: {
            is_null: bool,
            boolean_value: untyped,
            long_value: Integer,
            double_value: Float,
            string_value: String,
            blob_value: String,
            array_value: {
              boolean_values: Array[bool],
              long_values: Array[Integer],
              double_values: Array[Float],
              string_values: Array[String],
              array_values: Array[
                {
                  boolean_values: untyped,
                  long_values: untyped,
                  double_values: untyped,
                  string_values: untyped,
                  array_values: untyped
                }
              ]
            }
          },
          type_hint: String
        }
      ],
      ?transaction_id: String,
      ?include_result_metadata: bool,
      ?continue_after_timeout: bool,
      ?result_set_options: {
        decimal_return_type: String,
        long_return_type: String
      },
      ?format_records_as: String
    ) -> _ExecuteStatementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ExecuteStatementResponse

    interface _RollbackTransactionResponse
      include Smithy::Client::_Response[Types::RollbackTransactionOutput]
      def transaction_status: () -> String?
    end
    def rollback_transaction: (
      ?resource_arn: String,
      ?secret_arn: String,
      ?transaction_id: String
    ) -> _RollbackTransactionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RollbackTransactionResponse
  end
end
