        ?is_auto_increment: bool,
        ?is_signed: bool,
        ?is_currency: bool,
        ?is_case_sensitive: bool,
        ?nullable: Integer,
        ?precision: Integer,
        ?scale: Integer,
        ?array_base_column_type: Integer,
      ) -> void
