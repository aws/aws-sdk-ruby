    ) -> _ListSearchResultExportJobsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSearchResultExportJobsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def tags: () -> Hash[String, String?]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _StartSearchJobResponse
      include Smithy::Client::_Response[Types::StartSearchJobOutput]
      def search_job_arn: () -> String?
      def creation_time: () -> Time?
      def search_job_identifier: () -> String?
    end
    def start_search_job: (
      ?tags: Hash[String, String?],
      ?name: String,
      ?encryption_key_arn: String,
      ?client_token: String,
      ?search_scope: {
        backup_resource_types: Array[String],
        backup_resource_creation_time: {
          created_after: Time,
          created_before: untyped
        },
        source_resource_arns: Array[String],
        backup_resource_arns: Array[String],
        backup_resource_tags: Hash[String, String?]
      },
      ?item_filters: {
        s3_item_filters: Array[
          {
            object_keys: Array[
              {
                value: String,
                operator: String
              }
            ],
            sizes: Array[
              {
                value: Integer,
                operator: String
              }
            ],
            creation_times: Array[
              {
                value: Time,
                operator: String
              }
            ],
            version_ids: untyped,
            e_tags: untyped
          }
        ],
        ebs_item_filters: Array[
          {
            file_paths: untyped,
            sizes: untyped,
            creation_times: untyped,
            last_modification_times: untyped
          }
        ]
      }
    ) -> _StartSearchJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSearchJobResponse

    interface _StartSearchResultExportJobResponse
      include Smithy::Client::_Response[Types::StartSearchResultExportJobOutput]
