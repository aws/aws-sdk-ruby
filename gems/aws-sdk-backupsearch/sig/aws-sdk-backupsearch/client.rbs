module Aws::BackupSearch
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::BackupSearch::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: Smithy::Client::Retry::ExponentialBackoff,
      ?retry_base_delay: untyped,
      ?retry_max_attempts: Integer,
      ?retry_max_delay: untyped,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetSearchJobResponse
      include Smithy::Client::_Response[Types::GetSearchJobOutput]
      def name: () -> String?
      def search_scope_summary: () -> Types::SearchScopeSummary?
      def current_search_progress: () -> Types::CurrentSearchProgress?
      def status_message: () -> String?
      def encryption_key_arn: () -> String?
      def completion_time: () -> Time?
      def status: () -> String?
      def search_scope: () -> Types::SearchScope?
      def item_filters: () -> Types::ItemFilters?
      def creation_time: () -> Time?
      def search_job_identifier: () -> String?
      def search_job_arn: () -> String?
    end
    def get_search_job: (
      ?search_job_identifier: String
    ) -> _GetSearchJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSearchJobResponse

    interface _GetSearchResultExportJobResponse
      include Smithy::Client::_Response[Types::GetSearchResultExportJobOutput]
      def export_job_identifier: () -> String?
      def export_job_arn: () -> String?
      def status: () -> String?
      def creation_time: () -> Time?
      def completion_time: () -> Time?
      def status_message: () -> String?
      def export_specification: () -> Types::ExportSpecification?
      def search_job_arn: () -> String?
    end
    def get_search_result_export_job: (
      ?export_job_identifier: String
    ) -> _GetSearchResultExportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSearchResultExportJobResponse

    interface _ListSearchJobBackupsResponse
      include Smithy::Client::_Response[Types::ListSearchJobBackupsOutput]
      def results: () -> Array[Types::SearchJobBackupsResult]?
      def next_token: () -> String?
    end
    def list_search_job_backups: (
      ?search_job_identifier: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListSearchJobBackupsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSearchJobBackupsResponse

    interface _ListSearchJobResultsResponse
      include Smithy::Client::_Response[Types::ListSearchJobResultsOutput]
      def results: () -> Array[Types::ResultItem]?
      def next_token: () -> String?
    end
    def list_search_job_results: (
      ?search_job_identifier: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListSearchJobResultsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSearchJobResultsResponse

    interface _ListSearchJobsResponse
      include Smithy::Client::_Response[Types::ListSearchJobsOutput]
      def search_jobs: () -> Array[Types::SearchJobSummary]?
      def next_token: () -> String?
    end
    def list_search_jobs: (
      ?by_status: String,
      ?next_token: String,
      ?max_results: Integer
