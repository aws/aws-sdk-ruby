      def export_job_identifier: () -> String?
    end
    def start_search_result_export_job: (
      ?search_job_identifier: String,
      ?export_specification: {
        s3_export_specification: {
          destination_bucket: String,
          destination_prefix: untyped
        }
      },
      ?client_token: String,
      ?tags: Hash[String, String?],
      ?role_arn: String
    ) -> _StartSearchResultExportJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSearchResultExportJobResponse

    interface _StopSearchJobResponse
      include Smithy::Client::_Response[Types::StopSearchJobOutput]
    end
    def stop_search_job: (
      ?search_job_identifier: String
    ) -> _StopSearchJobResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StopSearchJobResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String?]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
