    end
    def list_suite_runs: (
      ?suite_definition_id: String,
      ?suite_definition_version: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListSuiteRunsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSuiteRunsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
