module Aws::IotDeviceAdvisor
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::IotDeviceAdvisor::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateSuiteDefinitionResponse
      include Smithy::Client::_Response[Types::CreateSuiteDefinitionResponse]
      def suite_definition_id: () -> String?
      def suite_definition_arn: () -> String?
      def suite_definition_name: () -> String?
      def created_at: () -> Time?
    end
    def create_suite_definition: (
      ?suite_definition_configuration: {
        suite_definition_name: String,
        devices: Array[
          {
            thing_arn: String,
            certificate_arn: untyped,
            device_role_arn: untyped
          }
        ],
        intended_for_qualification: bool,
        is_long_duration_test: bool,
        root_group: String,
        device_permission_role_arn: untyped,
        protocol: String
      },
      ?tags: Hash[String, String],
      ?client_token: String
    ) -> _CreateSuiteDefinitionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateSuiteDefinitionResponse

    interface _DeleteSuiteDefinitionResponse
      include Smithy::Client::_Response[Types::DeleteSuiteDefinitionResponse]
    end
    def delete_suite_definition: (
      ?suite_definition_id: String
    ) -> _DeleteSuiteDefinitionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSuiteDefinitionResponse

    interface _GetEndpointResponse
      include Smithy::Client::_Response[Types::GetEndpointResponse]
      def endpoint: () -> String?
    end
    def get_endpoint: (
      ?thing_arn: String,
      ?certificate_arn: String,
      ?device_role_arn: String,
      ?authentication_method: String
    ) -> _GetEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetEndpointResponse

    interface _GetSuiteDefinitionResponse
      include Smithy::Client::_Response[Types::GetSuiteDefinitionResponse]
      def suite_definition_id: () -> String?
      def suite_definition_arn: () -> String?
      def suite_definition_version: () -> String?
      def latest_version: () -> String?
      def suite_definition_configuration: () -> Types::SuiteDefinitionConfiguration?
      def created_at: () -> Time?
      def last_modified_at: () -> Time?
      def tags: () -> Hash[String, String]?
    end
    def get_suite_definition: (
      ?suite_definition_id: String,
      ?suite_definition_version: String
    ) -> _GetSuiteDefinitionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSuiteDefinitionResponse

    interface _GetSuiteRunResponse
      include Smithy::Client::_Response[Types::GetSuiteRunResponse]
      def suite_definition_id: () -> String?
      def suite_definition_version: () -> String?
      def suite_run_id: () -> String?
      def suite_run_arn: () -> String?
      def suite_run_configuration: () -> Types::SuiteRunConfiguration?
      def test_result: () -> Types::TestResult?
      def start_time: () -> Time?
      def end_time: () -> Time?
      def status: () -> String?
      def error_reason: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def get_suite_run: (
      ?suite_definition_id: String,
      ?suite_run_id: String
    ) -> _GetSuiteRunResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSuiteRunResponse

    interface _GetSuiteRunReportResponse
      include Smithy::Client::_Response[Types::GetSuiteRunReportResponse]
      def qualification_report_download_url: () -> String?
    end
    def get_suite_run_report: (
      ?suite_definition_id: String,
      ?suite_run_id: String
    ) -> _GetSuiteRunReportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSuiteRunReportResponse

    interface _ListSuiteDefinitionsResponse
      include Smithy::Client::_Response[Types::ListSuiteDefinitionsResponse]
      def suite_definition_information_list: () -> Array[Types::SuiteDefinitionInformation]?
      def next_token: () -> String?
    end
    def list_suite_definitions: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListSuiteDefinitionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSuiteDefinitionsResponse

    interface _ListSuiteRunsResponse
      include Smithy::Client::_Response[Types::ListSuiteRunsResponse]
      def suite_runs_list: () -> Array[Types::SuiteRunInformation]?
