    class DocumentVersionMetadata
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?name: String,
        ?content_type: String,
        ?size: Integer,
        ?signature: String,
        ?status: String,
        ?created_timestamp: Time,
        ?modified_timestamp: Time,
        ?content_created_timestamp: Time,
