      type search_expression = {
      filters: Array[
        {
          name: ::String,
          operator: ("Equals" | "NotEquals" | "GreaterThan" | "GreaterThanOrEqualTo" | "LessThan" | "LessThanOrEqualTo" | "Contains" | "Exists" | "NotExists" | "In")?,
          value: ::String?
        }
      ]?,
      nested_filters: Array[
        {
          nested_property_name: ::String,
          filters: Array[
            {
              name: ::String,
              operator: ("Equals" | "NotEquals" | "GreaterThan" | "GreaterThanOrEqualTo" | "LessThan" | "LessThanOrEqualTo" | "Contains" | "Exists" | "NotExists" | "In")?,
              value: ::String?
            }
          ]
        }
      ]?,
      sub_expressions: Array[
        {
          filters: Array[
            {
              name: ::String,
              operator: ("Equals" | "NotEquals" | "GreaterThan" | "GreaterThanOrEqualTo" | "LessThan" | "LessThanOrEqualTo" | "Contains" | "Exists" | "NotExists" | "In")?,
              value: ::String?
            }
          ]?,
          nested_filters: Array[
            {
              nested_property_name: ::String,
              filters: Array[
                {
                  name: ::String,
                  operator: ("Equals" | "NotEquals" | "GreaterThan" | "GreaterThanOrEqualTo" | "LessThan" | "LessThanOrEqualTo" | "Contains" | "Exists" | "NotExists" | "In")?,
                  value: ::String?
                }
              ]
            }
          ]?,
          sub_expressions: untyped?,
          operator: ("And" | "Or")?
        }
      ]?,
      operator: ("And" | "Or")?
    }

