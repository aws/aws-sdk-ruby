module Aws::SageMaker
  module Types

    class ActionSource
      include Smithy::Schema::Structure

      def initialize: (
        ?source_uri: String,
        ?source_type: String,
        ?source_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor source_uri: String?
      attr_accessor source_type: String?
      attr_accessor source_id: String?
    end

    module ActionStatus
      UNKNOWN: String
      IN_PROGRESS: String
      COMPLETED: String
      FAILED: String
      STOPPING: String
      STOPPED: String
    end

    class ActionSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?action_arn: String,
        ?action_name: String,
        ?source: Types::ActionSource,
        ?action_type: String,
        ?status: String,
        ?creation_time: Time,
        ?last_modified_time: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor action_arn: String?
      attr_accessor action_name: String?
      attr_accessor source: Types::ActionSource?
      attr_accessor action_type: String?
      attr_accessor status: String?
      attr_accessor creation_time: Time?
      attr_accessor last_modified_time: Time?
    end

    module ActivationState
      ENABLED: String
      DISABLED: String
    end

