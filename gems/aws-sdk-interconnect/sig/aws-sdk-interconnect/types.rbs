module Aws::Interconnect
  module Types

    class AcceptConnectionProposalRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?attach_point: Types::AttachPoint,
        ?activation_key: String,
        ?description: String,
        ?tags: Hash[String, String],
        ?client_token: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor attach_point: Types::AttachPoint?
      attr_accessor activation_key: String?
      attr_accessor description: String?
      attr_accessor tags: Hash[String, String]?
      attr_accessor client_token: String?
    end

    class AcceptConnectionProposalResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?connection: Types::Connection,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor connection: Types::Connection?
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AttachPoint
      include Smithy::Schema::Union

      def initialize: (
        ?direct_connect_gateway: String,
        ?arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor direct_connect_gateway: String?
      attr_accessor arn: String?

      class DirectConnectGateway < AttachPoint
      end
      class Arn < AttachPoint
      end
      class Unknown < AttachPoint
      end
    end

    class AttachPointDescriptor
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?identifier: String,
        ?name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor identifier: String?
      attr_accessor name: String?
    end

    module AttachPointType
      DirectConnectGateway: String
    end

    class Bandwidths
      include Smithy::Schema::Structure

      def initialize: (
        ?available: Array[String],
        ?supported: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor available: Array[String]?
      attr_accessor supported: Array[String]?
    end

    class Connection
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?arn: String,
        ?description: String,
        ?bandwidth: String,
        ?attach_point: Types::AttachPoint,
        ?environment_id: String,
        ?provider: Types::Provider,
        ?location: String,
        ?type: String,
        ?state: String,
        ?shared_id: String,
        ?billing_tier: Integer,
        ?owner_account: String,
        ?activation_key: String,
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor arn: String?
      attr_accessor description: String?
      attr_accessor bandwidth: String?
      attr_accessor attach_point: Types::AttachPoint?
      attr_accessor environment_id: String?
      attr_accessor provider: Types::Provider?
      attr_accessor location: String?
      attr_accessor type: String?
      attr_accessor state: String?
      attr_accessor shared_id: String?
      attr_accessor billing_tier: Integer?
      attr_accessor owner_account: String?
      attr_accessor activation_key: String?
      attr_accessor tags: Hash[String, String]?
    end

    module ConnectionState
      AVAILABLE: String
      REQUESTED: String
      PENDING: String
      DOWN: String
      DELETING: String
      DELETED: String
      FAILED: String
      UPDATING: String
    end

