module Aws::Artifact
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Artifact::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateComplianceInquiryResponse
      include Smithy::Client::_Response[Types::CreateComplianceInquiryResponse]
      def compliance_inquiry_summary: () -> Types::InquirySummary?
      def tags: () -> Hash[String, String]?
    end
    def create_compliance_inquiry: (
      ?name: String,
      ?inquiry_content: {
        query: String,
        file_content: {
          file_sections: Array[String],
          content: String
        }
      },
      ?client_token: String,
      ?support_mode: String,
      ?tags: Hash[String, String]
    ) -> _CreateComplianceInquiryResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateComplianceInquiryResponse

    interface _ExportComplianceInquiryResponse
      include Smithy::Client::_Response[Types::ExportComplianceInquiryResponse]
      def document_presigned_url: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def export_compliance_inquiry: (
      ?compliance_inquiry_id: String,
      ?query_identifiers: Array[Integer],
      ?include_citations: bool
    ) -> _ExportComplianceInquiryResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ExportComplianceInquiryResponse

    interface _GetAccountSettingsResponse
