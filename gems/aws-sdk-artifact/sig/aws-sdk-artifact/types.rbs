module Aws::Artifact
  module Types

    module AcceptanceType
      PASSTHROUGH: String
      EXPLICIT: String
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccountSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?notification_subscription_status: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor notification_subscription_status: String?
    end

    module AgreementType
      CUSTOM: String
      DEFAULT: String
      MODIFIED: String
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
    end

    module CustomerAgreementState
      ACTIVE: String
      CUSTOMER_TERMINATED: String
      AWS_TERMINATED: String
    end

    class CustomerAgreementSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?arn: String,
        ?id: String,
        ?agreement_arn: String,
        ?aws_account_id: String,
        ?organization_arn: String,
        ?effective_start: Time,
        ?effective_end: Time,
        ?state: String,
        ?description: String,
        ?acceptance_terms: Array[String],
        ?terminate_terms: Array[String],
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor arn: String?
      attr_accessor id: String?
      attr_accessor agreement_arn: String?
      attr_accessor aws_account_id: String?
      attr_accessor organization_arn: String?
      attr_accessor effective_start: Time?
      attr_accessor effective_end: Time?
      attr_accessor state: String?
      attr_accessor description: String?
      attr_accessor acceptance_terms: Array[String]?
      attr_accessor terminate_terms: Array[String]?
      attr_accessor type: String?
    end

    class GetAccountSettingsRequest
      include Smithy::Schema::Structure

      def initialize: (
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

