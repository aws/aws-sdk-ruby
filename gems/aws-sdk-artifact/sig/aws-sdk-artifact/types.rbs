    class InquiryContent
      include Smithy::Schema::Union

      def initialize: (
        ?query: String,
        ?file_content: Types::InquiryFileContent,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor query: String?
      attr_accessor file_content: Types::InquiryFileContent?

      class Query < InquiryContent
      end
      class FileContent < InquiryContent
      end
      class Unknown < InquiryContent
      end
    end

