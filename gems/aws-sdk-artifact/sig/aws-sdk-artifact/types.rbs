    class ReportDetail
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?name: String,
        ?description: String,
        ?period_start: Time,
        ?period_end: Time,
        ?created_at: Time,
        ?last_modified_at: Time,
        ?deleted_at: Time,
        ?state: String,
        ?arn: String,
        ?series: String,
        ?category: String,
        ?company_name: String,
        ?product_name: String,
        ?term_arn: String,
        ?version: Integer,
        ?acceptance_type: String,
        ?sequence_number: Integer,
        ?upload_state: String,
        ?status_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor period_start: Time?
      attr_accessor period_end: Time?
      attr_accessor created_at: Time?
      attr_accessor last_modified_at: Time?
      attr_accessor deleted_at: Time?
      attr_accessor state: String?
      attr_accessor arn: String?
      attr_accessor series: String?
      attr_accessor category: String?
      attr_accessor company_name: String?
      attr_accessor product_name: String?
      attr_accessor term_arn: String?
      attr_accessor version: Integer?
      attr_accessor acceptance_type: String?
      attr_accessor sequence_number: Integer?
      attr_accessor upload_state: String?
      attr_accessor status_message: String?
    end

    class ReportSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?name: String,
        ?state: String,
        ?arn: String,
        ?version: Integer,
        ?upload_state: String,
        ?description: String,
        ?period_start: Time,
        ?period_end: Time,
        ?series: String,
        ?category: String,
        ?company_name: String,
        ?product_name: String,
        ?status_message: String,
        ?acceptance_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor name: String?
      attr_accessor state: String?
      attr_accessor arn: String?
      attr_accessor version: Integer?
      attr_accessor upload_state: String?
      attr_accessor description: String?
      attr_accessor period_start: Time?
      attr_accessor period_end: Time?
      attr_accessor series: String?
      attr_accessor category: String?
      attr_accessor company_name: String?
      attr_accessor product_name: String?
      attr_accessor status_message: String?
      attr_accessor acceptance_type: String?
    end

    class ResourceNotFoundException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
    end

    class ServiceQuotaExceededException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
        ?service_code: String,
        ?quota_code: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
      attr_accessor service_code: String?
      attr_accessor quota_code: String?
    end

    class ThrottlingException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?service_code: String,
        ?quota_code: String,
        ?retry_after_seconds: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor service_code: String?
      attr_accessor quota_code: String?
      attr_accessor retry_after_seconds: Integer?
    end

    module UploadState
      PROCESSING: String
      COMPLETE: String
      FAILED: String
      FAULT: String
    end

    class ValidationException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
        ?field_list: Array[Types::ValidationExceptionField],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor field_list: Array[Types::ValidationExceptionField]?
    end

    class ValidationExceptionField
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor message: String?
    end
  end
end
