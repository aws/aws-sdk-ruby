module Aws::OAM
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::OAM::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateLinkResponse
      include Smithy::Client::_Response[Types::CreateLinkOutput]
      def arn: () -> String?
      def id: () -> String?
      def label: () -> String?
      def label_template: () -> String?
      def resource_types: () -> Array[String]?
      def sink_arn: () -> String?
      def tags: () -> Hash[String, String]?
      def link_configuration: () -> Types::LinkConfiguration?
    end
    def create_link: (
      ?label_template: String,
      ?resource_types: Array[String],
      ?sink_identifier: String,
      ?tags: Hash[String, String],
      ?link_configuration: {
        log_group_configuration: {
          filter: String
        },
        metric_configuration: {
          filter: String
        }
      }
    ) -> _CreateLinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateLinkResponse

    interface _CreateSinkResponse
      include Smithy::Client::_Response[Types::CreateSinkOutput]
      def arn: () -> String?
      def id: () -> String?
      def name: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def create_sink: (
      ?name: String,
      ?tags: Hash[String, String]
    ) -> _CreateSinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateSinkResponse

    interface _DeleteLinkResponse
      include Smithy::Client::_Response[Types::DeleteLinkOutput]
    end
    def delete_link: (
      ?identifier: String
    ) -> _DeleteLinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteLinkResponse

    interface _DeleteSinkResponse
      include Smithy::Client::_Response[Types::DeleteSinkOutput]
    end
    def delete_sink: (
      ?identifier: String
    ) -> _DeleteSinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSinkResponse

    interface _GetLinkResponse
      include Smithy::Client::_Response[Types::GetLinkOutput]
      def arn: () -> String?
      def id: () -> String?
      def label: () -> String?
      def label_template: () -> String?
      def resource_types: () -> Array[String]?
      def sink_arn: () -> String?
      def tags: () -> Hash[String, String]?
      def link_configuration: () -> Types::LinkConfiguration?
    end
    def get_link: (
      ?identifier: String,
      ?include_tags: bool
    ) -> _GetLinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetLinkResponse

    interface _GetSinkResponse
      include Smithy::Client::_Response[Types::GetSinkOutput]
      def arn: () -> String?
      def id: () -> String?
      def name: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def get_sink: (
      ?identifier: String,
      ?include_tags: bool
    ) -> _GetSinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSinkResponse

    interface _GetSinkPolicyResponse
      include Smithy::Client::_Response[Types::GetSinkPolicyOutput]
      def sink_arn: () -> String?
      def sink_id: () -> String?
      def policy: () -> String?
    end
    def get_sink_policy: (
      ?sink_identifier: String
    ) -> _GetSinkPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSinkPolicyResponse

    interface _ListAttachedLinksResponse
      include Smithy::Client::_Response[Types::ListAttachedLinksOutput]
      def items: () -> Array[Types::ListAttachedLinksItem]?
      def next_token: () -> String?
    end
    def list_attached_links: (
      ?max_results: Integer,
      ?next_token: String,
      ?sink_identifier: String
    ) -> _ListAttachedLinksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListAttachedLinksResponse

    interface _ListLinksResponse
      include Smithy::Client::_Response[Types::ListLinksOutput]
      def items: () -> Array[Types::ListLinksItem]?
      def next_token: () -> String?
    end
    def list_links: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListLinksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListLinksResponse

    interface _ListSinksResponse
      include Smithy::Client::_Response[Types::ListSinksOutput]
      def items: () -> Array[Types::ListSinksItem]?
      def next_token: () -> String?
    end
    def list_sinks: (
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListSinksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSinksResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceOutput]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _PutSinkPolicyResponse
      include Smithy::Client::_Response[Types::PutSinkPolicyOutput]
      def sink_arn: () -> String?
      def sink_id: () -> String?
      def policy: () -> String?
    end
    def put_sink_policy: (
      ?sink_identifier: String,
      ?policy: String
    ) -> _PutSinkPolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutSinkPolicyResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceOutput]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceOutput]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateLinkResponse
      include Smithy::Client::_Response[Types::UpdateLinkOutput]
      def arn: () -> String?
      def id: () -> String?
      def label: () -> String?
      def label_template: () -> String?
      def resource_types: () -> Array[String]?
      def sink_arn: () -> String?
      def tags: () -> Hash[String, String]?
      def link_configuration: () -> Types::LinkConfiguration?
    end
    def update_link: (
      ?identifier: String,
      ?resource_types: Array[String],
      ?link_configuration: {
        log_group_configuration: {
          filter: String
        },
        metric_configuration: {
          filter: String
        }
      },
      ?include_tags: bool
    ) -> _UpdateLinkResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateLinkResponse
  end
end
