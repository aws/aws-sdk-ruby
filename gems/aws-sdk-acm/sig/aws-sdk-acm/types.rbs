    end

    class AcmCertificateMetadataFilter
      include Smithy::Schema::Union

      def initialize: (
        ?status: String,
        ?renewal_status: String,
        ?type: String,
        ?in_use: bool,
        ?exported: bool,
        ?export_option: String,
        ?managed_by: String,
