module Aws::ACM
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AddTagsToCertificateRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?certificate_arn: String,
        ?tags: Array[Types::Tag],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

