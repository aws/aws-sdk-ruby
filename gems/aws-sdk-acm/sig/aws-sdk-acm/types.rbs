    class CertificateSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?certificate_arn: String,
        ?domain_name: String,
        ?subject_alternative_name_summaries: Array[String],
        ?has_additional_subject_alternative_names: bool,
        ?status: String,
        ?type: String,
        ?key_algorithm: String,
        ?key_usages: Array[String],
        ?extended_key_usages: Array[String],
        ?export_option: String,
        ?in_use: bool,
        ?exported: bool,
        ?renewal_eligibility: String,
        ?not_before: Time,
        ?not_after: Time,
        ?created_at: Time,
        ?issued_at: Time,
        ?imported_at: Time,
        ?revoked_at: Time,
        ?managed_by: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor certificate_arn: String?
      attr_accessor domain_name: String?
      attr_accessor subject_alternative_name_summaries: Array[String]?
      attr_accessor has_additional_subject_alternative_names: bool?
      attr_accessor status: String?
      attr_accessor type: String?
      attr_accessor key_algorithm: String?
      attr_accessor key_usages: Array[String]?
      attr_accessor extended_key_usages: Array[String]?
      attr_accessor export_option: String?
      attr_accessor in_use: bool?
      attr_accessor exported: bool?
      attr_accessor renewal_eligibility: String?
      attr_accessor not_before: Time?
      attr_accessor not_after: Time?
      attr_accessor created_at: Time?
      attr_accessor issued_at: Time?
      attr_accessor imported_at: Time?
      attr_accessor revoked_at: Time?
      attr_accessor managed_by: String?
    end

