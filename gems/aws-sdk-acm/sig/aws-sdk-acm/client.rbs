        and: Array[
          {
            and: untyped,
            or: untyped,
            not: untyped,
            filter: {
              certificate_arn: String,
              x509_attribute_filter: {
                subject: {
                  common_name: {
                    value: String,
                    comparison_operator: String
                  }
                },
                subject_alternative_name: {
                  dns_name: {
                    value: untyped,
                    comparison_operator: untyped
                  }
                },
                extended_key_usage: String,
                key_usage: String,
                key_algorithm: String,
                serial_number: String,
                not_after: {
                  start: Time,
                  end: untyped
                },
                not_before: untyped
              },
              acm_certificate_metadata_filter: {
                status: String,
                renewal_status: String,
                type: String,
                in_use: bool,
                exported: untyped,
                export_option: String,
                managed_by: String,
                validation_method: String,
                certificate_key_pair_origin: String,
                acme_endpoint_arn: untyped,
                acme_account_id: String
              }
            }
          }
        ],
        or: untyped,
        not: untyped,
        filter: untyped
      },
      ?max_results: Integer,
      ?next_token: String,
      ?sort_by: String,
      ?sort_order: String
    ) -> _SearchCertificatesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchCertificatesResponse

