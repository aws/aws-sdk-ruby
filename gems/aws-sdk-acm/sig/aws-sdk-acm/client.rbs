module Aws::ACM
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::ACM::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AddTagsToCertificateResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def add_tags_to_certificate: (
      ?certificate_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _AddTagsToCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AddTagsToCertificateResponse

    interface _DeleteCertificateResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_certificate: (
      ?certificate_arn: String
    ) -> _DeleteCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteCertificateResponse

    interface _DescribeCertificateResponse
      include Smithy::Client::_Response[Types::DescribeCertificateResponse]
      def certificate: () -> Types::CertificateDetail?
    end
    def describe_certificate: (
      ?certificate_arn: String
    ) -> _DescribeCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeCertificateResponse

    interface _ExportCertificateResponse
      include Smithy::Client::_Response[Types::ExportCertificateResponse]
      def certificate: () -> String?
      def certificate_chain: () -> String?
      def private_key: () -> String?
    end
    def export_certificate: (
      ?certificate_arn: String,
      ?passphrase: String
    ) -> _ExportCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ExportCertificateResponse

    interface _GetAccountConfigurationResponse
      include Smithy::Client::_Response[Types::GetAccountConfigurationResponse]
      def expiry_events: () -> Types::ExpiryEventsConfiguration?
    end
    def get_account_configuration: (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAccountConfigurationResponse

    interface _GetCertificateResponse
      include Smithy::Client::_Response[Types::GetCertificateResponse]
      def certificate: () -> String?
      def certificate_chain: () -> String?
    end
    def get_certificate: (
      ?certificate_arn: String
    ) -> _GetCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetCertificateResponse

    interface _ImportCertificateResponse
      include Smithy::Client::_Response[Types::ImportCertificateResponse]
      def certificate_arn: () -> String?
    end
    def import_certificate: (
      ?certificate_arn: String,
      ?certificate: String,
      ?private_key: String,
      ?certificate_chain: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _ImportCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ImportCertificateResponse

    interface _ListCertificatesResponse
      include Smithy::Client::_Response[Types::ListCertificatesResponse]
      def next_token: () -> String?
      def certificate_summary_list: () -> Array[Types::CertificateSummary]?
    end
    def list_certificates: (
      ?certificate_statuses: Array[String],
      ?includes: {
        extended_key_usage: Array[String],
        key_usage: Array[String],
        key_types: Array[String],
        export_option: String,
        managed_by: String
      },
      ?next_token: String,
      ?max_items: Integer,
      ?sort_by: String,
      ?sort_order: String
    ) -> _ListCertificatesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListCertificatesResponse

    interface _ListTagsForCertificateResponse
      include Smithy::Client::_Response[Types::ListTagsForCertificateResponse]
      def tags: () -> Array[Types::Tag]?
    end
    def list_tags_for_certificate: (
      ?certificate_arn: String
    ) -> _ListTagsForCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForCertificateResponse

    interface _PutAccountConfigurationResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def put_account_configuration: (
      ?expiry_events: {
        days_before_expiry: Integer
      },
      ?idempotency_token: String
    ) -> _PutAccountConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutAccountConfigurationResponse

    interface _RemoveTagsFromCertificateResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def remove_tags_from_certificate: (
      ?certificate_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _RemoveTagsFromCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RemoveTagsFromCertificateResponse

    interface _RenewCertificateResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def renew_certificate: (
      ?certificate_arn: String
    ) -> _RenewCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RenewCertificateResponse

    interface _RequestCertificateResponse
      include Smithy::Client::_Response[Types::RequestCertificateResponse]
      def certificate_arn: () -> String?
    end
    def request_certificate: (
      ?domain_name: String,
      ?validation_method: String,
      ?subject_alternative_names: Array[String],
      ?idempotency_token: String,
      ?domain_validation_options: Array[
        {
          domain_name: String,
          validation_domain: untyped
        }
      ],
      ?options: {
        certificate_transparency_logging_preference: String,
        export: String
      },
      ?certificate_authority_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?key_algorithm: String,
      ?managed_by: String
    ) -> _RequestCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RequestCertificateResponse

    interface _ResendValidationEmailResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def resend_validation_email: (
      ?certificate_arn: String,
      ?domain: String,
      ?validation_domain: String
    ) -> _ResendValidationEmailResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ResendValidationEmailResponse

    interface _RevokeCertificateResponse
      include Smithy::Client::_Response[Types::RevokeCertificateResponse]
      def certificate_arn: () -> String?
    end
    def revoke_certificate: (
      ?certificate_arn: String,
      ?revocation_reason: String
    ) -> _RevokeCertificateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RevokeCertificateResponse

    interface _UpdateCertificateOptionsResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def update_certificate_options: (
      ?certificate_arn: String,
      ?options: {
        certificate_transparency_logging_preference: String,
        export: String
      }
    ) -> _UpdateCertificateOptionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateCertificateOptionsResponse
  end
end
