        ?snapshot_window: String,
        ?acl_name: String,
        ?auto_minor_version_upgrade: bool,
        ?data_tiering: String,
        ?network_type: String,
        ?ip_discovery: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor status: String?
