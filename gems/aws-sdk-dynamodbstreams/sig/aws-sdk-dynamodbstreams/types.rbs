      include Smithy::Schema::Structure

      def initialize: (
        ?principal_id: String,
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor principal_id: String?
      attr_accessor type: String?
    end

