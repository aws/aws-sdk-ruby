    class ShardFilter
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?shard_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor shard_id: String?
    end

    module ShardFilterType
      CHILD_SHARDS: String
    end

    module ShardIteratorType
      TRIM_HORIZON: String
      LATEST: String
      AT_SEQUENCE_NUMBER: String
      AFTER_SEQUENCE_NUMBER: String
    end

    class Stream
      include Smithy::Schema::Structure

      def initialize: (
        ?stream_arn: String,
        ?table_name: String,
        ?stream_label: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor stream_arn: String?
      attr_accessor table_name: String?
      attr_accessor stream_label: String?
    end

    class StreamDescription
      include Smithy::Schema::Structure

      def initialize: (
        ?stream_arn: String,
        ?stream_label: String,
        ?stream_status: String,
        ?stream_view_type: String,
        ?creation_request_date_time: Time,
        ?table_name: String,
        ?key_schema: Array[Types::KeySchemaElement],
        ?shards: Array[Types::Shard],
        ?last_evaluated_shard_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor stream_arn: String?
      attr_accessor stream_label: String?
      attr_accessor stream_status: String?
      attr_accessor stream_view_type: String?
      attr_accessor creation_request_date_time: Time?
      attr_accessor table_name: String?
      attr_accessor key_schema: Array[Types::KeySchemaElement]?
      attr_accessor shards: Array[Types::Shard]?
      attr_accessor last_evaluated_shard_id: String?
    end

    class StreamRecord
      include Smithy::Schema::Structure

      def initialize: (
        ?approximate_creation_date_time: Time,
        ?keys: Hash[String, Types::AttributeValue],
        ?new_image: Hash[String, Types::AttributeValue],
        ?old_image: Hash[String, Types::AttributeValue],
        ?sequence_number: String,
        ?size_bytes: Integer,
        ?stream_view_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor approximate_creation_date_time: Time?
      attr_accessor keys: Hash[String, Types::AttributeValue]?
      attr_accessor new_image: Hash[String, Types::AttributeValue]?
      attr_accessor old_image: Hash[String, Types::AttributeValue]?
      attr_accessor sequence_number: String?
      attr_accessor size_bytes: Integer?
      attr_accessor stream_view_type: String?
    end

    module StreamStatus
      ENABLING: String
      ENABLED: String
      DISABLING: String
      DISABLED: String
    end

    module StreamViewType
      NEW_IMAGE: String
      OLD_IMAGE: String
      NEW_AND_OLD_IMAGES: String
      KEYS_ONLY: String
    end

    class TrimmedDataAccessException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end
