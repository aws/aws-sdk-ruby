module Aws::ACMPCA
  module Types

    class ASN1Subject
      include Smithy::Schema::Structure

      def initialize: (
        ?country: String,
        ?organization: String,
        ?organizational_unit: String,
        ?distinguished_name_qualifier: String,
        ?state: String,
        ?common_name: String,
        ?serial_number: String,
        ?locality: String,
        ?title: String,
        ?surname: String,
        ?given_name: String,
        ?initials: String,
        ?pseudonym: String,
        ?generation_qualifier: String,
        ?custom_attributes: Array[Types::CustomAttribute],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor country: String?
      attr_accessor organization: String?
      attr_accessor organizational_unit: String?
      attr_accessor distinguished_name_qualifier: String?
      attr_accessor state: String?
      attr_accessor common_name: String?
      attr_accessor serial_number: String?
      attr_accessor locality: String?
      attr_accessor title: String?
      attr_accessor surname: String?
      attr_accessor given_name: String?
      attr_accessor initials: String?
      attr_accessor pseudonym: String?
      attr_accessor generation_qualifier: String?
      attr_accessor custom_attributes: Array[Types::CustomAttribute]?
    end

    class AccessDescription
      include Smithy::Schema::Structure

      def initialize: (
        ?access_method: Types::AccessMethod,
        ?access_location: Types::GeneralName,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor access_method: Types::AccessMethod?
      attr_accessor access_location: Types::GeneralName?
    end

    class AccessMethod
      include Smithy::Schema::Structure

      def initialize: (
        ?custom_object_identifier: String,
        ?access_method_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor custom_object_identifier: String?
      attr_accessor access_method_type: String?
    end

    module AccessMethodType
      CA_REPOSITORY: String
      RESOURCE_PKI_MANIFEST: String
      RESOURCE_PKI_NOTIFY: String
    end

    module ActionType
      IssueCertificate: String
      GetCertificate: String
      ListPermissions: String
    end

    class ApiPassthrough
      include Smithy::Schema::Structure

      def initialize: (
        ?extensions: Types::Extensions,
        ?subject: Types::ASN1Subject,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor extensions: Types::Extensions?
      attr_accessor subject: Types::ASN1Subject?
    end

    module AuditReportResponseFormat
      JSON: String
      CSV: String
    end

    module AuditReportStatus
      CREATING: String
      SUCCESS: String
      FAILED: String
    end

    class CertificateAuthority
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?owner_account: String,
        ?created_at: Time,
        ?last_state_change_at: Time,
        ?type: String,
        ?serial: String,
        ?status: String,
        ?not_before: Time,
        ?not_after: Time,
        ?failure_reason: String,
        ?certificate_authority_configuration: Types::CertificateAuthorityConfiguration,
        ?revocation_configuration: Types::RevocationConfiguration,
        ?restorable_until: Time,
        ?key_storage_security_standard: String,
        ?usage_mode: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor owner_account: String?
      attr_accessor created_at: Time?
      attr_accessor last_state_change_at: Time?
      attr_accessor type: String?
      attr_accessor serial: String?
      attr_accessor status: String?
      attr_accessor not_before: Time?
      attr_accessor not_after: Time?
      attr_accessor failure_reason: String?
      attr_accessor certificate_authority_configuration: Types::CertificateAuthorityConfiguration?
      attr_accessor revocation_configuration: Types::RevocationConfiguration?
      attr_accessor restorable_until: Time?
      attr_accessor key_storage_security_standard: String?
      attr_accessor usage_mode: String?
    end

    class CertificateAuthorityConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?key_algorithm: String,
        ?signing_algorithm: String,
        ?subject: Types::ASN1Subject,
        ?csr_extensions: Types::CsrExtensions,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor key_algorithm: String?
      attr_accessor signing_algorithm: String?
      attr_accessor subject: Types::ASN1Subject?
      attr_accessor csr_extensions: Types::CsrExtensions?
    end

    module CertificateAuthorityStatus
      CREATING: String
      PENDING_CERTIFICATE: String
      ACTIVE: String
      DELETED: String
      DISABLED: String
      EXPIRED: String
      FAILED: String
    end

    module CertificateAuthorityType
      ROOT: String
      SUBORDINATE: String
    end

    module CertificateAuthorityUsageMode
      GENERAL_PURPOSE: String
      SHORT_LIVED_CERTIFICATE: String
    end

