      attr_accessor tag_keys: ::Array[::String]
      SENSITIVE: []
    end

    class UserContext
      attr_accessor role: ("CLINICIAN")
      attr_accessor user_id: ::String
      attr_accessor specialty: ("PRIMARY_CARE")
      SENSITIVE: [:user_id]
    end

    class ValidationException
      attr_accessor message: ::String
      attr_accessor event_type: untyped
      SENSITIVE: []
    end

    class WebAppConfiguration
      attr_accessor ehr_role: ::String
      attr_accessor idc_application_id: ::String
      attr_accessor idc_region: ::String
      SENSITIVE: []
    end

    class MedicalScribeInputStream < Enumerator[untyped, untyped]
      def event_types: () -> [:audio_event, :binary_audio_event, :session_control_event, :configuration_event]
    end

    class MedicalScribeOutputStream < Enumerator[untyped, untyped]
      def event_types: () -> [:transcript_event, :internal_failure_exception, :validation_exception, :periodontal_chart_event, :checklist_event]
    end
  end
end
