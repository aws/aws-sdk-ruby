module Aws::CleanRoomsML
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AudienceDestination
      include Smithy::Schema::Structure

      def initialize: (
        ?s3_destination: Types::S3ConfigMap,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor s3_destination: Types::S3ConfigMap?
    end

    module AudienceExportJobStatus
      CREATE_PENDING: String
      CREATE_IN_PROGRESS: String
      CREATE_FAILED: String
      ACTIVE: String
    end

    class AudienceExportJobSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?create_time: Time,
        ?update_time: Time,
        ?name: String,
        ?audience_generation_job_arn: String,
        ?audience_size: Types::AudienceSize,
        ?description: String,
        ?status: String,
        ?status_details: Types::StatusDetails,
        ?output_location: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor create_time: Time?
      attr_accessor update_time: Time?
      attr_accessor name: String?
      attr_accessor audience_generation_job_arn: String?
      attr_accessor audience_size: Types::AudienceSize?
      attr_accessor description: String?
      attr_accessor status: String?
      attr_accessor status_details: Types::StatusDetails?
      attr_accessor output_location: String?
    end

