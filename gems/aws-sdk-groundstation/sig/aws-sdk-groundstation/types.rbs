      attr_accessor center_frequency: Types::Frequency?
      attr_accessor polarization: String?
    end

    module VersionFailureReasonCode
      INTERNAL_ERROR: String
      INVALID_SATELLITE_ARN: String
      INVALID_UPDATE_CONTACT_REQUEST: String
      EPHEMERIS_NOT_FOUND: String
      EPHEMERIS_TIME_RANGE_INVALID: String
      EPHEMERIS_NOT_ENABLED: String
      SATELLITE_DOES_NOT_MATCH_EPHEMERIS: String
      NOT_ONBOARDED_TO_AZEL_EPHEMERIS: String
      AZEL_EPHEMERIS_NOT_FOUND: String
      AZEL_EPHEMERIS_WRONG_GROUND_STATION: String
      AZEL_EPHEMERIS_INVALID_STATUS: String
      AZEL_EPHEMERIS_TIME_RANGE_INVALID: String
    end

    module VersionStatus
      UPDATING: String
      ACTIVE: String
      SUPERSEDED: String
      FAILED_TO_UPDATE: String
    end
  end
