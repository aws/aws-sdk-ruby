module Aws::GroundStation
  module Types

    class AgentDetails
      include Smithy::Schema::Structure

      def initialize: (
        ?agent_version: String,
        ?instance_id: String,
        ?instance_type: String,
        ?reserved_cpu_cores: Array[Integer],
        ?agent_cpu_cores: Array[Integer],
        ?component_versions: Array[Types::ComponentVersion],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor agent_version: String?
      attr_accessor instance_id: String?
      attr_accessor instance_type: String?
      attr_accessor reserved_cpu_cores: Array[Integer]?
      attr_accessor agent_cpu_cores: Array[Integer]?
      attr_accessor component_versions: Array[Types::ComponentVersion]?
    end

    module AgentStatus
      SUCCESS: String
