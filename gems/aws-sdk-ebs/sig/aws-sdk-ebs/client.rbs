module Aws::EBS
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::EBS::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CompleteSnapshotResponse
      include Smithy::Client::_Response[Types::CompleteSnapshotResponse]
      def status: () -> String?
    end
    def complete_snapshot: (
      ?snapshot_id: String,
      ?changed_blocks_count: Integer,
      ?checksum: String,
      ?checksum_algorithm: String,
      ?checksum_aggregation_method: String
    ) -> _CompleteSnapshotResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CompleteSnapshotResponse

    interface _GetSnapshotBlockResponse
      include Smithy::Client::_Response[Types::GetSnapshotBlockResponse]
      def data_length: () -> Integer?
      def block_data: () -> String?
      def checksum: () -> String?
      def checksum_algorithm: () -> String?
    end
    def get_snapshot_block: (
      ?snapshot_id: String,
      ?block_index: Integer,
      ?block_token: String
    ) -> _GetSnapshotBlockResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSnapshotBlockResponse

    interface _ListChangedBlocksResponse
      include Smithy::Client::_Response[Types::ListChangedBlocksResponse]
      def changed_blocks: () -> Array[Types::ChangedBlock]?
      def expiry_time: () -> Time?
      def volume_size: () -> Integer?
      def block_size: () -> Integer?
      def next_token: () -> String?
    end
    def list_changed_blocks: (
      ?first_snapshot_id: String,
      ?second_snapshot_id: String,
      ?next_token: String,
      ?max_results: Integer,
      ?starting_block_index: Integer
    ) -> _ListChangedBlocksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListChangedBlocksResponse

    interface _ListSnapshotBlocksResponse
      include Smithy::Client::_Response[Types::ListSnapshotBlocksResponse]
      def blocks: () -> Array[Types::Block]?
      def expiry_time: () -> Time?
      def volume_size: () -> Integer?
      def block_size: () -> Integer?
      def next_token: () -> String?
    end
    def list_snapshot_blocks: (
      ?snapshot_id: String,
      ?next_token: String,
      ?max_results: Integer,
      ?starting_block_index: Integer
    ) -> _ListSnapshotBlocksResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSnapshotBlocksResponse

    interface _PutSnapshotBlockResponse
      include Smithy::Client::_Response[Types::PutSnapshotBlockResponse]
      def checksum: () -> String?
      def checksum_algorithm: () -> String?
    end
    def put_snapshot_block: (
      ?snapshot_id: String,
      ?block_index: Integer,
      ?block_data: String,
      ?data_length: Integer,
      ?progress: Integer,
      ?checksum: String,
      ?checksum_algorithm: String
    ) -> _PutSnapshotBlockResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutSnapshotBlockResponse

    interface _StartSnapshotResponse
      include Smithy::Client::_Response[Types::StartSnapshotResponse]
      def description: () -> String?
      def snapshot_id: () -> String?
      def owner_id: () -> String?
      def status: () -> String?
      def start_time: () -> Time?
      def volume_size: () -> Integer?
      def block_size: () -> Integer?
      def tags: () -> Array[Types::Tag]?
      def parent_snapshot_id: () -> String?
      def kms_key_arn: () -> String?
      def sse_type: () -> String?
    end
    def start_snapshot: (
      ?volume_size: Integer,
      ?parent_snapshot_id: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ],
      ?description: String,
      ?client_token: String,
      ?encrypted: bool,
      ?kms_key_arn: String,
      ?timeout: Integer
    ) -> _StartSnapshotResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSnapshotResponse
  end
end
