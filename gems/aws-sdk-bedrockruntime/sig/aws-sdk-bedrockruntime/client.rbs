module Aws::BedrockRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::BedrockRuntime::EndpointProvider,
      ?http_bearer_provider: Smithy::Client::HttpBearerProvider,
      ?http_bearer_token: String,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _ApplyGuardrailResponse
      include Smithy::Client::_Response[Types::ApplyGuardrailResponse]
      def usage: () -> Types::GuardrailUsage?
      def action: () -> String?
      def action_reason: () -> String?
      def outputs: () -> Array[Types::GuardrailOutputContent]?
      def assessments: () -> Array[Types::GuardrailAssessment]?
      def guardrail_coverage: () -> Types::GuardrailCoverage?
    end
    def apply_guardrail: (
      ?guardrail_identifier: String,
      ?guardrail_version: String,
      ?source: String,
      ?content: Array[
        {
          text: {
            text: String,
            qualifiers: Array[String]
          },
          image: {
            format: String,
            source: {
              bytes: String
            }
          }
        }
      ],
      ?output_scope: String
    ) -> _ApplyGuardrailResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ApplyGuardrailResponse

    interface _ConverseResponse
      include Smithy::Client::_Response[Types::ConverseResponse]
      def output: () -> Types::ConverseOutput?
