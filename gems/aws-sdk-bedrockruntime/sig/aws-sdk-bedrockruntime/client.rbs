            },
            image: {
              format: String,
              source: {
                bytes: String
              }
            }
          },
          cache_point: {
            type: String
          }
        }
      ],
      ?inference_config: {
        max_tokens: Integer,
        temperature: Float,
        top_p: untyped,
        stop_sequences: Array[String]
      },
      ?tool_config: {
        tools: Array[
          {
            tool_spec: {
              name: String,
              description: String,
              input_schema: {
                json: Smithy::Schema::document
              }
            },
            cache_point: {
              type: String
            }
          }
        ],
        tool_choice: {
          auto: {
          },
          any: {
          },
          tool: {
            name: untyped
          }
        }
      },
      ?guardrail_config: {
        guardrail_identifier: String,
        guardrail_version: String,
        trace: String
