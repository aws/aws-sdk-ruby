    interface _GetAsyncInvokeResponse
      include Smithy::Client::_Response[Types::GetAsyncInvokeResponse]
      def invocation_arn: () -> String?
      def model_arn: () -> String?
      def client_request_token: () -> String?
      def status: () -> String?
      def failure_message: () -> String?
      def submit_time: () -> Time?
      def last_modified_time: () -> Time?
      def end_time: () -> Time?
      def output_data_config: () -> Types::AsyncInvokeOutputDataConfig?
    end
    def get_async_invoke: (
      ?invocation_arn: String
    ) -> _GetAsyncInvokeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAsyncInvokeResponse

    interface _InvokeModelResponse
      include Smithy::Client::_Response[Types::InvokeModelResponse]
      def body: () -> String?
      def content_type: () -> String?
      def performance_config_latency: () -> String?
    end
