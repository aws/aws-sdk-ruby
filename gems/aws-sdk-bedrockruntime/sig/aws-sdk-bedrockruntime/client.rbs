                  {
                    json: untyped,
                    text: untyped,
                    image: untyped,
                    document: untyped,
                    video: untyped
                  }
                ],
                status: String
              },
              guard_content: {
                text: {
                  text: untyped,
                  qualifiers: Array[String]
                },
                image: {
                  format: String,
                  source: {
                    bytes: untyped
                  }
                }
              },
              cache_point: {
                type: String
              },
              reasoning_content: {
                reasoning_text: {
                  text: untyped,
                  signature: untyped
                },
                redacted_content: untyped
              },
              citations_content: {
                content: Array[
                  {
                    text: untyped
                  }
                ],
                citations: Array[
                  {
                    title: untyped,
                    source_content: Array[
                      {
                        text: untyped
                      }
                    ],
                    location: {
                      document_char: {
                        document_index: Integer,
                        start: untyped,
                        end: untyped
                      },
                      document_page: {
                        document_index: untyped,
                        start: untyped,
                        end: untyped
                      },
                      document_chunk: {
                        document_index: untyped,
                        start: untyped,
                        end: untyped
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ],
      ?system: Array[
        {
          text: String,
          guard_content: {
            text: {
