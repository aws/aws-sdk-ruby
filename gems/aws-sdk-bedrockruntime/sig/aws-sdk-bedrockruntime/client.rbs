      ?additional_model_response_field_paths: Array[String],
      ?request_metadata: Hash[String, String],
      ?performance_config: {
        latency: String
      }
    ) -> _ConverseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ConverseResponse

