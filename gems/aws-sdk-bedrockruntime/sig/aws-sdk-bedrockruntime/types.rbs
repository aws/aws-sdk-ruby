    class ConverseStreamOutput
      include Smithy::Schema::Union

      def initialize: (
        ?message_start: Types::MessageStartEvent,
        ?content_block_start: Types::ContentBlockStartEvent,
        ?content_block_delta: Types::ContentBlockDeltaEvent,
        ?content_block_stop: Types::ContentBlockStopEvent,
