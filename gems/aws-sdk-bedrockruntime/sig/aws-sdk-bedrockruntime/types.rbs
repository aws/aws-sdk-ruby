      attr_accessor content_block_start: Types::ContentBlockStartEvent?
      attr_accessor content_block_delta: Types::ContentBlockDeltaEvent?
      attr_accessor content_block_stop: Types::ContentBlockStopEvent?
      attr_accessor message_stop: Types::MessageStopEvent?
      attr_accessor metadata: Types::ConverseStreamMetadataEvent?
      attr_accessor internal_server_exception: Types::InternalServerException?
      attr_accessor model_stream_error_exception: Types::ModelStreamErrorException?
      attr_accessor validation_exception: Types::ValidationException?
      attr_accessor throttling_exception: Types::ThrottlingException?
      attr_accessor service_unavailable_exception: Types::ServiceUnavailableException?

      class MessageStart < ConverseStreamOutput
      end
      class ContentBlockStart < ConverseStreamOutput
      end
      class ContentBlockDelta < ConverseStreamOutput
      end
      class ContentBlockStop < ConverseStreamOutput
      end
      class MessageStop < ConverseStreamOutput
      end
      class Metadata < ConverseStreamOutput
      end
      class InternalServerException < ConverseStreamOutput
      end
      class ModelStreamErrorException < ConverseStreamOutput
      end
      class ValidationException < ConverseStreamOutput
      end
      class ThrottlingException < ConverseStreamOutput
      end
      class ServiceUnavailableException < ConverseStreamOutput
      end
      class Unknown < ConverseStreamOutput
      end
    end

