module Aws::BedrockRuntime
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ModelErrorException < Smithy::Client::ServiceError
      def message: () -> String?
      def original_status_code: () -> Integer?
      def resource_name: () -> String?
    end
    class ModelNotReadyException < Smithy::Client::ServiceError
      def message: () -> String?
      def retryable?: () -> true
    end
    class ModelStreamErrorException < Smithy::Client::ServiceError
      def message: () -> String?
      def original_status_code: () -> Integer?
      def original_message: () -> String?
    end
    class ModelTimeoutException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceUnavailableException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
