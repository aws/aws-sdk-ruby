      class Aggregation < AnalysisRulePolicyV1
      end
      class Custom < AnalysisRulePolicyV1
      end
      class IdMappingTable < AnalysisRulePolicyV1
      end
      class Unknown < AnalysisRulePolicyV1
      end
    end

