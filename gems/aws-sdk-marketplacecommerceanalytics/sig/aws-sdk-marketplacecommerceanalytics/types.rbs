module Aws::MarketplaceCommerceAnalytics
  module Types

    module DataSetType
      CUSTOMER_SUBSCRIBER_HOURLY_MONTHLY_SUBSCRIPTIONS: String
      CUSTOMER_SUBSCRIBER_ANNUAL_SUBSCRIPTIONS: String
      DAILY_BUSINESS_USAGE_BY_INSTANCE_TYPE: String
      DAILY_BUSINESS_FEES: String
      DAILY_BUSINESS_FREE_TRIAL_CONVERSIONS: String
      DAILY_BUSINESS_NEW_INSTANCES: String
      DAILY_BUSINESS_NEW_PRODUCT_SUBSCRIBERS: String
      DAILY_BUSINESS_CANCELED_PRODUCT_SUBSCRIBERS: String
      MONTHLY_REVENUE_BILLING_AND_REVENUE_DATA: String
      MONTHLY_REVENUE_ANNUAL_SUBSCRIPTIONS: String
      MONTHLY_REVENUE_FIELD_DEMONSTRATION_USAGE: String
      MONTHLY_REVENUE_FLEXIBLE_PAYMENT_SCHEDULE: String
      DISBURSED_AMOUNT_BY_PRODUCT: String
      DISBURSED_AMOUNT_BY_PRODUCT_WITH_UNCOLLECTED_FUNDS: String
      DISBURSED_AMOUNT_BY_INSTANCE_HOURS: String
      DISBURSED_AMOUNT_BY_CUSTOMER_GEO: String
      DISBURSED_AMOUNT_BY_AGE_OF_UNCOLLECTED_FUNDS: String
      DISBURSED_AMOUNT_BY_AGE_OF_DISBURSED_FUNDS: String
      DISBURSED_AMOUNT_BY_AGE_OF_PAST_DUE_FUNDS: String
      DISBURSED_AMOUNT_BY_UNCOLLECTED_FUNDS_BREAKDOWN: String
