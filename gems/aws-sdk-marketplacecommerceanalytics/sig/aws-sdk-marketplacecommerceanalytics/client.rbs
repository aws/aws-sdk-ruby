module Aws::MarketplaceCommerceAnalytics
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::MarketplaceCommerceAnalytics::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GenerateDataSetResponse
      include Smithy::Client::_Response[Types::GenerateDataSetResult]
      def data_set_request_id: () -> String?
    end
    def generate_data_set: (
      ?data_set_type: String,
      ?data_set_publication_date: Time,
      ?role_name_arn: String,
      ?destination_s3_bucket_name: String,
      ?destination_s3_prefix: String,
      ?sns_topic_arn: String,
      ?customer_defined_values: Hash[String, String]
    ) -> _GenerateDataSetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GenerateDataSetResponse

    interface _StartSupportDataExportResponse
      include Smithy::Client::_Response[Types::StartSupportDataExportResult]
      def data_set_request_id: () -> String?
    end
    def start_support_data_export: (
      ?data_set_type: String,
      ?from_date: Time,
      ?role_name_arn: String,
      ?destination_s3_bucket_name: String,
      ?destination_s3_prefix: String,
      ?sns_topic_arn: String,
      ?customer_defined_values: Hash[String, String]
    ) -> _StartSupportDataExportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartSupportDataExportResponse
