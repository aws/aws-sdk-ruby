      attr_accessor height: Integer?
      attr_accessor key: String?
      attr_accessor label_size: String?
      attr_accessor language: String?
      attr_accessor padding: Integer?
      attr_accessor political_view: String?
      attr_accessor points_of_interests: String?
      attr_accessor radius: Integer?
      attr_accessor file_name: String?
      attr_accessor scale_bar_unit: String?
      attr_accessor style: String?
      attr_accessor width: Integer?
      attr_accessor zoom: Float?
    end

