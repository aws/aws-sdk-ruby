module Aws::GeoMaps
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module Buildings
      BUILDINGS_3D: String
    end

    module ColorScheme
      LIGHT: String
      DARK: String
    end

    module ContourDensity
      LOW: String
