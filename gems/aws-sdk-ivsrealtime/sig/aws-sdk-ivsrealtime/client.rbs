    interface _StartCompositionResponse
      include Smithy::Client::_Response[Types::StartCompositionResponse]
      def composition: () -> Types::Composition?
    end
    def start_composition: (
      ?stage_arn: String,
      ?idempotency_token: String,
      ?layout: {
        grid: {
          featured_participant_attribute: String,
          omit_stopped_video: bool,
          video_aspect_ratio: String,
          video_fill_mode: String,
          grid_gap: Integer
        },
        pip: {
          featured_participant_attribute: untyped,
          omit_stopped_video: untyped,
          video_fill_mode: untyped,
          grid_gap: untyped,
          pip_participant_attribute: untyped,
          pip_behavior: String,
          pip_offset: Integer,
          pip_position: String,
          pip_width: Integer,
          pip_height: Integer
        }
      },
      ?destinations: Array[
        {
          name: String,
          channel: {
            channel_arn: String,
            encoder_configuration_arn: String
          },
          s3: {
            storage_configuration_arn: String,
            encoder_configuration_arns: Array[String],
            recording_configuration: {
              hls_configuration: {
                target_segment_duration_seconds: Integer
              },
              format: String
            },
            thumbnail_configurations: Array[
              {
                target_interval_seconds: Integer,
                storage: Array[String]
              }
            ]
          }
        }
      ],
      ?tags: Hash[String, String]
    ) -> _StartCompositionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartCompositionResponse

