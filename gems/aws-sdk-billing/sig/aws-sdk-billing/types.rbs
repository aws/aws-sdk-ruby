module Aws::Billing
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ActiveTimeRange
      include Smithy::Schema::Structure

      def initialize: (
        ?active_after_inclusive: Time,
        ?active_before_inclusive: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor active_after_inclusive: Time?
      attr_accessor active_before_inclusive: Time?
    end

    class BillingViewElement
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?name: String,
        ?description: String,
        ?billing_view_type: String,
        ?owner_account_id: String,
        ?data_filter_expression: Types::Expression,
        ?created_at: Time,
        ?updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor billing_view_type: String?
      attr_accessor owner_account_id: String?
      attr_accessor data_filter_expression: Types::Expression?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
    end

