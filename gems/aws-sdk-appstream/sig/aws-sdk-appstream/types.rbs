module Aws::AppStream
  module Types

    class AccessEndpoint
      include Smithy::Schema::Structure

      def initialize: (
        ?endpoint_type: String,
        ?vpce_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor endpoint_type: String?
      attr_accessor vpce_id: String?
    end

    module AccessEndpointType
      STREAMING: String
    end

    module Action
      CLIPBOARD_COPY_FROM_LOCAL_DEVICE: String
