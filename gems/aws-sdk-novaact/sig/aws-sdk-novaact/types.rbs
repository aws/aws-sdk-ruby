module Aws::NovaAct
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ActError
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor type: String?
    end

    module ActStatus
      RUNNING: String
      PENDING_CLIENT_ACTION: String
      PENDING_HUMAN_ACTION: String
      SUCCEEDED: String
      FAILED: String
      TIMED_OUT: String
    end

    class ActSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?workflow_run_id: String,
        ?session_id: String,
        ?act_id: String,
        ?status: String,
        ?started_at: Time,
        ?ended_at: Time,
        ?trace_location: Types::TraceLocation,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor workflow_run_id: String?
      attr_accessor session_id: String?
      attr_accessor act_id: String?
      attr_accessor status: String?
      attr_accessor started_at: Time?
      attr_accessor ended_at: Time?
      attr_accessor trace_location: Types::TraceLocation?
    end

    class Call
      include Smithy::Schema::Structure

      def initialize: (
        ?call_id: String,
        ?input: Smithy::Schema::document,
        ?name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor call_id: String?
      attr_accessor input: Smithy::Schema::document?
      attr_accessor name: String?
    end

    class CallResult
      include Smithy::Schema::Structure

      def initialize: (
        ?call_id: String,
        ?content: Array[Types::CallResultContent],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor call_id: String?
      attr_accessor content: Array[Types::CallResultContent]?
    end

    class CallResultContent
      include Smithy::Schema::Union

      def initialize: (
        ?text: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor text: String?

      class Text < CallResultContent
      end
      class Unknown < CallResultContent
      end
    end

    class ClientInfo
      include Smithy::Schema::Structure

      def initialize: (
        ?compatibility_version: Integer,
        ?sdk_version: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor compatibility_version: Integer?
      attr_accessor sdk_version: String?
    end

    class CompatibilityInformation
      include Smithy::Schema::Structure

      def initialize: (
        ?client_compatibility_version: Integer,
        ?supported_model_ids: Array[String],
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor client_compatibility_version: Integer?
      attr_accessor supported_model_ids: Array[String]?
      attr_accessor message: String?
    end

