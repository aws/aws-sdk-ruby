    interface _CreateClusterResponse
      include Smithy::Client::_Response[Types::CreateClusterResponse]
      def cluster_arn: () -> String?
      def cluster_name: () -> String?
      def state: () -> String?
    end
    def create_cluster: (
      ?broker_node_group_info: {
        broker_az_distribution: String,
        client_subnets: Array[String],
        instance_type: String,
        security_groups: untyped,
        storage_info: {
          ebs_storage_info: {
            provisioned_throughput: {
              enabled: bool,
              volume_throughput: Integer
            },
            volume_size: Integer
          }
        },
        connectivity_info: {
          public_access: {
            type: String
          },
          vpc_connectivity: {
            client_authentication: {
              sasl: {
                scram: {
                  enabled: untyped
                },
                iam: {
                  enabled: untyped
                }
              },
              tls: {
                enabled: untyped
              }
            }
          }
        },
        zone_ids: untyped
      },
      ?client_authentication: {
        sasl: {
          scram: {
            enabled: bool
          },
          iam: {
            enabled: untyped
          }
        },
        tls: {
          certificate_authority_arn_list: Array[String],
          enabled: untyped
        },
        unauthenticated: {
          enabled: untyped
        }
      },
      ?cluster_name: String,
      ?configuration_info: {
        arn: String,
        revision: Integer
      },
      ?encryption_info: {
        encryption_at_rest: {
          data_volume_kms_key_id: String
        },
        encryption_in_transit: {
          client_broker: String,
          in_cluster: bool
        }
      },
      ?enhanced_monitoring: String,
      ?open_monitoring: {
        prometheus: {
          jmx_exporter: {
            enabled_in_broker: bool
          },
          node_exporter: {
            enabled_in_broker: untyped
          }
        }
      },
      ?kafka_version: String,
      ?logging_info: {
        broker_logs: {
          cloud_watch_logs: {
            enabled: bool,
            log_group: String
          },
          firehose: {
            delivery_stream: untyped,
            enabled: untyped
          },
          s3: {
            bucket: untyped,
            enabled: untyped,
            prefix: untyped
          }
        }
      },
      ?number_of_broker_nodes: Integer,
      ?tags: Hash[String, String],
      ?storage_mode: String
    ) -> _CreateClusterResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateClusterResponse

