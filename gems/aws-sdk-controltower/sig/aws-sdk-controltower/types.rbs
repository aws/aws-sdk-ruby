module Aws::ControlTower
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class BaselineOperation
      include Smithy::Schema::Structure

      def initialize: (
        ?operation_identifier: String,
        ?operation_type: String,
        ?status: String,
        ?start_time: Time,
        ?end_time: Time,
        ?status_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor operation_identifier: String?
      attr_accessor operation_type: String?
      attr_accessor status: String?
      attr_accessor start_time: Time?
      attr_accessor end_time: Time?
      attr_accessor status_message: String?
    end

    module BaselineOperationStatus
      SUCCEEDED: String
      FAILED: String
      IN_PROGRESS: String
    end

    module BaselineOperationType
      ENABLE_BASELINE: String
      DISABLE_BASELINE: String
      UPDATE_ENABLED_BASELINE: String
      RESET_ENABLED_BASELINE: String
    end

