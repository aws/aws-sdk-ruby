    ) -> _SendMessageResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendMessageResponse

    interface _StartAttachmentUploadResponse
      include Smithy::Client::_Response[Types::StartAttachmentUploadResponse]
      def attachment_id: () -> String?
      def upload_metadata: () -> Types::UploadMetadata?
    end
    def start_attachment_upload: (
      ?content_type: String,
      ?attachment_size_in_bytes: Integer,
      ?attachment_name: String,
