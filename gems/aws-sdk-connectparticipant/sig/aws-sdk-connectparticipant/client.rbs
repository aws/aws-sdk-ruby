      },
      ?connection_token: String
    ) -> _GetTranscriptResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetTranscriptResponse

    interface _SendEventResponse
      include Smithy::Client::_Response[Types::SendEventResponse]
      def id: () -> String?
      def absolute_time: () -> String?
    end
    def send_event: (
      ?content_type: String,
      ?content: String,
      ?client_token: String,
