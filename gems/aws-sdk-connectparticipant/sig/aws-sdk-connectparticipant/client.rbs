    interface _SendMessageResponse
      include Smithy::Client::_Response[Types::SendMessageResponse]
      def id: () -> String?
      def absolute_time: () -> String?
    end
    def send_message: (
      ?content_type: String,
      ?content: String,
      ?client_token: String,
