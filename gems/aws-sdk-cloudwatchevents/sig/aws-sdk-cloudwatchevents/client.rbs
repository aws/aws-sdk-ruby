      def state_reason: () -> String?
      def replay_start_time: () -> Time?
    end
    def start_replay: (
      ?replay_name: String,
      ?description: String,
      ?event_source_arn: String,
      ?event_start_time: Time,
      ?event_end_time: Time,
      ?destination: {
        arn: String,
        filter_arns: Array[String]
      }
    ) -> _StartReplayResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartReplayResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _TestEventPatternResponse
      include Smithy::Client::_Response[Types::TestEventPatternResponse]
      def result: () -> bool?
    end
    def test_event_pattern: (
      ?event_pattern: String,
      ?event: String
    ) -> _TestEventPatternResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TestEventPatternResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateApiDestinationResponse
      include Smithy::Client::_Response[Types::UpdateApiDestinationResponse]
      def api_destination_arn: () -> String?
      def api_destination_state: () -> String?
      def creation_time: () -> Time?
      def last_modified_time: () -> Time?
    end
    def update_api_destination: (
      ?name: String,
      ?description: String,
      ?connection_arn: String,
      ?invocation_endpoint: String,
      ?http_method: String,
      ?invocation_rate_limit_per_second: Integer
    ) -> _UpdateApiDestinationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateApiDestinationResponse

    interface _UpdateArchiveResponse
      include Smithy::Client::_Response[Types::UpdateArchiveResponse]
      def archive_arn: () -> String?
      def state: () -> String?
      def state_reason: () -> String?
      def creation_time: () -> Time?
    end
    def update_archive: (
      ?archive_name: String,
      ?description: String,
      ?event_pattern: String,
      ?retention_days: Integer
    ) -> _UpdateArchiveResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateArchiveResponse

    interface _UpdateConnectionResponse
      include Smithy::Client::_Response[Types::UpdateConnectionResponse]
      def connection_arn: () -> String?
      def connection_state: () -> String?
      def creation_time: () -> Time?
      def last_modified_time: () -> Time?
      def last_authorized_time: () -> Time?
    end
    def update_connection: (
      ?name: String,
      ?description: String,
      ?authorization_type: String,
      ?auth_parameters: {
        basic_auth_parameters: {
          username: String,
          password: String
        },
        o_auth_parameters: {
          client_parameters: {
            client_id: untyped,
            client_secret: untyped
          },
          authorization_endpoint: String,
          http_method: String,
          o_auth_http_parameters: {
            header_parameters: Array[
              {
                key: String,
                value: String,
                is_value_secret: bool
              }
            ],
            query_string_parameters: Array[
              {
                key: String,
                value: String,
                is_value_secret: untyped
              }
            ],
            body_parameters: Array[
              {
                key: String,
                value: String,
                is_value_secret: untyped
              }
            ]
          }
        },
        api_key_auth_parameters: {
          api_key_name: untyped,
          api_key_value: untyped
        },
        invocation_http_parameters: untyped
      }
    ) -> _UpdateConnectionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateConnectionResponse
  end
end
