    interface _CreateApplicationResponse
      include Smithy::Client::_Response[Types::CreateApplicationOutput]
      def application_id: () -> String?
      def name: () -> String?
      def arn: () -> String?
    end
    def create_application: (
      ?name: String,
      ?release_label: String,
      ?type: String,
      ?client_token: String,
      ?initial_capacity: Hash[String,
        {
          worker_count: Integer,
          worker_configuration: {
            cpu: String,
            memory: String,
            disk: String,
            disk_type: String
          }
        }
      ],
      ?maximum_capacity: {
        cpu: String,
        memory: String,
        disk: String
      },
      ?tags: Hash[String, String],
      ?auto_start_configuration: {
        enabled: bool
      },
      ?auto_stop_configuration: {
        enabled: bool,
        idle_timeout_minutes: Integer
      },
      ?network_configuration: {
        subnet_ids: Array[String],
        security_group_ids: Array[String]
      },
      ?architecture: String,
      ?image_configuration: {
        image_uri: String,
        application_level_digest_resolution: bool
      },
      ?worker_type_specifications: Hash[String,
        {
          image_configuration: {
            image_uri: String,
            application_level_digest_resolution: bool
          }
        }
      ],
      ?runtime_configuration: Array[
        {
          classification: String,
          properties: Hash[String, String],
          configurations: untyped
        }
      ],
      ?monitoring_configuration: {
        s3_monitoring_configuration: {
          log_uri: String,
          encryption_key_arn: String
        },
        managed_persistence_monitoring_configuration: {
          enabled: bool,
          encryption_key_arn: untyped
        },
        cloud_watch_logging_configuration: {
          enabled: untyped,
          log_group_name: String,
          log_stream_name_prefix: String,
          encryption_key_arn: untyped,
          log_types: Hash[String,
            Array[String]
          ]
        },
        prometheus_monitoring_configuration: {
          remote_write_url: String
        }
      },
      ?disk_encryption_configuration: {
        encryption_context: Hash[String, String],
        encryption_key_arn: String
      },
      ?interactive_configuration: {
        studio_enabled: bool,
        livy_endpoint_enabled: untyped,
        session_enabled: untyped
      },
      ?scheduler_configuration: {
        queue_timeout_minutes: Integer,
        max_concurrent_runs: untyped
      },
      ?identity_center_configuration: {
        identity_center_instance_arn: String,
        user_background_sessions_enabled: bool
      },
      ?job_level_cost_allocation_configuration: {
        enabled: bool
      }
    ) -> _CreateApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateApplicationResponse

