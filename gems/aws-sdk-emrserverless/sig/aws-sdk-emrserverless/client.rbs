      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CancelJobRunResponse
      include Smithy::Client::_Response[Types::CancelJobRunOutput]
      def application_id: () -> String?
      def job_run_id: () -> String?
    end
