    def create_program: (
      ?ad_breaks: Array[
        {
          message_type: String,
          offset_millis: Integer,
          slate: {
            source_location_name: String,
            vod_source_name: untyped
          },
          splice_insert_message: {
            avail_num: Integer,
            avails_expected: untyped,
            splice_event_id: untyped,
            unique_program_id: untyped
          },
          time_signal_message: {
            segmentation_descriptors: Array[
              {
                segmentation_event_id: Integer,
                segmentation_upid_type: untyped,
                segmentation_upid: String,
                segmentation_type_id: untyped,
                segment_num: untyped,
                segments_expected: untyped,
                sub_segment_num: untyped,
                sub_segments_expected: untyped
              }
            ]
          },
          ad_break_metadata: Array[
            {
              key: untyped,
              value: untyped
            }
          ]
        }
      ],
      ?channel_name: String,
      ?live_source_name: String,
      ?program_name: String,
      ?schedule_configuration: {
        transition: {
          duration_millis: Integer,
          relative_position: String,
          relative_program: String,
          scheduled_start_time_millis: untyped,
          type: untyped
        },
        clip_range: {
          end_offset_millis: untyped,
          start_offset_millis: untyped
        }
      },
      ?source_location_name: String,
      ?vod_source_name: String,
      ?audience_media: Array[
        {
          audience: String,
          alternate_media: Array[
            {
              source_location_name: untyped,
              live_source_name: untyped,
              vod_source_name: untyped,
              clip_range: {
                end_offset_millis: Integer,
                start_offset_millis: untyped
              },
              scheduled_start_time_millis: untyped,
              ad_breaks: Array[
                {
                  message_type: String,
                  offset_millis: untyped,
                  slate: {
                    source_location_name: untyped,
                    vod_source_name: untyped
                  },
                  splice_insert_message: {
                    avail_num: Integer,
                    avails_expected: untyped,
                    splice_event_id: untyped,
                    unique_program_id: untyped
                  },
                  time_signal_message: {
                    segmentation_descriptors: Array[
                      {
                        segmentation_event_id: Integer,
                        segmentation_upid_type: untyped,
                        segmentation_upid: String,
                        segmentation_type_id: untyped,
                        segment_num: untyped,
                        segments_expected: untyped,
                        sub_segment_num: untyped,
                        sub_segments_expected: untyped
                      }
                    ]
                  },
                  ad_break_metadata: Array[
                    {
                      key: untyped,
                      value: untyped
                    }
                  ]
                }
              ],
              duration_millis: untyped
            }
          ]
        }
      ]
    ) -> _CreateProgramResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateProgramResponse

