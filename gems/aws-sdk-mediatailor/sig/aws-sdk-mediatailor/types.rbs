module Aws::MediaTailor
  module Types

    class AccessConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?access_type: String,
        ?secrets_manager_access_token_configuration: Types::SecretsManagerAccessTokenConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor access_type: String?
      attr_accessor secrets_manager_access_token_configuration: Types::SecretsManagerAccessTokenConfiguration?
    end

    module AccessType
      S3_SIGV4: String
      SECRETS_MANAGER_ACCESS_TOKEN: String
      AUTODETECT_SIGV4: String
    end

