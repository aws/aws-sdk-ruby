      def tags: () -> Hash[String, String]?
    end
    def create_web_function: (
      ?function_name: String,
      ?revision_config: {
        description: String,
        kms_key_arn: String,
        build_config: {
          code_config: {
            s3_object: {
              bucket: String,
              key: untyped,
              version_id: untyped
            }
          },
          runtime_config: {
            runtime: untyped
          }
        },
        service_config: {
          execution_role_arn: String,
          timeout_seconds: Integer,
          egress_network_connector_arn: untyped,
          max_concurrency_per_environment: untyped,
          environment_variables: Hash[String, String],
          telemetry_config: {
            logging_config: {
              log_group: untyped,
              application_log_level: String,
              system_log_level: String
            }
          }
        }
      },
      ?endpoint_config: {
        endpoint_name: String,
        description: String,
        endpoint_type: String,
        auth_type: String,
        auto_deployment_mode: String,
        regions: Array[String],
        scaling_config: {
          max_environments: Integer
        },
        throttle_config: {
          rate_limit: untyped
        }
      },
      ?tags: Hash[String, String]
    ) -> _CreateWebFunctionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateWebFunctionResponse

