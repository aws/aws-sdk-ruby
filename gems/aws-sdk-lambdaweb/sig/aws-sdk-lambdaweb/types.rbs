module Aws::LambdaWeb
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccountQuotas
      include Smithy::Schema::Structure

      def initialize: (
        ?max_total_arm_v_cpus: Integer,
        ?max_total_rate_limit: Integer,
        ?max_revisions_per_function: Integer,
        ?max_endpoints_per_function: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor max_total_arm_v_cpus: Integer?
      attr_accessor max_total_rate_limit: Integer?
      attr_accessor max_revisions_per_function: Integer?
      attr_accessor max_endpoints_per_function: Integer?
    end

    class AccountUsage
      include Smithy::Schema::Structure

      def initialize: (
        ?function_count: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor function_count: Integer?
    end

