module Aws::CloudSearchDomain
  module Types

    class Bucket
      include Smithy::Schema::Structure

      def initialize: (
        ?value: String,
        ?count: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor value: String?
      attr_accessor count: Integer?
    end

    class BucketInfo
      include Smithy::Schema::Structure

      def initialize: (
        ?buckets: Array[Types::Bucket],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor buckets: Array[Types::Bucket]?
    end

    module ContentType
      application_json: String
      application_xml: String
    end

    class DocumentServiceException
      include Smithy::Schema::Structure

      def initialize: (
        ?status: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: String?
      attr_accessor message: String?
    end

    class DocumentServiceWarning
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class FieldStats
      include Smithy::Schema::Structure

      def initialize: (
        ?min: String,
        ?max: String,
        ?count: Integer,
        ?missing: Integer,
        ?sum: Float,
        ?sum_of_squares: Float,
        ?mean: String,
        ?stddev: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor min: String?
      attr_accessor max: String?
      attr_accessor count: Integer?
      attr_accessor missing: Integer?
      attr_accessor sum: Float?
      attr_accessor sum_of_squares: Float?
      attr_accessor mean: String?
      attr_accessor stddev: Float?
    end

    class Hit
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?fields: Hash[String, Array[String]],
        ?exprs: Hash[String, String],
        ?highlights: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor fields: Hash[String, Array[String]]?
      attr_accessor exprs: Hash[String, String]?
      attr_accessor highlights: Hash[String, String]?
    end

    class Hits
      include Smithy::Schema::Structure

      def initialize: (
        ?found: Integer,
        ?start: Integer,
        ?cursor: String,
        ?hit: Array[Types::Hit],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor found: Integer?
      attr_accessor start: Integer?
      attr_accessor cursor: String?
      attr_accessor hit: Array[Types::Hit]?
    end

    module QueryParser
      simple: String
      structured: String
      lucene: String
      dismax: String
    end

    class SearchException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class SearchRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?cursor: String,
        ?expr: String,
        ?facet: String,
        ?filter_query: String,
        ?highlight: String,
        ?partial: bool,
        ?query: String,
        ?query_options: String,
        ?query_parser: String,
        ?return: String,
        ?size: Integer,
        ?sort: String,
        ?start: Integer,
        ?stats: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor cursor: String?
      attr_accessor expr: String?
      attr_accessor facet: String?
      attr_accessor filter_query: String?
      attr_accessor highlight: String?
      attr_accessor partial: bool?
      attr_accessor query: String?
      attr_accessor query_options: String?
      attr_accessor query_parser: String?
      attr_accessor return: String?
      attr_accessor size: Integer?
      attr_accessor sort: String?
      attr_accessor start: Integer?
      attr_accessor stats: String?
    end

    class SearchResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?status: Types::SearchStatus,
        ?hits: Types::Hits,
        ?facets: Hash[String, Types::BucketInfo],
        ?stats: Hash[String, Types::FieldStats],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: Types::SearchStatus?
      attr_accessor hits: Types::Hits?
      attr_accessor facets: Hash[String, Types::BucketInfo]?
      attr_accessor stats: Hash[String, Types::FieldStats]?
    end

    class SearchStatus
      include Smithy::Schema::Structure

      def initialize: (
        ?timems: Integer,
        ?rid: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor timems: Integer?
      attr_accessor rid: String?
    end

    class SuggestModel
      include Smithy::Schema::Structure

      def initialize: (
        ?query: String,
        ?found: Integer,
        ?suggestions: Array[Types::SuggestionMatch],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor query: String?
      attr_accessor found: Integer?
      attr_accessor suggestions: Array[Types::SuggestionMatch]?
    end

    class SuggestRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?query: String,
        ?suggester: String,
        ?size: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor query: String?
      attr_accessor suggester: String?
      attr_accessor size: Integer?
    end

    class SuggestResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?status: Types::SuggestStatus,
        ?suggest: Types::SuggestModel,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: Types::SuggestStatus?
      attr_accessor suggest: Types::SuggestModel?
    end

    class SuggestStatus
      include Smithy::Schema::Structure

      def initialize: (
        ?timems: Integer,
        ?rid: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor timems: Integer?
      attr_accessor rid: String?
    end

    class SuggestionMatch
      include Smithy::Schema::Structure

      def initialize: (
        ?suggestion: String,
        ?score: Integer,
        ?id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor suggestion: String?
      attr_accessor score: Integer?
      attr_accessor id: String?
    end

    class UploadDocumentsRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?documents: String,
        ?content_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor documents: String?
      attr_accessor content_type: String?
    end

    class UploadDocumentsResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?status: String,
        ?adds: Integer,
        ?deletes: Integer,
        ?warnings: Array[Types::DocumentServiceWarning],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: String?
      attr_accessor adds: Integer?
      attr_accessor deletes: Integer?
      attr_accessor warnings: Array[Types::DocumentServiceWarning]?
    end
  end
end
