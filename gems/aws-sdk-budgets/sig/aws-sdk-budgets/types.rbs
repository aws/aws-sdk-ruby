    class Budget
      include Smithy::Schema::Structure

      def initialize: (
        ?budget_name: String,
        ?budget_limit: Types::Spend,
        ?planned_budget_limits: Hash[String, Types::Spend],
        ?cost_filters: Hash[String, Array[String]],
        ?cost_types: Types::CostTypes,
        ?time_unit: String,
        ?time_period: Types::TimePeriod,
        ?calculated_spend: Types::CalculatedSpend,
        ?budget_type: String,
        ?last_updated_time: Time,
        ?auto_adjust_data: Types::AutoAdjustData,
        ?filter_expression: Types::Expression,
        ?metrics: Array[String],
        ?billing_view_arn: String,
        ?health_status: Types::HealthStatus,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor budget_name: String?
      attr_accessor budget_limit: Types::Spend?
      attr_accessor planned_budget_limits: Hash[String, Types::Spend]?
      attr_accessor cost_filters: Hash[String, Array[String]]?
      attr_accessor cost_types: Types::CostTypes?
      attr_accessor time_unit: String?
      attr_accessor time_period: Types::TimePeriod?
      attr_accessor calculated_spend: Types::CalculatedSpend?
      attr_accessor budget_type: String?
      attr_accessor last_updated_time: Time?
      attr_accessor auto_adjust_data: Types::AutoAdjustData?
      attr_accessor filter_expression: Types::Expression?
      attr_accessor metrics: Array[String]?
      attr_accessor billing_view_arn: String?
      attr_accessor health_status: Types::HealthStatus?
    end

