module Aws::Budgets
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Action
      include Smithy::Schema::Structure

      def initialize: (
        ?action_id: String,
        ?budget_name: String,
        ?notification_type: String,
        ?action_type: String,
        ?action_threshold: Types::ActionThreshold,
        ?definition: Types::Definition,
        ?execution_role_arn: String,
        ?approval_model: String,
        ?status: String,
        ?subscribers: Array[Types::Subscriber],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor action_id: String?
      attr_accessor budget_name: String?
      attr_accessor notification_type: String?
      attr_accessor action_type: String?
      attr_accessor action_threshold: Types::ActionThreshold?
      attr_accessor definition: Types::Definition?
      attr_accessor execution_role_arn: String?
      attr_accessor approval_model: String?
      attr_accessor status: String?
      attr_accessor subscribers: Array[Types::Subscriber]?
    end

    class ActionHistory
      include Smithy::Schema::Structure

      def initialize: (
        ?timestamp: Time,
        ?status: String,
        ?event_type: String,
        ?action_history_details: Types::ActionHistoryDetails,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor timestamp: Time?
      attr_accessor status: String?
      attr_accessor event_type: String?
      attr_accessor action_history_details: Types::ActionHistoryDetails?
    end

    class ActionHistoryDetails
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?action: Types::Action,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor action: Types::Action?
    end

    module ActionStatus
      Standby: String
      Pending: String
      Execution_In_Progress: String
      Execution_Success: String
      Execution_Failure: String
      Reverse_In_Progress: String
      Reverse_Success: String
      Reverse_Failure: String
      Reset_In_Progress: String
      Reset_Failure: String
    end

    module ActionSubType
      STOP_EC2: String
      STOP_RDS: String
    end

    class ActionThreshold
      include Smithy::Schema::Structure

      def initialize: (
