      attr_accessor customer_managed_s3: Types::CustomerManagedDatastoreS3Storage?
      attr_accessor iot_site_wise_multi_layer_storage: Types::DatastoreIotSiteWiseMultiLayerStorage?

      class ServiceManagedS3 < DatastoreStorage
      end
      class CustomerManagedS3 < DatastoreStorage
      end
      class IotSiteWiseMultiLayerStorage < DatastoreStorage
      end
      class Unknown < DatastoreStorage
      end
    end

