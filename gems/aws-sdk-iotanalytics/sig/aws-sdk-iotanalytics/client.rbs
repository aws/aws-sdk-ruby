    interface _CreateChannelResponse
      include Smithy::Client::_Response[Types::CreateChannelResponse]
      def channel_name: () -> String?
      def channel_arn: () -> String?
      def retention_period: () -> Types::RetentionPeriod?
    end
    def create_channel: (
      ?channel_name: String,
      ?channel_storage: {
        service_managed_s3: {
        },
        customer_managed_s3: {
          bucket: String,
          key_prefix: String,
          role_arn: String
        }
      },
      ?retention_period: {
        unlimited: bool,
        number_of_days: Integer
      },
      ?tags: Array[
