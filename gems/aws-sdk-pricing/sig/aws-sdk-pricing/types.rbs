    class Filter
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?field: String,
        ?value: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor field: String?
      attr_accessor value: String?
    end

    module FilterType
      TERM_MATCH: String
      EQUALS: String
      CONTAINS: String
      ANY_OF: String
      NONE_OF: String
    end

