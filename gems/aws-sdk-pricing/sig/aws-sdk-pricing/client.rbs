module Aws::Pricing
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Pricing::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DescribeServicesResponse
      include Smithy::Client::_Response[Types::DescribeServicesResponse]
      def services: () -> Array[Types::Service]?
      def format_version: () -> String?
      def next_token: () -> String?
    end
    def describe_services: (
      ?service_code: String,
      ?format_version: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _DescribeServicesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeServicesResponse

    interface _GetAttributeValuesResponse
      include Smithy::Client::_Response[Types::GetAttributeValuesResponse]
      def attribute_values: () -> Array[Types::AttributeValue]?
      def next_token: () -> String?
    end
    def get_attribute_values: (
      ?service_code: String,
      ?attribute_name: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _GetAttributeValuesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAttributeValuesResponse

    interface _GetPriceListFileUrlResponse
      include Smithy::Client::_Response[Types::GetPriceListFileUrlResponse]
      def url: () -> String?
    end
    def get_price_list_file_url: (
      ?price_list_arn: String,
      ?file_format: String
    ) -> _GetPriceListFileUrlResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPriceListFileUrlResponse

    interface _GetProductsResponse
      include Smithy::Client::_Response[Types::GetProductsResponse]
      def format_version: () -> String?
      def price_list: () -> Array[String]?
      def next_token: () -> String?
    end
    def get_products: (
      ?service_code: String,
      ?filters: Array[
        {
          type: String,
          field: String,
          value: String
        }
      ],
      ?format_version: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _GetProductsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetProductsResponse

    interface _ListPriceListsResponse
      include Smithy::Client::_Response[Types::ListPriceListsResponse]
      def price_lists: () -> Array[Types::PriceList]?
      def next_token: () -> String?
    end
    def list_price_lists: (
      ?service_code: String,
      ?effective_date: Time,
      ?region_code: String,
      ?currency_code: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListPriceListsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListPriceListsResponse
  end
end
