module Aws::IAMToolbox
  module Schema
    include Smithy::Schema::Shapes

    AccessDeniedException: StructureShape
    AttachedTo: StructureShape
    AttachedToList: ListShape
    AuthorizationContext: MapShape
    EvaluatedEffect: EnumShape
    Evaluation: StructureShape
    Evaluations: ListShape
    GetRequestAuthorizationDetailsInput: StructureShape
    GetRequestAuthorizationDetailsOutput: StructureShape
    InternalServerException: StructureShape
    MatchedPolicy: StructureShape
    MatchedPolicyList: ListShape
    MatchedStatement: StructureShape
    MatchedStatementList: ListShape
    PolicyInfo: StructureShape
    PolicyInfoList: ListShape
    PolicyType: EnumShape
    ResourceNotFoundException: StructureShape
    StatementEffect: EnumShape
    ValidationException: StructureShape

    AuthRequestService: ServiceShape
  end
end
