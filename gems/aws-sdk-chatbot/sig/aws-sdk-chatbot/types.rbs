        ?operator: String,
        ?variable_name: String,
        ?value: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor operator: String?
      attr_accessor variable_name: String?
      attr_accessor value: String?
    end

    module CustomActionAttachmentCriteriaOperator
      HAS_VALUE: String
      EQUALS: String
    end

