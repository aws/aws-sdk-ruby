      attr_accessor exclude_matched_pattern: bool?
    end

    module WebhookFilterType
      EVENT: String
      BASE_REF: String
      HEAD_REF: String
      ACTOR_ACCOUNT_ID: String
      FILE_PATH: String
      COMMIT_MESSAGE: String
      WORKFLOW_NAME: String
      TAG_NAME: String
      RELEASE_NAME: String
      REPOSITORY_NAME: String
      ORGANIZATION_NAME: String
    end

    module WebhookScopeType
      GITHUB_ORGANIZATION: String
      GITHUB_GLOBAL: String
      GITLAB_GROUP: String
    end

    module WebhookStatus
      CREATING: String
      CREATE_FAILED: String
      ACTIVE: String
      DELETING: String
    end
  end
end
