    class ResponseStream
      include Smithy::Schema::Union

      def initialize: (
        ?trace: Types::Trace,
        ?output: Types::InvocationOutput,
        ?access_denied_exception: Types::AccessDeniedException,
        ?conflicting_operation_exception: Types::ConflictingOperationException,
        ?internal_failure_exception: Types::InternalFailureException,
        ?invalid_request_exception: Types::InvalidRequestException,
        ?limit_exceeded_exception: Types::LimitExceededException,
        ?resource_not_found_exception: Types::ResourceNotFoundException,
        ?throttling_exception: Types::ThrottlingException,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor trace: Types::Trace?
      attr_accessor output: Types::InvocationOutput?
      attr_accessor access_denied_exception: Types::AccessDeniedException?
      attr_accessor conflicting_operation_exception: Types::ConflictingOperationException?
      attr_accessor internal_failure_exception: Types::InternalFailureException?
      attr_accessor invalid_request_exception: Types::InvalidRequestException?
      attr_accessor limit_exceeded_exception: Types::LimitExceededException?
      attr_accessor resource_not_found_exception: Types::ResourceNotFoundException?
      attr_accessor throttling_exception: Types::ThrottlingException?

      class Trace < ResponseStream
      end
      class Output < ResponseStream
      end
      class AccessDeniedException < ResponseStream
      end
      class ConflictingOperationException < ResponseStream
      end
      class InternalFailureException < ResponseStream
      end
      class InvalidRequestException < ResponseStream
      end
      class LimitExceededException < ResponseStream
      end
      class ResourceNotFoundException < ResponseStream
      end
      class ThrottlingException < ResponseStream
      end
      class Unknown < ResponseStream
      end
    end

