      attr_accessor workspace_status: Types::WorkspaceStatus
      SENSITIVE: []
    end

    class UserIdentity
      attr_accessor id: ::String
      SENSITIVE: []
    end

    class ValidationException
      attr_accessor message: ::String
      SENSITIVE: []
    end

    class VariableValue
      attr_accessor property_id: ::String
      attr_accessor hierarchy_id: ::String
      attr_accessor property_path: ::Array[Types::AssetModelPropertyPathSegment]
      SENSITIVE: []
    end

    class Variant
      attr_accessor string_value: ::String
      attr_accessor integer_value: ::Integer
      attr_accessor double_value: ::Float
      attr_accessor boolean_value: bool
      attr_accessor null_value: Types::PropertyValueNullValue
      SENSITIVE: []
    end

    class WarmTierRetentionPeriod
      attr_accessor number_of_days: ::Integer
      attr_accessor unlimited: bool
      SENSITIVE: []
    end

    class WorkspaceEncryptionConfiguration
      attr_accessor encryption_type: ("SITEWISE_DEFAULT_ENCRYPTION" | "KMS_BASED_ENCRYPTION")
      attr_accessor kms_key_id: ::String
      SENSITIVE: []
    end

    class WorkspaceEncryptionConfigurationInfo
      attr_accessor encryption_type: ("SITEWISE_DEFAULT_ENCRYPTION" | "KMS_BASED_ENCRYPTION")
      attr_accessor kms_key_arn: ::String
      SENSITIVE: []
    end

    class WorkspaceErrorDetails
      attr_accessor code: ("VALIDATION_ERROR" | "INTERNAL_FAILURE")
      attr_accessor message: ::String
      SENSITIVE: []
    end

    class WorkspaceStatus
      attr_accessor state: ("CREATING" | "ACTIVE" | "UPDATING" | "DELETING" | "FAILED")
      attr_accessor error: Types::WorkspaceErrorDetails
      SENSITIVE: []
    end

    class WorkspaceSummary
      attr_accessor name: ::String
      attr_accessor arn: ::String
      attr_accessor status: Types::WorkspaceStatus
      attr_accessor created_at: ::Time
      attr_accessor updated_at: ::Time
      SENSITIVE: []
    end

    class ResponseStream < Enumerator[untyped, untyped]
      def event_types: () -> [:trace, :output, :access_denied_exception, :conflicting_operation_exception, :internal_failure_exception, :invalid_request_exception, :limit_exceeded_exception, :resource_not_found_exception, :throttling_exception]
    end
  end
end
