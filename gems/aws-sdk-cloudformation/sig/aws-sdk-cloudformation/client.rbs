        retain_stacks_on_account_removal: bool
      },
      ?operation_id: String,
      ?accounts: Array[String],
      ?regions: Array[String],
      ?call_as: String,
      ?managed_execution: {
        active: bool
      }
    ) -> _UpdateStackSetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateStackSetResponse

    interface _UpdateTerminationProtectionResponse
      include Smithy::Client::_Response[Types::UpdateTerminationProtectionOutput]
      def stack_id: () -> String?
    end
    def update_termination_protection: (
      ?enable_termination_protection: bool,
      ?stack_name: String
    ) -> _UpdateTerminationProtectionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateTerminationProtectionResponse

    interface _ValidateTemplateResponse
      include Smithy::Client::_Response[Types::ValidateTemplateOutput]
      def parameters: () -> Array[Types::TemplateParameter]?
      def description: () -> String?
      def capabilities: () -> Array[String]?
      def capabilities_reason: () -> String?
      def declared_transforms: () -> Array[String]?
    end
    def validate_template: (
      ?template_body: String,
      ?template_url: String
    ) -> _ValidateTemplateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ValidateTemplateResponse
  end
end
