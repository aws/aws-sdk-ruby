module Aws::NetworkManager
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
    end
    class CoreNetworkPolicyException < Smithy::Client::ServiceError
      def message: () -> String?
      def errors: () -> Array[Types::CoreNetworkPolicyError]?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
      def retry_after_seconds: () -> Integer?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
      def context: () -> Hash[String, String]?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
      def limit_code: () -> String?
      def service_code: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
      def retry_after_seconds: () -> Integer?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
      def reason: () -> String?
      def fields: () -> Array[Types::ValidationExceptionField]?
    end
  end
end
