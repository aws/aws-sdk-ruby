    class Attachment
      include Smithy::Schema::Structure

      def initialize: (
        ?core_network_id: String,
        ?core_network_arn: String,
        ?attachment_id: String,
        ?owner_account_id: String,
        ?attachment_type: String,
        ?state: String,
        ?edge_location: String,
        ?edge_locations: Array[String],
        ?resource_arn: String,
        ?attachment_policy_rule_number: Integer,
        ?segment_name: String,
        ?network_function_group_name: String,
        ?tags: Array[Types::Tag],
        ?proposed_segment_change: Types::ProposedSegmentChange,
        ?proposed_network_function_group_change: Types::ProposedNetworkFunctionGroupChange,
        ?created_at: Time,
        ?updated_at: Time,
        ?last_modification_errors: Array[Types::AttachmentError],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor core_network_id: String?
      attr_accessor core_network_arn: String?
      attr_accessor attachment_id: String?
      attr_accessor owner_account_id: String?
      attr_accessor attachment_type: String?
      attr_accessor state: String?
      attr_accessor edge_location: String?
      attr_accessor edge_locations: Array[String]?
      attr_accessor resource_arn: String?
      attr_accessor attachment_policy_rule_number: Integer?
      attr_accessor segment_name: String?
      attr_accessor network_function_group_name: String?
      attr_accessor tags: Array[Types::Tag]?
      attr_accessor proposed_segment_change: Types::ProposedSegmentChange?
      attr_accessor proposed_network_function_group_change: Types::ProposedNetworkFunctionGroupChange?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
      attr_accessor last_modification_errors: Array[Types::AttachmentError]?
    end

