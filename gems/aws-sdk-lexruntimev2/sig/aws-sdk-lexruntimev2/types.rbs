        ?heartbeat_event: Types::HeartbeatEvent,
        ?access_denied_exception: Types::AccessDeniedException,
        ?resource_not_found_exception: Types::ResourceNotFoundException,
        ?validation_exception: Types::ValidationException,
        ?throttling_exception: Types::ThrottlingException,
        ?internal_server_exception: Types::InternalServerException,
        ?conflict_exception: Types::ConflictException,
        ?dependency_failed_exception: Types::DependencyFailedException,
        ?bad_gateway_exception: Types::BadGatewayException,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor playback_interruption_event: Types::PlaybackInterruptionEvent?
      attr_accessor transcript_event: Types::TranscriptEvent?
      attr_accessor intent_result_event: Types::IntentResultEvent?
      attr_accessor text_response_event: Types::TextResponseEvent?
      attr_accessor audio_response_event: Types::AudioResponseEvent?
      attr_accessor heartbeat_event: Types::HeartbeatEvent?
      attr_accessor access_denied_exception: Types::AccessDeniedException?
      attr_accessor resource_not_found_exception: Types::ResourceNotFoundException?
      attr_accessor validation_exception: Types::ValidationException?
      attr_accessor throttling_exception: Types::ThrottlingException?
      attr_accessor internal_server_exception: Types::InternalServerException?
      attr_accessor conflict_exception: Types::ConflictException?
      attr_accessor dependency_failed_exception: Types::DependencyFailedException?
      attr_accessor bad_gateway_exception: Types::BadGatewayException?

      class PlaybackInterruptionEvent < StartConversationResponseEventStream
      end
      class TranscriptEvent < StartConversationResponseEventStream
      end
      class IntentResultEvent < StartConversationResponseEventStream
      end
      class TextResponseEvent < StartConversationResponseEventStream
      end
      class AudioResponseEvent < StartConversationResponseEventStream
      end
      class HeartbeatEvent < StartConversationResponseEventStream
      end
      class AccessDeniedException < StartConversationResponseEventStream
      end
      class ResourceNotFoundException < StartConversationResponseEventStream
      end
      class ValidationException < StartConversationResponseEventStream
      end
      class ThrottlingException < StartConversationResponseEventStream
      end
      class InternalServerException < StartConversationResponseEventStream
      end
      class ConflictException < StartConversationResponseEventStream
      end
      class DependencyFailedException < StartConversationResponseEventStream
      end
      class BadGatewayException < StartConversationResponseEventStream
      end
      class Unknown < StartConversationResponseEventStream
