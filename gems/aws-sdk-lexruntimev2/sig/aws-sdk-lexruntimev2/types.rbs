    class StartConversationRequestEventStream
      include Smithy::Schema::Union

      def initialize: (
        ?configuration_event: Types::ConfigurationEvent,
        ?audio_input_event: Types::AudioInputEvent,
        ?dtmf_input_event: Types::DTMFInputEvent,
        ?text_input_event: Types::TextInputEvent,
        ?playback_completion_event: Types::PlaybackCompletionEvent,
        ?disconnection_event: Types::DisconnectionEvent,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

