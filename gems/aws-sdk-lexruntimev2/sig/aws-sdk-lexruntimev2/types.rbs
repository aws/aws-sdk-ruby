    class StartConversationResponseEventStream
      include Smithy::Schema::Union

      def initialize: (
        ?playback_interruption_event: Types::PlaybackInterruptionEvent,
        ?transcript_event: Types::TranscriptEvent,
        ?intent_result_event: Types::IntentResultEvent,
