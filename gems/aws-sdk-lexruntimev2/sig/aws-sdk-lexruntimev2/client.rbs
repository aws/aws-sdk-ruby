      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DeleteSessionResponse
      include Smithy::Client::_Response[Types::DeleteSessionResponse]
      def bot_id: () -> String?
      def bot_alias_id: () -> String?
      def locale_id: () -> String?
      def session_id: () -> String?
    end
    def delete_session: (
      ?bot_id: String,
      ?bot_alias_id: String,
      ?locale_id: String,
      ?session_id: String
    ) -> _DeleteSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSessionResponse

    interface _GetSessionResponse
      include Smithy::Client::_Response[Types::GetSessionResponse]
      def session_id: () -> String?
      def messages: () -> Array[Types::Message]?
      def interpretations: () -> Array[Types::Interpretation]?
      def session_state: () -> Types::SessionState?
    end
    def get_session: (
      ?bot_id: String,
      ?bot_alias_id: String,
      ?locale_id: String,
      ?session_id: String
    ) -> _GetSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSessionResponse

    interface _PutSessionResponse
      include Smithy::Client::_Response[Types::PutSessionResponse]
      def content_type: () -> String?
      def messages: () -> String?
      def session_state: () -> String?
      def request_attributes: () -> String?
      def session_id: () -> String?
      def audio_stream: () -> String?
    end
    def put_session: (
      ?bot_id: String,
      ?bot_alias_id: String,
      ?locale_id: String,
      ?session_id: String,
      ?messages: Array[
        {
          content: String,
          content_type: String,
          image_response_card: {
            title: String,
            subtitle: untyped,
            image_url: String,
            buttons: Array[
              {
                text: String,
                value: String
              }
            ]
          }
        }
      ],
      ?session_state: {
        dialog_action: {
          type: String,
          slot_to_elicit: String,
          slot_elicitation_style: String,
          sub_slot_to_elicit: {
            name: untyped,
            sub_slot_to_elicit: untyped
          }
        },
        intent: {
          name: untyped,
          slots: Hash[String,
            {
              value: {
                original_value: untyped,
                interpreted_value: untyped,
                resolved_values: Array[String]
              },
              shape: String,
              values: Array[
                {
                  value: untyped,
                  shape: untyped,
                  values: untyped,
                  sub_slots: untyped
                }
              ],
              sub_slots: untyped
            }
          ],
          state: String,
          confirmation_state: String
        },
        active_contexts: Array[
          {
            name: String,
            time_to_live: {
              time_to_live_in_seconds: Integer,
              turns_to_live: Integer
            },
            context_attributes: Hash[String, String]
          }
        ],
        session_attributes: Hash[String, String],
        originating_request_id: untyped,
        runtime_hints: {
          slot_hints: Hash[String,
            Hash[String,
              {
                runtime_hint_values: Array[
                  {
                    phrase: String
                  }
                ],
                sub_slot_hints: Hash[String,
                  {
                    runtime_hint_values: untyped,
                    sub_slot_hints: untyped
                  }
                ]
              }
            ]
          ]
        }
      },
      ?request_attributes: Hash[String, String],
      ?response_content_type: String
    ) -> _PutSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutSessionResponse

