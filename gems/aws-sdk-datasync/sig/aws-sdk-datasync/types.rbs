module Aws::DataSync
  module Types

    class AgentListEntry
      include Smithy::Schema::Structure

      def initialize: (
        ?agent_arn: String,
        ?name: String,
        ?status: String,
        ?platform: Types::Platform,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor agent_arn: String?
      attr_accessor name: String?
      attr_accessor status: String?
      attr_accessor platform: Types::Platform?
    end

    module AgentStatus
      ONLINE: String
      OFFLINE: String
    end

    module Atime
      NONE: String
      BEST_EFFORT: String
    end

    module AzureAccessTier
      HOT: String
      COOL: String
      ARCHIVE: String
    end

    module AzureBlobAuthenticationType
      SAS: String
      NONE: String
    end

