    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateCampaignResponse
      include Smithy::Client::_Response[Types::CreateCampaignOutput]
      def id: () -> String?
      def arn: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def create_campaign: (
      ?name: String,
      ?connect_instance_id: String,
      ?dialer_config: {
        progressive_dialer_config: {
          bandwidth_allocation: Float,
          dialing_capacity: Float
        },
        predictive_dialer_config: {
          bandwidth_allocation: untyped,
          dialing_capacity: untyped
        },
        agentless_dialer_config: {
          dialing_capacity: untyped
        }
      },
      ?outbound_call_config: {
        connect_contact_flow_id: String,
        connect_source_phone_number: String,
        connect_queue_id: String,
        answer_machine_detection_config: {
          enable_answer_machine_detection: bool,
          await_answer_machine_prompt: untyped
        }
      },
      ?tags: Hash[String, String]
    ) -> _CreateCampaignResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCampaignResponse

    interface _DeleteCampaignResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def delete_campaign: (
