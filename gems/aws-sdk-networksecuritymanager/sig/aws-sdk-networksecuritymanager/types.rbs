module Aws::NetworkSecurityManager
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccountFilter
      include Smithy::Schema::Union

      def initialize: (
        ?include_all: Smithy::Schema::EmptyStructure,
        ?include: Types::AccountSet,
        ?exclude: Types::AccountSet,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor include_all: Smithy::Schema::EmptyStructure?
      attr_accessor include: Types::AccountSet?
      attr_accessor exclude: Types::AccountSet?

      class IncludeAll < AccountFilter
      end
      class Include < AccountFilter
      end
      class Exclude < AccountFilter
      end
      class Unknown < AccountFilter
      end
    end

