    def create_opportunity: (
      ?catalog: String,
      ?primary_needs_from_aws: Array[String],
      ?national_security: String,
      ?partner_opportunity_identifier: String,
      ?customer: {
        account: {
          industry: String,
          other_industry: String,
          company_name: String,
          website_url: String,
          aws_account_id: String,
          address: {
            city: String,
            postal_code: untyped,
            state_or_region: untyped,
            country_code: String,
            street_address: untyped
          },
          duns: String
        },
        contacts: Array[
          {
            email: String,
            first_name: untyped,
            last_name: untyped,
            business_title: String,
            phone: String
          }
        ]
      },
      ?project: {
        delivery_models: Array[String],
        expected_customer_spend: Array[
          {
            amount: String,
            currency_code: String,
            frequency: String,
            target_company: String,
            estimation_url: String
          }
        ],
        title: String,
        apn_programs: Array[String],
        customer_business_problem: untyped,
        customer_use_case: untyped,
        related_opportunity_identifier: String,
        sales_activities: Array[String],
        competitor_name: String,
        other_competitor_names: untyped,
        other_solution_description: untyped,
        additional_comments: untyped
      },
      ?opportunity_type: String,
      ?marketing: {
        campaign_name: String,
        source: String,
        use_cases: Array[String],
        channels: Array[String],
        aws_funding_used: String
      },
      ?software_revenue: {
        delivery_model: String,
        value: {
          amount: String,
          currency_code: String
        },
        effective_date: String,
        expiration_date: untyped
      },
      ?client_token: String,
      ?life_cycle: {
        stage: String,
        closed_lost_reason: String,
        next_steps: String,
        target_close_date: String,
        review_status: String,
        review_comments: String,
        review_status_reason: untyped,
        next_steps_history: Array[
          {
            value: untyped,
            time: Time
          }
        ]
      },
      ?origin: String,
      ?opportunity_team: Array[
        {
          email: String,
          first_name: String,
          last_name: untyped,
          business_title: String,
          phone: String
        }
      ],
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateOpportunityResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateOpportunityResponse

