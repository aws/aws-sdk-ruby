module Aws::ObservabilityAdmin
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?amzn_error_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor amzn_error_type: String?
    end

    module CentralizationFailureReason
      TRUSTED_ACCESS_NOT_ENABLED: String
      DESTINATION_ACCOUNT_NOT_IN_ORGANIZATION: String
      INTERNAL_SERVER_ERROR: String
    end

