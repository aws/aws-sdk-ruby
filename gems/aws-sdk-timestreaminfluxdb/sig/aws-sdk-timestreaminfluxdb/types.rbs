module Aws::TimestreamInfluxDB
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AutomatedDbBackupType
      HOURLY: String
      DAILY: String
      WEEKLY: String
      MONTHLY: String
      CUSTOM_SCHEDULE: String
      CONTINUOUS: String
    end

    class ClusterConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?ingest_query_instances: Integer,
        ?query_only_instances: Integer,
        ?dedicated_compactor: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor ingest_query_instances: Integer?
      attr_accessor query_only_instances: Integer?
      attr_accessor dedicated_compactor: bool?
    end

    module ClusterDeploymentType
      MULTI_NODE_READ_REPLICAS: String
    end

    module ClusterStatus
      CREATING: String
      UPDATING: String
      DELETING: String
      AVAILABLE: String
      FAILED: String
      DELETED: String
      MAINTENANCE: String
      UPDATING_INSTANCE_TYPE: String
      REBOOTING: String
      REBOOT_FAILED: String
      PARTIALLY_AVAILABLE: String
      RESTORING: String
      RESTORE_FAILED: String
    end

