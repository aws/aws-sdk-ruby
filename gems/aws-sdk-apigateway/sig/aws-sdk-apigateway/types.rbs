module Aws::APIGateway
  module Types

    module AccessAssociationSourceType
      VPCE: String
    end

    class AccessLogSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?format: String,
        ?destination_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor format: String?
      attr_accessor destination_arn: String?
    end

    class ApiKey
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?value: String,
        ?name: String,
        ?customer_id: String,
        ?description: String,
        ?enabled: bool,
        ?created_date: Time,
        ?last_updated_date: Time,
        ?stage_keys: Array[String],
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor value: String?
      attr_accessor name: String?
      attr_accessor customer_id: String?
      attr_accessor description: String?
      attr_accessor enabled: bool?
      attr_accessor created_date: Time?
      attr_accessor last_updated_date: Time?
      attr_accessor stage_keys: Array[String]?
      attr_accessor tags: Hash[String, String]?
    end

    module ApiKeySourceType
      HEADER: String
      AUTHORIZER: String
    end

    module ApiKeysFormat
      csv: String
    end

    class ApiStage
      include Smithy::Schema::Structure

      def initialize: (
