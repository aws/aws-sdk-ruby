      def comment: () -> String?
      def created_at: () -> Time?
      def data_set_id: () -> String?
      def finalized: () -> bool?
      def id: () -> String?
      def source_id: () -> String?
      def updated_at: () -> Time?
      def revocation_comment: () -> String?
      def revoked: () -> bool?
      def revoked_at: () -> Time?
    end
    def update_revision: (
      ?comment: String,
      ?data_set_id: String,
      ?finalized: bool,
      ?revision_id: String
    ) -> _UpdateRevisionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateRevisionResponse
  end
end
