module Aws::Kendra
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class FeaturedResultsConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def conflicting_items: () -> Array[Types::ConflictingItem]?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InvalidRequestException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceAlreadyExistException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceInUseException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceUnavailableException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
