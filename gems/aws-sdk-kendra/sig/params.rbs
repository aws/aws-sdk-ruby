      issuer: ::String?,
      claim_regex: ::String?
    }

      type user_token_configuration = {
      jwt_token_type_configuration: Params::jwt_token_type_configuration?,
      json_token_type_configuration: {
        user_name_attribute_field: ::String,
        group_attribute_field: ::String
      }?
    }

      type attribute_filter = {
      and_all_filters: Array[
        {
          and_all_filters: untyped?,
          or_all_filters: untyped?,
          not_filter: untyped?,
          equals_to: Params::document_attribute?,
          contains_all: Params::document_attribute?,
          contains_any: Params::document_attribute?,
          greater_than: Params::document_attribute?,
          greater_than_or_equals: Params::document_attribute?,
          less_than: Params::document_attribute?,
          less_than_or_equals: Params::document_attribute?
        }
      ]?,
      or_all_filters: Array[
        {
          and_all_filters: untyped?,
          or_all_filters: untyped?,
          not_filter: untyped?,
          equals_to: Params::document_attribute?,
          contains_all: Params::document_attribute?,
          contains_any: Params::document_attribute?,
          greater_than: Params::document_attribute?,
          greater_than_or_equals: Params::document_attribute?,
          less_than: Params::document_attribute?,
          less_than_or_equals: Params::document_attribute?
        }
      ]?,
      not_filter: {
        and_all_filters: Array[
          untyped
        ]?,
        or_all_filters: Array[
          untyped
        ]?,
        not_filter: untyped?,
        equals_to: Params::document_attribute?,
        contains_all: Params::document_attribute?,
        contains_any: Params::document_attribute?,
        greater_than: Params::document_attribute?,
        greater_than_or_equals: Params::document_attribute?,
        less_than: Params::document_attribute?,
        less_than_or_equals: Params::document_attribute?
      }?,
      equals_to: Params::document_attribute?,
      contains_all: Params::document_attribute?,
      contains_any: Params::document_attribute?,
      greater_than: Params::document_attribute?,
      greater_than_or_equals: Params::document_attribute?,
      less_than: Params::document_attribute?,
      less_than_or_equals: Params::document_attribute?
    }

      type user_context = {
      token: ::String?,
      user_id: ::String?,
      groups: Array[::String]?,
      data_source_groups: Array[
        {
          group_id: ::String,
          data_source_id: ::String
        }
      ]?
    }

      type document_relevance_configuration = {
      name: ::String,
      relevance: {
        freshness: bool?,
        importance: ::Integer?,
        duration: ::String?,
        rank_order: ("ASCENDING" | "DESCENDING")?,
        value_importance_map: Hash[::String, ::Integer]?
      }
    }

    end
  end
end
