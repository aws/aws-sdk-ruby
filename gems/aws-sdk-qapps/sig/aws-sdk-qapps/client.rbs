    def create_q_app: (
      ?instance_id: String,
      ?title: String,
      ?description: String,
      ?app_definition: {
        cards: Array[
          {
            text_input: {
              title: String,
              id: String,
              type: String,
              placeholder: String,
              default_value: String
            },
            q_query: {
              title: untyped,
              id: untyped,
              type: untyped,
              prompt: String,
              output_source: String,
              attribute_filter: {
                and_all_filters: Array[
                  {
                    and_all_filters: untyped,
                    or_all_filters: untyped,
                    not_filter: untyped,
                    equals_to: {
                      name: String,
                      value: {
                        string_value: String,
                        string_list_value: Array[String],
                        long_value: Integer,
                        date_value: Time
                      }
                    },
                    contains_all: untyped,
                    contains_any: untyped,
                    greater_than: untyped,
                    greater_than_or_equals: untyped,
                    less_than: untyped,
                    less_than_or_equals: untyped
                  }
                ],
                or_all_filters: untyped,
                not_filter: untyped,
                equals_to: untyped,
                contains_all: untyped,
                contains_any: untyped,
                greater_than: untyped,
                greater_than_or_equals: untyped,
                less_than: untyped,
                less_than_or_equals: untyped
              }
            },
            q_plugin: {
              title: untyped,
              id: untyped,
              type: untyped,
              prompt: untyped,
              plugin_id: String,
              action_identifier: String
            },
            file_upload: {
              title: untyped,
              id: untyped,
              type: untyped,
              filename: String,
              file_id: untyped,
              allow_override: bool
            },
            form_input: {
              title: untyped,
              id: untyped,
              type: untyped,
              metadata: {
                schema: Smithy::Schema::document
              },
              compute_mode: String
            }
          }
        ],
        initial_prompt: String
      },
      ?tags: Hash[String, String]
    ) -> _CreateQAppResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateQAppResponse

