module Aws::CodeGuruSecurity
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::CodeGuruSecurity::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: Smithy::Client::Retry::ExponentialBackoff,
      ?retry_base_delay: untyped,
      ?retry_max_attempts: Integer,
      ?retry_max_delay: untyped,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchGetFindingsResponse
      include Smithy::Client::_Response[Types::BatchGetFindingsResponse]
      def findings: () -> Array[Types::Finding]?
      def failed_findings: () -> Array[Types::BatchGetFindingsError]?
    end
    def batch_get_findings: (
      ?finding_identifiers: Array[
        {
          scan_name: String,
          finding_id: untyped
        }
      ]
    ) -> _BatchGetFindingsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchGetFindingsResponse

    interface _CreateScanResponse
      include Smithy::Client::_Response[Types::CreateScanResponse]
      def scan_name: () -> String?
      def run_id: () -> String?
      def resource_id: () -> Types::ResourceId?
      def scan_state: () -> String?
      def scan_name_arn: () -> String?
    end
    def create_scan: (
      ?client_token: String,
      ?resource_id: {
        code_artifact_id: String
      },
      ?scan_name: String,
      ?scan_type: String,
      ?analysis_type: String,
      ?tags: Hash[String, String]
    ) -> _CreateScanResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateScanResponse

    interface _CreateUploadUrlResponse
      include Smithy::Client::_Response[Types::CreateUploadUrlResponse]
      def s3_url: () -> String?
      def request_headers: () -> Hash[String, String]?
      def code_artifact_id: () -> String?
    end
    def create_upload_url: (
      ?scan_name: String
    ) -> _CreateUploadUrlResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateUploadUrlResponse

    interface _GetAccountConfigurationResponse
      include Smithy::Client::_Response[Types::GetAccountConfigurationResponse]
      def encryption_config: () -> Types::EncryptionConfig?
    end
    def get_account_configuration: (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAccountConfigurationResponse

    interface _GetFindingsResponse
      include Smithy::Client::_Response[Types::GetFindingsResponse]
      def findings: () -> Array[Types::Finding]?
      def next_token: () -> String?
    end
    def get_findings: (
      ?scan_name: String,
      ?next_token: String,
      ?max_results: Integer,
      ?status: String
    ) -> _GetFindingsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetFindingsResponse

    interface _GetMetricsSummaryResponse
      include Smithy::Client::_Response[Types::GetMetricsSummaryResponse]
      def metrics_summary: () -> Types::MetricsSummary?
    end
    def get_metrics_summary: (
      ?date: Time
    ) -> _GetMetricsSummaryResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetMetricsSummaryResponse

    interface _GetScanResponse
      include Smithy::Client::_Response[Types::GetScanResponse]
      def scan_name: () -> String?
      def run_id: () -> String?
      def scan_state: () -> String?
      def created_at: () -> Time?
      def analysis_type: () -> String?
      def updated_at: () -> Time?
      def number_of_revisions: () -> Integer?
      def scan_name_arn: () -> String?
      def error_message: () -> String?
    end
    def get_scan: (
      ?scan_name: String,
      ?run_id: String
    ) -> _GetScanResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetScanResponse

    interface _ListFindingsMetricsResponse
      include Smithy::Client::_Response[Types::ListFindingsMetricsResponse]
      def findings_metrics: () -> Array[Types::AccountFindingsMetric]?
      def next_token: () -> String?
    end
    def list_findings_metrics: (
      ?next_token: String,
      ?max_results: Integer,
      ?start_date: Time,
      ?end_date: Time
    ) -> _ListFindingsMetricsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListFindingsMetricsResponse

    interface _ListScansResponse
      include Smithy::Client::_Response[Types::ListScansResponse]
      def summaries: () -> Array[Types::ScanSummary]?
      def next_token: () -> String?
    end
    def list_scans: (
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListScansResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListScansResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def tags: () -> Hash[String, String]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Hash[String, String]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateAccountConfigurationResponse
      include Smithy::Client::_Response[Types::UpdateAccountConfigurationResponse]
      def encryption_config: () -> Types::EncryptionConfig?
    end
    def update_account_configuration: (
      ?encryption_config: {
        kms_key_arn: String
      }
    ) -> _UpdateAccountConfigurationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateAccountConfigurationResponse
  end
end
