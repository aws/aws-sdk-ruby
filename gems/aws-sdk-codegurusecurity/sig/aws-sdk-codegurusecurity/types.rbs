module Aws::CodeGuruSecurity
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?error_code: String,
        ?message: String,
        ?resource_id: String,
        ?resource_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor error_code: String?
      attr_accessor message: String?
      attr_accessor resource_id: String?
      attr_accessor resource_type: String?
    end

    class AccountFindingsMetric
      include Smithy::Schema::Structure

      def initialize: (
        ?date: Time,
        ?new_findings: Types::FindingMetricsValuePerSeverity,
        ?closed_findings: Types::FindingMetricsValuePerSeverity,
        ?open_findings: Types::FindingMetricsValuePerSeverity,
        ?mean_time_to_close: Types::FindingMetricsValuePerSeverity,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor date: Time?
      attr_accessor new_findings: Types::FindingMetricsValuePerSeverity?
      attr_accessor closed_findings: Types::FindingMetricsValuePerSeverity?
      attr_accessor open_findings: Types::FindingMetricsValuePerSeverity?
      attr_accessor mean_time_to_close: Types::FindingMetricsValuePerSeverity?
    end

    module AnalysisType
      SECURITY: String
      ALL: String
    end

    class BatchGetFindingsError
      include Smithy::Schema::Structure

      def initialize: (
        ?scan_name: String,
