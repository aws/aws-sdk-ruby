      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor message: String?
    end

    module ValidationExceptionReason
      UNKNOWN_OPERATION: String
      CANNOT_PARSE: String
      FIELD_VALIDATION_FAILED: String
      OTHER: String
      LAMBDA_CODE_SHA_MISMATCH: String
    end

    class Vulnerability
      include Smithy::Schema::Structure

      def initialize: (
        ?reference_urls: Array[String],
        ?related_vulnerabilities: Array[String],
        ?id: String,
        ?file_path: Types::FilePath,
        ?item_count: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor reference_urls: Array[String]?
      attr_accessor related_vulnerabilities: Array[String]?
      attr_accessor id: String?
      attr_accessor file_path: Types::FilePath?
      attr_accessor item_count: Integer?
    end
