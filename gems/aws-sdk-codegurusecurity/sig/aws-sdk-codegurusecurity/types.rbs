    class ResourceId
      include Smithy::Schema::Union

      def initialize: (
        ?code_artifact_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor code_artifact_id: String?

      class CodeArtifactId < ResourceId
      end
      class Unknown < ResourceId
      end
    end

