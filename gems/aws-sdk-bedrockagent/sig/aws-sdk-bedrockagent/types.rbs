module Aws::BedrockAgent
  module Types

    class APISchema
      include Smithy::Schema::Union

      def initialize: (
        ?s3: Types::S3Identifier,
        ?payload: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor s3: Types::S3Identifier?
      attr_accessor payload: String?

      class S3 < APISchema
      end
      class Payload < APISchema
      end
      class Unknown < APISchema
      end
    end

    module AccessControlAccess
      ALLOW: String
      DENY: String
    end

    module AccessControlPrincipalType
      USER: String
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ActionGroupExecutor
      include Smithy::Schema::Union

      def initialize: (
        ?lambda: String,
        ?custom_control: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor lambda: String?
      attr_accessor custom_control: String?

      class Lambda < ActionGroupExecutor
      end
      class CustomControl < ActionGroupExecutor
      end
      class Unknown < ActionGroupExecutor
      end
    end

    module ActionGroupSignature
      AMAZON_USERINPUT: String
      AMAZON_CODEINTERPRETER: String
      ANTHROPIC_COMPUTER: String
      ANTHROPIC_BASH: String
      ANTHROPIC_TEXTEDITOR: String
    end

    module ActionGroupState
      ENABLED: String
      DISABLED: String
    end

    class ActionGroupSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?action_group_id: String,
        ?action_group_name: String,
        ?action_group_state: String,
        ?description: String,
        ?updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor action_group_id: String?
      attr_accessor action_group_name: String?
      attr_accessor action_group_state: String?
      attr_accessor description: String?
      attr_accessor updated_at: Time?
    end

    class Agent
      include Smithy::Schema::Structure

      def initialize: (
        ?agent_id: String,
        ?agent_name: String,
        ?agent_arn: String,
        ?agent_version: String,
        ?client_token: String,
        ?instruction: String,
        ?agent_status: String,
        ?foundation_model: String,
        ?description: String,
        ?orchestration_type: String,
        ?custom_orchestration: Types::CustomOrchestration,
        ?idle_session_ttl_in_seconds: Integer,
        ?agent_resource_role_arn: String,
        ?customer_encryption_key_arn: String,
        ?created_at: Time,
        ?updated_at: Time,
        ?prepared_at: Time,
        ?failure_reasons: Array[String],
        ?recommended_actions: Array[String],
        ?prompt_override_configuration: Types::PromptOverrideConfiguration,
        ?guardrail_configuration: Types::GuardrailConfiguration,
        ?memory_configuration: Types::MemoryConfiguration,
        ?agent_collaboration: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor agent_id: String?
      attr_accessor agent_name: String?
      attr_accessor agent_arn: String?
      attr_accessor agent_version: String?
      attr_accessor client_token: String?
      attr_accessor instruction: String?
      attr_accessor agent_status: String?
      attr_accessor foundation_model: String?
      attr_accessor description: String?
      attr_accessor orchestration_type: String?
      attr_accessor custom_orchestration: Types::CustomOrchestration?
      attr_accessor idle_session_ttl_in_seconds: Integer?
      attr_accessor agent_resource_role_arn: String?
      attr_accessor customer_encryption_key_arn: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
      attr_accessor prepared_at: Time?
      attr_accessor failure_reasons: Array[String]?
      attr_accessor recommended_actions: Array[String]?
      attr_accessor prompt_override_configuration: Types::PromptOverrideConfiguration?
      attr_accessor guardrail_configuration: Types::GuardrailConfiguration?
      attr_accessor memory_configuration: Types::MemoryConfiguration?
      attr_accessor agent_collaboration: String?
    end

    class AgentActionGroup
      include Smithy::Schema::Structure

      def initialize: (
        ?agent_id: String,
        ?agent_version: String,
        ?action_group_id: String,
        ?action_group_name: String,
        ?client_token: String,
        ?description: String,
        ?created_at: Time,
        ?updated_at: Time,
        ?parent_action_signature: String,
        ?parent_action_group_signature_params: Hash[String, String],
        ?action_group_executor: Types::ActionGroupExecutor,
        ?api_schema: Types::APISchema,
        ?function_schema: Types::FunctionSchema,
        ?action_group_state: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor agent_id: String?
      attr_accessor agent_version: String?
      attr_accessor action_group_id: String?
      attr_accessor action_group_name: String?
      attr_accessor client_token: String?
      attr_accessor description: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
      attr_accessor parent_action_signature: String?
      attr_accessor parent_action_group_signature_params: Hash[String, String]?
      attr_accessor action_group_executor: Types::ActionGroupExecutor?
      attr_accessor api_schema: Types::APISchema?
      attr_accessor function_schema: Types::FunctionSchema?
      attr_accessor action_group_state: String?
    end

