module Aws::BedrockDataAutomationRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::BedrockDataAutomationRuntime::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetDataAutomationStatusResponse
      include Smithy::Client::_Response[Types::GetDataAutomationStatusResponse]
      def status: () -> String?
      def error_type: () -> String?
      def error_message: () -> String?
      def output_configuration: () -> Types::OutputConfiguration?
    end
    def get_data_automation_status: (
      ?invocation_arn: String
    ) -> _GetDataAutomationStatusResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetDataAutomationStatusResponse

    interface _InvokeDataAutomationAsyncResponse
      include Smithy::Client::_Response[Types::InvokeDataAutomationAsyncResponse]
      def invocation_arn: () -> String?
    end
    def invoke_data_automation_async: (
      ?client_token: String,
      ?input_configuration: {
        s3_uri: String,
        asset_processing_configuration: {
          video: {
            segment_configuration: {
              timestamp_segment: {
                start_time_millis: Integer,
                end_time_millis: untyped
              }
            }
          }
        }
      },
      ?output_configuration: {
        s3_uri: String
      },
      ?data_automation_configuration: {
        data_automation_project_arn: String,
        stage: String
      },
      ?encryption_configuration: {
        kms_key_id: String,
        kms_encryption_context: Hash[String, String]
      },
      ?notification_configuration: {
        event_bridge_configuration: {
          event_bridge_enabled: bool
        }
      },
      ?blueprints: Array[
        {
          blueprint_arn: String,
          version: String,
          stage: String
        }
      ],
      ?data_automation_profile_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _InvokeDataAutomationAsyncResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InvokeDataAutomationAsyncResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def tags: () -> Array[Types::Tag]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
  end
end
