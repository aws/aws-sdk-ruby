        ?replication_group_log_delivery_enabled: bool,
        ?log_delivery_configurations: Array[Types::LogDeliveryConfiguration],
        ?network_type: String,
        ?ip_discovery: String,
        ?transit_encryption_mode: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor cache_cluster_id: String?
