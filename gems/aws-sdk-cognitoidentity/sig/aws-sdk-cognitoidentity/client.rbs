      ?open_id_connect_provider_ar_ns: Array[String],
      ?cognito_identity_providers: Array[
        {
          provider_name: String,
          client_id: String,
          server_side_token_check: bool
        }
      ],
      ?saml_provider_ar_ns: Array[String],
