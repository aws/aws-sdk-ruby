module Aws::SagemakerJobRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SagemakerJobRuntime::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CompleteRolloutResponse
      include Smithy::Client::_Response[Types::CompleteRolloutResponse]
    end
    def complete_rollout: (
      ?job_arn: String,
      ?trajectory_id: String,
      ?status: String,
      ?client_token: String
    ) -> _CompleteRolloutResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CompleteRolloutResponse

    interface _SampleResponse
      include Smithy::Client::_Response[Types::SampleResponse]
      def content_type: () -> String?
      def body: () -> String?
    end
    def sample: (
      ?job_arn: String,
      ?trajectory_id: String,
      ?body: String
    ) -> _SampleResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SampleResponse

    interface _SampleWithResponseStreamResponse
      include Smithy::Client::_Response[Types::SampleWithResponseStreamResponse]
      def content_type: () -> String?
      def body: () -> String?
    end
    def sample_with_response_stream: (
      ?job_arn: String,
      ?trajectory_id: String,
      ?body: String
    ) -> _SampleWithResponseStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SampleWithResponseStreamResponse

    interface _UpdateRewardResponse
      include Smithy::Client::_Response[Types::UpdateRewardResponse]
    end
    def update_reward: (
      ?job_arn: String,
      ?trajectory_id: String,
      ?rewards: Array[Float],
      ?client_token: String
    ) -> _UpdateRewardResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateRewardResponse
  end
end
