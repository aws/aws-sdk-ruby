    end
    def describe_attachment: (
      ?attachment_id: String
    ) -> _DescribeAttachmentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeAttachmentResponse

    interface _DescribeCasesResponse
      include Smithy::Client::_Response[Types::DescribeCasesResponse]
      def cases: () -> Array[Types::CaseDetails]?
      def next_token: () -> String?
    end
    def describe_cases: (
      ?case_id_list: Array[String],
      ?display_id: String,
      ?after_time: String,
      ?before_time: String,
      ?include_resolved_cases: bool,
      ?next_token: String,
      ?max_results: Integer,
      ?language: String,
      ?include_communications: bool
    ) -> _DescribeCasesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeCasesResponse

    interface _DescribeCommunicationsResponse
      include Smithy::Client::_Response[Types::DescribeCommunicationsResponse]
      def communications: () -> Array[Types::Communication]?
      def next_token: () -> String?
    end
    def describe_communications: (
      ?case_id: String,
      ?before_time: String,
      ?after_time: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _DescribeCommunicationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeCommunicationsResponse

    interface _DescribeCreateCaseOptionsResponse
      include Smithy::Client::_Response[Types::DescribeCreateCaseOptionsResponse]
      def language_availability: () -> String?
