module Aws::Support
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Support::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AddAttachmentsToSetResponse
      include Smithy::Client::_Response[Types::AddAttachmentsToSetResponse]
      def attachment_set_id: () -> String?
      def expiry_time: () -> String?
    end
    def add_attachments_to_set: (
      ?attachment_set_id: String,
      ?attachments: Array[
        {
          file_name: String,
          data: String
        }
      ]
    ) -> _AddAttachmentsToSetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AddAttachmentsToSetResponse

    interface _AddCommunicationToCaseResponse
      include Smithy::Client::_Response[Types::AddCommunicationToCaseResponse]
      def result: () -> bool?
    end
    def add_communication_to_case: (
      ?case_id: String,
      ?communication_body: String,
      ?cc_email_addresses: Array[String],
      ?attachment_set_id: String
    ) -> _AddCommunicationToCaseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AddCommunicationToCaseResponse

    interface _CreateCaseResponse
      include Smithy::Client::_Response[Types::CreateCaseResponse]
      def case_id: () -> String?
    end
    def create_case: (
      ?subject: String,
      ?service_code: String,
      ?severity_code: String,
      ?category_code: String,
      ?communication_body: String,
      ?cc_email_addresses: Array[String],
      ?language: String,
      ?issue_type: String,
      ?attachment_set_id: String
    ) -> _CreateCaseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCaseResponse

    interface _DescribeAttachmentResponse
      include Smithy::Client::_Response[Types::DescribeAttachmentResponse]
