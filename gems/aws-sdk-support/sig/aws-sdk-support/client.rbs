    ) -> _DescribeServicesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeServicesResponse

    interface _DescribeSeverityLevelsResponse
      include Smithy::Client::_Response[Types::DescribeSeverityLevelsResponse]
      def severity_levels: () -> Array[Types::SeverityLevel]?
    end
    def describe_severity_levels: (
