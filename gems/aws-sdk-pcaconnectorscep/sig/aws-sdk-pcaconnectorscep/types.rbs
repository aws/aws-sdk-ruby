      attr_accessor arn: String?
      attr_accessor connector_arn: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
    end

    class ChallengeMetadataSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?connector_arn: String,
        ?created_at: Time,
        ?updated_at: Time,
