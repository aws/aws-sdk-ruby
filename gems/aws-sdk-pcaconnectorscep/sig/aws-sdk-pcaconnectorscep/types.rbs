    class Connector
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?certificate_authority_arn: String,
        ?type: String,
        ?mobile_device_management: Types::MobileDeviceManagement,
        ?open_id_configuration: Types::OpenIdConfiguration,
        ?status: String,
        ?status_reason: String,
        ?endpoint: String,
        ?created_at: Time,
        ?updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor certificate_authority_arn: String?
      attr_accessor type: String?
      attr_accessor mobile_device_management: Types::MobileDeviceManagement?
      attr_accessor open_id_configuration: Types::OpenIdConfiguration?
      attr_accessor status: String?
      attr_accessor status_reason: String?
      attr_accessor endpoint: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
    end

    module ConnectorStatus
      CREATING: String
      ACTIVE: String
      DELETING: String
      FAILED: String
    end

    module ConnectorStatusReason
      INTERNAL_FAILURE: String
      PRIVATECA_ACCESS_DENIED: String
      PRIVATECA_INVALID_STATE: String
      PRIVATECA_RESOURCE_NOT_FOUND: String
      VPC_ENDPOINT_RESOURCE_NOT_FOUND: String
      VPC_ENDPOINT_DNS_ENTRIES_NOT_FOUND: String
    end

    class ConnectorSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?certificate_authority_arn: String,
        ?type: String,
        ?mobile_device_management: Types::MobileDeviceManagement,
        ?open_id_configuration: Types::OpenIdConfiguration,
        ?status: String,
        ?status_reason: String,
        ?endpoint: String,
        ?created_at: Time,
        ?updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor certificate_authority_arn: String?
      attr_accessor type: String?
      attr_accessor mobile_device_management: Types::MobileDeviceManagement?
      attr_accessor open_id_configuration: Types::OpenIdConfiguration?
      attr_accessor status: String?
      attr_accessor status_reason: String?
      attr_accessor endpoint: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
    end

    module ConnectorType
      GENERAL_PURPOSE: String
      INTUNE: String
    end

