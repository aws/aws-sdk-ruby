module Aws::MediaPackage
  module Types

    module AdMarkers
      NONE: String
      SCTE35_ENHANCED: String
      PASSTHROUGH: String
      DATERANGE: String
    end

    module AdsOnDeliveryRestrictions
      NONE: String
      RESTRICTED: String
      UNRESTRICTED: String
      BOTH: String
    end

    class Authorization
      include Smithy::Schema::Structure

      def initialize: (
        ?cdn_identifier_secret: String,
        ?secrets_role_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor cdn_identifier_secret: String?
      attr_accessor secrets_role_arn: String?
    end

    class Channel
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?created_at: String,
        ?description: String,
        ?egress_access_logs: Types::EgressAccessLogs,
        ?hls_ingest: Types::HlsIngest,
        ?id: String,
        ?ingress_access_logs: Types::IngressAccessLogs,
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor created_at: String?
      attr_accessor description: String?
      attr_accessor egress_access_logs: Types::EgressAccessLogs?
      attr_accessor hls_ingest: Types::HlsIngest?
      attr_accessor id: String?
      attr_accessor ingress_access_logs: Types::IngressAccessLogs?
      attr_accessor tags: Hash[String, String]?
    end

    class CmafEncryption
      include Smithy::Schema::Structure

      def initialize: (
        ?constant_initialization_vector: String,
