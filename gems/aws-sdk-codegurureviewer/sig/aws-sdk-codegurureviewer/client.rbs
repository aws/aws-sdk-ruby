            repository_head: untyped,
            branch_diff: {
              source_branch_name: untyped,
              destination_branch_name: untyped
            },
            s3_bucket_repository: {
              name: String,
              details: {
                bucket_name: String,
                code_artifacts: {
                  source_code_artifacts_object_key: String,
                  build_artifacts_object_key: String
