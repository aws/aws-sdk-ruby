    interface _AssociateRepositoryResponse
      include Smithy::Client::_Response[Types::AssociateRepositoryResponse]
      def repository_association: () -> Types::RepositoryAssociation?
      def tags: () -> Hash[String, String]?
    end
    def associate_repository: (
      ?repository: {
        code_commit: {
          name: String
        },
        bitbucket: {
          name: untyped,
          connection_arn: String,
          owner: String
        },
        git_hub_enterprise_server: untyped,
        s3_bucket: {
          name: untyped,
          bucket_name: String
        }
      },
      ?client_request_token: String,
      ?tags: Hash[String, String],
      ?kms_key_details: {
