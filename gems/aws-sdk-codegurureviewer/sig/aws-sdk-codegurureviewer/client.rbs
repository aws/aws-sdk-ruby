              }
            },
            request_metadata: {
              request_id: String,
              requester: String,
              event_info: {
                name: String,
                state: String
              },
              vendor_name: String
            }
          }
        },
        analysis_types: Array[String]
      },
      ?client_request_token: String
    ) -> _CreateCodeReviewResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCodeReviewResponse

