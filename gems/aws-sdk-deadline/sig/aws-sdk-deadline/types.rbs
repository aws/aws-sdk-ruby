      include Smithy::Schema::Structure

      def initialize: (
        ?min: Integer,
        ?max: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor min: Integer?
      attr_accessor max: Integer?
    end

    module AcceleratorName
      T4: String
      A10G: String
      L4: String
      L40S: String
