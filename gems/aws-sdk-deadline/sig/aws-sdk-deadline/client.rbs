              {
                name: String,
                min: Float,
                max: untyped
              }
            ],
            custom_attributes: Array[
              {
                name: String,
                values: Array[String]
              }
            ]
          },
          storage_profile_id: String,
          tag_propagation_mode: String
        },
        service_managed_ec2: {
          instance_capabilities: {
            v_cpu_count: untyped,
            memory_mi_b: untyped,
            os_family: String,
            cpu_architecture_type: untyped,
            root_ebs_volume: {
              size_gi_b: Integer,
              iops: Integer,
              throughput_mi_b: Integer
            },
            accelerator_capabilities: {
              selections: Array[
                {
                  name: String,
                  runtime: String
                }
              ],
              count: untyped
            },
            allowed_instance_types: Array[String],
            excluded_instance_types: untyped,
            custom_amounts: untyped,
            custom_attributes: untyped
          },
          instance_market_options: {
            type: String
          },
          vpc_configuration: {
            resource_configuration_arns: Array[String]
          },
          storage_profile_id: untyped
        }
      },
      ?tags: Hash[String, String],
      ?host_configuration: {
        script_body: String,
        script_timeout_seconds: Integer
      }
    ) -> _CreateFleetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateFleetResponse

