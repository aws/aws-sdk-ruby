module Aws::InspectorScan
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InternalServerException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
        ?retry_after_seconds: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor retry_after_seconds: Integer?
    end

    module InternalServerExceptionReason
      FAILED_TO_GENERATE_SBOM: String
      OTHER: String
    end

    module OutputFormat
      CYCLONE_DX_1_5: String
      INSPECTOR: String
      INSPECTOR_ALT: String
    end

    class ScanSbomRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?sbom: Smithy::Schema::document,
        ?output_format: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor sbom: Smithy::Schema::document?
      attr_accessor output_format: String?
    end

    class ScanSbomResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?sbom: Smithy::Schema::document,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor sbom: Smithy::Schema::document?
    end

    class ThrottlingException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?retry_after_seconds: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor retry_after_seconds: Integer?
    end

    class ValidationException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
        ?fields: Array[Types::ValidationExceptionField],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor fields: Array[Types::ValidationExceptionField]?
    end

    class ValidationExceptionField
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor message: String?
    end

    module ValidationExceptionReason
      UNKNOWN_OPERATION: String
      CANNOT_PARSE: String
      FIELD_VALIDATION_FAILED: String
      UNSUPPORTED_SBOM_TYPE: String
      OTHER: String
    end
  end
end
