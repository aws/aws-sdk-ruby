          max_speed: untyped,
          occupancy: untyped
        },
        truck: {
          axle_count: untyped,
          engine_type: untyped,
          gross_weight: Integer,
          hazardous_cargos: Array[String],
          height: Integer,
          height_above_first_axle: untyped,
          kpra_length: untyped,
          length: untyped,
          license_plate: untyped,
          max_speed: untyped,
          occupancy: untyped,
          payload_capacity: untyped,
          tire_count: untyped,
