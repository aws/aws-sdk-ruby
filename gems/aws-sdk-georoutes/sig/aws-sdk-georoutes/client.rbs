        dirt_roads: untyped,
        ferries: untyped,
        seasonal_closure: untyped,
        toll_roads: untyped,
        toll_transponders: untyped,
        truck_road_types: Array[String],
        tunnels: untyped,
        u_turns: untyped,
        zone_categories: Array[
          {
            category: String
          }
        ]
      },
      ?depart_now: bool,
      ?departure_time: String,
      ?destination: Array[Float],
      ?destination_options: {
        avoid_actions_for_distance: Integer,
        heading: Float,
        matching: {
          name_hint: String,
          on_road_threshold: untyped,
          radius: untyped,
          strategy: String
        },
        side_of_street: {
          position: Array[Float],
          use_with: String
        }
      },
      ?isoline_geometry_format: String,
      ?isoline_granularity: {
        max_points: Integer,
        max_resolution: Integer
      },
      ?key: String,
      ?optimize_isoline_for: String,
      ?optimize_routing_for: String,
      ?origin: Array[Float],
      ?origin_options: {
        avoid_actions_for_distance: Integer,
        heading: Float,
        matching: {
          name_hint: String,
          on_road_threshold: untyped,
          radius: untyped,
          strategy: String
        },
        side_of_street: {
          position: Array[Float],
          use_with: String
        }
      },
      ?thresholds: {
        distance: Array[Integer],
        time: Array[Integer]
      },
      ?traffic: {
        flow_event_threshold_override: Integer,
        usage: String
      },
      ?travel_mode: String,
