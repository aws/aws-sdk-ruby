    def calculate_isolines: (
      ?allow: {
        hot: bool,
        hov: untyped
      },
      ?arrival_time: String,
      ?avoid: {
        areas: Array[
          {
            except: Array[
              {
                bounding_box: Array[Float],
                corridor: {
                  line_string: Array[
                    Array[Float]
                  ],
                  radius: Integer
                },
                polygon: Array[
                  Array[
                    Array[Float]
                  ]
                ],
                polyline_corridor: {
                  polyline: String,
                  radius: untyped
                },
                polyline_polygon: Array[String]
              }
            ],
            geometry: {
              bounding_box: untyped,
              corridor: untyped,
              polygon: untyped,
