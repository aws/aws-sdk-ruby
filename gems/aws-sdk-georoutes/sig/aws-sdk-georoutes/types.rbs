      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class CalculateIsolinesRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?allow: Types::IsolineAllowOptions,
        ?arrival_time: String,
        ?avoid: Types::IsolineAvoidanceOptions,
        ?depart_now: bool,
        ?departure_time: String,
        ?destination: Array[Float],
        ?destination_options: Types::IsolineDestinationOptions,
        ?isoline_geometry_format: String,
        ?isoline_granularity: Types::IsolineGranularityOptions,
        ?key: String,
        ?optimize_isoline_for: String,
        ?optimize_routing_for: String,
        ?origin: Array[Float],
        ?origin_options: Types::IsolineOriginOptions,
        ?thresholds: Types::IsolineThresholds,
        ?traffic: Types::IsolineTrafficOptions,
        ?travel_mode: String,
        ?travel_mode_options: Types::IsolineTravelModeOptions,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor allow: Types::IsolineAllowOptions?
      attr_accessor arrival_time: String?
      attr_accessor avoid: Types::IsolineAvoidanceOptions?
      attr_accessor depart_now: bool?
      attr_accessor departure_time: String?
      attr_accessor destination: Array[Float]?
      attr_accessor destination_options: Types::IsolineDestinationOptions?
      attr_accessor isoline_geometry_format: String?
      attr_accessor isoline_granularity: Types::IsolineGranularityOptions?
      attr_accessor key: String?
      attr_accessor optimize_isoline_for: String?
      attr_accessor optimize_routing_for: String?
      attr_accessor origin: Array[Float]?
      attr_accessor origin_options: Types::IsolineOriginOptions?
      attr_accessor thresholds: Types::IsolineThresholds?
      attr_accessor traffic: Types::IsolineTrafficOptions?
      attr_accessor travel_mode: String?
      attr_accessor travel_mode_options: Types::IsolineTravelModeOptions?
    end

    class CalculateIsolinesResponse
      include Smithy::Schema::Structure

