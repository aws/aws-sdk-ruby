    def create_test_case: (
      ?name: String,
      ?description: String,
      ?steps: Array[
        {
          name: String,
          description: String,
          action: {
            resource_action: {
              m2_managed_application_action: {
                resource: String,
                action_type: String,
                properties: {
                  force_stop: bool,
                  import_data_set_location: untyped
                }
              },
              m2_non_managed_application_action: {
                resource: untyped,
                action_type: String
              },
              cloud_formation_action: {
                resource: untyped,
                action_type: String
              }
            },
            mainframe_action: {
              resource: untyped,
              action_type: {
                batch: {
                  batch_job_name: untyped,
                  batch_job_parameters: Hash[String, String],
                  export_data_set_names: Array[String]
                },
                tn3270: {
                  script: {
                    script_location: String,
                    type: String
                  },
                  export_data_set_names: untyped
                }
              },
              properties: {
                dms_task_arn: untyped
              }
            },
            compare_action: {
              input: {
                file: {
                  source_location: untyped,
                  target_location: untyped,
                  file_metadata: {
                    data_sets: Array[
                      {
                        type: String,
                        name: String,
                        ccsid: String,
                        format: String,
                        length: Integer
                      }
                    ],
                    database_cdc: {
                      source_metadata: {
                        type: String,
                        capture_tool: String
                      },
                      target_metadata: {
                        type: String,
                        capture_tool: untyped
                      }
                    }
                  }
                }
              },
              output: {
                file: {
                  file_location: untyped
                }
              }
            }
          }
        }
      ],
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateTestCaseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateTestCaseResponse

