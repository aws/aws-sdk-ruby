module Aws::DLM
  module Types

    class Action
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?cross_region_copy: Array[Types::CrossRegionCopyAction],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor cross_region_copy: Array[Types::CrossRegionCopyAction]?
    end

