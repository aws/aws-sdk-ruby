module Aws::OpsWorks
  module Types

    class AgentVersion
      include Smithy::Schema::Structure

      def initialize: (
        ?version: String,
        ?configuration_manager: Types::StackConfigurationManager,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor version: String?
      attr_accessor configuration_manager: Types::StackConfigurationManager?
    end

    class App
      include Smithy::Schema::Structure

      def initialize: (
        ?app_id: String,
        ?stack_id: String,
        ?shortname: String,
        ?name: String,
        ?description: String,
        ?data_sources: Array[Types::DataSource],
        ?type: String,
        ?app_source: Types::Source,
        ?domains: Array[String],
        ?enable_ssl: bool,
        ?ssl_configuration: Types::SslConfiguration,
        ?attributes: Hash[String, String],
        ?created_at: String,
        ?environment: Array[Types::EnvironmentVariable],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor app_id: String?
      attr_accessor stack_id: String?
      attr_accessor shortname: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor data_sources: Array[Types::DataSource]?
      attr_accessor type: String?
      attr_accessor app_source: Types::Source?
      attr_accessor domains: Array[String]?
      attr_accessor enable_ssl: bool?
      attr_accessor ssl_configuration: Types::SslConfiguration?
      attr_accessor attributes: Hash[String, String]?
      attr_accessor created_at: String?
      attr_accessor environment: Array[Types::EnvironmentVariable]?
    end

    module AppAttributesKeys
      DocumentRoot: String
      RailsEnv: String
      AutoBundleOnDeploy: String
      AwsFlowRubySettings: String
    end

    module AppType
      aws_flow_ruby: String
      java: String
      rails: String
      php: String
      nodejs: String
      static: String
      other: String
    end

    module Architecture
      x86_64: String
      i386: String
    end

