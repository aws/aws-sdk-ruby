      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::IoTFleetHub::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateApplicationResponse
      include Smithy::Client::_Response[Types::CreateApplicationResponse]
      def application_id: () -> String?
      def application_arn: () -> String?
    end
    def create_application: (
      ?application_name: String,
      ?application_description: String,
      ?client_token: String,
      ?role_arn: String,
      ?tags: Hash[String, String]
    ) -> _CreateApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateApplicationResponse

    interface _DeleteApplicationResponse
      include Smithy::Client::_Response[Types::DeleteApplicationResponse]
    end
    def delete_application: (
      ?application_id: String,
      ?client_token: String
    ) -> _DeleteApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteApplicationResponse

    interface _DescribeApplicationResponse
      include Smithy::Client::_Response[Types::DescribeApplicationResponse]
      def application_id: () -> String?
      def application_arn: () -> String?
      def application_name: () -> String?
      def application_description: () -> String?
      def application_url: () -> String?
      def application_state: () -> String?
      def application_creation_date: () -> Integer?
      def application_last_update_date: () -> Integer?
      def role_arn: () -> String?
      def sso_client_id: () -> String?
      def error_message: () -> String?
      def tags: () -> Hash[String, String]?
    end
    def describe_application: (
      ?application_id: String
    ) -> _DescribeApplicationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeApplicationResponse

    interface _ListApplicationsResponse
      include Smithy::Client::_Response[Types::ListApplicationsResponse]
      def application_summaries: () -> Array[Types::ApplicationSummary]?
      def next_token: () -> String?
    end
    def list_applications: (
      ?next_token: String
    ) -> _ListApplicationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListApplicationsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
