module Aws::IoTFleetHub
  module Types

    module ApplicationState
      CREATING: String
      DELETING: String
      ACTIVE: String
      CREATE_FAILED: String
      DELETE_FAILED: String
    end

    class ApplicationSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?application_id: String,
        ?application_name: String,
        ?application_description: String,
        ?application_url: String,
        ?application_creation_date: Integer,
        ?application_last_update_date: Integer,
        ?application_state: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor application_id: String?
      attr_accessor application_name: String?
      attr_accessor application_description: String?
      attr_accessor application_url: String?
      attr_accessor application_creation_date: Integer?
      attr_accessor application_last_update_date: Integer?
      attr_accessor application_state: String?
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class CreateApplicationRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?application_name: String,
        ?application_description: String,
        ?client_token: String,
        ?role_arn: String,
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor application_name: String?
      attr_accessor application_description: String?
      attr_accessor client_token: String?
      attr_accessor role_arn: String?
      attr_accessor tags: Hash[String, String]?
    end

    class CreateApplicationResponse
      include Smithy::Schema::Structure

      def initialize: (
