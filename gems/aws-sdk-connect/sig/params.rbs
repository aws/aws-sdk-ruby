              min_value: ::Integer?,
              max_value: ::Integer?,
              comparison_type: ("GREATER_OR_EQUAL" | "GREATER" | "LESSER_OR_EQUAL" | "LESSER" | "EQUAL" | "NOT_EQUAL" | "RANGE")?
            }?
          }
        ]?
      }?,
      hierarchy_group_condition: {
        value: ::String?,
        hierarchy_group_match_type: ("EXACT" | "WITH_CHILD_GROUPS")?
      }?
    }

      type view_search_criteria = {
      or_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?,
          view_type_condition: ("CUSTOMER_MANAGED" | "AWS_MANAGED")?,
          view_status_condition: ("PUBLISHED" | "SAVED")?
        }
      ]?,
      and_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?,
          view_type_condition: ("CUSTOMER_MANAGED" | "AWS_MANAGED")?,
          view_status_condition: ("PUBLISHED" | "SAVED")?
        }
      ]?,
      string_condition: {
        field_name: ::String?,
        value: ::String?,
        comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
      }?,
      view_type_condition: ("CUSTOMER_MANAGED" | "AWS_MANAGED")?,
      view_status_condition: ("PUBLISHED" | "SAVED")?
    }

      type workspace_association_search_criteria = {
      or_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?
        }
      ]?,
      and_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?
        }
      ]?,
      string_condition: {
        field_name: ::String?,
        value: ::String?,
        comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
      }?
    }

      type workspace_search_criteria = {
      or_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?
        }
      ]?,
      and_conditions: Array[
        {
          or_conditions: untyped?,
          and_conditions: untyped?,
          string_condition: {
            field_name: ::String?,
            value: ::String?,
            comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
          }?
        }
      ]?,
      string_condition: {
        field_name: ::String?,
        value: ::String?,
        comparison_type: ("STARTS_WITH" | "CONTAINS" | "EXACT")?
      }?
    }

      type templated_message_config = {
      knowledge_base_id: ::String,
      message_template_id: ::String,
      template_attributes: {
        custom_attributes: Hash[::String, ::String]?,
        customer_profile_attributes: ::String?
      }
    }

      type outbound_email_content = {
      message_source_type: ("TEMPLATE" | "RAW"),
      templated_message_config: Params::templated_message_config?,
      raw_message: {
        subject: ::String,
        body: ::String,
        content_type: ::String
      }?
    }

      type evaluation_answer_input = {
      value: {
        string_value: ::String?,
        numeric_value: ::Float?,
        string_values: Array[::String]?,
        date_time_value: ::String?,
        not_applicable: bool?
      }?
    }

      type attribute_condition = {
      name: ::String?,
      value: ::String?,
      proficiency_level: ::Float?,
      range: {
        min_proficiency_level: ::Float?,
        max_proficiency_level: ::Float?
      }?,
      match_criteria: {
        agents_criteria: {
          agent_ids: Array[::String]?
        }?
      }?,
      comparison_operator: ::String?
    }

      type expression = {
      attribute_condition: Params::attribute_condition?,
      and_expression: Array[
        {
          attribute_condition: Params::attribute_condition?,
          and_expression: untyped?,
          or_expression: untyped?,
          not_attribute_condition: Params::attribute_condition?
        }
      ]?,
      or_expression: Array[
        {
          attribute_condition: Params::attribute_condition?,
          and_expression: untyped?,
          or_expression: untyped?,
          not_attribute_condition: Params::attribute_condition?
        }
      ]?,
      not_attribute_condition: Params::attribute_condition?
    }

    end
  end
end
