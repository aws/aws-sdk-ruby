    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class TooManyRequestsException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class UserNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
