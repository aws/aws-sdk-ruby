    end
    def create_evaluation_form: (
      ?instance_id: String,
      ?title: String,
      ?description: String,
      ?items: Array[
        {
          section: {
            title: String,
            ref_id: String,
            instructions: String,
            items: untyped,
            weight: Float
          },
          question: {
            title: String,
            instructions: untyped,
            ref_id: untyped,
            not_applicable_enabled: bool,
            question_type: String,
            question_type_properties: {
              numeric: {
                min_value: Integer,
                max_value: untyped,
                options: Array[
                  {
                    min_value: untyped,
                    max_value: untyped,
                    score: Integer,
                    automatic_fail: untyped
                  }
                ],
                automation: {
                  property_value: {
                    label: String
                  }
                }
              },
              single_select: {
                options: Array[
                  {
                    ref_id: untyped,
                    text: String,
                    score: untyped,
                    automatic_fail: untyped
                  }
                ],
                display_as: String,
                automation: {
                  options: Array[
                    {
                      rule_category: {
                        category: String,
                        condition: String,
                        option_ref_id: untyped
                      }
                    }
                  ],
                  default_option_ref_id: untyped
                }
              }
            },
            weight: untyped
          }
        }
      ],
      ?scoring_strategy: {
        mode: String,
        status: String
      },
      ?client_token: String
    ) -> _CreateEvaluationFormResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateEvaluationFormResponse

