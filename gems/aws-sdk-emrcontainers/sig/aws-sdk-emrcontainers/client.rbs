          }
        }
      },
      ?client_token: String,
      ?tags: Hash[String, String]
    ) -> _CreateManagedEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateManagedEndpointResponse

