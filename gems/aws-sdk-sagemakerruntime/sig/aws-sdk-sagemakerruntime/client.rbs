module Aws::SageMakerRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SageMakerRuntime::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _InvokeEndpointResponse
      include Smithy::Client::_Response[Types::InvokeEndpointOutput]
      def body: () -> String?
      def content_type: () -> String?
      def invoked_production_variant: () -> String?
      def custom_attributes: () -> String?
      def new_session_id: () -> String?
      def closed_session_id: () -> String?
    end
    def invoke_endpoint: (
      ?endpoint_name: String,
      ?body: String,
      ?content_type: String,
      ?accept: String,
      ?custom_attributes: String,
      ?target_model: String,
      ?target_variant: String,
      ?target_container_hostname: String,
      ?inference_id: String,
      ?enable_explanations: String,
      ?inference_component_name: String,
      ?session_id: String,
      ?prefix_aware_id: String
    ) -> _InvokeEndpointResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InvokeEndpointResponse

    interface _InvokeEndpointAsyncResponse
      include Smithy::Client::_Response[Types::InvokeEndpointAsyncOutput]
      def inference_id: () -> String?
      def output_location: () -> String?
      def failure_location: () -> String?
    end
    def invoke_endpoint_async: (
      ?endpoint_name: String,
      ?content_type: String,
      ?accept: String,
      ?custom_attributes: String,
      ?inference_id: String,
      ?input_location: String,
      ?s3_output_path_extension: String,
      ?filename: String,
      ?request_ttl_seconds: Integer,
      ?invocation_timeout_seconds: Integer,
      ?body: String
    ) -> _InvokeEndpointAsyncResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InvokeEndpointAsyncResponse

    interface _InvokeEndpointWithResponseStreamResponse
      include Smithy::Client::_Response[Types::InvokeEndpointWithResponseStreamOutput]
      def body: () -> Types::ResponseStream?
      def content_type: () -> String?
      def invoked_production_variant: () -> String?
      def custom_attributes: () -> String?
    end
    def invoke_endpoint_with_response_stream: (
      ?endpoint_name: String,
      ?body: String,
      ?content_type: String,
      ?accept: String,
      ?custom_attributes: String,
      ?target_variant: String,
      ?target_container_hostname: String,
      ?inference_id: String,
      ?inference_component_name: String,
      ?session_id: String,
      ?prefix_aware_id: String
    ) -> _InvokeEndpointWithResponseStreamResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _InvokeEndpointWithResponseStreamResponse
  end
end
