      attr_accessor quality_tuning_level: String?
      attr_accessor slices: Integer?
      attr_accessor telecine: String?
    end

    module XavcHdProfileTelecine
      NONE: String
      HARD: String
    end

    module XavcInterlaceMode
      PROGRESSIVE: String
      TOP_FIELD: String
      BOTTOM_FIELD: String
      FOLLOW_TOP_FIELD: String
      FOLLOW_BOTTOM_FIELD: String
    end

    module XavcProfile
      XAVC_HD_INTRA_CBG: String
      XAVC_4K_INTRA_CBG: String
      XAVC_4K_INTRA_VBR: String
      XAVC_HD: String
      XAVC_4K: String
    end

    class XavcSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?adaptive_quantization: String,
        ?entropy_encoding: String,
        ?framerate_control: String,
        ?framerate_conversion_algorithm: String,
        ?framerate_denominator: Integer,
        ?framerate_numerator: Integer,
        ?per_frame_metrics: Array[String],
        ?profile: String,
        ?slow_pal: String,
        ?softness: Integer,
        ?spatial_adaptive_quantization: String,
        ?temporal_adaptive_quantization: String,
        ?xavc4k_intra_cbg_profile_settings: Types::Xavc4kIntraCbgProfileSettings,
        ?xavc4k_intra_vbr_profile_settings: Types::Xavc4kIntraVbrProfileSettings,
        ?xavc4k_profile_settings: Types::Xavc4kProfileSettings,
        ?xavc_hd_intra_cbg_profile_settings: Types::XavcHdIntraCbgProfileSettings,
        ?xavc_hd_profile_settings: Types::XavcHdProfileSettings,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor adaptive_quantization: String?
      attr_accessor entropy_encoding: String?
      attr_accessor framerate_control: String?
      attr_accessor framerate_conversion_algorithm: String?
      attr_accessor framerate_denominator: Integer?
      attr_accessor framerate_numerator: Integer?
      attr_accessor per_frame_metrics: Array[String]?
      attr_accessor profile: String?
      attr_accessor slow_pal: String?
      attr_accessor softness: Integer?
      attr_accessor spatial_adaptive_quantization: String?
      attr_accessor temporal_adaptive_quantization: String?
      attr_accessor xavc4k_intra_cbg_profile_settings: Types::Xavc4kIntraCbgProfileSettings?
      attr_accessor xavc4k_intra_vbr_profile_settings: Types::Xavc4kIntraVbrProfileSettings?
      attr_accessor xavc4k_profile_settings: Types::Xavc4kProfileSettings?
      attr_accessor xavc_hd_intra_cbg_profile_settings: Types::XavcHdIntraCbgProfileSettings?
      attr_accessor xavc_hd_profile_settings: Types::XavcHdProfileSettings?
    end

    module XavcSlowPal
      DISABLED: String
      ENABLED: String
    end

    module XavcSpatialAdaptiveQuantization
      DISABLED: String
      ENABLED: String
    end

    module XavcTemporalAdaptiveQuantization
      DISABLED: String
      ENABLED: String
    end
  end
end
