    class AacSettings
      include Smithy::Schema::Structure

      def initialize: (
        ?audio_description_broadcaster_mix: String,
        ?bitrate: Integer,
        ?codec_profile: String,
        ?coding_mode: String,
        ?loudness_measurement_mode: String,
        ?rap_interval: Integer,
        ?rate_control_mode: String,
        ?raw_format: String,
        ?sample_rate: Integer,
        ?specification: String,
        ?target_loudness_range: Integer,
        ?vbr_quality: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor audio_description_broadcaster_mix: String?
      attr_accessor bitrate: Integer?
      attr_accessor codec_profile: String?
      attr_accessor coding_mode: String?
      attr_accessor loudness_measurement_mode: String?
      attr_accessor rap_interval: Integer?
      attr_accessor rate_control_mode: String?
      attr_accessor raw_format: String?
      attr_accessor sample_rate: Integer?
      attr_accessor specification: String?
      attr_accessor target_loudness_range: Integer?
      attr_accessor vbr_quality: String?
    end

