module Aws::SMS
  module Types

    module AppLaunchConfigurationStatus
      NotConfigured: String
      Configured: String
    end

    module AppLaunchStatus
      ReadyForConfiguration: String
      ConfigurationInProgress: String
      ConfigurationInvalid: String
      ReadyForLaunch: String
      ValidationInProgress: String
      LaunchPending: String
      LaunchInProgress: String
      Launched: String
      PartiallyLaunched: String
      DeltaLaunchInProgress: String
      DeltaLaunchFailed: String
      LaunchFailed: String
      TerminateInProgress: String
      TerminateFailed: String
      Terminated: String
    end

    module AppReplicationConfigurationStatus
      NotConfigured: String
      Configured: String
    end

    module AppReplicationStatus
      ReadyForConfiguration: String
      ConfigurationInProgress: String
      ConfigurationInvalid: String
      ReadyForReplication: String
      ValidationInProgress: String
      ReplicationPending: String
      ReplicationInProgress: String
      Replicated: String
      PartiallyReplicated: String
      DeltaReplicationInProgress: String
      DeltaReplicated: String
      DeltaReplicationFailed: String
      ReplicationFailed: String
      ReplicationStopping: String
      ReplicationStopFailed: String
      ReplicationStopped: String
    end

    module AppStatus
      Creating: String
      Active: String
      Updating: String
      Deleting: String
      Deleted: String
      DELETE_FAILED: String
    end

    class AppSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?app_id: String,
        ?imported_app_id: String,
        ?name: String,
        ?description: String,
        ?status: String,
        ?status_message: String,
        ?replication_configuration_status: String,
        ?replication_status: String,
        ?replication_status_message: String,
        ?latest_replication_time: Time,
        ?launch_configuration_status: String,
        ?launch_status: String,
        ?launch_status_message: String,
        ?launch_details: Types::LaunchDetails,
        ?creation_time: Time,
        ?last_modified: Time,
        ?role_name: String,
        ?total_server_groups: Integer,
        ?total_servers: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor app_id: String?
      attr_accessor imported_app_id: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor status: String?
      attr_accessor status_message: String?
      attr_accessor replication_configuration_status: String?
      attr_accessor replication_status: String?
      attr_accessor replication_status_message: String?
      attr_accessor latest_replication_time: Time?
      attr_accessor launch_configuration_status: String?
      attr_accessor launch_status: String?
      attr_accessor launch_status_message: String?
      attr_accessor launch_details: Types::LaunchDetails?
      attr_accessor creation_time: Time?
      attr_accessor last_modified: Time?
      attr_accessor role_name: String?
      attr_accessor total_server_groups: Integer?
      attr_accessor total_servers: Integer?
    end

    class AppValidationConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?validation_id: String,
        ?name: String,
        ?app_validation_strategy: String,
        ?ssm_validation_parameters: Types::SSMValidationParameters,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor validation_id: String?
      attr_accessor name: String?
      attr_accessor app_validation_strategy: String?
      attr_accessor ssm_validation_parameters: Types::SSMValidationParameters?
    end

    class AppValidationOutput
      include Smithy::Schema::Structure

      def initialize: (
        ?ssm_output: Types::SSMOutput,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor ssm_output: Types::SSMOutput?
    end

    module AppValidationStrategy
      SSM: String
    end

    class Connector
      include Smithy::Schema::Structure

      def initialize: (
        ?connector_id: String,
        ?version: String,
        ?status: String,
        ?capability_list: Array[String],
        ?vm_manager_name: String,
        ?vm_manager_type: String,
        ?vm_manager_id: String,
        ?ip_address: String,
        ?mac_address: String,
        ?associated_on: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor connector_id: String?
      attr_accessor version: String?
      attr_accessor status: String?
      attr_accessor capability_list: Array[String]?
      attr_accessor vm_manager_name: String?
      attr_accessor vm_manager_type: String?
      attr_accessor vm_manager_id: String?
      attr_accessor ip_address: String?
      attr_accessor mac_address: String?
      attr_accessor associated_on: Time?
    end

    module ConnectorCapability
      vSphere: String
      scvmm: String
      hyperVManager: String
      snapshotBatching: String
      smsOptimized: String
    end

    module ConnectorStatus
      Healthy: String
      Unhealthy: String
    end

