    class ReplicationJob
      include Smithy::Schema::Structure

      def initialize: (
        ?replication_job_id: String,
        ?server_id: String,
        ?server_type: String,
        ?vm_server: Types::VmServer,
        ?seed_replication_time: Time,
        ?frequency: Integer,
        ?run_once: bool,
        ?next_replication_run_start_time: Time,
        ?license_type: String,
        ?role_name: String,
        ?latest_ami_id: String,
        ?state: String,
        ?status_message: String,
        ?description: String,
        ?number_of_recent_amis_to_keep: Integer,
        ?encrypted: bool,
        ?kms_key_id: String,
        ?replication_run_list: Array[Types::ReplicationRun],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor replication_job_id: String?
      attr_accessor server_id: String?
      attr_accessor server_type: String?
      attr_accessor vm_server: Types::VmServer?
      attr_accessor seed_replication_time: Time?
      attr_accessor frequency: Integer?
      attr_accessor run_once: bool?
      attr_accessor next_replication_run_start_time: Time?
      attr_accessor license_type: String?
      attr_accessor role_name: String?
      attr_accessor latest_ami_id: String?
      attr_accessor state: String?
      attr_accessor status_message: String?
      attr_accessor description: String?
      attr_accessor number_of_recent_amis_to_keep: Integer?
      attr_accessor encrypted: bool?
