module Aws::SageMakerA2IRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SageMakerA2IRuntime::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DeleteHumanLoopResponse
      include Smithy::Client::_Response[Types::DeleteHumanLoopResponse]
    end
    def delete_human_loop: (
      ?human_loop_name: String
    ) -> _DeleteHumanLoopResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteHumanLoopResponse

    interface _DescribeHumanLoopResponse
      include Smithy::Client::_Response[Types::DescribeHumanLoopResponse]
      def creation_time: () -> Time?
      def failure_reason: () -> String?
      def failure_code: () -> String?
      def human_loop_status: () -> String?
      def human_loop_name: () -> String?
      def human_loop_arn: () -> String?
      def flow_definition_arn: () -> String?
      def human_loop_output: () -> Types::HumanLoopOutput?
    end
    def describe_human_loop: (
      ?human_loop_name: String
    ) -> _DescribeHumanLoopResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeHumanLoopResponse

    interface _ListHumanLoopsResponse
      include Smithy::Client::_Response[Types::ListHumanLoopsResponse]
      def human_loop_summaries: () -> Array[Types::HumanLoopSummary]?
      def next_token: () -> String?
    end
    def list_human_loops: (
      ?creation_time_after: Time,
      ?creation_time_before: Time,
      ?flow_definition_arn: String,
      ?sort_order: String,
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListHumanLoopsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListHumanLoopsResponse

    interface _StartHumanLoopResponse
      include Smithy::Client::_Response[Types::StartHumanLoopResponse]
      def human_loop_arn: () -> String?
    end
    def start_human_loop: (
      ?human_loop_name: String,
      ?flow_definition_arn: String,
      ?human_loop_input: {
        input_content: String
      },
      ?data_attributes: {
        content_classifiers: Array[String]
      }
    ) -> _StartHumanLoopResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartHumanLoopResponse

    interface _StopHumanLoopResponse
      include Smithy::Client::_Response[Types::StopHumanLoopResponse]
    end
    def stop_human_loop: (
      ?human_loop_name: String
    ) -> _StopHumanLoopResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StopHumanLoopResponse
  end
end
