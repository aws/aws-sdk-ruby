module Aws::PersonalizeRuntime
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::PersonalizeRuntime::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetActionRecommendationsResponse
      include Smithy::Client::_Response[Types::GetActionRecommendationsResponse]
      def action_list: () -> Array[Types::PredictedAction]?
      def recommendation_id: () -> String?
    end
    def get_action_recommendations: (
      ?campaign_arn: String,
      ?user_id: String,
      ?num_results: Integer,
      ?filter_arn: String,
      ?filter_values: Hash[String, String]
    ) -> _GetActionRecommendationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetActionRecommendationsResponse

    interface _GetPersonalizedRankingResponse
      include Smithy::Client::_Response[Types::GetPersonalizedRankingResponse]
      def personalized_ranking: () -> Array[Types::PredictedItem]?
      def recommendation_id: () -> String?
    end
    def get_personalized_ranking: (
      ?campaign_arn: String,
      ?input_list: Array[String],
      ?user_id: String,
      ?context: Hash[String, String],
      ?filter_arn: String,
      ?filter_values: Hash[String, String],
      ?metadata_columns: Hash[String,
        Array[String]
      ]
    ) -> _GetPersonalizedRankingResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPersonalizedRankingResponse

    interface _GetRecommendationsResponse
      include Smithy::Client::_Response[Types::GetRecommendationsResponse]
      def item_list: () -> Array[Types::PredictedItem]?
      def recommendation_id: () -> String?
    end
    def get_recommendations: (
      ?campaign_arn: String,
      ?item_id: String,
      ?user_id: String,
      ?num_results: Integer,
      ?context: Hash[String, String],
      ?filter_arn: String,
      ?filter_values: Hash[String, String],
      ?recommender_arn: String,
      ?promotions: Array[
        {
          name: String,
          percent_promoted_items: Integer,
          filter_arn: String,
          filter_values: Hash[String, String]
        }
      ],
      ?metadata_columns: Hash[String,
        Array[String]
      ]
    ) -> _GetRecommendationsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetRecommendationsResponse
  end
end
