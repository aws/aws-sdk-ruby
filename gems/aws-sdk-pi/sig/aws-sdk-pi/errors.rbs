module Aws::PI
  module Errors
    class InternalServiceError < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InvalidArgumentException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class NotAuthorizedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
