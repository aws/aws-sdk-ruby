module Aws::Signer
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class BadRequestException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class InternalServiceErrorException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class NotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class ServiceLimitExceededException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class TooManyRequestsException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
      def code: () -> String?
    end
  end
end
