module Aws::AuditManager
  module Types

    class AWSAccount
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?email_address: String,
        ?name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor email_address: String?
      attr_accessor name: String?
    end

    class AWSService
      include Smithy::Schema::Structure

      def initialize: (
        ?service_name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor service_name: String?
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AccountStatus
      ACTIVE: String
      INACTIVE: String
      PENDING_ACTIVATION: String
    end

    module ActionEnum
      CREATE: String
      UPDATE_METADATA: String
      ACTIVE: String
      INACTIVE: String
      DELETE: String
      UNDER_REVIEW: String
      REVIEWED: String
      IMPORT_EVIDENCE: String
    end

    class Assessment
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?aws_account: Types::AWSAccount,
        ?metadata: Types::AssessmentMetadata,
        ?framework: Types::AssessmentFramework,
        ?tags: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor aws_account: Types::AWSAccount?
      attr_accessor metadata: Types::AssessmentMetadata?
      attr_accessor framework: Types::AssessmentFramework?
      attr_accessor tags: Hash[String, String]?
    end

    class AssessmentControl
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?name: String,
        ?description: String,
        ?status: String,
        ?response: String,
