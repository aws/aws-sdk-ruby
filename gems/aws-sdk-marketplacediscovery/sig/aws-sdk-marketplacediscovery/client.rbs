      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetListingResponse
      include Smithy::Client::_Response[Types::GetListingOutput]
      def locale: () -> String?
      def associated_entities: () -> Array[Types::ListingAssociatedEntity]?
      def badges: () -> Array[Types::ListingBadge]?
      def catalog: () -> String?
      def categories: () -> Array[Types::Category]?
      def fulfillment_option_summaries: () -> Array[Types::FulfillmentOptionSummary]?
