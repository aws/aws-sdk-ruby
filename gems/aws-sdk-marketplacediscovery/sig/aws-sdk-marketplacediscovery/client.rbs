      def listing_name: () -> String?
      def logo_thumbnail_url: () -> String?
      def long_description: () -> String?
      def pricing_models: () -> Array[Types::PricingModel]?
      def pricing_units: () -> Array[Types::PricingUnit]?
      def promotional_media: () -> Array[Types::PromotionalMedia]?
      def publisher: () -> Types::SellerInformation?
      def resources: () -> Array[Types::Resource]?
      def review_summary: () -> Types::ReviewSummary?
      def seller_engagements: () -> Array[Types::SellerEngagement]?
      def short_description: () -> String?
      def use_cases: () -> Array[Types::UseCaseEntry]?
    end
    def get_listing: (
      ?locale: String,
      ?listing_id: String
    ) -> _GetListingResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetListingResponse

