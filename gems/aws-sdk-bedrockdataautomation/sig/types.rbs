    end

    class UpsertEntityInfo
      attr_accessor vocabulary: Types::VocabularyEntityInfo
      attr_accessor unknown: untyped
      SENSITIVE: []

      class Vocabulary < UpsertEntityInfo
      end
      class Unknown < UpsertEntityInfo
      end
