      DynamoDBWriteCapacityUtilization: String
      ECSServiceAverageCPUUtilization: String
      ECSServiceAverageMemoryUtilization: String
      ALBRequestCountPerTarget: String
      RDSReaderAverageCPUUtilization: String
      RDSReaderAverageDatabaseConnections: String
      EC2SpotFleetRequestAverageCPUUtilization: String
      EC2SpotFleetRequestAverageNetworkIn: String
      EC2SpotFleetRequestAverageNetworkOut: String
    end

    class ScalingPlan
      include Smithy::Schema::Structure

      def initialize: (
        ?scaling_plan_name: String,
        ?scaling_plan_version: Integer,
        ?application_source: Types::ApplicationSource,
        ?scaling_instructions: Array[Types::ScalingInstruction],
        ?status_code: String,
        ?status_message: String,
        ?status_start_time: Time,
        ?creation_time: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor scaling_plan_name: String?
      attr_accessor scaling_plan_version: Integer?
      attr_accessor application_source: Types::ApplicationSource?
      attr_accessor scaling_instructions: Array[Types::ScalingInstruction]?
      attr_accessor status_code: String?
      attr_accessor status_message: String?
      attr_accessor status_start_time: Time?
      attr_accessor creation_time: Time?
    end

    class ScalingPlanResource
      include Smithy::Schema::Structure

      def initialize: (
        ?scaling_plan_name: String,
        ?scaling_plan_version: Integer,
        ?service_namespace: String,
        ?resource_id: String,
        ?scalable_dimension: String,
        ?scaling_policies: Array[Types::ScalingPolicy],
        ?scaling_status_code: String,
        ?scaling_status_message: String,
      ) -> void
