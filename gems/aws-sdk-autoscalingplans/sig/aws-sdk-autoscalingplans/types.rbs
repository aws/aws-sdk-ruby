      EC2SpotFleetRequestTargetCapacity: String
      RDSClusterReadReplicaCount: String
      DynamoDBTableReadCapacityUnits: String
      DynamoDBTableWriteCapacityUnits: String
      DynamoDBIndexReadCapacityUnits: String
      DynamoDBIndexWriteCapacityUnits: String
    end

    class ScalingInstruction
      include Smithy::Schema::Structure

      def initialize: (
        ?service_namespace: String,
        ?resource_id: String,
        ?scalable_dimension: String,
        ?min_capacity: Integer,
        ?max_capacity: Integer,
        ?target_tracking_configurations: Array[Types::TargetTrackingConfiguration],
        ?predefined_load_metric_specification: Types::PredefinedLoadMetricSpecification,
        ?customized_load_metric_specification: Types::CustomizedLoadMetricSpecification,
        ?scheduled_action_buffer_time: Integer,
        ?predictive_scaling_max_capacity_behavior: String,
        ?predictive_scaling_max_capacity_buffer: Integer,
        ?predictive_scaling_mode: String,
        ?scaling_policy_update_behavior: String,
        ?disable_dynamic_scaling: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor service_namespace: String?
      attr_accessor resource_id: String?
      attr_accessor scalable_dimension: String?
      attr_accessor min_capacity: Integer?
      attr_accessor max_capacity: Integer?
      attr_accessor target_tracking_configurations: Array[Types::TargetTrackingConfiguration]?
      attr_accessor predefined_load_metric_specification: Types::PredefinedLoadMetricSpecification?
      attr_accessor customized_load_metric_specification: Types::CustomizedLoadMetricSpecification?
      attr_accessor scheduled_action_buffer_time: Integer?
      attr_accessor predictive_scaling_max_capacity_behavior: String?
      attr_accessor predictive_scaling_max_capacity_buffer: Integer?
      attr_accessor predictive_scaling_mode: String?
      attr_accessor scaling_policy_update_behavior: String?
      attr_accessor disable_dynamic_scaling: bool?
    end

