      attr_accessor resource_id: String?
      attr_accessor scalable_dimension: String?
      attr_accessor scaling_policies: Array[Types::ScalingPolicy]?
      attr_accessor scaling_status_code: String?
      attr_accessor scaling_status_message: String?
    end

    module ScalingPlanStatusCode
      Active: String
      ActiveWithProblems: String
      CreationInProgress: String
      CreationFailed: String
      DeletionInProgress: String
      DeletionFailed: String
      UpdateInProgress: String
      UpdateFailed: String
    end

    class ScalingPolicy
      include Smithy::Schema::Structure

      def initialize: (
        ?policy_name: String,
        ?policy_type: String,
        ?target_tracking_configuration: Types::TargetTrackingConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor policy_name: String?
      attr_accessor policy_type: String?
      attr_accessor target_tracking_configuration: Types::TargetTrackingConfiguration?
    end

    module ScalingPolicyUpdateBehavior
      KeepExternalPolicies: String
      ReplaceExternalPolicies: String
    end

    module ScalingStatusCode
      Inactive: String
      PartiallyActive: String
      Active: String
    end

    module ServiceNamespace
      AUTOSCALING: String
      ECS: String
      EC2: String
      RDS: String
      DYNAMODB: String
    end

    class TagFilter
      include Smithy::Schema::Structure

      def initialize: (
        ?key: String,
