    module PredictiveScalingMaxCapacityBehavior
      SetForecastCapacityToMaxCapacity: String
      SetMaxCapacityToForecastCapacity: String
      SetMaxCapacityAboveForecastCapacity: String
    end

    module PredictiveScalingMode
      ForecastAndScale: String
      ForecastOnly: String
    end

    module ScalableDimension
      AutoScalingGroupDesiredCapacity: String
