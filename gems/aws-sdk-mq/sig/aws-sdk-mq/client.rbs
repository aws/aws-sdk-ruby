    interface _CreateBrokerResponse
      include Smithy::Client::_Response[Types::CreateBrokerResponse]
      def broker_arn: () -> String?
      def broker_id: () -> String?
    end
    def create_broker: (
      ?authentication_strategy: String,
      ?auto_minor_version_upgrade: bool,
      ?broker_name: String,
