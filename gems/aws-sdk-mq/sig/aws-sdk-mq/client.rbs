        service_account_password: untyped,
        service_account_username: untyped,
        user_base: untyped,
        user_role_name: untyped,
        user_search_matching: untyped,
        user_search_subtree: untyped
      },
      ?logs: {
        audit: bool,
        general: untyped
      },
