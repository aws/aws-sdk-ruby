        day_of_week: String,
        time_of_day: String,
        time_zone: untyped
      },
      ?publicly_accessible: bool,
      ?security_groups: Array[String],
      ?storage_size: Integer,
      ?storage_type: String,
      ?subnet_ids: Array[String],
      ?tags: Hash[String, String],
      ?users: Array[
        {
          console_access: bool,
          groups: Array[String],
          password: String,
          username: untyped,
          replication_user: untyped
        }
      ],
      ?data_replication_mode: String,
      ?data_replication_primary_broker_arn: String
    ) -> _CreateBrokerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateBrokerResponse

