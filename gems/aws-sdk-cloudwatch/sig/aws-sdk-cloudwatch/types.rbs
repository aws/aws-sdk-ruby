module Aws::CloudWatch
  module Types

    module ActionsSuppressedBy
      WaitPeriod: String
      ExtensionPeriod: String
      Alarm: String
    end

    class AlarmContributor
      include Smithy::Schema::Structure

      def initialize: (
        ?contributor_id: String,
        ?contributor_attributes: Hash[String, String],
        ?state_reason: String,
        ?state_transitioned_timestamp: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor contributor_id: String?
      attr_accessor contributor_attributes: Hash[String, String]?
      attr_accessor state_reason: String?
      attr_accessor state_transitioned_timestamp: Time?
    end

    class AlarmHistoryItem
      include Smithy::Schema::Structure

      def initialize: (
        ?alarm_name: String,
        ?alarm_contributor_id: String,
        ?alarm_type: String,
        ?timestamp: Time,
        ?history_item_type: String,
        ?history_summary: String,
        ?history_data: String,
        ?alarm_contributor_attributes: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor alarm_name: String?
      attr_accessor alarm_contributor_id: String?
      attr_accessor alarm_type: String?
      attr_accessor timestamp: Time?
      attr_accessor history_item_type: String?
      attr_accessor history_summary: String?
      attr_accessor history_data: String?
      attr_accessor alarm_contributor_attributes: Hash[String, String]?
    end

    module AlarmType
      CompositeAlarm: String
      MetricAlarm: String
    end

    class AnomalyDetector
      include Smithy::Schema::Structure

      def initialize: (
        ?namespace: String,
        ?metric_name: String,
        ?dimensions: Array[Types::Dimension],
        ?stat: String,
        ?configuration: Types::AnomalyDetectorConfiguration,
        ?state_value: String,
        ?metric_characteristics: Types::MetricCharacteristics,
        ?single_metric_anomaly_detector: Types::SingleMetricAnomalyDetector,
        ?metric_math_anomaly_detector: Types::MetricMathAnomalyDetector,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor namespace: String?
      attr_accessor metric_name: String?
      attr_accessor dimensions: Array[Types::Dimension]?
      attr_accessor stat: String?
      attr_accessor configuration: Types::AnomalyDetectorConfiguration?
      attr_accessor state_value: String?
      attr_accessor metric_characteristics: Types::MetricCharacteristics?
      attr_accessor single_metric_anomaly_detector: Types::SingleMetricAnomalyDetector?
      attr_accessor metric_math_anomaly_detector: Types::MetricMathAnomalyDetector?
    end

    class AnomalyDetectorConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?excluded_time_ranges: Array[Types::Range],
        ?metric_timezone: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor excluded_time_ranges: Array[Types::Range]?
      attr_accessor metric_timezone: String?
    end

    module AnomalyDetectorStateValue
      PENDING_TRAINING: String
      TRAINED_INSUFFICIENT_DATA: String
      TRAINED: String
    end

    module AnomalyDetectorType
      SINGLE_METRIC: String
      METRIC_MATH: String
    end

    module ComparisonOperator
      GreaterThanOrEqualToThreshold: String
      GreaterThanThreshold: String
      LessThanThreshold: String
      LessThanOrEqualToThreshold: String
      LessThanLowerOrGreaterThanUpperThreshold: String
      LessThanLowerThreshold: String
      GreaterThanUpperThreshold: String
    end

    class CompositeAlarm
      include Smithy::Schema::Structure

      def initialize: (
        ?actions_enabled: bool,
        ?alarm_actions: Array[String],
