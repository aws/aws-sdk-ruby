    def add_instance_fleet: (
      ?cluster_id: String,
      ?instance_fleet: {
        name: String,
        instance_fleet_type: String,
        target_on_demand_capacity: Integer,
        target_spot_capacity: untyped,
        instance_type_configs: Array[
          {
            instance_type: String,
            weighted_capacity: untyped,
            bid_price: untyped,
            bid_price_as_percentage_of_on_demand_price: Float,
            ebs_configuration: {
              ebs_block_device_configs: Array[
                {
                  volume_specification: {
                    volume_type: String,
                    iops: Integer,
                    size_in_gb: untyped,
                    throughput: Integer
                  },
                  volumes_per_instance: untyped
                }
              ],
              ebs_optimized: bool
            },
            configurations: Array[
              {
                classification: untyped,
                configurations: untyped,
                properties: Hash[String, String]
              }
            ],
            custom_ami_id: untyped,
            priority: untyped
          }
        ],
        launch_specifications: {
          spot_specification: {
            timeout_duration_minutes: untyped,
            timeout_action: String,
            block_duration_minutes: untyped,
            allocation_strategy: String
          },
          on_demand_specification: {
            allocation_strategy: String,
            capacity_reservation_options: {
              usage_strategy: String,
              capacity_reservation_preference: String,
              capacity_reservation_resource_group_arn: untyped
            }
          }
        },
        resize_specifications: {
          spot_resize_specification: {
            timeout_duration_minutes: untyped,
            allocation_strategy: untyped
          },
          on_demand_resize_specification: {
            timeout_duration_minutes: untyped,
            allocation_strategy: untyped,
            capacity_reservation_options: untyped
          }
        },
        context: untyped
      }
    ) -> _AddInstanceFleetResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AddInstanceFleetResponse

