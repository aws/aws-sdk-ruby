    interface _BatchDeleteTaxRegistrationResponse
      include Smithy::Client::_Response[Types::BatchDeleteTaxRegistrationResponse]
      def errors: () -> Array[Types::BatchDeleteTaxRegistrationError]?
    end
    def batch_delete_tax_registration: (
      ?account_ids: Array[String]
    ) -> _BatchDeleteTaxRegistrationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchDeleteTaxRegistrationResponse

