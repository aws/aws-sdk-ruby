module Aws::Bedrock
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AgreementAvailability
      include Smithy::Schema::Structure

      def initialize: (
        ?status: String,
        ?error_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status: String?
      attr_accessor error_message: String?
    end

    module AgreementStatus
      AVAILABLE: String
      PENDING: String
      NOT_AVAILABLE: String
      ERROR: String
    end

    module ApplicationType
      MODEL_EVALUATION: String
      RAG_EVALUATION: String
    end

    module AttributeType
      STRING: String
      NUMBER: String
      BOOLEAN: String
      STRING_LIST: String
    end

    module AuthorizationStatus
      AUTHORIZED: String
      NOT_AUTHORIZED: String
    end

    class AutomatedEvaluationConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?dataset_metric_configs: Array[Types::EvaluationDatasetMetricConfig],
        ?evaluator_model_config: Types::EvaluatorModelConfig,
        ?custom_metric_config: Types::AutomatedEvaluationCustomMetricConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor dataset_metric_configs: Array[Types::EvaluationDatasetMetricConfig]?
      attr_accessor evaluator_model_config: Types::EvaluatorModelConfig?
      attr_accessor custom_metric_config: Types::AutomatedEvaluationCustomMetricConfig?
    end

    class AutomatedEvaluationCustomMetricConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?custom_metrics: Array[Types::AutomatedEvaluationCustomMetricSource],
        ?evaluator_model_config: Types::CustomMetricEvaluatorModelConfig,
