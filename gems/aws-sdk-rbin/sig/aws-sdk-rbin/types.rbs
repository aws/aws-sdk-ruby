module Aws::Rbin
  module Types

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
    end

    module ConflictExceptionReason
      INVALID_RULE_STATE: String
    end

    class CreateRuleRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?retention_period: Types::RetentionPeriod,
        ?description: String,
        ?tags: Array[Types::Tag],
        ?resource_type: String,
        ?resource_tags: Array[Types::ResourceTag],
        ?lock_configuration: Types::LockConfiguration,
        ?exclude_resource_tags: Array[Types::ResourceTag],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor retention_period: Types::RetentionPeriod?
      attr_accessor description: String?
      attr_accessor tags: Array[Types::Tag]?
