module Aws::DynamoDB
  class EndpointParameters
    def initialize: (
      ?region: String,
      use_dual_stack: bool,
      use_fips: bool,
      ?endpoint: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?resource_arn: String,
      ?resource_arn_list: Array[String],
    ) -> void | (?Hash[Symbol, untyped]) -> void

    attr_accessor region: String?
    attr_accessor use_dual_stack: bool
    attr_accessor use_fips: bool
    attr_accessor endpoint: String?
    attr_accessor account_id: String?
    attr_accessor account_id_endpoint_mode: String?
    attr_accessor resource_arn: String?
    attr_accessor resource_arn_list: Array[String]?
  end
end
