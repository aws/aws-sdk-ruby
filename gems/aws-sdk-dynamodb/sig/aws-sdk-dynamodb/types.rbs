module Aws::DynamoDB
  module Types

    module ApproximateCreationDateTimePrecision
      MILLISECOND: String
      MICROSECOND: String
    end

    class ArchivalSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?archival_date_time: Time,
        ?archival_reason: String,
        ?archival_backup_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor archival_date_time: Time?
      attr_accessor archival_reason: String?
      attr_accessor archival_backup_arn: String?
    end

    module AttributeAction
      ADD: String
      PUT: String
      DELETE: String
    end

    class AttributeDefinition
      include Smithy::Schema::Structure

      def initialize: (
        ?attribute_name: String,
        ?attribute_type: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor attribute_name: String?
      attr_accessor attribute_type: String?
    end

    class AttributeValue
      include Smithy::Schema::Union

      def initialize: (
        ?s: String,
        ?n: String,
        ?b: String,
        ?ss: Array[String],
        ?ns: Array[String],
        ?bs: Array[String],
        ?m: Hash[String, Types::AttributeValue],
        ?l: Array[Types::AttributeValue],
        ?null: bool,
        ?bool: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor s: String?
      attr_accessor n: String?
      attr_accessor b: String?
      attr_accessor ss: Array[String]?
      attr_accessor ns: Array[String]?
      attr_accessor bs: Array[String]?
      attr_accessor m: Hash[String, Types::AttributeValue]?
      attr_accessor l: Array[Types::AttributeValue]?
      attr_accessor null: bool?
      attr_accessor bool: bool?

      class S < AttributeValue
      end
      class N < AttributeValue
      end
      class B < AttributeValue
      end
      class SS < AttributeValue
      end
      class NS < AttributeValue
      end
      class BS < AttributeValue
      end
      class M < AttributeValue
      end
      class L < AttributeValue
      end
      class NULL < AttributeValue
      end
      class BOOL < AttributeValue
      end
      class Unknown < AttributeValue
      end
    end

    class AttributeValueUpdate
      include Smithy::Schema::Structure

      def initialize: (
