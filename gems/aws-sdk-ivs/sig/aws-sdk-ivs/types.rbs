module Aws::Ivs
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?exception_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor exception_message: String?
    end

    class AudioConfiguration
      include Smithy::Schema::Structure

      def initialize: (
