module Aws::MarketplaceAgreement
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::MarketplaceAgreement::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DescribeAgreementResponse
      include Smithy::Client::_Response[Types::DescribeAgreementOutput]
      def agreement_id: () -> String?
      def acceptor: () -> Types::Acceptor?
      def proposer: () -> Types::Proposer?
      def start_time: () -> Time?
      def end_time: () -> Time?
      def acceptance_time: () -> Time?
      def agreement_type: () -> String?
      def estimated_charges: () -> Types::EstimatedCharges?
      def proposal_summary: () -> Types::ProposalSummary?
      def status: () -> String?
    end
    def describe_agreement: (
      ?agreement_id: String
    ) -> _DescribeAgreementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DescribeAgreementResponse

    interface _GetAgreementTermsResponse
      include Smithy::Client::_Response[Types::GetAgreementTermsOutput]
      def accepted_terms: () -> Array[Types::AcceptedTerm]?
      def next_token: () -> String?
    end
    def get_agreement_terms: (
      ?agreement_id: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _GetAgreementTermsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAgreementTermsResponse

    interface _SearchAgreementsResponse
      include Smithy::Client::_Response[Types::SearchAgreementsOutput]
      def agreement_view_summaries: () -> Array[Types::AgreementViewSummary]?
      def next_token: () -> String?
    end
    def search_agreements: (
      ?catalog: String,
      ?filters: Array[
        {
          name: String,
          values: Array[String]
        }
      ],
      ?sort: {
        sort_by: String,
        sort_order: String
      },
      ?max_results: Integer,
      ?next_token: String
    ) -> _SearchAgreementsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchAgreementsResponse
  end
end
