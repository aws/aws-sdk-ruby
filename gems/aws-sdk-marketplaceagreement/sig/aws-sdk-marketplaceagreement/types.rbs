      include Smithy::Schema::Structure

      def initialize: (
        ?agreement_id: String,
        ?acceptor: Types::Acceptor,
        ?proposer: Types::Proposer,
        ?start_time: Time,
        ?end_time: Time,
        ?acceptance_time: Time,
