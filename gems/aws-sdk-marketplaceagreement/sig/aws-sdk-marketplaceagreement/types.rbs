        ?variable_payment_term_configuration: Types::VariablePaymentTermConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor configurable_upfront_pricing_term_configuration: Types::ConfigurableUpfrontPricingTermConfiguration?
      attr_accessor renewal_term_configuration: Types::RenewalTermConfiguration?
      attr_accessor variable_payment_term_configuration: Types::VariablePaymentTermConfiguration?

      class ConfigurableUpfrontPricingTermConfiguration < RequestedTermConfiguration
      end
      class RenewalTermConfiguration < RequestedTermConfiguration
      end
      class VariablePaymentTermConfiguration < RequestedTermConfiguration
      end
      class Unknown < RequestedTermConfiguration
      end
    end

