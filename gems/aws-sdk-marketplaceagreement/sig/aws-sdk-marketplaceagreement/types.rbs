      include Smithy::Schema::Structure

      def initialize: (
        ?rate_card: Array[Types::RateCardItem],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor rate_card: Array[Types::RateCardItem]?
    end

    class ValidationException
      include Smithy::Schema::Structure

      def initialize: (
        ?request_id: String,
        ?message: String,
        ?reason: String,
        ?fields: Array[Types::ValidationExceptionField],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor request_id: String?
      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor fields: Array[Types::ValidationExceptionField]?
    end

    class ValidationExceptionField
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor message: String?
    end

    module ValidationExceptionReason
      INVALID_AGREEMENT_ID: String
      MISSING_AGREEMENT_ID: String
      INVALID_CATALOG: String
      INVALID_FILTER_NAME: String
      INVALID_FILTER_VALUES: String
      INVALID_SORT_BY: String
      INVALID_SORT_ORDER: String
      INVALID_NEXT_TOKEN: String
      INVALID_MAX_RESULTS: String
      UNSUPPORTED_FILTERS: String
      OTHER: String
    end

