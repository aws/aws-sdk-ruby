PATIBLE_TERMS" | "MISSING_USAGE_AGREEMENT" | "INVALID_INCREMENTAL_CHARGE" | "MISSING_ACCOUNT_ADDRESS" | "UNSUPPORTED_ACTION" | "INVALID_REJECTION_REASON" | "INVALID_PAYMENT_REQUEST_STATUS" | "OTHER" | "DUPLICATE_CHARGES" | "UNSUPPORTED_ACCOUNT_PLAN" | "DUPLICATE_AGREEMENT_IN_ORGANIZATION" | "MISSING_PURCHASE_ORDER_REFERENCE")
