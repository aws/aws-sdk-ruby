module Aws::Invoicing
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::Invoicing::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _BatchGetInvoiceProfileResponse
      include Smithy::Client::_Response[Types::BatchGetInvoiceProfileResponse]
      def profiles: () -> Array[Types::InvoiceProfile]?
    end
    def batch_get_invoice_profile: (
      ?account_ids: Array[String]
    ) -> _BatchGetInvoiceProfileResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchGetInvoiceProfileResponse

    interface _CreateInvoiceUnitResponse
      include Smithy::Client::_Response[Types::CreateInvoiceUnitResponse]
      def invoice_unit_arn: () -> String?
    end
    def create_invoice_unit: (
      ?name: String,
      ?invoice_receiver: String,
      ?description: String,
      ?tax_inheritance_disabled: bool,
      ?rule: {
        linked_accounts: Array[String]
      },
      ?resource_tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateInvoiceUnitResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateInvoiceUnitResponse

    interface _DeleteInvoiceUnitResponse
      include Smithy::Client::_Response[Types::DeleteInvoiceUnitResponse]
      def invoice_unit_arn: () -> String?
    end
    def delete_invoice_unit: (
      ?invoice_unit_arn: String
    ) -> _DeleteInvoiceUnitResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteInvoiceUnitResponse

    interface _GetInvoiceUnitResponse
      include Smithy::Client::_Response[Types::GetInvoiceUnitResponse]
      def invoice_unit_arn: () -> String?
      def invoice_receiver: () -> String?
      def name: () -> String?
      def description: () -> String?
      def tax_inheritance_disabled: () -> bool?
      def rule: () -> Types::InvoiceUnitRule?
      def last_modified: () -> Time?
    end
    def get_invoice_unit: (
      ?invoice_unit_arn: String,
      ?as_of: Time
    ) -> _GetInvoiceUnitResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetInvoiceUnitResponse

    interface _ListInvoiceSummariesResponse
      include Smithy::Client::_Response[Types::ListInvoiceSummariesResponse]
      def invoice_summaries: () -> Array[Types::InvoiceSummary]?
      def next_token: () -> String?
    end
    def list_invoice_summaries: (
      ?selector: {
        resource_type: String,
        value: String
      },
      ?filter: {
        time_interval: {
          start_date: Time,
          end_date: untyped
        },
        billing_period: {
          month: Integer,
          year: Integer
        },
        invoicing_entity: String
      },
      ?next_token: String,
      ?max_results: Integer
    ) -> _ListInvoiceSummariesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListInvoiceSummariesResponse

    interface _ListInvoiceUnitsResponse
      include Smithy::Client::_Response[Types::ListInvoiceUnitsResponse]
      def invoice_units: () -> Array[Types::InvoiceUnit]?
      def next_token: () -> String?
    end
    def list_invoice_units: (
      ?filters: {
        names: Array[String],
        invoice_receivers: Array[String],
        accounts: untyped
      },
      ?next_token: String,
      ?max_results: Integer,
      ?as_of: Time
    ) -> _ListInvoiceUnitsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListInvoiceUnitsResponse

    interface _ListTagsForResourceResponse
      include Smithy::Client::_Response[Types::ListTagsForResourceResponse]
      def resource_tags: () -> Array[Types::ResourceTag]?
    end
    def list_tags_for_resource: (
      ?resource_arn: String
    ) -> _ListTagsForResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListTagsForResourceResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?resource_tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?resource_tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateInvoiceUnitResponse
      include Smithy::Client::_Response[Types::UpdateInvoiceUnitResponse]
      def invoice_unit_arn: () -> String?
    end
    def update_invoice_unit: (
      ?invoice_unit_arn: String,
      ?description: String,
      ?tax_inheritance_disabled: bool,
      ?rule: {
        linked_accounts: Array[String]
      }
    ) -> _UpdateInvoiceUnitResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdateInvoiceUnitResponse
  end
end
