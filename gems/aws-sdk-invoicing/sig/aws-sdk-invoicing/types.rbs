      MAX_ACCOUNTS_EXCEEDED: String
      MAX_INVOICE_UNITS_EXCEEDED: String
      DUPLICATE_INVOICE_UNIT: String
      MUTUAL_EXCLUSION_ERROR: String
      ACCOUNT_MEMBERSHIP_ERROR: String
      TAX_SETTINGS_ERROR: String
      EXPIRED_NEXT_TOKEN: String
      INVALID_NEXT_TOKEN: String
      INVALID_INPUT: String
      FIELD_VALIDATION_FAILED: String
