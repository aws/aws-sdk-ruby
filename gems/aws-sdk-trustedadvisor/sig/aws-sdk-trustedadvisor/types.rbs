      attr_accessor update_reason_code: String?
      attr_accessor recommendation_identifier: String?
    end

    module UpdateRecommendationLifecycleStage
      PENDING_RESPONSE: String
      IN_PROGRESS: String
      DISMISSED: String
      RESOLVED: String
    end

    module UpdateRecommendationLifecycleStageReasonCode
      NON_CRITICAL_ACCOUNT: String
      TEMPORARY_ACCOUNT: String
      VALID_BUSINESS_CASE: String
      OTHER_METHODS_AVAILABLE: String
      LOW_PRIORITY: String
      NOT_APPLICABLE: String
      OTHER: String
    end

    class UpdateRecommendationResourceExclusionError
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?error_code: String,
        ?error_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor error_code: String?
      attr_accessor error_message: String?
    end

    class ValidationException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end
  end
end
