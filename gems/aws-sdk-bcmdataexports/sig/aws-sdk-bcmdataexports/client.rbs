    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?connect_timeout: Numeric,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::BCMDataExports::EndpointProvider,
      ?http_proxy: URI::HTTP | String,
      ?http_wire_trace: bool,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?protocol: Symbol | Object,
      ?raise_response_errors: bool,
      ?read_timeout: Numeric,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?ssl_ca_bundle: String,
      ?ssl_ca_directory: String,
      ?ssl_ca_store: OpenSSL::X509::Store,
      ?ssl_verify_peer: bool,
      ?stub_responses: bool,
      ?transport: Smithy::Client::NetHTTP::Transport,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateExportResponse
      include Smithy::Client::_Response[Types::CreateExportResponse]
      def export_arn: () -> String?
    end
    def create_export: (
      ?export: {
        export_arn: String,
        name: String,
        description: String,
        data_query: {
          query_statement: String,
          table_configurations: Hash[String,
            Hash[String, String]
          ]
        },
        destination_configurations: {
          s3_destination: {
            s3_bucket: untyped,
            s3_prefix: untyped,
            s3_region: untyped,
            s3_output_configurations: {
              output_type: String,
              format: String,
              compression: String,
              overwrite: String
            }
          }
        },
        refresh_cadence: {
          frequency: String
        }
      },
      ?resource_tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateExportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateExportResponse

    interface _DeleteExportResponse
      include Smithy::Client::_Response[Types::DeleteExportResponse]
      def export_arn: () -> String?
    end
    def delete_export: (
      ?export_arn: String
    ) -> _DeleteExportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteExportResponse

    interface _GetExecutionResponse
