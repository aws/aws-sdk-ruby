      def export_status: () -> Types::ExportStatus?
    end
    def get_export: (
      ?export_arn: String
    ) -> _GetExportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetExportResponse

    interface _GetTableResponse
      include Smithy::Client::_Response[Types::GetTableResponse]
      def table_name: () -> String?
      def description: () -> String?
      def table_properties: () -> Hash[String, String]?
      def schema: () -> Array[Types::Column]?
    end
    def get_table: (
      ?table_name: String,
      ?table_properties: Hash[String, String]
    ) -> _GetTableResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetTableResponse

    interface _ListExecutionsResponse
      include Smithy::Client::_Response[Types::ListExecutionsResponse]
      def executions: () -> Array[Types::ExecutionReference]?
      def next_token: () -> String?
    end
    def list_executions: (
      ?export_arn: String,
      ?max_results: Integer,
      ?next_token: String
    ) -> _ListExecutionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListExecutionsResponse

    interface _ListExportsResponse
      include Smithy::Client::_Response[Types::ListExportsResponse]
