      attr_accessor affected_sessions: ::Array[Types::UserIntentAffectedSession]
      SENSITIVE: []
    end

    class UserIntentClusteringResultContent
      attr_accessor user_intents: ::Array[Types::UserIntentCluster]
      SENSITIVE: []
    end

    class ValidationException
      attr_accessor message: ::String
      attr_accessor reason: ("CannotParse" | "FieldValidationFailed" | "IdempotentParameterMismatchException" | "EventInOtherSession" | "ResourceConflict")
      attr_accessor field_list: ::Array[Types::ValidationExceptionField]
      attr_accessor event_type: untyped
      SENSITIVE: []
    end

    class ValidationExceptionField
      attr_accessor name: ::String
      attr_accessor message: ::String
      SENSITIVE: []
    end

    class Variant
      attr_accessor name: ::String
      attr_accessor weight: ::Integer
      attr_accessor variant_configuration: Types::VariantConfiguration
      SENSITIVE: []
    end

    class VariantConfiguration
      attr_accessor configuration_bundle: Types::ConfigurationBundleRef
      attr_accessor target: Types::TargetRef
      SENSITIVE: []
    end

    class VariantResult
      attr_accessor variant_name: ::String
      attr_accessor sample_size: ::Integer
      attr_accessor mean: ::Float
      attr_accessor absolute_change: ::Float
      attr_accessor percent_change: ::Float
      attr_accessor p_value: ::Float
      attr_accessor confidence_interval: Types::ConfidenceInterval
      attr_accessor is_significant: bool
      SENSITIVE: []
    end

    class ViewPort
      attr_accessor width: ::Integer
      attr_accessor height: ::Integer
      SENSITIVE: []
    end

    class CodeInterpreterStreamOutput < Enumerator[untyped, untyped]
      def event_types: () -> [:result, :access_denied_exception, :conflict_exception, :internal_server_exception, :resource_not_found_exception, :service_quota_exceeded_exception, :throttling_exception, :validation_exception]
    end

    class InvokeAgentRuntimeCommandStreamOutput < Enumerator[untyped, untyped]
      def event_types: () -> [:chunk, :access_denied_exception, :internal_server_exception, :resource_not_found_exception, :service_quota_exceeded_exception, :throttling_exception, :validation_exception, :runtime_client_error]
    end

    class InvokeHarnessStreamOutput < Enumerator[untyped, untyped]
      def event_types: () -> [:message_start, :content_block_start, :content_block_delta, :content_block_stop, :message_stop, :metadata, :internal_server_exception, :validation_exception, :runtime_client_error]
    end
  end
end
