      ?session_id: String,
      ?event_timestamp: Time,
      ?payload: Array[
        {
          conversational: {
            content: {
              text: String
            },
            role: String
          },
          blob: Smithy::Schema::document
        }
      ],
      ?branch: {
        root_event_id: String,
        name: String
      },
      ?client_token: String
    ) -> _CreateEventResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateEventResponse

