    class BrowserSessionSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?browser_identifier: String,
        ?session_id: String,
        ?name: String,
        ?status: String,
        ?created_at: Time,
        ?last_updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor browser_identifier: String?
      attr_accessor session_id: String?
      attr_accessor name: String?
      attr_accessor status: String?
      attr_accessor created_at: Time?
      attr_accessor last_updated_at: Time?
    end

    class CodeInterpreterResult
      include Smithy::Schema::Structure

      def initialize: (
        ?content: Array[Types::ContentBlock],
        ?structured_content: Types::ToolResultStructuredContent,
        ?is_error: bool,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor content: Array[Types::ContentBlock]?
      attr_accessor structured_content: Types::ToolResultStructuredContent?
      attr_accessor is_error: bool?
    end

    module CodeInterpreterSessionStatus
      READY: String
      TERMINATED: String
    end

    class CodeInterpreterSessionSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?code_interpreter_identifier: String,
        ?session_id: String,
        ?name: String,
        ?status: String,
        ?created_at: Time,
        ?last_updated_at: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor code_interpreter_identifier: String?
      attr_accessor session_id: String?
      attr_accessor name: String?
      attr_accessor status: String?
      attr_accessor created_at: Time?
      attr_accessor last_updated_at: Time?
    end

    class CodeInterpreterStreamOutput
      include Smithy::Schema::Union

      def initialize: (
        ?result: Types::CodeInterpreterResult,
        ?access_denied_exception: Types::AccessDeniedException,
        ?conflict_exception: Types::ConflictException,
        ?internal_server_exception: Types::InternalServerException,
        ?resource_not_found_exception: Types::ResourceNotFoundException,
        ?service_quota_exceeded_exception: Types::ServiceQuotaExceededException,
        ?throttling_exception: Types::ThrottlingException,
        ?validation_exception: Types::ValidationException,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor result: Types::CodeInterpreterResult?
      attr_accessor access_denied_exception: Types::AccessDeniedException?
      attr_accessor conflict_exception: Types::ConflictException?
      attr_accessor internal_server_exception: Types::InternalServerException?
      attr_accessor resource_not_found_exception: Types::ResourceNotFoundException?
      attr_accessor service_quota_exceeded_exception: Types::ServiceQuotaExceededException?
      attr_accessor throttling_exception: Types::ThrottlingException?
      attr_accessor validation_exception: Types::ValidationException?

      class Result < CodeInterpreterStreamOutput
      end
      class AccessDeniedException < CodeInterpreterStreamOutput
      end
      class ConflictException < CodeInterpreterStreamOutput
      end
      class InternalServerException < CodeInterpreterStreamOutput
      end
      class ResourceNotFoundException < CodeInterpreterStreamOutput
      end
      class ServiceQuotaExceededException < CodeInterpreterStreamOutput
      end
      class ThrottlingException < CodeInterpreterStreamOutput
      end
      class ValidationException < CodeInterpreterStreamOutput
      end
      class Unknown < CodeInterpreterStreamOutput
      end
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Content
      include Smithy::Schema::Union

      def initialize: (
        ?text: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor text: String?

      class Text < Content
      end
      class Unknown < Content
      end
    end

    class ContentBlock
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?text: String,
        ?data: String,
        ?mime_type: String,
        ?uri: String,
        ?name: String,
        ?description: String,
        ?size: Integer,
        ?resource: Types::ResourceContent,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor text: String?
      attr_accessor data: String?
      attr_accessor mime_type: String?
      attr_accessor uri: String?
      attr_accessor name: String?
      attr_accessor description: String?
      attr_accessor size: Integer?
      attr_accessor resource: Types::ResourceContent?
    end

    module ContentBlockType
      TEXT: String
      IMAGE: String
      EMBEDDED_RESOURCE: String
      RESOURCE_LINK: String
    end

