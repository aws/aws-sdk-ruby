      attr_accessor name: String?
      attr_accessor include_parent_branches: bool?
    end

    module BrowserSessionStatus
      READY: String
      TERMINATED: String
    end

    class BrowserSessionStream
      include Smithy::Schema::Structure

      def initialize: (
