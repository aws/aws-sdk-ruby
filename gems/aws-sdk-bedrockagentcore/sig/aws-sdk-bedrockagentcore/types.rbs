      attr_accessor online_evaluation_config_arn: String?
      attr_accessor per_variant_online_evaluation_config: Array[Types::PerVariantOnlineEvaluationConfig]?

      class OnlineEvaluationConfigArn < ABTestEvaluationConfig
      end
      class PerVariantOnlineEvaluationConfig < ABTestEvaluationConfig
      end
      class Unknown < ABTestEvaluationConfig
      end
    end

