module Aws::BedrockAgentCore
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InvalidInputException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class RuntimeClientError < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottledException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class UnauthorizedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
      def reason: () -> String?
      def field_list: () -> Array[Types::ValidationExceptionField]?
    end
  end
