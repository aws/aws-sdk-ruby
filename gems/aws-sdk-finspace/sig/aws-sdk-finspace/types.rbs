module Aws::Finspace
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AutoScalingConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?min_node_count: Integer,
        ?max_node_count: Integer,
        ?auto_scaling_metric: String,
        ?metric_target: Float,
        ?scale_in_cooldown_seconds: Float,
        ?scale_out_cooldown_seconds: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor min_node_count: Integer?
      attr_accessor max_node_count: Integer?
      attr_accessor auto_scaling_metric: String?
      attr_accessor metric_target: Float?
      attr_accessor scale_in_cooldown_seconds: Float?
      attr_accessor scale_out_cooldown_seconds: Float?
    end

    module AutoScalingMetric
      CPU_UTILIZATION_PERCENTAGE: String
    end

    class CapacityConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?node_type: String,
        ?node_count: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor node_type: String?
      attr_accessor node_count: Integer?
    end

    class ChangeRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?change_type: String,
        ?s3_path: String,
        ?db_path: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor change_type: String?
      attr_accessor s3_path: String?
      attr_accessor db_path: String?
    end

    module ChangeType
      PUT: String
      DELETE: String
    end

    module ChangesetStatus
      PENDING: String
      PROCESSING: String
      FAILED: String
      COMPLETED: String
    end

