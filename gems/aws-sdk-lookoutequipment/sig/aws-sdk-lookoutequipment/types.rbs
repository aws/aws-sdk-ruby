module Aws::LookoutEquipment
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AutoPromotionResult
      MODEL_PROMOTED: String
      MODEL_NOT_PROMOTED: String
      RETRAINING_INTERNAL_ERROR: String
      RETRAINING_CUSTOMER_ERROR: String
      RETRAINING_CANCELLED: String
    end

    class CategoricalValues
      include Smithy::Schema::Structure

      def initialize: (
