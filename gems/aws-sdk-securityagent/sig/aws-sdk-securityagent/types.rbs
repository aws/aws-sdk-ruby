module Aws::SecurityAgent
  module Types

    class AWSResources
      include Smithy::Schema::Structure

      def initialize: (
        ?vpcs: Array[Types::VpcConfig],
        ?log_groups: Array[String],
        ?s3_buckets: Array[String],
        ?secret_arns: Array[String],
        ?lambda_function_arns: Array[String],
        ?iam_roles: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor vpcs: Array[Types::VpcConfig]?
      attr_accessor log_groups: Array[String]?
      attr_accessor s3_buckets: Array[String]?
      attr_accessor secret_arns: Array[String]?
      attr_accessor lambda_function_arns: Array[String]?
      attr_accessor iam_roles: Array[String]?
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AccessType
      PRIVATE: String
      PUBLIC: String
    end

    class Actor
      include Smithy::Schema::Structure

      def initialize: (
        ?identifier: String,
