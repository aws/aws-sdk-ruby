module Aws::RTBFabric
  module Types

    class AcceptLinkRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?gateway_id: String,
        ?link_id: String,
        ?attributes: Types::LinkAttributes,
        ?log_settings: Types::LinkLogSettings,
        ?timeout_in_millis: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor gateway_id: String?
      attr_accessor link_id: String?
      attr_accessor attributes: Types::LinkAttributes?
      attr_accessor log_settings: Types::LinkLogSettings?
      attr_accessor timeout_in_millis: Integer?
    end

    class AcceptLinkResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?gateway_id: String,
        ?peer_gateway_id: String,
        ?status: String,
        ?created_at: Time,
        ?updated_at: Time,
        ?direction: String,
        ?flow_modules: Array[Types::ModuleConfiguration],
        ?pending_flow_modules: Array[Types::ModuleConfiguration],
        ?attributes: Types::LinkAttributes,
        ?log_settings: Types::LinkLogSettings,
        ?connectivity_type: String,
        ?link_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor gateway_id: String?
      attr_accessor peer_gateway_id: String?
      attr_accessor status: String?
      attr_accessor created_at: Time?
      attr_accessor updated_at: Time?
      attr_accessor direction: String?
      attr_accessor flow_modules: Array[Types::ModuleConfiguration]?
      attr_accessor pending_flow_modules: Array[Types::ModuleConfiguration]?
      attr_accessor attributes: Types::LinkAttributes?
      attr_accessor log_settings: Types::LinkLogSettings?
      attr_accessor connectivity_type: String?
      attr_accessor link_id: String?
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Action
      include Smithy::Schema::Union

      def initialize: (
        ?no_bid: Types::NoBidAction,
        ?header_tag: Types::HeaderTagAction,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor no_bid: Types::NoBidAction?
      attr_accessor header_tag: Types::HeaderTagAction?

      class NoBid < Action
      end
      class HeaderTag < Action
      end
      class Unknown < Action
      end
    end

