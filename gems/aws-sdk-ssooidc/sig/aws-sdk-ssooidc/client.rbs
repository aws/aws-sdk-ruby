module Aws::SSOOIDC
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?account_id_endpoint_mode: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?auth_scheme_preference: Array[String],
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SSOOIDC::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?max_attempts: Integer,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_mode: String,
      ?retry_strategy: Object,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateTokenResponse
      include Smithy::Client::_Response[Types::CreateTokenResponse]
      def access_token: () -> String?
      def token_type: () -> String?
      def expires_in: () -> Integer?
      def refresh_token: () -> String?
      def id_token: () -> String?
    end
    def create_token: (
      ?client_id: String,
      ?client_secret: String,
      ?grant_type: String,
      ?device_code: String,
      ?code: String,
      ?refresh_token: String,
      ?scope: Array[String],
      ?redirect_uri: String,
      ?code_verifier: String
    ) -> _CreateTokenResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateTokenResponse

    interface _CreateTokenWithIAMResponse
      include Smithy::Client::_Response[Types::CreateTokenWithIAMResponse]
      def access_token: () -> String?
      def token_type: () -> String?
      def expires_in: () -> Integer?
      def refresh_token: () -> String?
      def id_token: () -> String?
      def issued_token_type: () -> String?
      def scope: () -> Array[String]?
      def aws_additional_details: () -> Types::AwsAdditionalDetails?
    end
    def create_token_with_iam: (
      ?client_id: String,
      ?grant_type: String,
      ?code: String,
      ?refresh_token: String,
      ?assertion: String,
      ?scope: Array[String],
      ?redirect_uri: String,
      ?subject_token: String,
      ?subject_token_type: String,
      ?requested_token_type: String,
      ?code_verifier: String
    ) -> _CreateTokenWithIAMResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateTokenWithIAMResponse

    interface _RegisterClientResponse
      include Smithy::Client::_Response[Types::RegisterClientResponse]
      def client_id: () -> String?
      def client_secret: () -> String?
      def client_id_issued_at: () -> Integer?
      def client_secret_expires_at: () -> Integer?
      def authorization_endpoint: () -> String?
      def token_endpoint: () -> String?
    end
    def register_client: (
      ?client_name: String,
      ?client_type: String,
      ?scopes: Array[String],
      ?redirect_uris: Array[String],
      ?grant_types: Array[String],
      ?issuer_url: String,
      ?entitled_application_arn: String
    ) -> _RegisterClientResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _RegisterClientResponse

    interface _StartDeviceAuthorizationResponse
      include Smithy::Client::_Response[Types::StartDeviceAuthorizationResponse]
      def device_code: () -> String?
      def user_code: () -> String?
      def verification_uri: () -> String?
      def verification_uri_complete: () -> String?
      def expires_in: () -> Integer?
      def interval: () -> Integer?
    end
    def start_device_authorization: (
      ?client_id: String,
      ?client_secret: String,
      ?start_url: String
    ) -> _StartDeviceAuthorizationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartDeviceAuthorizationResponse
  end
end
