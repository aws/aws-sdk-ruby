        ?update_time: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor tracker_name: String?
      attr_accessor tracker_arn: String?
      attr_accessor update_time: Time?
    end

    class ValidationException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
        ?reason: String,
        ?field_list: Array[Types::ValidationExceptionField],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
      attr_accessor reason: String?
      attr_accessor field_list: Array[Types::ValidationExceptionField]?
    end

    class ValidationExceptionField
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor message: String?
    end

    class VerifyDevicePositionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?tracker_name: String,
        ?device_state: Types::DeviceState,
        ?distance_unit: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor tracker_name: String?
      attr_accessor device_state: Types::DeviceState?
      attr_accessor distance_unit: String?
    end

    class VerifyDevicePositionResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?inferred_state: Types::InferredState,
        ?device_id: String,
        ?sample_time: Time,
        ?received_time: Time,
        ?distance_unit: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor inferred_state: Types::InferredState?
      attr_accessor device_id: String?
      attr_accessor sample_time: Time?
      attr_accessor received_time: Time?
      attr_accessor distance_unit: String?
    end

    class WiFiAccessPoint
      include Smithy::Schema::Structure

      def initialize: (
        ?mac_address: String,
        ?rss: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor mac_address: String?
      attr_accessor rss: Integer?
    end
  end
end
