module Aws::EKSAuth
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AssumeRoleForPodIdentityRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?cluster_name: String,
        ?token: String,
        ?eks_node_name: String,
        ?instance_id: String,
        ?zone: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor cluster_name: String?
      attr_accessor token: String?
      attr_accessor eks_node_name: String?
      attr_accessor instance_id: String?
      attr_accessor zone: String?
    end

    class AssumeRoleForPodIdentityResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?subject: Types::Subject,
        ?audience: String,
        ?pod_identity_association: Types::PodIdentityAssociation,
        ?assumed_role_user: Types::AssumedRoleUser,
        ?credentials: Types::Credentials,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor subject: Types::Subject?
      attr_accessor audience: String?
      attr_accessor pod_identity_association: Types::PodIdentityAssociation?
      attr_accessor assumed_role_user: Types::AssumedRoleUser?
      attr_accessor credentials: Types::Credentials?
    end

    class AssumedRoleUser
      include Smithy::Schema::Structure

      def initialize: (
        ?arn: String,
        ?assume_role_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor arn: String?
      attr_accessor assume_role_id: String?
    end

    class Credentials
      include Smithy::Schema::Structure

      def initialize: (
        ?session_token: String,
        ?secret_access_key: String,
        ?access_key_id: String,
        ?expiration: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor session_token: String?
      attr_accessor secret_access_key: String?
      attr_accessor access_key_id: String?
      attr_accessor expiration: Time?
    end

    class ExpiredTokenException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InternalServerException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InvalidParameterException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InvalidRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class InvalidTokenException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class PodIdentityAssociation
      include Smithy::Schema::Structure

      def initialize: (
        ?association_arn: String,
        ?association_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor association_arn: String?
      attr_accessor association_id: String?
    end

    class ResourceNotFoundException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ServiceUnavailableException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Subject
      include Smithy::Schema::Structure

      def initialize: (
        ?namespace: String,
        ?service_account: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor namespace: String?
      attr_accessor service_account: String?
    end

    class ThrottlingException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end
  end
end
