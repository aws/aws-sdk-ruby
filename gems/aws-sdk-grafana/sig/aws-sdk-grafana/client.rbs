      ?workspace_id: String,
      ?authentication_providers: Array[String],
      ?saml_configuration: {
        idp_metadata: {
          url: String,
          xml: String
        },
        assertion_attributes: {
          name: String,
          login: untyped,
          email: untyped,
          groups: untyped,
          role: untyped,
          org: untyped
        },
        role_values: {
          editor: Array[String],
          admin: untyped
        },
        allowed_organizations: Array[String],
        login_validity_duration: Integer
