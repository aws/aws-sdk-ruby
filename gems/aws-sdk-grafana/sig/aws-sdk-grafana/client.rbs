      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AssociateLicenseResponse
      include Smithy::Client::_Response[Types::AssociateLicenseOutput]
      def workspace: () -> Types::WorkspaceDescription?
    end
    def associate_license: (
      ?workspace_id: String,
      ?license_type: String,
      ?grafana_token: String
    ) -> _AssociateLicenseResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AssociateLicenseResponse

    interface _CreateWorkspaceResponse
      include Smithy::Client::_Response[Types::CreateWorkspaceOutput]
