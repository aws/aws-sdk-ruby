module Aws::SagemakerEdge
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::SagemakerEdge::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _GetDeploymentsResponse
      include Smithy::Client::_Response[Types::GetDeploymentsResult]
      def deployments: () -> Array[Types::EdgeDeployment]?
    end
    def get_deployments: (
      ?device_name: String,
      ?device_fleet_name: String
    ) -> _GetDeploymentsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetDeploymentsResponse

    interface _GetDeviceRegistrationResponse
      include Smithy::Client::_Response[Types::GetDeviceRegistrationResult]
      def device_registration: () -> String?
      def cache_ttl: () -> String?
    end
    def get_device_registration: (
      ?device_name: String,
      ?device_fleet_name: String
    ) -> _GetDeviceRegistrationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetDeviceRegistrationResponse

    interface _SendHeartbeatResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def send_heartbeat: (
      ?agent_metrics: Array[
        {
          dimension: String,
          metric_name: String,
          value: Float,
          timestamp: Time
        }
      ],
      ?models: Array[
        {
          model_name: String,
          model_version: String,
          latest_sample_time: Time,
          latest_inference: untyped,
          model_metrics: Array[
            {
              dimension: String,
              metric_name: String,
              value: Float,
              timestamp: untyped
            }
          ]
        }
      ],
      ?agent_version: String,
      ?device_name: String,
      ?device_fleet_name: String,
      ?deployment_result: {
        deployment_name: String,
        deployment_status: untyped,
        deployment_status_message: String,
        deployment_start_time: Time,
        deployment_end_time: untyped,
        deployment_models: Array[
          {
            model_handle: untyped,
            model_name: String,
            model_version: String,
            desired_state: String,
            state: untyped,
            status: String,
            status_reason: untyped,
            rollback_failure_reason: untyped
          }
        ]
      }
    ) -> _SendHeartbeatResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SendHeartbeatResponse
  end
end
