                  category: String,
                  owner: String,
                  provider: String,
                  version: String
                },
                run_order: Integer,
                configuration: Hash[String, String],
                commands: Array[String],
                output_artifacts: Array[
                  {
                    name: String,
                    files: Array[String]
                  }
                ],
                input_artifacts: Array[
                  {
                    name: untyped
                  }
                ],
                output_variables: Array[String],
                role_arn: untyped,
                region: String,
                namespace: String,
                timeout_in_minutes: Integer,
                environment_variables: Array[
                  {
                    name: String,
                    value: String,
                    type: String
                  }
                ]
              }
            ],
            on_failure: {
              result: String,
              retry_configuration: {
                retry_mode: String
              },
              conditions: Array[
                {
                  result: untyped,
                  rules: Array[
                    {
                      name: String,
                      rule_type_id: {
                        category: String,
                        owner: String,
                        provider: String,
                        version: untyped
                      },
                      configuration: Hash[String, String],
                      commands: untyped,
                      input_artifacts: untyped,
                      role_arn: untyped,
                      region: untyped,
                      timeout_in_minutes: Integer
                    }
                  ]
                }
              ]
            },
            on_success: {
              conditions: untyped
            },
            before_entry: {
              conditions: untyped
            }
          }
        ],
        version: Integer,
        execution_mode: String,
        pipeline_type: String,
        variables: Array[
          {
            name: String,
            default_value: String,
            description: String
          }
        ],
        triggers: Array[
          {
            provider_type: String,
            git_configuration: {
              source_action_name: untyped,
              push: Array[
                {
                  tags: {
                    includes: Array[String],
                    excludes: untyped
                  },
                  branches: {
                    includes: Array[String],
                    excludes: untyped
                  },
                  file_paths: {
                    includes: Array[String],
                    excludes: untyped
                  }
                }
              ],
              pull_request: Array[
                {
                  events: Array[String],
                  branches: untyped,
                  file_paths: untyped
                }
              ]
            }
          }
        ]
      },
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
