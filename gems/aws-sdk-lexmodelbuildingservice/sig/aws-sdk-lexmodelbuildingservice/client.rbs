        },
        rejection_statement: {
          messages: untyped,
          response_card: untyped
        }
      },
      ?conclusion_statement: {
        messages: Array[
          {
            content_type: String,
            content: String,
            group_number: Integer
          }
        ],
        response_card: String
      },
      ?dialog_code_hook: {
        uri: String,
        message_version: String
      },
      ?fulfillment_activity: {
        type: String,
        code_hook: {
          uri: String,
          message_version: String
        }
      },
      ?parent_intent_signature: String,
      ?checksum: String,
      ?create_version: bool,
      ?kendra_configuration: {
        kendra_index: String,
        query_filter_string: String,
        role: String
      },
      ?input_contexts: Array[
        {
          name: String
        }
      ],
      ?output_contexts: Array[
        {
          name: String,
          time_to_live_in_seconds: Integer,
          turns_to_live: Integer
        }
      ]
    ) -> _PutIntentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutIntentResponse

    interface _PutSlotTypeResponse
      include Smithy::Client::_Response[Types::PutSlotTypeResponse]
      def name: () -> String?
      def description: () -> String?
      def enumeration_values: () -> Array[Types::EnumerationValue]?
      def last_updated_date: () -> Time?
      def created_date: () -> Time?
      def version: () -> String?
      def checksum: () -> String?
      def value_selection_strategy: () -> String?
      def create_version: () -> bool?
      def parent_slot_type_signature: () -> String?
      def slot_type_configurations: () -> Array[Types::SlotTypeConfiguration]?
    end
    def put_slot_type: (
      ?name: String,
      ?description: String,
      ?enumeration_values: Array[
        {
          value: String,
          synonyms: Array[String]
        }
      ],
      ?checksum: String,
      ?value_selection_strategy: String,
      ?create_version: bool,
      ?parent_slot_type_signature: String,
      ?slot_type_configurations: Array[
        {
          regex_configuration: {
            pattern: String
          }
        }
      ]
    ) -> _PutSlotTypeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutSlotTypeResponse

    interface _StartImportResponse
      include Smithy::Client::_Response[Types::StartImportResponse]
      def name: () -> String?
      def resource_type: () -> String?
      def merge_strategy: () -> String?
      def import_id: () -> String?
      def import_status: () -> String?
      def tags: () -> Array[Types::Tag]?
      def created_date: () -> Time?
    end
    def start_import: (
      ?payload: String,
      ?resource_type: String,
      ?merge_strategy: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _StartImportResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartImportResponse

    interface _StartMigrationResponse
      include Smithy::Client::_Response[Types::StartMigrationResponse]
      def v1_bot_name: () -> String?
      def v1_bot_version: () -> String?
      def v1_bot_locale: () -> String?
      def v2_bot_id: () -> String?
      def v2_bot_role: () -> String?
      def migration_id: () -> String?
      def migration_strategy: () -> String?
      def migration_timestamp: () -> Time?
    end
    def start_migration: (
      ?v1_bot_name: String,
      ?v1_bot_version: String,
      ?v2_bot_name: String,
      ?v2_bot_role: String,
      ?migration_strategy: String
    ) -> _StartMigrationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _StartMigrationResponse

    interface _TagResourceResponse
      include Smithy::Client::_Response[Types::TagResourceResponse]
    end
    def tag_resource: (
      ?resource_arn: String,
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _TagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _TagResourceResponse

    interface _UntagResourceResponse
      include Smithy::Client::_Response[Types::UntagResourceResponse]
    end
    def untag_resource: (
      ?resource_arn: String,
      ?tag_keys: Array[String]
    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse
  end
end
