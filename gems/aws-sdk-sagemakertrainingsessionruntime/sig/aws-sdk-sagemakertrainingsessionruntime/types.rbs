module Aws::SageMakerTrainingSessionRuntime
  module Types

    class AdamParamsConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?learning_rate: Float,
        ?beta1: Float,
        ?beta2: Float,
        ?eps: Float,
        ?weight_decay: Float,
        ?grad_clip_norm: Float,
        ?lora_plus_lr_ratio: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor learning_rate: Float?
      attr_accessor beta1: Float?
      attr_accessor beta2: Float?
      attr_accessor eps: Float?
      attr_accessor weight_decay: Float?
      attr_accessor grad_clip_norm: Float?
      attr_accessor lora_plus_lr_ratio: Float?
    end

    class ComputeLogprobsConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?prompt: Types::ModelInput,
        ?model_package_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor prompt: Types::ModelInput?
      attr_accessor model_package_arn: String?
    end

    class ComputeLogprobsResult
      include Smithy::Schema::Structure

      def initialize: (
        ?logprobs: Array[Float],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor logprobs: Array[Float]?
    end

