    end

    class ModelInput
      include Smithy::Schema::Structure

      def initialize: (
        ?chunks: Array[Types::EncodedTextChunk],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor chunks: Array[Types::EncodedTextChunk]?
    end

    class OperationConfig
      include Smithy::Schema::Union

      def initialize: (
        ?forward: Types::ForwardConfig,
        ?forward_backward: Types::ForwardBackwardConfig,
        ?optimizer_step: Types::OptimizerStepConfig,
        ?save_weights: Types::SaveWeightsConfig,
        ?save_state: Types::SaveStateConfig,
        ?load_state: Types::LoadStateConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor forward: Types::ForwardConfig?
      attr_accessor forward_backward: Types::ForwardBackwardConfig?
      attr_accessor optimizer_step: Types::OptimizerStepConfig?
      attr_accessor save_weights: Types::SaveWeightsConfig?
      attr_accessor save_state: Types::SaveStateConfig?
      attr_accessor load_state: Types::LoadStateConfig?

      class Forward < OperationConfig
      end
      class ForwardBackward < OperationConfig
      end
      class OptimizerStep < OperationConfig
      end
      class SaveWeights < OperationConfig
      end
      class SaveState < OperationConfig
      end
      class LoadState < OperationConfig
      end
      class Unknown < OperationConfig
      end
    end

    class OperationResult
      include Smithy::Schema::Union

      def initialize: (
        ?forward: Types::ForwardResult,
        ?forward_backward: Types::ForwardBackwardResult,
        ?optimizer_step: Types::OptimizerStepResult,
        ?save_weights: Types::SaveWeightsResult,
        ?save_state: Types::SaveStateResult,
        ?load_state: Types::LoadStateResult,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor forward: Types::ForwardResult?
      attr_accessor forward_backward: Types::ForwardBackwardResult?
      attr_accessor optimizer_step: Types::OptimizerStepResult?
      attr_accessor save_weights: Types::SaveWeightsResult?
      attr_accessor save_state: Types::SaveStateResult?
      attr_accessor load_state: Types::LoadStateResult?

      class Forward < OperationResult
      end
      class ForwardBackward < OperationResult
      end
      class OptimizerStep < OperationResult
      end
      class SaveWeights < OperationResult
      end
      class SaveState < OperationResult
      end
      class LoadState < OperationResult
      end
      class Unknown < OperationResult
      end
    end

