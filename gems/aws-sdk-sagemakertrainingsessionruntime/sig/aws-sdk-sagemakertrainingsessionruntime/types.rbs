    class SampleConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?prompt: Types::ModelInput,
        ?num_samples: Integer,
        ?sampling_params: Types::SamplingParams,
        ?include_prompt_logprobs: bool,
        ?topk_prompt_logprobs: Integer,
        ?model_package_arn: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor prompt: Types::ModelInput?
      attr_accessor num_samples: Integer?
      attr_accessor sampling_params: Types::SamplingParams?
      attr_accessor include_prompt_logprobs: bool?
      attr_accessor topk_prompt_logprobs: Integer?
      attr_accessor model_package_arn: String?
    end

    class SampleOperationConfig
      include Smithy::Schema::Union

      def initialize: (
        ?sample: Types::SampleConfig,
        ?compute_logprobs: Types::ComputeLogprobsConfig,
        ?load_weights_for_sampling: Types::LoadWeightsForSamplingConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor sample: Types::SampleConfig?
      attr_accessor compute_logprobs: Types::ComputeLogprobsConfig?
      attr_accessor load_weights_for_sampling: Types::LoadWeightsForSamplingConfig?

      class Sample < SampleOperationConfig
      end
      class ComputeLogprobs < SampleOperationConfig
      end
      class LoadWeightsForSampling < SampleOperationConfig
      end
      class Unknown < SampleOperationConfig
      end
    end

    class SampleOperationResult
      include Smithy::Schema::Union

      def initialize: (
        ?sample: Types::SampleResponse,
        ?compute_logprobs: Types::ComputeLogprobsResult,
        ?load_weights_for_sampling: Types::LoadWeightsForSamplingResult,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor sample: Types::SampleResponse?
      attr_accessor compute_logprobs: Types::ComputeLogprobsResult?
      attr_accessor load_weights_for_sampling: Types::LoadWeightsForSamplingResult?

      class Sample < SampleOperationResult
      end
      class ComputeLogprobs < SampleOperationResult
      end
      class LoadWeightsForSampling < SampleOperationResult
      end
      class Unknown < SampleOperationResult
      end
    end

    class SampleResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?sequences: Array[Types::SampledSequence],
        ?prompt_logprobs: Array[Float],
        ?topk_prompt_logprobs: Array[Array[Types::TokenLogprob]],
