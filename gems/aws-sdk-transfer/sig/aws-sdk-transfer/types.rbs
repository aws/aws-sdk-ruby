module Aws::Transfer
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module AgreementStatusType
      ACTIVE: String
      INACTIVE: String
    end

    class As2AsyncMdnConnectorConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?url: String,
        ?server_ids: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor url: String?
      attr_accessor server_ids: Array[String]?
    end

    class As2ConnectorConfig
      include Smithy::Schema::Structure

      def initialize: (
        ?local_profile_id: String,
        ?partner_profile_id: String,
        ?message_subject: String,
        ?compression: String,
        ?encryption_algorithm: String,
        ?signing_algorithm: String,
        ?mdn_signing_algorithm: String,
        ?mdn_response: String,
        ?basic_auth_secret_id: String,
        ?preserve_content_type: String,
        ?async_mdn_config: Types::As2AsyncMdnConnectorConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor local_profile_id: String?
      attr_accessor partner_profile_id: String?
      attr_accessor message_subject: String?
      attr_accessor compression: String?
      attr_accessor encryption_algorithm: String?
      attr_accessor signing_algorithm: String?
      attr_accessor mdn_signing_algorithm: String?
      attr_accessor mdn_response: String?
      attr_accessor basic_auth_secret_id: String?
      attr_accessor preserve_content_type: String?
      attr_accessor async_mdn_config: Types::As2AsyncMdnConnectorConfig?
    end

    module As2Transport
      HTTP: String
    end

    module CertificateStatusType
      ACTIVE: String
      PENDING_ROTATION: String
      INACTIVE: String
    end

    module CertificateType
      CERTIFICATE: String
      CERTIFICATE_WITH_PRIVATE_KEY: String
    end

    module CertificateUsageType
      SIGNING: String
      ENCRYPTION: String
      TLS: String
    end

    module CommunicationMode
      CLIENT_TALK_FIRST: String
      SERVER_TALK_FIRST: String
    end

    module CompressionEnum
      ZLIB: String
      DISABLED: String
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class ConnectorEgressConfig
      include Smithy::Schema::Union

      def initialize: (
        ?vpc_lattice: Types::ConnectorVpcLatticeEgressConfig,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor vpc_lattice: Types::ConnectorVpcLatticeEgressConfig?

      class VpcLattice < ConnectorEgressConfig
      end
      class Unknown < ConnectorEgressConfig
      end
    end

    module ConnectorEgressType
      SERVICE_MANAGED: String
      VPC_LATTICE: String
    end

