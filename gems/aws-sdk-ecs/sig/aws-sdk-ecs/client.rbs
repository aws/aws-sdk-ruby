        {
          capacity_provider: String,
          weight: Integer,
          base: Integer
        }
      ],
      ?platform_version: String,
      ?role: String,
      ?deployment_configuration: {
        deployment_circuit_breaker: {
          enable: bool,
          rollback: untyped
        },
        maximum_percent: Integer,
        minimum_healthy_percent: untyped,
        alarms: {
          alarm_names: Array[String],
          rollback: untyped,
          enable: untyped
        },
        strategy: String,
        bake_time_in_minutes: untyped,
