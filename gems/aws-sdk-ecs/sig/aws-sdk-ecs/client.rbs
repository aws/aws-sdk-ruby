        auto_scaling_group_arn: String,
        managed_scaling: {
          status: String,
          target_capacity: Integer,
          minimum_scaling_step_size: Integer,
          maximum_scaling_step_size: untyped,
          instance_warmup_period: Integer
        },
        managed_termination_protection: String,
        managed_draining: String
      },
      ?managed_instances_provider: {
        infrastructure_role_arn: String,
        instance_launch_template: {
          ec2_instance_profile_arn: untyped,
          network_configuration: {
            subnets: Array[String],
            security_groups: untyped
          },
          storage_configuration: {
            storage_size_gi_b: Integer
          },
          monitoring: String,
          instance_requirements: {
            v_cpu_count: {
              min: Integer,
              max: untyped
            },
            memory_mi_b: {
              min: untyped,
              max: untyped
            },
            cpu_manufacturers: Array[String],
            memory_gi_b_per_v_cpu: {
              min: Float,
              max: untyped
            },
            excluded_instance_types: Array[String],
            instance_generations: Array[String],
            spot_max_price_percentage_over_lowest_price: untyped,
            on_demand_max_price_percentage_over_lowest_price: untyped,
            bare_metal: String,
            burstable_performance: String,
            require_hibernate_support: bool,
            network_interface_count: {
              min: untyped,
              max: untyped
            },
            local_storage: String,
            local_storage_types: Array[String],
            total_local_storage_gb: {
              min: untyped,
              max: untyped
            },
            baseline_ebs_bandwidth_mbps: {
              min: untyped,
              max: untyped
            },
            accelerator_types: Array[String],
            accelerator_count: {
              min: untyped,
              max: untyped
            },
            accelerator_manufacturers: Array[String],
            accelerator_names: Array[String],
            accelerator_total_memory_mi_b: {
              min: untyped,
              max: untyped
            },
            network_bandwidth_gbps: {
              min: untyped,
              max: untyped
            },
            allowed_instance_types: Array[String],
            max_spot_price_as_percentage_of_optimal_on_demand_price: untyped
          }
        },
        propagate_tags: String
      },
      ?tags: Array[
        {
          key: String,
          value: String
        }
      ]
    ) -> _CreateCapacityProviderResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateCapacityProviderResponse

