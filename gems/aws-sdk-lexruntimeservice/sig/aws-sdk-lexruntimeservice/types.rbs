module Aws::LexRuntimeService
  module Types

    class ActiveContext
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?time_to_live: Types::ActiveContextTimeToLive,
        ?parameters: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor time_to_live: Types::ActiveContextTimeToLive?
      attr_accessor parameters: Hash[String, String]?
    end

    class ActiveContextTimeToLive
      include Smithy::Schema::Structure

      def initialize: (
        ?time_to_live_in_seconds: Integer,
        ?turns_to_live: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor time_to_live_in_seconds: Integer?
      attr_accessor turns_to_live: Integer?
    end

    class BadGatewayException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class BadRequestException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class Button
      include Smithy::Schema::Structure

      def initialize: (
        ?text: String,
        ?value: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor text: String?
      attr_accessor value: String?
    end

    module ConfirmationStatus
      NONE: String
      CONFIRMED: String
      DENIED: String
    end

    class ConflictException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module ContentType
      GENERIC: String
    end

    class DeleteSessionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?bot_name: String,
        ?bot_alias: String,
        ?user_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor bot_name: String?
      attr_accessor bot_alias: String?
      attr_accessor user_id: String?
    end

    class DeleteSessionResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?bot_name: String,
        ?bot_alias: String,
        ?user_id: String,
        ?session_id: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor bot_name: String?
      attr_accessor bot_alias: String?
      attr_accessor user_id: String?
      attr_accessor session_id: String?
    end

    class DependencyFailedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class DialogAction
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?intent_name: String,
        ?slots: Hash[String, String],
        ?slot_to_elicit: String,
        ?fulfillment_state: String,
        ?message: String,
        ?message_format: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor intent_name: String?
      attr_accessor slots: Hash[String, String]?
      attr_accessor slot_to_elicit: String?
      attr_accessor fulfillment_state: String?
      attr_accessor message: String?
      attr_accessor message_format: String?
    end

    module DialogActionType
      ELICIT_INTENT: String
      CONFIRM_INTENT: String
      ELICIT_SLOT: String
      CLOSE: String
      DELEGATE: String
    end

    module DialogState
      ELICIT_INTENT: String
      CONFIRM_INTENT: String
      ELICIT_SLOT: String
      FULFILLED: String
      READY_FOR_FULFILLMENT: String
      FAILED: String
    end

    module FulfillmentState
      FULFILLED: String
      FAILED: String
      READY_FOR_FULFILLMENT: String
    end

    class GenericAttachment
      include Smithy::Schema::Structure

      def initialize: (
        ?title: String,
        ?sub_title: String,
        ?attachment_link_url: String,
        ?image_url: String,
        ?buttons: Array[Types::Button],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor title: String?
      attr_accessor sub_title: String?
      attr_accessor attachment_link_url: String?
      attr_accessor image_url: String?
      attr_accessor buttons: Array[Types::Button]?
    end

    class GetSessionRequest
      include Smithy::Schema::Structure

      def initialize: (
        ?bot_name: String,
        ?bot_alias: String,
        ?user_id: String,
        ?checkpoint_label_filter: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor bot_name: String?
      attr_accessor bot_alias: String?
      attr_accessor user_id: String?
      attr_accessor checkpoint_label_filter: String?
    end

    class GetSessionResponse
      include Smithy::Schema::Structure

      def initialize: (
        ?recent_intent_summary_view: Array[Types::IntentSummary],
        ?session_attributes: Hash[String, String],
        ?session_id: String,
        ?dialog_action: Types::DialogAction,
        ?active_contexts: Array[Types::ActiveContext],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor recent_intent_summary_view: Array[Types::IntentSummary]?
      attr_accessor session_attributes: Hash[String, String]?
      attr_accessor session_id: String?
      attr_accessor dialog_action: Types::DialogAction?
      attr_accessor active_contexts: Array[Types::ActiveContext]?
    end

    class IntentConfidence
      include Smithy::Schema::Structure

      def initialize: (
        ?score: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor score: Float?
    end

    class IntentSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?intent_name: String,
        ?checkpoint_label: String,
        ?slots: Hash[String, String],
        ?confirmation_status: String,
        ?dialog_action_type: String,
        ?fulfillment_state: String,
        ?slot_to_elicit: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor intent_name: String?
      attr_accessor checkpoint_label: String?
      attr_accessor slots: Hash[String, String]?
      attr_accessor confirmation_status: String?
      attr_accessor dialog_action_type: String?
      attr_accessor fulfillment_state: String?
      attr_accessor slot_to_elicit: String?
    end

