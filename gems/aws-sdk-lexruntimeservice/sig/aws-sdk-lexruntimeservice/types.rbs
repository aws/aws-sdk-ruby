        ?encoded_message: String,
        ?message_format: String,
        ?dialog_state: String,
        ?slot_to_elicit: String,
        ?input_transcript: String,
        ?encoded_input_transcript: String,
        ?audio_stream: String,
        ?bot_version: String,
        ?session_id: String,
        ?active_contexts: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor content_type: String?
