      include Smithy::Schema::Structure

      def initialize: (
        ?intent_name: String,
        ?nlu_intent_confidence: Types::IntentConfidence,
        ?alternative_intents: Array[Types::PredictedIntent],
        ?slots: Hash[String, String],
        ?session_attributes: Hash[String, String],
