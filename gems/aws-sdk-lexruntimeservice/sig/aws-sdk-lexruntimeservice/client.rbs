module Aws::LexRuntimeService
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::LexRuntimeService::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _DeleteSessionResponse
      include Smithy::Client::_Response[Types::DeleteSessionResponse]
      def bot_name: () -> String?
      def bot_alias: () -> String?
      def user_id: () -> String?
      def session_id: () -> String?
    end
    def delete_session: (
      ?bot_name: String,
      ?bot_alias: String,
      ?user_id: String
    ) -> _DeleteSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _DeleteSessionResponse

    interface _GetSessionResponse
      include Smithy::Client::_Response[Types::GetSessionResponse]
      def recent_intent_summary_view: () -> Array[Types::IntentSummary]?
      def session_attributes: () -> Hash[String, String]?
      def session_id: () -> String?
      def dialog_action: () -> Types::DialogAction?
      def active_contexts: () -> Array[Types::ActiveContext]?
    end
    def get_session: (
      ?bot_name: String,
      ?bot_alias: String,
      ?user_id: String,
      ?checkpoint_label_filter: String
    ) -> _GetSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetSessionResponse

    interface _PostContentResponse
      include Smithy::Client::_Response[Types::PostContentResponse]
      def content_type: () -> String?
      def intent_name: () -> String?
      def nlu_intent_confidence: () -> String?
      def alternative_intents: () -> String?
      def slots: () -> String?
      def session_attributes: () -> String?
      def sentiment_response: () -> String?
      def message: () -> String?
      def encoded_message: () -> String?
      def message_format: () -> String?
      def dialog_state: () -> String?
      def slot_to_elicit: () -> String?
      def input_transcript: () -> String?
      def encoded_input_transcript: () -> String?
      def audio_stream: () -> String?
      def bot_version: () -> String?
      def session_id: () -> String?
      def active_contexts: () -> String?
    end
    def post_content: (
      ?bot_name: String,
      ?bot_alias: String,
      ?user_id: String,
      ?session_attributes: String,
      ?request_attributes: String,
      ?content_type: String,
      ?accept: String,
      ?input_stream: String,
      ?active_contexts: String
    ) -> _PostContentResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PostContentResponse

    interface _PostTextResponse
      include Smithy::Client::_Response[Types::PostTextResponse]
      def intent_name: () -> String?
      def nlu_intent_confidence: () -> Types::IntentConfidence?
      def alternative_intents: () -> Array[Types::PredictedIntent]?
      def slots: () -> Hash[String, String]?
      def session_attributes: () -> Hash[String, String]?
      def message: () -> String?
      def sentiment_response: () -> Types::SentimentResponse?
      def message_format: () -> String?
      def dialog_state: () -> String?
      def slot_to_elicit: () -> String?
      def response_card: () -> Types::ResponseCard?
      def session_id: () -> String?
      def bot_version: () -> String?
      def active_contexts: () -> Array[Types::ActiveContext]?
    end
    def post_text: (
      ?bot_name: String,
      ?bot_alias: String,
      ?user_id: String,
      ?session_attributes: Hash[String, String],
      ?request_attributes: Hash[String, String],
      ?input_text: String,
      ?active_contexts: Array[
        {
          name: String,
          time_to_live: {
            time_to_live_in_seconds: Integer,
            turns_to_live: Integer
          },
          parameters: Hash[String, String]
        }
      ]
    ) -> _PostTextResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PostTextResponse

    interface _PutSessionResponse
      include Smithy::Client::_Response[Types::PutSessionResponse]
      def content_type: () -> String?
      def intent_name: () -> String?
      def slots: () -> String?
      def session_attributes: () -> String?
      def message: () -> String?
      def encoded_message: () -> String?
      def message_format: () -> String?
      def dialog_state: () -> String?
      def slot_to_elicit: () -> String?
      def audio_stream: () -> String?
      def session_id: () -> String?
      def active_contexts: () -> String?
    end
    def put_session: (
      ?bot_name: String,
      ?bot_alias: String,
      ?user_id: String,
      ?session_attributes: Hash[String, String],
      ?dialog_action: {
        type: String,
        intent_name: String,
        slots: Hash[String, String],
        slot_to_elicit: String,
        fulfillment_state: String,
        message: String,
        message_format: String
      },
      ?recent_intent_summary_view: Array[
        {
          intent_name: String,
          checkpoint_label: String,
          slots: Hash[String, String],
          confirmation_status: String,
          dialog_action_type: String,
          fulfillment_state: String,
          slot_to_elicit: String
        }
      ],
      ?accept: String,
      ?active_contexts: Array[
        {
          name: String,
          time_to_live: {
            time_to_live_in_seconds: Integer,
            turns_to_live: Integer
          },
          parameters: Hash[String, String]
        }
      ]
    ) -> _PutSessionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _PutSessionResponse
  end
end
