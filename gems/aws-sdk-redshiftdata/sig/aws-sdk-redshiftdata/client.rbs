      include Smithy::Client::_Response[Types::ExecuteStatementOutput]
      def id: () -> String?
      def created_at: () -> Time?
      def cluster_identifier: () -> String?
      def db_user: () -> String?
      def db_groups: () -> Array[String]?
      def database: () -> String?
      def secret_arn: () -> String?
      def workgroup_name: () -> String?
      def session_id: () -> String?
    end
    def execute_statement: (
      ?sql: String,
      ?cluster_identifier: String,
      ?secret_arn: String,
      ?db_user: String,
      ?database: String,
      ?with_event: bool,
      ?statement_name: String,
      ?parameters: Array[
        {
          name: String,
          value: String
        }
      ],
      ?workgroup_name: String,
      ?client_token: String,
      ?session_keep_alive_seconds: Integer,
      ?session_id: String,
      ?result_format: String
    ) -> _ExecuteStatementResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ExecuteStatementResponse

    interface _GetStatementResultResponse
      include Smithy::Client::_Response[Types::GetStatementResultResponse]
      def records: () -> Array[Array[Types::Field]]?
      def column_metadata: () -> Array[Types::ColumnMetadata]?
      def total_num_rows: () -> Integer?
      def next_token: () -> String?
    end
    def get_statement_result: (
      ?id: String,
      ?next_token: String
    ) -> _GetStatementResultResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetStatementResultResponse

    interface _GetStatementResultV2Response
      include Smithy::Client::_Response[Types::GetStatementResultV2Response]
