    ) -> _ListSchemasResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListSchemasResponse

    interface _ListStatementsResponse
      include Smithy::Client::_Response[Types::ListStatementsResponse]
      def statements: () -> Array[Types::StatementData]?
      def next_token: () -> String?
    end
    def list_statements: (
      ?next_token: String,
      ?max_results: Integer,
      ?statement_name: String,
      ?status: String,
