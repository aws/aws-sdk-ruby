    ) -> _ListDatabasesResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListDatabasesResponse

    interface _ListSchemasResponse
      include Smithy::Client::_Response[Types::ListSchemasResponse]
