      ?database: String,
      ?cluster_identifier: String,
      ?workgroup_name: String
    ) -> _ListStatementsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListStatementsResponse

    interface _ListTablesResponse
      include Smithy::Client::_Response[Types::ListTablesResponse]
      def tables: () -> Array[Types::TableMember]?
