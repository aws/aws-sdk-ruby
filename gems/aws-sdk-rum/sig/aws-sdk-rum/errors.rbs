module Aws::RUM
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_name: () -> String?
      def resource_type: () -> String?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
      def retry_after_seconds: () -> Integer?
      def retryable?: () -> true
    end
    class InvalidPolicyRevisionIdException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class MalformedPolicyDocumentException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class PolicyNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class PolicySizeLimitExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_name: () -> String?
      def resource_type: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
      def service_code: () -> String?
      def quota_code: () -> String?
      def retry_after_seconds: () -> Integer?
      def retryable?: () -> true
      def throttling?: () -> true
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
