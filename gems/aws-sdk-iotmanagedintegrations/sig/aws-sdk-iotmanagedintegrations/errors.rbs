module Aws::IoTManagedIntegrations
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalFailureException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class InvalidRequestException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class LimitExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ServiceUnavailableException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class UnauthorizedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
    end
  end
end
