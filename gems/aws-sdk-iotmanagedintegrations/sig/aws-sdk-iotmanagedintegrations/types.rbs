module Aws::IoTManagedIntegrations
  module Types

    class AbortConfigCriteria
      include Smithy::Schema::Structure

      def initialize: (
        ?action: String,
        ?failure_type: String,
        ?min_number_of_executed_things: Integer,
        ?threshold_percentage: Float,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor action: String?
      attr_accessor failure_type: String?
      attr_accessor min_number_of_executed_things: Integer?
      attr_accessor threshold_percentage: Float?
    end

    module AbortCriteriaAction
      CANCEL: String
    end

    module AbortCriteriaFailureType
      FAILED: String
      REJECTED: String
      TIMED_OUT: String
      ALL: String
    end

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccountAssociationItem
      include Smithy::Schema::Structure

