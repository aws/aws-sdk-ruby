      def manager_arn: () -> String?
      def description: () -> String?
      def name: () -> String?
      def created_at: () -> Time?
      def last_modified_at: () -> Time?
      def status_summaries: () -> Array[Types::StatusSummary]?
      def configuration_definitions: () -> Array[Types::ConfigurationDefinition]?
      def tags: () -> Hash[String, String]?
    end
    def get_configuration_manager: (
      ?manager_arn: String
    ) -> _GetConfigurationManagerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetConfigurationManagerResponse

    interface _GetServiceSettingsResponse
      include Smithy::Client::_Response[Types::GetServiceSettingsOutput]
