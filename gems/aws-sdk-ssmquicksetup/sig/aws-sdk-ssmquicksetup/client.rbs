      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dualstack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _CreateConfigurationManagerResponse
      include Smithy::Client::_Response[Types::CreateConfigurationManagerOutput]
      def manager_arn: () -> String?
    end
    def create_configuration_manager: (
      ?name: String,
      ?description: String,
      ?configuration_definitions: Array[
        {
          type: String,
          parameters: Hash[String, String],
          type_version: untyped,
          local_deployment_execution_role_name: untyped,
          local_deployment_administration_role_arn: String
        }
      ],
      ?tags: Hash[String, String]
    ) -> _CreateConfigurationManagerResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateConfigurationManagerResponse

    interface _DeleteConfigurationManagerResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
