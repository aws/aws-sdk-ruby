      attr_accessor type_version: String?
      attr_accessor first_class_parameters: Hash[String, String]?
    end

    class ConfigurationManagerSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?manager_arn: String,
        ?description: String,
        ?name: String,
        ?status_summaries: Array[Types::StatusSummary],
        ?configuration_definition_summaries: Array[Types::ConfigurationDefinitionSummary],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor manager_arn: String?
      attr_accessor description: String?
      attr_accessor name: String?
      attr_accessor status_summaries: Array[Types::StatusSummary]?
      attr_accessor configuration_definition_summaries: Array[Types::ConfigurationDefinitionSummary]?
    end

    class ConfigurationSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?manager_arn: String,
        ?configuration_definition_id: String,
        ?type: String,
        ?type_version: String,
        ?region: String,
        ?account: String,
