    module Status
      INITIALIZING: String
      DEPLOYING: String
      SUCCEEDED: String
      DELETING: String
      STOPPING: String
      FAILED: String
      STOPPED: String
      DELETE_FAILED: String
      STOP_FAILED: String
      NONE: String
    end

    class StatusSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?status_type: String,
        ?status: String,
        ?status_message: String,
        ?last_updated_at: Time,
        ?status_details: Hash[String, String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor status_type: String?
      attr_accessor status: String?
      attr_accessor status_message: String?
      attr_accessor last_updated_at: Time?
      attr_accessor status_details: Hash[String, String]?
    end

    module StatusType
      DEPLOYMENT: String
      ASYNC_EXECUTIONS: String
    end

