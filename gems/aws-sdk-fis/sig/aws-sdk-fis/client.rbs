    interface _CreateExperimentTemplateResponse
      include Smithy::Client::_Response[Types::CreateExperimentTemplateResponse]
      def experiment_template: () -> Types::ExperimentTemplate?
    end
    def create_experiment_template: (
      ?client_token: String,
      ?description: String,
      ?stop_conditions: Array[
        {
          source: String,
          value: String
        }
      ],
      ?targets: Hash[String,
        {
          resource_type: String,
          resource_arns: Array[String],
          resource_tags: Hash[String, String],
          filters: Array[
            {
              path: String,
              values: Array[String]
            }
          ],
          selection_mode: String,
          parameters: Hash[String, String]
        }
      ],
      ?actions: Hash[String,
        {
          action_id: String,
          description: String,
          parameters: Hash[String, String],
          targets: Hash[String, String],
          start_after: Array[String]
        }
      ],
      ?role_arn: String,
      ?tags: Hash[String, String],
      ?log_configuration: {
        cloud_watch_logs_configuration: {
          log_group_arn: String
        },
        s3_configuration: {
          bucket_name: String,
          prefix: String
        },
        log_schema_version: Integer
      },
      ?experiment_options: {
        account_targeting: String,
        empty_target_resolution_mode: String
      },
      ?experiment_report_configuration: {
        outputs: {
          s3_configuration: {
            bucket_name: String,
            prefix: String
          }
        },
        data_sources: {
          cloud_watch_dashboards: Array[
            {
              dashboard_identifier: String
            }
          ]
        },
        pre_experiment_duration: String,
        post_experiment_duration: untyped
      }
    ) -> _CreateExperimentTemplateResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateExperimentTemplateResponse

