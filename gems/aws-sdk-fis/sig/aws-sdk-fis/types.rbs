    class Experiment
      include Smithy::Schema::Structure

      def initialize: (
        ?id: String,
        ?arn: String,
        ?experiment_template_id: String,
        ?role_arn: String,
        ?state: Types::ExperimentState,
        ?targets: Hash[String, Types::ExperimentTarget],
        ?actions: Hash[String, Types::ExperimentAction],
        ?stop_conditions: Array[Types::ExperimentStopCondition],
        ?creation_time: Time,
        ?start_time: Time,
        ?end_time: Time,
        ?tags: Hash[String, String],
        ?log_configuration: Types::ExperimentLogConfiguration,
        ?experiment_options: Types::ExperimentOptions,
        ?target_account_configurations_count: Integer,
        ?experiment_report_configuration: Types::ExperimentReportConfiguration,
        ?experiment_report: Types::ExperimentReport,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor id: String?
      attr_accessor arn: String?
      attr_accessor experiment_template_id: String?
      attr_accessor role_arn: String?
      attr_accessor state: Types::ExperimentState?
      attr_accessor targets: Hash[String, Types::ExperimentTarget]?
      attr_accessor actions: Hash[String, Types::ExperimentAction]?
      attr_accessor stop_conditions: Array[Types::ExperimentStopCondition]?
      attr_accessor creation_time: Time?
      attr_accessor start_time: Time?
      attr_accessor end_time: Time?
      attr_accessor tags: Hash[String, String]?
      attr_accessor log_configuration: Types::ExperimentLogConfiguration?
      attr_accessor experiment_options: Types::ExperimentOptions?
      attr_accessor target_account_configurations_count: Integer?
      attr_accessor experiment_report_configuration: Types::ExperimentReportConfiguration?
      attr_accessor experiment_report: Types::ExperimentReport?
    end

