      QUERY_TOO_LARGE: String
      UNSUPPORTED_OPERATION: String
      BAD_REQUEST: String
    end

    class VectorSearchConfiguration
      include Smithy::Schema::Structure

      def initialize: (
        ?dimension: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor dimension: Integer?
    end
  end
end
