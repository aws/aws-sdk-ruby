module Aws::WAF
  module Types

    class ActivatedRule
      include Smithy::Schema::Structure

      def initialize: (
        ?priority: Integer,
        ?rule_id: String,
        ?action: Types::WafAction,
        ?override_action: Types::WafOverrideAction,
        ?type: String,
        ?excluded_rules: Array[Types::ExcludedRule],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor priority: Integer?
      attr_accessor rule_id: String?
      attr_accessor action: Types::WafAction?
      attr_accessor override_action: Types::WafOverrideAction?
      attr_accessor type: String?
      attr_accessor excluded_rules: Array[Types::ExcludedRule]?
    end

    class ByteMatchSet
      include Smithy::Schema::Structure

      def initialize: (
        ?byte_match_set_id: String,
        ?name: String,
        ?byte_match_tuples: Array[Types::ByteMatchTuple],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor byte_match_set_id: String?
      attr_accessor name: String?
      attr_accessor byte_match_tuples: Array[Types::ByteMatchTuple]?
    end

    class ByteMatchSetSummary
      include Smithy::Schema::Structure

      def initialize: (
        ?byte_match_set_id: String,
        ?name: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor byte_match_set_id: String?
      attr_accessor name: String?
    end

    class ByteMatchSetUpdate
      include Smithy::Schema::Structure

      def initialize: (
        ?action: String,
        ?byte_match_tuple: Types::ByteMatchTuple,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor action: String?
      attr_accessor byte_match_tuple: Types::ByteMatchTuple?
    end

    class ByteMatchTuple
      include Smithy::Schema::Structure

      def initialize: (
        ?field_to_match: Types::FieldToMatch,
        ?target_string: String,
        ?text_transformation: String,
        ?positional_constraint: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor field_to_match: Types::FieldToMatch?
      attr_accessor target_string: String?
      attr_accessor text_transformation: String?
      attr_accessor positional_constraint: String?
    end

    module ChangeAction
      INSERT: String
      DELETE: String
    end

    module ChangeTokenStatus
      PROVISIONED: String
      PENDING: String
      INSYNC: String
    end

    module ComparisonOperator
      EQ: String
      NE: String
      LE: String
      LT: String
      GE: String
      GT: String
    end

