    interface _BatchUpdateRuleResponse
      include Smithy::Client::_Response[Types::BatchUpdateRuleOutput]
      def successful: () -> Array[Types::RuleUpdateSuccess]?
      def unsuccessful: () -> Array[Types::RuleUpdateFailure]?
    end
    def batch_update_rule: (
      ?service_identifier: String,
      ?listener_identifier: String,
      ?rules: Array[
        {
          rule_identifier: String,
          match: {
            http_match: {
              method: String,
              path_match: {
                match: {
                  exact: String,
                  prefix: String
                },
                case_sensitive: bool
              },
              header_matches: Array[
                {
                  name: String,
                  match: {
                    exact: String,
                    prefix: String,
                    contains: String
                  },
                  case_sensitive: untyped
                }
              ]
            }
          },
          priority: Integer,
          action: {
            forward: {
              target_groups: Array[
                {
                  target_group_identifier: String,
                  weight: Integer
                }
              ]
            },
            fixed_response: {
              status_code: Integer
            }
          }
        }
      ]
    ) -> _BatchUpdateRuleResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _BatchUpdateRuleResponse

