module Aws::WellArchitected
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    class AccountJiraConfigurationInput
      include Smithy::Schema::Structure

      def initialize: (
        ?issue_management_status: String,
        ?issue_management_type: String,
        ?jira_project_key: String,
        ?integration_status: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor issue_management_status: String?
      attr_accessor issue_management_type: String?
      attr_accessor jira_project_key: String?
      attr_accessor integration_status: String?
    end

    class AccountJiraConfigurationOutput
      include Smithy::Schema::Structure

      def initialize: (
        ?integration_status: String,
        ?issue_management_status: String,
        ?issue_management_type: String,
        ?subdomain: String,
        ?jira_project_key: String,
        ?status_message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor integration_status: String?
      attr_accessor issue_management_status: String?
      attr_accessor issue_management_type: String?
      attr_accessor subdomain: String?
      attr_accessor jira_project_key: String?
      attr_accessor status_message: String?
    end

    module AccountJiraIssueManagementStatus
      ENABLED: String
      DISABLED: String
    end

    module AdditionalResourceType
      HELPFUL_RESOURCE: String
      IMPROVEMENT_PLAN: String
    end

    class AdditionalResources
      include Smithy::Schema::Structure

      def initialize: (
        ?type: String,
        ?content: Array[Types::ChoiceContent],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor type: String?
      attr_accessor content: Array[Types::ChoiceContent]?
    end

    class Answer
      include Smithy::Schema::Structure

      def initialize: (
        ?question_id: String,
        ?pillar_id: String,
        ?question_title: String,
        ?question_description: String,
        ?improvement_plan_url: String,
        ?helpful_resource_url: String,
        ?helpful_resource_display_text: String,
        ?choices: Array[Types::Choice],
        ?selected_choices: Array[String],
        ?choice_answers: Array[Types::ChoiceAnswer],
        ?is_applicable: bool,
        ?risk: String,
        ?notes: String,
        ?reason: String,
        ?jira_configuration: Types::JiraConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor question_id: String?
      attr_accessor pillar_id: String?
      attr_accessor question_title: String?
      attr_accessor question_description: String?
      attr_accessor improvement_plan_url: String?
      attr_accessor helpful_resource_url: String?
      attr_accessor helpful_resource_display_text: String?
      attr_accessor choices: Array[Types::Choice]?
      attr_accessor selected_choices: Array[String]?
      attr_accessor choice_answers: Array[Types::ChoiceAnswer]?
      attr_accessor is_applicable: bool?
      attr_accessor risk: String?
      attr_accessor notes: String?
      attr_accessor reason: String?
      attr_accessor jira_configuration: Types::JiraConfiguration?
    end

    module AnswerReason
      OUT_OF_SCOPE: String
      BUSINESS_PRIORITIES: String
      ARCHITECTURE_CONSTRAINTS: String
      OTHER: String
      NONE: String
    end

    class AnswerSummary
      include Smithy::Schema::Structure

      def initialize: (
