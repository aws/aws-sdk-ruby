module Aws::GeoPlaces
  class Client < Smithy::Client::Base
    include Smithy::Client::Stubs

    def self.new: (
      ?access_key_id: String,
      ?account_id: String,
      ?adaptive_retry_wait_to_fill: bool,
      ?auth_resolver: AuthResolver,
      ?convert_params: bool,
      ?credentials_provider: #identity,
      ?disable_host_prefix_injection: bool,
      ?disable_request_compression: bool,
      ?endpoint: String,
      ?endpoint_provider: Aws::GeoPlaces::EndpointProvider,
      ?http_ca_file: String,
      ?http_ca_path: String,
      ?http_cert: OpenSSL::X509::Certificate,
      ?http_cert_store: OpenSSL::X509::Store,
      ?http_continue_timeout: Numeric,
      ?http_debug_output: bool,
      ?http_keep_alive_timeout: Numeric,
      ?http_key: OpenSSL::PKey::RSA | OpenSSL::PKey::DSA,
      ?http_open_timeout: Numeric,
      ?http_proxy: URI::HTTP | String,
      ?http_read_timeout: Numeric,
      ?http_ssl_timeout: Numeric,
      ?http_verify_mode: Integer,
      ?http_write_timeout: Numeric,
      ?log_formatter: Smithy::Client::LogFormatter,
      ?log_level: Symbol,
      ?logger: Logger,
      ?profile: String,
      ?raise_response_errors: bool,
      ?region: String,
      ?request_min_compression_size_bytes: Integer,
      ?retry_backoff: lambda,
      ?retry_max_attempts: Integer,
      ?retry_strategy: String | Class,
      ?sdk_ua_app_id: String,
      ?secret_access_key: String,
      ?session_token: String,
      ?stub_responses: bool,
      ?use_dual_stack_endpoint: bool,
      ?use_fips_endpoint: bool,
      ?validate_params: bool,
    ) -> void | (?Hash[Symbol, untyped]) -> void

    interface _AutocompleteResponse
      include Smithy::Client::_Response[Types::AutocompleteResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::AutocompleteResultItem]?
    end
    def autocomplete: (
      ?query_text: String,
      ?max_results: Integer,
      ?bias_position: Array[Float],
      ?filter: {
        bounding_box: Array[Float],
        circle: {
          center: Array[Float],
          radius: Integer
        },
        include_countries: Array[String],
        include_place_types: Array[String]
      },
      ?postal_code_mode: String,
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?key: String
    ) -> _AutocompleteResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _AutocompleteResponse

    interface _GeocodeResponse
      include Smithy::Client::_Response[Types::GeocodeResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::GeocodeResultItem]?
    end
    def geocode: (
      ?query_text: String,
      ?query_components: {
        country: String,
        region: untyped,
        sub_region: untyped,
        locality: untyped,
        district: untyped,
        street: untyped,
        address_number: untyped,
        postal_code: untyped
      },
      ?max_results: Integer,
      ?bias_position: Array[Float],
      ?filter: {
        include_countries: Array[String],
        include_place_types: Array[String]
      },
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?key: String
    ) -> _GeocodeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GeocodeResponse

    interface _GetPlaceResponse
      include Smithy::Client::_Response[Types::GetPlaceResponse]
      def place_id: () -> String?
      def place_type: () -> String?
      def title: () -> String?
      def pricing_bucket: () -> String?
      def address: () -> Types::Address?
      def address_number_corrected: () -> bool?
      def postal_code_details: () -> Array[Types::PostalCodeDetails]?
      def position: () -> Array[Float]?
      def map_view: () -> Array[Float]?
      def categories: () -> Array[Types::Category]?
      def food_types: () -> Array[Types::FoodType]?
      def business_chains: () -> Array[Types::BusinessChain]?
      def contacts: () -> Types::Contacts?
      def opening_hours: () -> Array[Types::OpeningHours]?
      def access_points: () -> Array[Types::AccessPoint]?
      def access_restrictions: () -> Array[Types::AccessRestriction]?
      def time_zone: () -> Types::TimeZone?
      def political_view: () -> String?
      def phonemes: () -> Types::PhonemeDetails?
      def main_address: () -> Types::RelatedPlace?
      def secondary_addresses: () -> Array[Types::RelatedPlace]?
    end
    def get_place: (
      ?place_id: String,
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?key: String
    ) -> _GetPlaceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPlaceResponse

    interface _ReverseGeocodeResponse
      include Smithy::Client::_Response[Types::ReverseGeocodeResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::ReverseGeocodeResultItem]?
    end
    def reverse_geocode: (
      ?query_position: Array[Float],
      ?query_radius: Integer,
      ?max_results: Integer,
      ?filter: {
        include_place_types: Array[String]
      },
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?key: String
    ) -> _ReverseGeocodeResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ReverseGeocodeResponse

    interface _SearchNearbyResponse
      include Smithy::Client::_Response[Types::SearchNearbyResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::SearchNearbyResultItem]?
      def next_token: () -> String?
    end
    def search_nearby: (
      ?query_position: Array[Float],
      ?query_radius: Integer,
      ?max_results: Integer,
      ?filter: {
        bounding_box: Array[Float],
        include_countries: Array[String],
        include_categories: Array[String],
        exclude_categories: untyped,
        include_business_chains: Array[String],
        exclude_business_chains: untyped,
        include_food_types: Array[String],
        exclude_food_types: untyped
      },
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?next_token: String,
      ?key: String
    ) -> _SearchNearbyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchNearbyResponse

    interface _SearchTextResponse
      include Smithy::Client::_Response[Types::SearchTextResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::SearchTextResultItem]?
      def next_token: () -> String?
    end
    def search_text: (
      ?query_text: String,
      ?query_id: String,
      ?max_results: Integer,
      ?bias_position: Array[Float],
      ?filter: {
        bounding_box: Array[Float],
        circle: {
          center: Array[Float],
          radius: Integer
        },
        include_countries: Array[String]
      },
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?next_token: String,
      ?key: String
    ) -> _SearchTextResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SearchTextResponse

    interface _SuggestResponse
      include Smithy::Client::_Response[Types::SuggestResponse]
      def pricing_bucket: () -> String?
      def result_items: () -> Array[Types::SuggestResultItem]?
      def query_refinements: () -> Array[Types::QueryRefinement]?
    end
    def suggest: (
      ?query_text: String,
      ?max_results: Integer,
      ?max_query_refinements: Integer,
      ?bias_position: Array[Float],
      ?filter: {
        bounding_box: Array[Float],
        circle: {
          center: Array[Float],
          radius: Integer
        },
        include_countries: Array[String]
      },
      ?additional_features: Array[String],
      ?language: String,
      ?political_view: String,
      ?intended_use: String,
      ?key: String
    ) -> _SuggestResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _SuggestResponse
  end
end
