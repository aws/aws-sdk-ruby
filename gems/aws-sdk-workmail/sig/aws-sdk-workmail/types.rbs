module Aws::WorkMail
  module Types

    class AccessControlRule
      include Smithy::Schema::Structure

      def initialize: (
        ?name: String,
        ?effect: String,
        ?description: String,
        ?ip_ranges: Array[String],
        ?not_ip_ranges: Array[String],
        ?actions: Array[String],
        ?not_actions: Array[String],
        ?user_ids: Array[String],
        ?not_user_ids: Array[String],
        ?date_created: Time,
        ?date_modified: Time,
        ?impersonation_role_ids: Array[String],
        ?not_impersonation_role_ids: Array[String],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor name: String?
      attr_accessor effect: String?
      attr_accessor description: String?
      attr_accessor ip_ranges: Array[String]?
      attr_accessor not_ip_ranges: Array[String]?
      attr_accessor actions: Array[String]?
      attr_accessor not_actions: Array[String]?
      attr_accessor user_ids: Array[String]?
      attr_accessor not_user_ids: Array[String]?
      attr_accessor date_created: Time?
      attr_accessor date_modified: Time?
      attr_accessor impersonation_role_ids: Array[String]?
      attr_accessor not_impersonation_role_ids: Array[String]?
    end

    module AccessControlRuleEffect
      ALLOW: String
      DENY: String
    end

    module AccessEffect
      ALLOW: String
      DENY: String
    end

