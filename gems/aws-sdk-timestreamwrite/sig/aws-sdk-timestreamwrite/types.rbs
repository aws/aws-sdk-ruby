module Aws::TimestreamWrite
  module Types

    class AccessDeniedException
      include Smithy::Schema::Structure

      def initialize: (
        ?message: String,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor message: String?
    end

    module BatchLoadDataFormat
      CSV: String
    end

    class BatchLoadProgressReport
      include Smithy::Schema::Structure

      def initialize: (
        ?records_processed: Integer,
        ?records_ingested: Integer,
        ?parse_failures: Integer,
        ?record_ingestion_failures: Integer,
        ?file_failures: Integer,
        ?bytes_metered: Integer,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor records_processed: Integer?
      attr_accessor records_ingested: Integer?
      attr_accessor parse_failures: Integer?
      attr_accessor record_ingestion_failures: Integer?
      attr_accessor file_failures: Integer?
      attr_accessor bytes_metered: Integer?
    end

    module BatchLoadStatus
      CREATED: String
      IN_PROGRESS: String
      FAILED: String
      SUCCEEDED: String
      PROGRESS_STOPPED: String
      PENDING_RESUME: String
    end

    class BatchLoadTask
      include Smithy::Schema::Structure

      def initialize: (
        ?task_id: String,
        ?task_status: String,
        ?database_name: String,
        ?table_name: String,
        ?creation_time: Time,
        ?last_updated_time: Time,
        ?resumable_until: Time,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor task_id: String?
      attr_accessor task_status: String?
      attr_accessor database_name: String?
      attr_accessor table_name: String?
      attr_accessor creation_time: Time?
      attr_accessor last_updated_time: Time?
      attr_accessor resumable_until: Time?
    end

    class BatchLoadTaskDescription
      include Smithy::Schema::Structure

      def initialize: (
        ?task_id: String,
        ?error_message: String,
