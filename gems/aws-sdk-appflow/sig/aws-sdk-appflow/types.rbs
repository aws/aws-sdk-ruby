        ?connector_provisioning_config: Types::ConnectorProvisioningConfig,
        ?logo_url: String,
        ?registered_at: Time,
        ?registered_by: String,
        ?supported_data_transfer_types: Array[String],
        ?supported_data_transfer_apis: Array[Types::DataTransferApi],
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor can_use_as_source: bool?
      attr_accessor can_use_as_destination: bool?
      attr_accessor supported_destination_connectors: Array[String]?
      attr_accessor supported_scheduling_frequencies: Array[String]?
      attr_accessor is_private_link_enabled: bool?
      attr_accessor is_private_link_endpoint_url_required: bool?
      attr_accessor supported_trigger_types: Array[String]?
      attr_accessor connector_metadata: Types::ConnectorMetadata?
      attr_accessor connector_type: String?
      attr_accessor connector_label: String?
      attr_accessor connector_description: String?
      attr_accessor connector_owner: String?
      attr_accessor connector_name: String?
      attr_accessor connector_version: String?
      attr_accessor connector_arn: String?
      attr_accessor connector_modes: Array[String]?
      attr_accessor authentication_config: Types::AuthenticationConfig?
      attr_accessor connector_runtime_settings: Array[Types::ConnectorRuntimeSetting]?
      attr_accessor supported_api_versions: Array[String]?
      attr_accessor supported_operators: Array[String]?
      attr_accessor supported_write_operations: Array[String]?
      attr_accessor connector_provisioning_type: String?
      attr_accessor connector_provisioning_config: Types::ConnectorProvisioningConfig?
      attr_accessor logo_url: String?
      attr_accessor registered_at: Time?
      attr_accessor registered_by: String?
      attr_accessor supported_data_transfer_types: Array[String]?
      attr_accessor supported_data_transfer_apis: Array[Types::DataTransferApi]?
