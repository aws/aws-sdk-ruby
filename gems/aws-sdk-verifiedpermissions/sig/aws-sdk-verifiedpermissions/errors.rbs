module Aws::VerifiedPermissions
  module Errors
    class AccessDeniedException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ConflictException < Smithy::Client::ServiceError
      def message: () -> String?
      def resources: () -> Array[Types::ResourceConflict]?
    end
    class InternalServerException < Smithy::Client::ServiceError
      def message: () -> String?
      def retryable?: () -> true
    end
    class InvalidStateException < Smithy::Client::ServiceError
      def message: () -> String?
    end
    class ResourceNotFoundException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
    end
    class ServiceQuotaExceededException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_id: () -> String?
      def resource_type: () -> String?
      def service_code: () -> String?
      def quota_code: () -> String?
    end
    class ThrottlingException < Smithy::Client::ServiceError
      def message: () -> String?
      def service_code: () -> String?
      def quota_code: () -> String?
      def retryable?: () -> true
      def throttling?: () -> true
    end
    class TooManyTagsException < Smithy::Client::ServiceError
      def message: () -> String?
      def resource_name: () -> String?
    end
    class ValidationException < Smithy::Client::ServiceError
      def message: () -> String?
      def field_list: () -> Array[Types::ValidationExceptionField]?
    end
  end
end
