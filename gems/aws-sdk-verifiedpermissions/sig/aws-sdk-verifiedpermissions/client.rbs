    ) -> _UntagResourceResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UntagResourceResponse

    interface _UpdateIdentitySourceResponse
      include Smithy::Client::_Response[Types::UpdateIdentitySourceOutput]
