          statement: String
        }
      }
    ) -> _UpdatePolicyResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _UpdatePolicyResponse

    interface _UpdatePolicyStoreResponse
      include Smithy::Client::_Response[Types::UpdatePolicyStoreOutput]
