    interface _CreateChannelResponse
      include Smithy::Client::_Response[Types::CreateChannelOutput]
      def channel_description: () -> Types::ChannelDescription?
    end
    def create_channel: (
      ?channel_name: String,
      ?service_execution_role_arn: String,
      ?stream_configuration_list: Array[
        {
          stream_arn: String,
          record_configuration: {
            record_format_type: String,
            gsr_schema_arn: String
          }
        }
      ],
      ?s3_destination_configuration: {
        data_freshness_in_seconds: Integer,
        dead_letter_queue_s3_configuration: {
          bucket_arn: String,
          expected_bucket_owner: String,
          error_output_prefix: String
        },
        storage_configuration: {
          bucket_arn: untyped,
          expected_bucket_owner: untyped,
          output_key_template: String,
          storage_class: String,
          compression_type: String
        }
      },
      ?s3_tables_destination_configuration: {
        data_freshness_in_seconds: Integer,
        dead_letter_queue_s3_configuration: {
          bucket_arn: String,
          expected_bucket_owner: String,
          error_output_prefix: String
        },
        s3_tables_configuration_list: Array[
          {
            table_bucket_arn: String,
            namespace: String,
            table_name: String,
            compression_type: String,
            partition_spec: {
              partition_fields: Array[
                {
                  transform: String,
                  source_name: String
                }
              ]
            }
          }
        ]
      },
      ?encryption_configuration: {
        encryption_type: String,
        key_id: String
      },
      ?tags: Hash[String, String],
      ?logging_configuration: {
        cloud_watch_logs: {
          enabled: bool,
          log_group_name: String,
          log_stream_name: String
        }
      }
    ) -> _CreateChannelResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _CreateChannelResponse

