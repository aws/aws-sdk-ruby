    class ChannelDescription
      include Smithy::Schema::Structure

      def initialize: (
        ?channel_name: String,
        ?channel_arn: String,
        ?channel_id: String,
        ?channel_status: String,
        ?channel_status_reason: String,
        ?channel_creation_timestamp: Time,
        ?service_execution_role_arn: String,
        ?stream_configuration_list: Array[Types::ChannelStreamDescription],
        ?s3_destination_configuration: Types::S3DestinationDescription,
        ?s3_tables_destination_configuration: Types::S3TablesDestinationDescription,
        ?encryption_configuration: Types::ChannelEncryptionConfiguration,
        ?logging_configuration: Types::ChannelLoggingConfiguration,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor channel_name: String?
      attr_accessor channel_arn: String?
      attr_accessor channel_id: String?
      attr_accessor channel_status: String?
      attr_accessor channel_status_reason: String?
      attr_accessor channel_creation_timestamp: Time?
      attr_accessor service_execution_role_arn: String?
      attr_accessor stream_configuration_list: Array[Types::ChannelStreamDescription]?
      attr_accessor s3_destination_configuration: Types::S3DestinationDescription?
      attr_accessor s3_tables_destination_configuration: Types::S3TablesDestinationDescription?
      attr_accessor encryption_configuration: Types::ChannelEncryptionConfiguration?
      attr_accessor logging_configuration: Types::ChannelLoggingConfiguration?
    end

