    class SubscribeToShardEventStream
      include Smithy::Schema::Union

      def initialize: (
        ?subscribe_to_shard_event: Types::SubscribeToShardEvent,
        ?resource_not_found_exception: Types::ResourceNotFoundException,
        ?resource_in_use_exception: Types::ResourceInUseException,
        ?kms_disabled_exception: Types::KMSDisabledException,
        ?kms_invalid_state_exception: Types::KMSInvalidStateException,
        ?kms_access_denied_exception: Types::KMSAccessDeniedException,
        ?kms_not_found_exception: Types::KMSNotFoundException,
        ?kms_opt_in_required: Types::KMSOptInRequired,
        ?kms_throttling_exception: Types::KMSThrottlingException,
        ?internal_failure_exception: Types::InternalFailureException,
      ) -> void
      | (?Hash[Symbol, untyped]) -> void

      attr_accessor subscribe_to_shard_event: Types::SubscribeToShardEvent?
      attr_accessor resource_not_found_exception: Types::ResourceNotFoundException?
      attr_accessor resource_in_use_exception: Types::ResourceInUseException?
      attr_accessor kms_disabled_exception: Types::KMSDisabledException?
      attr_accessor kms_invalid_state_exception: Types::KMSInvalidStateException?
      attr_accessor kms_access_denied_exception: Types::KMSAccessDeniedException?
      attr_accessor kms_not_found_exception: Types::KMSNotFoundException?
      attr_accessor kms_opt_in_required: Types::KMSOptInRequired?
      attr_accessor kms_throttling_exception: Types::KMSThrottlingException?
      attr_accessor internal_failure_exception: Types::InternalFailureException?

      class SubscribeToShardEvent < SubscribeToShardEventStream
      end
      class ResourceNotFoundException < SubscribeToShardEventStream
      end
      class ResourceInUseException < SubscribeToShardEventStream
      end
      class KMSDisabledException < SubscribeToShardEventStream
      end
      class KMSInvalidStateException < SubscribeToShardEventStream
      end
      class KMSAccessDeniedException < SubscribeToShardEventStream
      end
      class KMSNotFoundException < SubscribeToShardEventStream
      end
      class KMSOptInRequired < SubscribeToShardEventStream
      end
      class KMSThrottlingException < SubscribeToShardEventStream
      end
      class InternalFailureException < SubscribeToShardEventStream
      end
      class Unknown < SubscribeToShardEventStream
      end
    end

