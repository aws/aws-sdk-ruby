    def create_simulation_job: (
      ?client_request_token: String,
      ?output_location: {
        s3_bucket: String,
        s3_prefix: String
      },
      ?logging_config: {
        record_all_ros_topics: bool
      },
      ?max_job_duration_in_seconds: Integer,
      ?iam_role: String,
      ?failure_behavior: String,
      ?robot_applications: Array[
        {
          application: String,
          application_version: String,
          launch_config: {
            package_name: String,
            launch_file: untyped,
            environment_variables: Hash[String, String],
            port_forwarding_config: {
              port_mappings: Array[
                {
                  job_port: Integer,
                  application_port: Integer,
                  enable_on_public_ip: bool
                }
              ]
            },
            stream_ui: untyped,
            command: Array[String]
          },
          upload_configurations: Array[
            {
              name: String,
              path: String,
              upload_behavior: String
            }
          ],
          use_default_upload_configurations: bool,
          tools: Array[
            {
              stream_ui: untyped,
              name: untyped,
              command: String,
              stream_output_to_cloud_watch: untyped,
              exit_behavior: String
            }
          ],
          use_default_tools: untyped
        }
      ],
      ?simulation_applications: Array[
        {
          application: String,
          application_version: String,
          launch_config: {
            package_name: String,
            launch_file: untyped,
            environment_variables: Hash[String, String],
            port_forwarding_config: {
              port_mappings: Array[
                {
                  job_port: Integer,
                  application_port: Integer,
                  enable_on_public_ip: bool
                }
              ]
            },
            stream_ui: untyped,
            command: Array[String]
          },
          upload_configurations: Array[
            {
              name: String,
              path: String,
              upload_behavior: String
            }
          ],
          world_configs: Array[
            {
              world: untyped
            }
          ],
          use_default_upload_configurations: bool,
          tools: Array[
            {
              stream_ui: untyped,
              name: untyped,
              command: String,
              stream_output_to_cloud_watch: untyped,
              exit_behavior: String
            }
          ],
          use_default_tools: untyped
        }
      ],
      ?data_sources: Array[
        {
          name: String,
          s3_bucket: String,
          s3_keys: Array[String],
          type: String,
          destination: String
        }
      ],
      ?tags: Hash[String, String],
      ?vpc_config: {
        subnets: Array[String],
        security_groups: Array[String],
        assign_public_ip: bool
      },
      ?compute: {
        simulation_unit_limit: Integer,
        compute_type: String,
        gpu_unit_limit: Integer
      }
