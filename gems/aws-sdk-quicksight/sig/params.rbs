      type numeric_range_filter = {
      filter_id: ::String,
      column: {
        data_set_identifier: ::String,
        column_name: ::String
      },
      include_minimum: bool?,
      include_maximum: bool?,
      range_minimum: {
        static_value: ::Float?,
        parameter: ::String?
      }?,
      range_maximum: {
        static_value: ::Float?,
        parameter: ::String?
      }?,
      select_all_options: ("FILTER_ALL_VALUES")?,
      aggregation_function: Params::aggregation_function?,
      null_option: ("ALL_VALUES" | "NULLS_ONLY" | "NON_NULLS_ONLY"),
      default_filter_control_configuration: Params::default_filter_control_configuration?
    }

      type numeric_equality_filter = {
      filter_id: ::String,
      column: {
        data_set_identifier: ::String,
        column_name: ::String
      },
      value: ::Float?,
      select_all_options: ("FILTER_ALL_VALUES")?,
      match_operator: ("EQUALS" | "DOES_NOT_EQUAL"),
