    end
    def list_regions: (
      ?account_id: String,
      ?max_results: Integer,
      ?next_token: String,
      ?region_opt_status_contains: Array[String]
    ) -> _ListRegionsResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _ListRegionsResponse

    interface _PutAccountNameResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def put_account_name: (
      ?account_name: String,
