    interface _PutContactInformationResponse
      include Smithy::Client::_Response[Smithy::Schema::EmptyStructure]
    end
    def put_contact_information: (
      ?contact_information: {
        full_name: String,
        address_line1: String,
        address_line2: untyped,
        address_line3: untyped,
        city: String,
        state_or_region: String,
