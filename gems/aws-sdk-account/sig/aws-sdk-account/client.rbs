    ) -> _EnableRegionResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _EnableRegionResponse

    interface _GetAccountInformationResponse
      include Smithy::Client::_Response[Types::GetAccountInformationResponse]
      def account_id: () -> String?
      def account_name: () -> String?
      def account_created_date: () -> Time?
    end
    def get_account_information: (
      ?account_id: String
    ) -> _GetAccountInformationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAccountInformationResponse

    interface _GetAlternateContactResponse
