    ) -> _GetAlternateContactResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetAlternateContactResponse

    interface _GetContactInformationResponse
      include Smithy::Client::_Response[Types::GetContactInformationResponse]
      def contact_information: () -> Types::ContactInformation?
    end
    def get_contact_information: (
      ?account_id: String
    ) -> _GetContactInformationResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetContactInformationResponse

    interface _GetPrimaryEmailResponse
      include Smithy::Client::_Response[Types::GetPrimaryEmailResponse]
      def primary_email: () -> String?
    end
    def get_primary_email: (
      ?account_id: String
    ) -> _GetPrimaryEmailResponse | (?Hash[Symbol, untyped], ?Hash[Symbol, untyped]) -> _GetPrimaryEmailResponse

    interface _GetRegionOptStatusResponse
      include Smithy::Client::_Response[Types::GetRegionOptStatusResponse]
      def region_name: () -> String?
      def region_opt_status: () -> String?
    end
    def get_region_opt_status: (
      ?account_id: String,
